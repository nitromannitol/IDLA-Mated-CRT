import MatedCRT.Proofs.Sec1.EnvironmentScaling.CountableObservableIdentification
import MatedCRT.Proofs.Sec1.EnvironmentScaling.CircleProcessSpace

/-!
# Represented continuous circle process: joint law from countable codes

The written dense-coordinate law identification: "Use countably many test
pairings to code `Ĥ`, and evaluations on a countable dense subset of `E` to code a continuous circle process. Joint laws of
these codes determine their joint law on `𝒟'(ℂ) × C(E,ℝ)`, so the identification is simultaneous."

* `E = (0,∞) × ℂ` is `PosCircleIndex` and `C(E,ℝ)` is `PosCircleFns` (CircleProcessSpace.lean: Polish, Borel).
* The distribution half is the countable test-pairing code `planeDistributionCode` (DistributionCode.lean), built from
  Leonardo Bonanno's imported modules `LQGMetric.comb` and `LQGMetric.measurableEmbedding_pairJ`. Its law determination
  `map_eq_of_codeTests_map_eq` (CountableObservableIdentification.lean) is reused, not reproved.

Scope. The represented distribution `H` and the continuous representative `Φ` are supplied as measurable maps; neither is
constructed. The continuous modification of Duplantier-Sheffield circle averages is not used, and no extra
premise appears: continuity of `Φ` is part of its type. This file does not discharge the represented-grid
producer and does not close any environment-scaling step.
-/

open MeasureTheory Filter Topology Set
open HarmonicBalls
open MatedCRT.CircleProcessSpace

namespace MatedCRT.Sec1

/-! ### Countable dense coordinates of a continuous circle process -/

/-- The countable dense coordinates `f ↦ (f (D n))_n` of a function on the positive-circle index set `E`, for a
sequence `D` of indices. -/
def posCircleCode (D : ℕ → PosCircleIndex) (f : PosCircleFns) : ℕ → ℝ :=
  fun n => f (D n)

theorem measurable_posCircleCode (D : ℕ → PosCircleIndex) : Measurable (posCircleCode D) :=
  Measurable.of_eval fun n => measurable_posCircleFns_eval (D n)

/-- Transfer of measurability along `e`: if the codomain σ-algebra of `g` is the one induced by `e`, then `g` is
measurable as soon as `e ∘ g` is. -/
theorem measurable_of_comp_comap_eq {α β γ : Type*} {mα : MeasurableSpace α} {mβ : MeasurableSpace β}
    {mγ : MeasurableSpace γ} {e : β → γ} (he : mβ = MeasurableSpace.comap e mγ) {g : α → β}
    (h : @Measurable α γ mα mγ (e ∘ g)) : @Measurable α β mα mβ g := by
  rw [measurable_iff_comap_le, he, MeasurableSpace.comap_comp]
  exact measurable_iff_comap_le.mp h

/-- Measurability of a pointwise limit of real-valued measurable functions, for an arbitrary σ-algebra on `α` (the
instance is taken explicitly, so that it can be the one induced by the countable dense coordinates). -/
theorem measurable_limit_of_tendsto {α : Type*} [MeasurableSpace α] {f : ℕ → α → ℝ} {g : α → ℝ}
    (hf : ∀ i, Measurable (f i)) (lim : Tendsto f atTop (𝓝 g)) : Measurable g :=
  measurable_of_tendsto_metrizable hf lim

/-- The Borel σ-algebra of `C(E,ℝ)` is generated by evaluations on a dense sequence: every evaluation at `p ∈ E` is a
pointwise limit of evaluations at points of `D`, since `E` is metrizable. -/
theorem borel_le_comap_posCircleCode {D : ℕ → PosCircleIndex} (hD : DenseRange D) :
    (inferInstance : MeasurableSpace PosCircleFns) ≤
      MeasurableSpace.comap (posCircleCode D) inferInstance := by
  have hev : ∀ p : PosCircleIndex,
      @Measurable PosCircleFns ℝ (MeasurableSpace.comap (posCircleCode D) inferInstance) inferInstance
        (fun f : PosCircleFns => f p) := by
    intro p
    obtain ⟨x, hx_mem, hx_lim⟩ := mem_closure_iff_seq_limit.mp (hD p)
    choose k hk using fun n => Set.mem_range.mp (hx_mem n)
    refine @measurable_limit_of_tendsto PosCircleFns (MeasurableSpace.comap (posCircleCode D) inferInstance)
      (fun n (f : PosCircleFns) => f (D (k n))) (fun f : PosCircleFns => f p) (fun n => ?_) ?_
    · exact (measurable_pi_apply (k n)).comp (comap_measurable (posCircleCode D))
    · rw [tendsto_pi_nhds]
      intro f
      have hlim : Tendsto (fun n => D (k n)) atTop (𝓝 p) := by
        simpa only [hk] using hx_lim
      exact (f.continuous.tendsto p).comp hlim
  have hid : @Measurable PosCircleFns PosCircleFns (MeasurableSpace.comap (posCircleCode D) inferInstance)
      inferInstance id :=
    (@measurable_iff_eval_posCircleFns PosCircleFns (MeasurableSpace.comap (posCircleCode D) inferInstance) id).mpr
      hev
  exact fun s hs => hid hs

/-- The Borel σ-algebra of `C(E,ℝ)` equals the σ-algebra of its countable dense coordinates. -/
theorem borel_eq_comap_posCircleCode {D : ℕ → PosCircleIndex} (hD : DenseRange D) :
    (inferInstance : MeasurableSpace PosCircleFns) =
      MeasurableSpace.comap (posCircleCode D) inferInstance :=
  le_antisymm (borel_le_comap_posCircleCode hD) (measurable_posCircleCode D).comap_le

/-- A map into `C(E,ℝ)` is measurable iff each countable dense coordinate of it is measurable. -/
theorem measurable_iff_posCircleCode {Z : Type*} [MeasurableSpace Z] {D : ℕ → PosCircleIndex}
    (hD : DenseRange D) {g : Z → PosCircleFns} :
    Measurable g ↔ Measurable (fun z n => g z (D n)) :=
  ⟨fun hg => Measurable.of_eval fun n => (measurable_posCircleFns_eval (D n)).comp hg,
    fun h => measurable_of_comp_comap_eq (borel_eq_comap_posCircleCode hD) h⟩

/-- Two measures agree when they have equal images under a measurable map `f` whose induced σ-algebra contains the
σ-algebra of the source: every measurable set is then a preimage of a measurable set. -/
theorem ext_of_map_eq_of_le_comap {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] {f : α → β}
    (hf : Measurable f) (hle : (inferInstance : MeasurableSpace α) ≤ MeasurableSpace.comap f inferInstance)
    {μ ν : Measure α} (h : μ.map f = ν.map f) : μ = ν := by
  ext s hs
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp (hle s hs)
  have h' : μ.map f t = ν.map f t := by rw [h]
  rwa [Measure.map_apply hf ht, Measure.map_apply hf ht] at h'

/-! ### Circle half: the law of a represented continuous circle process -/

/-- Countable dense code identification for a measurable continuous positive-radius circle representative: its law on
`C(E,ℝ)` is identified by the law of its countable dense coordinates `(Φ(D n))_n`. -/
theorem map_posCircle_eq_iff {Ω Ω' : Type} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
    {P' : Measure Ω'} {D : ℕ → PosCircleIndex} (hD : DenseRange D) {Φ : Ω → PosCircleFns}
    {Φ' : Ω' → PosCircleFns} (hΦ : Measurable Φ) (hΦ' : Measurable Φ') :
    P.map Φ = P'.map Φ' ↔
      P.map (fun ω n => Φ ω (D n)) = P'.map (fun ω' n => Φ' ω' (D n)) := by
  have hc : Measurable (posCircleCode D) := measurable_posCircleCode D
  constructor
  · intro h
    have h2 := congrArg (Measure.map (posCircleCode D)) h
    rw [Measure.map_map hc hΦ, Measure.map_map hc hΦ'] at h2
    exact h2
  · intro h
    refine ext_of_map_eq_of_le_comap hc (borel_le_comap_posCircleCode hD) ?_
    rw [Measure.map_map hc hΦ, Measure.map_map hc hΦ']
    exact h

/-! ### Joint half: represented distribution and circle process -/

/-- Joint countable code of a represented pair: the test pairings of the distribution (`planeDistributionCode`,
Bonanno's code) together with the countable dense coordinates of the circle representative. -/
noncomputable def representedPairCode (D : ℕ → PosCircleIndex) (x : LQGMetric.DistC × PosCircleFns) :
    (LQGMetric.CoordJ → ℝ) × (ℕ → ℝ) :=
  (fun c => x.1 (planeDistributionCode.test c), posCircleCode D x.2)

theorem measurable_representedPairCode (D : ℕ → PosCircleIndex) :
    Measurable (representedPairCode D) :=
  (planeDistributionCode.embedding.measurable.comp measurable_fst).prodMk
    ((measurable_posCircleCode D).comp measurable_snd)

/-- The σ-algebra of the pair `DistC × C(E,ℝ)` is contained in the σ-algebra induced by the joint code. -/
theorem prod_le_comap_representedPairCode {D : ℕ → PosCircleIndex} (hD : DenseRange D) :
    (inferInstance : MeasurableSpace (LQGMetric.DistC × PosCircleFns)) ≤
      MeasurableSpace.comap (representedPairCode D) inferInstance := by
  have hfst : @Measurable (LQGMetric.DistC × PosCircleFns) LQGMetric.DistC
      (MeasurableSpace.comap (representedPairCode D) inferInstance) inferInstance Prod.fst :=
    measurable_of_comp_comap_eq planeDistributionCode.embedding.comap_eq.symm
      (measurable_fst.comp (comap_measurable (representedPairCode D)))
  have hsnd : @Measurable (LQGMetric.DistC × PosCircleFns) PosCircleFns
      (MeasurableSpace.comap (representedPairCode D) inferInstance) inferInstance Prod.snd :=
    measurable_of_comp_comap_eq (borel_eq_comap_posCircleCode hD)
      (measurable_snd.comp (comap_measurable (representedPairCode D)))
  have hid : @Measurable (LQGMetric.DistC × PosCircleFns) (LQGMetric.DistC × PosCircleFns)
      (MeasurableSpace.comap (representedPairCode D) inferInstance) inferInstance id :=
    hfst.prodMk hsnd
  exact fun s hs => hid hs

/-- Joint identification: the joint law of a measurable represented distribution `H` and a measurable continuous
circle representative `Φ` is identified by the joint law of their countable codes, the test pairings `H ω (test c)`
and the dense evaluations `Φ ω (D n)`. -/
theorem map_representedPair_iff {Ω Ω' : Type} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
    {P' : Measure Ω'} {D : ℕ → PosCircleIndex} (hD : DenseRange D) {H : Ω → LQGMetric.DistC}
    {H' : Ω' → LQGMetric.DistC} {Φ : Ω → PosCircleFns} {Φ' : Ω' → PosCircleFns} (hH : Measurable H)
    (hH' : Measurable H') (hΦ : Measurable Φ) (hΦ' : Measurable Φ') :
    P.map (fun ω => (H ω, Φ ω)) = P'.map (fun ω' => (H' ω', Φ' ω')) ↔
      P.map (fun ω => ((fun c : LQGMetric.CoordJ => H ω (planeDistributionCode.test c)), fun n => Φ ω (D n))) =
        P'.map (fun ω' => ((fun c : LQGMetric.CoordJ => H' ω' (planeDistributionCode.test c)),
          fun n => Φ' ω' (D n))) := by
  have hJ : Measurable (representedPairCode D) := measurable_representedPairCode D
  have hp : Measurable (fun ω => (H ω, Φ ω)) := hH.prodMk hΦ
  have hp' : Measurable (fun ω' => (H' ω', Φ' ω')) := hH'.prodMk hΦ'
  constructor
  · intro h
    have h2 := congrArg (Measure.map (representedPairCode D)) h
    rw [Measure.map_map hJ hp, Measure.map_map hJ hp'] at h2
    exact h2
  · intro h
    refine ext_of_map_eq_of_le_comap hJ (prod_le_comap_representedPairCode hD) ?_
    rw [Measure.map_map hJ hp, Measure.map_map hJ hp']
    exact h

end MatedCRT.Sec1
