    (hξ : 0 < ξ) (hA : 0 ≤ A) (hβ : 0 < β) (hα : 0 < α) (hC₁ : 0 ≤ C₁)
    (hH : ∀ᶠ n in atTop, ∀ (x : ℂ) (r : ℝ), 0 < r → ball x r ⊆ ball 0 ρ → ∀ f : ℤ → ℝ,
      (∀ a ∈ interiorCellVertices (ε n) η (ball x r), matedLaplacian (m n) f a = 0) →
