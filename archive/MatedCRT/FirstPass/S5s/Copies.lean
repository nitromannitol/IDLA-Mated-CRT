  refine ⟨φ ∘ θ, hφ.comp hθ, ?_⟩
  filter_upwards [hi, hb] with ω hi hb
  obtain ⟨ξ, A, C₁, q, Cm, R₁, C, hξ, hA, hC₁, hq, hCm, hR₁, hC, hi⟩ := hi
  obtain ⟨B, χ, hχ, hχ1, hb⟩ := hb
  refine ⟨ξ, A, C₁, q, Cm, R₁, C, B, χ, hξ, hA, hC₁, hq, hCm, hR₁, hC, hχ, hχ1, ?_⟩
  intro ψ hψ w hw
