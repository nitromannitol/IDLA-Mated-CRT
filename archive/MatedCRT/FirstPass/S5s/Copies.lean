namespace MatedCRT
open Set Metric MeasureTheory Filter Topology
open scoped ENNReal
theorem ball_convergenceNormalizedExitTime_of_prepared_estimates (𝒮 : SpaceFillingSLEModel)
    (hm : MepsScalingInput 𝒮) (h33 : UniformConvergenceGreenKernelStmt 𝒮)
    (h35 : DiscreteDirichletProblemStmt 𝒮) (h217 : BoundedExitTimeRVStmt)
    (h218 : ExitTimeUpperBoundBallStmt 𝒮) (hH : DiscreteHolderContinuityCorrectedStep 𝒮) :
