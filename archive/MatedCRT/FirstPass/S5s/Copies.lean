theorem ball_convergenceNormalizedExitTime_of_prepared (𝒮 : SpaceFillingSLEModel)
    (h33 : UniformConvergenceGreenKernelStmt 𝒮) (h35 : DiscreteDirichletProblemStmt 𝒮)
    (h217 : BoundedExitTimeRVStmt) (h218 : ExitTimeUpperBoundBallStmt 𝒮)
    (h31 : DiscretePotentialTightnessPreparedStmt 𝒮) :
    ConvergenceNormalizedExitTimeStmt 𝒮 :=
  MatedCRT.ball_convergenceNormalizedExitTime_of_prepared_steps 𝒮 h33 h35 h217 h218 h31
    (MatedCRT.ball_normalizedExitInteriorPreparedStep 𝒮)
