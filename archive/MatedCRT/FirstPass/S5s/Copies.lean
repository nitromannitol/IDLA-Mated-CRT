  obtain ⟨φ, hφ, hreg⟩ := MatedCRT.ball_odometer_prepared_pair_modulus_of_polyScales
    𝒮 hm h47 h44 h218 hH h27 hγ hγ2 hρ hρ1 S hS t ht (e ∘ κ) hpoly
