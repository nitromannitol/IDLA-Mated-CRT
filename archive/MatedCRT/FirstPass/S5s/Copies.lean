    (he0 : Tendsto e atTop (𝓝 0)) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ᵐ ω ∂S.P,
      ∃ ξ A C₁ q Cm R₁ C : ℝ,
        0 < ξ ∧ 0 ≤ A ∧ 0 ≤ C₁ ∧ 0 < q ∧ 0 ≤ Cm ∧ 0 < R₁ ∧ 0 ≤ C ∧
