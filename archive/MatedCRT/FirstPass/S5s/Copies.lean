        ∀ ψ : ℕ → ℕ, StrictMono ψ → ∀ w : ℂ → ℝ,
        OdometerLocalLimit S ρ t (e ∘ φ ∘ ψ) ω w →
        (∀ (x y : ℂ) (r0 : ℝ), 0 ≤ r0 → dist x 0 + r0 < ρ → dist y 0 + r0 < ρ →
        ∀ R : ℝ, 0 < R → R < min R₁ (min r0 1) →
        ‖x - y‖ ≤ ((R / 2) * (R / 2)) / 2 →
        |w x - w y| ≤ Cm * (A * C * (R / 2) ^ ξ + 2 * C * C₁ * R ^ q)) ∧
