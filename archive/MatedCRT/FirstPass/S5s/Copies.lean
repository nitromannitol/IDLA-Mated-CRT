  obtain ⟨K, hK, hKscale⟩ := hscale γ hγ hγ2
  have hKpos : 0 < K := by linarith
  refine ⟨α, hα, ?_⟩
  intro ρ hρ hρ1
  obtain ⟨C, hC, h218C⟩ := h218α ρ hρ hρ1
  refine ⟨2 * (C * K) ^ 2, by positivity, ?_⟩
  intro Ω _ S hS
  obtain ⟨ε₀, hε₀, hscaleε⟩ := hKscale Ω S hS
