open Set Metric MeasureTheory Filter Topology _root_.HarmonicBalls
open scoped ENNReal
theorem ball_ae_eventual_exit_size_of_statements
    {𝒮 : SpaceFillingSLEModel} (h218 : ExitTimeUpperBoundBallStmt 𝒮) (h217 : BoundedExitTimeRVStmt)
    {γ ρ : ℝ} (hγ : 0 < γ) (hγ2 : γ < 2) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    {Ω : Type} [MeasurableSpace Ω] (S : MatedCRTEnv Ω) (hS : S.IsValid 𝒮 γ)
    {D : Set ℂ} (x : ℂ) (r : ℝ) (hr : 0 < r) (hDeq : D = ball x r) (hD : D ⊆ ball 0 ρ) (e : ℕ → ℝ) (he : IsPolySummableScales e)
    (E : Ω → ℕ → ℝ) (hErange : ∀ ω n, E ω n ∈ range e)
    (hElim : ∀ ω, Tendsto (E ω) atTop (𝓝 0)) :
    ∀ᵐ ω ∂S.P, ∃ C : ℝ, ∀ᶠ n in atTop,
      ∀ a ∈ cellVertices (E ω n) (S.η ω) D,
        E ω n * |normExitTime (S.mult (E ω n) ω) (interiorCellVertices (E ω n) (S.η ω) D) a| ≤ C := by
  subst hDeq
  obtain ⟨α, hα, h218α⟩ := h218 γ hγ hγ2
  obtain ⟨C₀, hC₀, h218C⟩ := h218α ρ hρ hρ1
  set ρ' : ℝ := (1 + ρ) / 2 with hρ'
  have hρρ' : ρ < ρ' := by rw [hρ']; linarith
  have hρ'1 : ρ' < 1 := by rw [hρ']; linarith
  have hρ'0 : 0 < ρ' := by linarith
  obtain ⟨q, -, h217q⟩ := h217 γ hγ hγ2
  have hfin := (h217q ρ' hρ'0 hρ'1 Ω S.P S.hC S.hcirc S.μ hS.isConeField).1
  have key : ∀ G : ℝ → Set Ω, PolyHighProb S.P G → ∀ᵐ ω ∂S.P, ∀ᶠ n in atTop, ω ∈ G (E ω n) := by
    intro G hG
    filter_upwards [Tightness.ae_eventually_mem_of_polyHighProb hG he] with ω hω
    exact Tightness.eventually_of_range (Q := fun ε => ω ∈ G ε) he.1 (hErange ω) (hElim ω) hω
  have hεα : Tendsto (fun ε : ℝ => ε ^ α) (𝓝 0) (𝓝 0) := by
    have h3 := (Real.continuousAt_rpow_const 0 α (Or.inr hα.le)).tendsto
    rwa [Real.zero_rpow hα.ne'] at h3
  filter_upwards [key _ (h218C Ω S hS), hfin] with ω hω hfinω
  refine ⟨C₀ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal, ?_⟩
  have hsmall : ∀ᶠ n in atTop, E ω n ^ α < ρ' - ρ :=
    (hεα.comp (hElim ω)).eventually (gt_mem_nhds (by linarith))
  have hMle : largestExitTimeRV (S.μ ω) (ball 0 ρ') ≤
      ⨆ (D' : Set ℂ) (_ : D' ⊆ ball 0 ρ'), largestExitTimeRV (S.μ ω) D' :=
    le_iSup₂_of_le (ball 0 ρ') Subset.rfl le_rfl
  have hM : largestExitTimeRV (S.μ ω) (ball 0 ρ') < ⊤ := hMle.trans_lt hfinω
  filter_upwards [hω, hsmall] with n hn hsm
  intro a ha
  obtain ⟨-, hn2⟩ := hn
  obtain ⟨j, hj⟩ := hErange ω n
  have hε : 0 < E ω n := hj ▸ he.1 j
  have hsm' : E ω n ^ α < ρ' - ρ := hsm
  have hqa := hn2 x r hr hD a ha
  have hsub : thickening (E ω n ^ α) (ball x r) ⊆ ball 0 ρ' := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := mem_thickening_iff.1 hx
    have hy' := hD hy
    rw [mem_ball] at hy' ⊢
    linarith [dist_triangle x y 0]
  have hCε : 0 ≤ C₀ * (E ω n)⁻¹ := mul_nonneg hC₀.le (inv_nonneg.2 hε.le)
  have hreal : 0 ≤ C₀ * (E ω n)⁻¹ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal :=
    mul_nonneg hCε ENNReal.toReal_nonneg
  have hq' : ENNReal.ofReal (normExitTime (S.mult (E ω n) ω)
      (interiorCellVertices (E ω n) (S.η ω) (ball x r)) a) ≤
      ENNReal.ofReal (C₀ * (E ω n)⁻¹ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal) := by
    calc
      _ ≤ ENNReal.ofReal (C₀ * (E ω n)⁻¹) *
          largestExitTimeRV (S.μ ω) (thickening (E ω n ^ α) (ball x r)) := hqa.1.trans hqa.2
      _ ≤ ENNReal.ofReal (C₀ * (E ω n)⁻¹) * largestExitTimeRV (S.μ ω) (ball 0 ρ') :=
        mul_le_mul_right (Tightness.largestExitTimeRV_mono hsub) _
      _ = _ := by rw [ENNReal.ofReal_mul hCε, ENNReal.ofReal_toReal hM.ne]
  have hle := (ENNReal.ofReal_le_ofReal_iff hreal).1 hq'
  rw [abs_of_nonneg (normExitTime_nonneg _ _ _)]
  calc E ω n * normExitTime (S.mult (E ω n) ω) (interiorCellVertices (E ω n) (S.η ω) (ball x r)) a ≤
        E ω n * (C₀ * (E ω n)⁻¹ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal) :=
        mul_le_mul_of_nonneg_left hle hε.le
    _ = C₀ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal * (E ω n * (E ω n)⁻¹) := by ring
    _ = C₀ * (largestExitTimeRV (S.μ ω) (ball 0 ρ')).toReal := by
        rw [mul_inv_cancel₀ hε.ne', mul_one]
end MatedCRT

namespace MatedCRT
open Set Metric MeasureTheory Filter Topology
open scoped ENNReal
theorem ball_exit_compactness_dyadic_of_prepared
    (𝒮 : SpaceFillingSLEModel) (h218 : ExitTimeUpperBoundBallStmt 𝒮)
    (h217 : BoundedExitTimeRVStmt) (h31 : DiscretePotentialTightnessPreparedStmt 𝒮)
    {γ ρ : ℝ} (hγ : 0 < γ) (hγ2 : γ < 2) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    {Ω : Type} [MeasurableSpace Ω] (S : MatedCRTEnv Ω) (hS : S.IsValid 𝒮 γ)
    {r r' : ℝ} {z : ℂ} (hr : 0 < r) (hr' : r' < r) (hball : ball z r ⊆ ball 0 ρ)
    (ε : ℕ → ℝ) (hε : ∀ n, 0 < ε n ∧ ε n < (1 / 2) ^ n)
    (ψ : ℕ → ℕ) (hψ : StrictMono ψ) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ᵐ ω ∂S.P,
      ∀ θ : ℕ → ℕ, StrictMono θ → ∃ η : ℕ → ℕ, StrictMono η ∧ ∃ u : ℂ → ℝ,
        ContinuousOn u (closedBall z r') ∧ TendstoUniformlyOn
          (fun k => rescale (S.mε (ε (ψ (φ (θ (η k)))))) (ε (ψ (φ (θ (η k))))) (S.η ω)
            (normExitTime (S.mult (ε (ψ (φ (θ (η k))))) ω)
              (interiorCellVertices (ε (ψ (φ (θ (η k))))) (S.η ω) (ball z r))))
          u atTop (closedBall z r') := by
  let e : ℕ → ℝ := ε ∘ ψ
  have he : IsPolySummableScales ε := isPolySummableScales_of_lt_half_pow hε
  have hepos : ∀ n, 0 < e n := fun n => (hε (ψ n)).1
  have hezero : Tendsto e atTop (𝓝 0) := he.tendsto_zero.comp hψ.tendsto_atTop
  have hsize := MatedCRT.ball_ae_eventual_exit_size_of_statements h218 h217 hγ hγ2 hρ hρ1 S hS z r hr rfl hball ε he
    (fun _ n => e n) (fun _ n => ⟨ψ n, rfl⟩) (fun _ => hezero)
  obtain ⟨C, hCm, hC, hCa⟩ := hS.exists_measurable_exit_time_bound_of_eventual
    e (fun _ n => n) (fun _ => measurable_const) (fun _ n => hepos n)
    (ball z r) (Or.inl isOpen_ball) isBounded_ball hsize
  have hbounds := hS.ae_exit_bounds_of_eventual_size hγ hγ2 (ball z r) isBounded_ball
    (fun _ n => e n) (fun _ n => hepos n) C hC
    (by filter_upwards [hCa] with ω hω; exact Eventually.of_forall (fun n a _ => hω n a))
  obtain ⟨u, hum, hue⟩ := hS.exists_envSigma_measurable_selected_normExitTime e (ball z r)
    (Or.inl isOpen_ball) (fun _ n => n) (fun _ => measurable_const)
  have hbound : ∀ᵐ ω ∂S.P, ∃ C : ℝ, 0 < C ∧ ∀ᶠ n in atTop,
      (∀ a ∈ interiorCellVertices (e n) (S.η ω) (ball z r),
        |matedLaplacian (S.mult (e n) ω) (u ω n) a| ≤ C) ∧
      (∀ a ∈ cellVertices (e n) (S.η ω) (ball z r), |u ω n a| ≤ C / e n) := by
    filter_upwards [hbounds, hue] with ω hb hu
    refine ⟨C ω, zero_lt_one.trans_le (hC ω), ?_⟩
    filter_upwards [hb] with n hn
    have hfun : u ω n = normExitTime (S.mult (e n) ω)
        (interiorCellVertices (e n) (S.η ω) (ball z r)) := funext (hu n)
    rw [hfun]
    exact hn
  obtain ⟨φ, hφ, hcompact⟩ := preparedTightness_pathwise_local 𝒮 h31 hγ hγ2 hρ hρ1
    S hS (ball z r) hball isOpen_ball ((convex_ball z r).isConnected (nonempty_ball.2 hr))
    e hepos hezero u hum hbound
  refine ⟨φ, hφ, ?_⟩
  filter_upwards [hcompact, hue] with ω hω hu θ hθ
  obtain ⟨η, hη, v, hv, hvconv⟩ := hω θ hθ
  have hKD : closure (closedBall z r') ⊆ ball z r := by
    rw [isClosed_closedBall.closure_eq]
    exact closedBall_subset_ball hr'
  refine ⟨η, hη, v, hv.mono (subset_closure.trans hKD), ?_⟩
  have hfun : ∀ n, u ω n = normExitTime (S.mult (e n) ω)
      (interiorCellVertices (e n) (S.η ω) (ball z r)) := fun n => funext (hu n)
  simpa only [hfun, e, Function.comp_apply] using hvconv (closedBall z r') (isCompact_closedBall _ _) hKD
end MatedCRT

namespace MatedCRT
open MeasureTheory Filter Topology Set Metric
open scoped ENNReal
def ball_NormalizedExitInteriorPreparedStep (𝒮 : SpaceFillingSLEModel) : Prop :=
  UniformConvergenceGreenKernelStmt 𝒮 → DiscreteDirichletProblemStmt 𝒮 →
  BoundedExitTimeRVStmt → ExitTimeUpperBoundBallStmt 𝒮 → DiscretePotentialTightnessPreparedStmt 𝒮 →
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ ρ : ℝ, 0 < ρ → ρ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  ∀ (r : ℝ) (z : ℂ), 0 < r → ball z r ⊆ ball 0 ρ →
  ∀ r' : ℝ, r' < r →
    TendstoUniformlyOnInProbability S.P
      (fun ε ω => rescale (S.mε ε) ε (S.η ω)
        (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball z r))))
      (normalizedExitGreenPotential S r z) (closedBall z r')
end MatedCRT

namespace MatedCRT
open MeasureTheory Filter Topology Set Metric
open scoped ENNReal
theorem ball_convergenceNormalizedExitTime_of_prepared_steps (𝒮 : SpaceFillingSLEModel)
    (h33 : UniformConvergenceGreenKernelStmt 𝒮) (h35 : DiscreteDirichletProblemStmt 𝒮)
    (h217 : BoundedExitTimeRVStmt) (h218 : ExitTimeUpperBoundBallStmt 𝒮)
    (h31 : DiscretePotentialTightnessPreparedStmt 𝒮)
    (hinterior : MatedCRT.ball_NormalizedExitInteriorPreparedStep 𝒮) :
    ConvergenceNormalizedExitTimeStmt 𝒮 := by
  intro γ hγ hγ2 ρ hρ hρ1 Ω _ S hS r z hr hball
  refine ⟨normalizedExitGreenPotential S r z,
    normalizedExitPotentialStep_of_boundedExitTime 𝒮 h217 γ hγ hγ2 ρ hρ hρ1 Ω S hS r z hr hball, ?_⟩
  apply uniformOn_closedBall_of_interior_boundary
  · intro r' _ hr'
    exact hinterior h33 h35 h217 h218 h31 γ hγ hγ2 ρ hρ hρ1 Ω S hS r z hr hball r' hr'
  · intro δ hδ e he
    have he2 : 0 < e / 2 := ENNReal.half_pos he.ne'
    obtain ⟨r₁, hr₁0, hr₁r, h₁⟩ := discreteExitBoundary_of_statements 𝒮 h33 h35 h217
      hγ hγ2 hρ hρ1 S hS hr hball hδ he2
    obtain ⟨r₂, hr₂0, hr₂r, h₂⟩ := normalizedExitGreenPotential_boundary_small_of_statements
      𝒮 h33 h217 hγ hγ2 hρ hρ1 S hS hr hball hδ he2
    refine ⟨max r₁ r₂, lt_of_lt_of_le hr₁0 (le_max_left _ _), max_lt hr₁r hr₂r, ?_⟩
    filter_upwards [h₁] with ε hε
    calc
      S.P {ω | ∃ x ∈ closedBall z r \ closedBall z (max r₁ r₂),
          δ < |rescale (S.mε ε) ε (S.η ω)
            (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball z r))) x| ∨
          δ < |normalizedExitGreenPotential S r z ω x|} ≤
        S.P ({ω | ∃ x ∈ closedBall z r \ closedBall z r₁,
          δ < |rescale (S.mε ε) ε (S.η ω)
            (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball z r))) x|} ∪
        {ω | ∃ x ∈ closedBall z r \ closedBall z r₂,
          δ < |normalizedExitGreenPotential S r z ω x|}) := by
            apply measure_mono
            rintro ω ⟨x, ⟨hx, hxout⟩, h⟩
            have hx₁ : x ∉ closedBall z r₁ := fun hx' =>
              hxout (closedBall_subset_closedBall (le_max_left _ _) hx')
            have hx₂ : x ∉ closedBall z r₂ := fun hx' =>
              hxout (closedBall_subset_closedBall (le_max_right _ _) hx')
            rcases h with h | h
            · exact Or.inl ⟨x, ⟨hx, hx₁⟩, h⟩
            · exact Or.inr ⟨x, ⟨hx, hx₂⟩, h⟩
      _ ≤ _ := measure_union_le _ _
      _ ≤ e / 2 + e / 2 := add_le_add hε h₂
      _ = e := ENNReal.add_halves e
end MatedCRT

