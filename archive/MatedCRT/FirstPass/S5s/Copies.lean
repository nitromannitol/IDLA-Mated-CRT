theorem ball_discretePotentialTightnessPrepared_of_inputs {𝒮 : SpaceFillingSLEModel}
    (hm : MepsScalingInput 𝒮) (h217 : BoundedExitTimeRVStmt)
    (h218 : ExitTimeUpperBoundBallStmt 𝒮) (hH : DiscreteHolderContinuityCorrectedStep 𝒮) :
    DiscretePotentialTightnessPreparedStmt 𝒮 :=
  discretePotentialTightnessPrepared_of_vertexModuli hm
    (MatedCRT.ball_preparedTightnessVertexModuliStep_of_boundary h217 h218 hH
      (preparedBoundaryVertexModuliStep_of_holder hH))
