import Mathlib

/-!
# FIRST PASS: measurability of the quenched exit probability by cylinders (LEMMA68 B1) (task fp-S6e-lemma68-C17, z9)

Source: `notes/fp-gaps/CHATGPT-z9-lemma68-B1B2.md` §3 (B1.1-B1.6), the cylinder argument for the hypothesis `hΦ`
of `S6e/Universal.lean`. Paths are `ℕ → ℤ`; `p ω u v : ℝ≥0∞` are the transition weights of the quenched walk
(measurable in `ω` by `Lemma68MeasurableInputs.transition_measurable`, a named hypothesis); `U ω, A ω ⊆ ℤ` are the
admissible and target vertex sets, with measurable memberships `{ω | v ∈ U ω}`. Nothing is assumed about the
finiteness of `U ω` or about almost-sure finiteness of the exit time.
`IsQuenchedWalk p a P` is the walk interface: `P` is a probability on paths whose cylinder probabilities are the
products of `p` from `a` (the identification of the quenched law with the law generated by `p`, §1.2).
-/

open MeasureTheory Filter Topology Set
open scoped ENNReal Classical

namespace MatedCRT

namespace Lemma68Walk

/-- The cylinder of the first `N + 1` coordinates equal to the word `w`. -/
def cyl (N : ℕ) (w : Fin (N + 1) → ℤ) : Set (ℕ → ℤ) := {x | ∀ k : Fin (N + 1), x k = w k}

/-- The exit event of B1: `x_n ∈ A` for every `n < τ_U(x)`, where `τ_U(x) = inf {n : x_n ∉ U}`; equivalently
`n < τ_U(x)` iff `x_k ∈ U` for all `k ≤ n`. -/
def exitEvent (U A : Set ℤ) : Set (ℕ → ℤ) := {x | ∀ n : ℕ, (∀ k ≤ n, x k ∈ U) → x n ∈ A}

/-- The word `w` of length `N + 1` satisfies the exit condition up to time `N` (B1.3). -/
def goodWord (U A : Set ℤ) (N : ℕ) (w : Fin (N + 1) → ℤ) : Prop :=
  ∀ n : Fin (N + 1), (∀ k : Fin (N + 1), k ≤ n → w k ∈ U) → w n ∈ A

/-- The finite-horizon event `E_N` of B1.2, as a condition on the first `N + 1` coordinates. -/
def finiteEvent (U A : Set ℤ) (N : ℕ) : Set (ℕ → ℤ) := {x | goodWord U A N (fun k : Fin (N + 1) => x k)}

/-- The cylinder probability `W_{N,w}` of B1.4: `1[w_0 = a] ∏_{k<N} p(w_k, w_{k+1})`. -/
noncomputable def cylWeight (p : ℤ → ℤ → ℝ≥0∞) (a : ℤ) (N : ℕ) (w : Fin (N + 1) → ℤ) : ℝ≥0∞ :=
  if w 0 = a then ∏ k : Fin N, p (w k.castSucc) (w k.succ) else 0

/-- The sum `q_N` of B1.5: `∑_w I_{N,w} W_{N,w}`. -/
noncomputable def exitWeight (p : ℤ → ℤ → ℝ≥0∞) (a : ℤ) (U A : Set ℤ) (N : ℕ) : ℝ≥0∞ :=
  ∑' w : Fin (N + 1) → ℤ, if goodWord U A N w then cylWeight p a N w else 0

/-- The walk interface: `P` is a probability on paths `ℕ → ℤ` whose cylinder probabilities are the products of the
transition weights `p` started at `a`. -/
def IsQuenchedWalk (p : ℤ → ℤ → ℝ≥0∞) (a : ℤ) (P : Measure (ℕ → ℤ)) : Prop :=
  IsProbabilityMeasure P ∧ ∀ (N : ℕ) (w : Fin (N + 1) → ℤ), P (cyl N w) = cylWeight p a N w

lemma measurableSet_cyl (N : ℕ) (w : Fin (N + 1) → ℤ) : MeasurableSet (cyl N w) := by
  have h : cyl N w = ⋂ k : Fin (N + 1), (fun x : ℕ → ℤ => x k) ⁻¹' {w k} := by
    ext x
    simp [cyl]
  rw [h]
  exact MeasurableSet.iInter fun k => measurable_pi_apply (k : ℕ) (measurableSet_singleton _)

lemma mem_finiteEvent_iff (U A : Set ℤ) (N : ℕ) (x : ℕ → ℤ) :
    x ∈ finiteEvent U A N ↔ ∀ n ≤ N, (∀ k ≤ n, x k ∈ U) → x n ∈ A := by
  constructor
  · intro h n hn hk
    exact h ⟨n, Nat.lt_succ_of_le hn⟩ fun k hkn => hk k (Fin.le_def.1 hkn)
  · intro h n hk
    have hn : (n : ℕ) ≤ N := Nat.lt_succ_iff.1 n.isLt
    exact h n hn fun k hkn => hk ⟨k, by omega⟩ (Fin.le_def.2 hkn)

lemma measurableSet_finiteEvent (U A : Set ℤ) (N : ℕ) : MeasurableSet (finiteEvent U A N) := by
  have hf : Measurable (fun x : ℕ → ℤ => fun k : Fin (N + 1) => x k) :=
    Measurable.of_eval fun k => measurable_pi_apply (k : ℕ)
  have hw : MeasurableSet {w : Fin (N + 1) → ℤ | goodWord U A N w} := (Set.to_countable _).measurableSet
  exact hf hw

lemma finiteEvent_anti (U A : Set ℤ) : Antitone (finiteEvent U A) := by
  intro M N hMN x hx
  rw [mem_finiteEvent_iff] at hx ⊢
  exact fun n hn => hx n (hn.trans hMN)

lemma exitEvent_eq_iInter (U A : Set ℤ) : exitEvent U A = ⋂ N : ℕ, finiteEvent U A N := by
  ext x
  simp only [exitEvent, mem_ofPred_eq, mem_iInter, mem_finiteEvent_iff]
  constructor
  · intro h N n _ hk
    exact h n hk
  · intro h n hk
    exact h n n le_rfl hk

lemma measure_finiteEvent {p : ℤ → ℤ → ℝ≥0∞} {a : ℤ} {P : Measure (ℕ → ℤ)} (hP : IsQuenchedWalk p a P)
    (U A : Set ℤ) (N : ℕ) : P (finiteEvent U A N) = exitWeight p a U A N := by
  have hcover : finiteEvent U A N = ⋃ w : Fin (N + 1) → ℤ, finiteEvent U A N ∩ cyl N w := by
    ext x
    simp only [mem_iUnion, mem_inter_iff]
    exact ⟨fun h => ⟨fun k => x k, h, fun k => rfl⟩, fun ⟨_, h, _⟩ => h⟩
  have hdisj : Pairwise fun w w' : Fin (N + 1) → ℤ => Disjoint (finiteEvent U A N ∩ cyl N w) (finiteEvent U A N ∩ cyl N w') := by
    intro w w' hne
    refine Set.disjoint_left.2 fun x hx hx' => hne ?_
    funext k
    exact (hx.2 k).symm.trans (hx'.2 k)
  rw [hcover, measure_iUnion hdisj fun w => (measurableSet_finiteEvent U A N).inter (measurableSet_cyl N w)]
  unfold exitWeight
  congr 1
  funext w
  by_cases hg : goodWord U A N w
  · have hset : finiteEvent U A N ∩ cyl N w = cyl N w := by
      ext x
      refine ⟨fun h => h.2, fun hx => ⟨?_, hx⟩⟩
      have hxw : (fun k : Fin (N + 1) => x k) = w := funext fun k => hx k
      show goodWord U A N (fun k : Fin (N + 1) => x k)
      rw [hxw]
      exact hg
    rw [hset, hP.2 N w]
    simp [hg]
  · have hset : finiteEvent U A N ∩ cyl N w = ∅ := by
      ext x
      refine ⟨fun h => ?_, fun h => h.elim⟩
      have hxw : (fun k : Fin (N + 1) => x k) = w := funext fun k => h.2 k
      apply hg
      have hx : goodWord U A N (fun k : Fin (N + 1) => x k) := h.1
      rw [hxw] at hx
      exact hx
    rw [hset, measure_empty]
    simp [hg]

/-- (B1, deterministic core) For a quenched walk with transition weights `p` from `a`, the exit probability
`P(τ_U-exit event)` is the infimum over `N` of the cylinder sums `q_N` (continuity from above of `P`). -/
theorem quenched_exit_eq_iInf {p : ℤ → ℤ → ℝ≥0∞} {a : ℤ} {P : Measure (ℕ → ℤ)} (hP : IsQuenchedWalk p a P)
    (U A : Set ℤ) : P (exitEvent U A) = ⨅ N : ℕ, exitWeight p a U A N := by
  have := hP.1
  have hlim := tendsto_measure_iInter_atTop (μ := P) (fun N => (measurableSet_finiteEvent U A N).nullMeasurableSet)
    (finiteEvent_anti U A) ⟨0, measure_ne_top P _⟩
  have hlim' : Tendsto (fun N => P (finiteEvent U A N)) atTop (𝓝 (⨅ N, P (finiteEvent U A N))) :=
    tendsto_atTop_iInf fun M N hMN => measure_mono (finiteEvent_anti U A hMN)
  have heq := tendsto_nhds_unique hlim hlim'
  rw [exitEvent_eq_iInter, heq]
  congr 1
  funext N
  exact measure_finiteEvent hP U A N

lemma measurableSet_goodWord {Ω : Type*} [MeasurableSpace Ω] {U A : Ω → Set ℤ}
    (hU : ∀ v : ℤ, MeasurableSet {ω | v ∈ U ω}) (hA : ∀ v : ℤ, MeasurableSet {ω | v ∈ A ω})
    (N : ℕ) (w : Fin (N + 1) → ℤ) : MeasurableSet {ω | goodWord (U ω) (A ω) N w} := by
  unfold goodWord
  simp only [Set.ofPred_forall]
  refine MeasurableSet.iInter fun n => ?_
  refine MeasurableSet.imp ?_ (hA (w n))
  simp only [Set.ofPred_forall]
  exact MeasurableSet.iInter fun k => MeasurableSet.iInter fun _ => hU (w k)

lemma measurable_cylWeight {Ω : Type*} [MeasurableSpace Ω] {p : Ω → ℤ → ℤ → ℝ≥0∞}
    (hp : ∀ u v : ℤ, Measurable fun ω => p ω u v) (a : ℤ) (N : ℕ) (w : Fin (N + 1) → ℤ) :
    Measurable fun ω => cylWeight (p ω) a N w := by
  by_cases h : w 0 = a
  · simp only [cylWeight, h, ↓reduceIte]
    exact Finset.measurable_prod _ fun k _ => hp _ _
  · simp only [cylWeight, h, ↓reduceIte]
    exact measurable_const

lemma measurable_exitWeight {Ω : Type*} [MeasurableSpace Ω] {p : Ω → ℤ → ℤ → ℝ≥0∞}
    (hp : ∀ u v : ℤ, Measurable fun ω => p ω u v) (a : ℤ) {U A : Ω → Set ℤ}
    (hU : ∀ v : ℤ, MeasurableSet {ω | v ∈ U ω}) (hA : ∀ v : ℤ, MeasurableSet {ω | v ∈ A ω}) (N : ℕ) :
    Measurable fun ω => exitWeight (p ω) a (U ω) (A ω) N := by
  unfold exitWeight
  exact Measurable.tsum fun w =>
    Measurable.ite (measurableSet_goodWord hU hA N w) (measurable_cylWeight hp a N w) measurable_const

/-- (B1, measurable core, cylinder argument) If the transition weights are measurable in `ω`, the admissible and
target memberships are measurable, and `P ω` is the quenched walk of `p ω` from `a`, then `ω ↦ P ω (exit event)` is
measurable. No finiteness of `U ω` and no almost-sure finiteness of the exit time is used. -/
theorem measurable_quenchedExit {Ω : Type*} [MeasurableSpace Ω] {p : Ω → ℤ → ℤ → ℝ≥0∞}
    (hp : ∀ u v : ℤ, Measurable fun ω => p ω u v) {a : ℤ} {U A : Ω → Set ℤ}
    (hU : ∀ v : ℤ, MeasurableSet {ω | v ∈ U ω}) (hA : ∀ v : ℤ, MeasurableSet {ω | v ∈ A ω})
    {P : Ω → Measure (ℕ → ℤ)} (hP : ∀ ω, IsQuenchedWalk (p ω) a (P ω)) :
    Measurable fun ω => P ω (exitEvent (U ω) (A ω)) := by
  have h : (fun ω => P ω (exitEvent (U ω) (A ω))) = fun ω => ⨅ N : ℕ, exitWeight (p ω) a (U ω) (A ω) N :=
    funext fun ω => quenched_exit_eq_iInf (hP ω) (U ω) (A ω)
  rw [h]
  exact Measurable.iInf fun N => measurable_exitWeight hp a hU hA N

/-- (B1, the event `hΦ` at a fixed radius) The event `{ω | P ω (exit event) ≤ c}` is measurable. -/
theorem measurableSet_quenchedExit_le {Ω : Type*} [MeasurableSpace Ω] {p : Ω → ℤ → ℤ → ℝ≥0∞}
    (hp : ∀ u v : ℤ, Measurable fun ω => p ω u v) {a : ℤ} {U A : Ω → Set ℤ}
    (hU : ∀ v : ℤ, MeasurableSet {ω | v ∈ U ω}) (hA : ∀ v : ℤ, MeasurableSet {ω | v ∈ A ω})
    {P : Ω → Measure (ℕ → ℤ)} (hP : ∀ ω, IsQuenchedWalk (p ω) a (P ω)) (c : ℝ≥0∞) :
    MeasurableSet {ω | P ω (exitEvent (U ω) (A ω)) ≤ c} :=
  measurableSet_le (measurable_quenchedExit hp hU hA hP) measurable_const

