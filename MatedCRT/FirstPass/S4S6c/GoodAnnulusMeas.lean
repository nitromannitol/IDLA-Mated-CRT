import MatedCRT.FirstPass.S4S6c.GoodRadiusCover
import MatedCRT.Proofs.Measurability.GoodScale

/-!
# Field measurability of the good-annulus cover events: `hmeas` of eq (9) discharged

`GoodRadiusCover.goodAnnulusCover_dyadic` takes the field measurability of the cover events as a hypothesis `hmeas`
. This file removes it for a measure-valued `μ'` that is measurable for the
field σ-algebra `m'` and almost surely equal to `μ`. For the LQG measure such a `μ'` exists by
`MatedCRT.lqgMeasureFieldMeasurableStep` (Proofs/Measurability/LQGMeasureField.lean).

* `measurableSet_goodAnnulusCover` (Proofs/Measurability/GoodScale.lean:258, proved): the set of measures
  `{m | GoodAnnulusCover m ρ c₀ C δ}` is Borel for the σ-algebra of `Measure ℂ` generated by `m ↦ m B`.
* `goodAnnulusCover_dyadic_ae`: the conclusion of `goodAnnulusCover_dyadic` for `μ`, with the field-measurable
  version `μ'` in its proof. The cover events of `μ'` and `μ` differ only on the null set `{μ' ≠ μ}`, so the
  polynomial bound transfers (`compl_coverEvent_le`, `polyHighProb_of_compl_le`).

Terminology: LQG measure (Duplantier-Sheffield), good annuli (Berestycki-Powell, Armstrong-Kuusi-Mourrat).
-/

open MeasureTheory Set Metric Filter
open scoped ENNReal

namespace MatedCRT

namespace GoodAnnulusMeas

open GoodRadiusCover

/-- The cover event of a field-measurable measure-valued map is field measurable. -/
theorem measurableSet_coverEvent_of_measurable {Ω : Type*} {m' : MeasurableSpace Ω} {μ' : Ω → Measure ℂ}
    (hμ' : Measurable[m'] μ') (ρ c₀ C δ : ℝ) :
    MeasurableSet[m'] (GoodAnnulusCoverEvent μ' ρ c₀ C δ) :=
  hμ' (measurableSet_goodAnnulusCover ρ c₀ C δ)

/-- The cover events of two measure-valued maps agreeing almost surely have complements of the same probability
(up to the null set where they differ). -/
theorem compl_coverEvent_le {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {μ' μ : Ω → Measure ℂ}
    (hae : ∀ᵐ ω ∂P, μ' ω = μ ω) (ρ c₀ C δ : ℝ) :
    P (GoodAnnulusCoverEvent μ' ρ c₀ C δ)ᶜ ≤ P (GoodAnnulusCoverEvent μ ρ c₀ C δ)ᶜ := by
  have hN : P {ω | ¬ μ' ω = μ ω} = 0 := ae_iff.1 hae
  have key : ∀ ω, μ' ω = μ ω →
      (ω ∈ GoodAnnulusCoverEvent μ' ρ c₀ C δ ↔ ω ∈ GoodAnnulusCoverEvent μ ρ c₀ C δ) := by
    intro ω h
    simp only [GoodAnnulusCoverEvent, Set.mem_ofPred_eq, h]
  have hsub : (GoodAnnulusCoverEvent μ' ρ c₀ C δ)ᶜ ⊆
      (GoodAnnulusCoverEvent μ ρ c₀ C δ)ᶜ ∪ {ω | ¬ μ' ω = μ ω} := by
    intro ω hω
    by_cases h : μ' ω = μ ω
    · exact Or.inl fun hE => hω ((key ω h).2 hE)
    · exact Or.inr h
  calc P (GoodAnnulusCoverEvent μ' ρ c₀ C δ)ᶜ
      ≤ P ((GoodAnnulusCoverEvent μ ρ c₀ C δ)ᶜ ∪ {ω | ¬ μ' ω = μ ω}) := measure_mono hsub
    _ ≤ P (GoodAnnulusCoverEvent μ ρ c₀ C δ)ᶜ + P {ω | ¬ μ' ω = μ ω} := measure_union_le _ _
    _ = P (GoodAnnulusCoverEvent μ ρ c₀ C δ)ᶜ := by rw [hN, add_zero]

/-- A polynomial bound transfers to any family whose complements have smaller probability. -/
theorem polyHighProb_of_compl_le {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {E E' : ℝ → Set Ω}
    (hE : HarmonicBalls.PolyHighProb P E) (hle : ∀ δ, P (E' δ)ᶜ ≤ P (E δ)ᶜ) :
    HarmonicBalls.PolyHighProb P E' := by
  obtain ⟨p, hp, C, r₀, hr₀, h⟩ := hE
  exact ⟨p, hp, C, r₀, hr₀, fun r hr hr₀' => (hle r).trans (h r hr hr₀')⟩

/-- **Lemma 2, eq (9)** with the measurability of the cover events discharged (`hmeas` of
`goodAnnulusCover_dyadic`): for a field-measurable version `μ'` of the measure `μ` (`μ' = μ` almost surely), the
good-annulus radii of eq (9) exist for every grid centre at every dyadic scale below a field-measurable cutoff,
almost surely. -/
theorem goodAnnulusCover_dyadic_ae {Ω : Type*} {m' : MeasurableSpace Ω} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {μ' μ : Ω → Measure ℂ} {ρ c₀ C : ℝ}
    (hμ' : Measurable[m'] μ') (hae : ∀ᵐ ω ∂P, μ' ω = μ ω)
    (hpoly : HarmonicBalls.PolyHighProb P (fun δ => GoodAnnulusCoverEvent μ ρ c₀ C δ)) :
    ∃ tStar : Ω → ℝ, Measurable[m'] tStar ∧ ∀ᵐ ω ∂P, 0 < tStar ω ∧
      ∀ n : ℕ, (1 / 2 : ℝ) ^ n < tStar ω → ∀ z : ℂ,
        z ∈ Metric.ball (0 : ℂ) (ρ - 3 * Real.sqrt ((1 / 2 : ℝ) ^ n)) \
          Metric.ball (0 : ℂ) (10 * Real.sqrt ((1 / 2 : ℝ) ^ n)) →
        (∃ m k : ℤ, z = ((((1 / 2 : ℝ) ^ n) / 100 : ℝ) : ℂ) * (m + k * Complex.I)) →
        ∃ r : ℝ, (1 / 2 : ℝ) ^ n ≤ r ∧ r ≤ Real.sqrt ((1 / 2 : ℝ) ^ n) ∧ (∃ k : ℕ, r = (7 : ℝ)⁻¹ ^ k) ∧
          IsGoodAnnulusEvent (μ ω) c₀ C r z := by
  have hpoly' : HarmonicBalls.PolyHighProb P (fun δ => GoodAnnulusCoverEvent μ' ρ c₀ C δ) :=
    polyHighProb_of_compl_le hpoly (fun δ => compl_coverEvent_le hae ρ c₀ C δ)
  obtain ⟨tStar, htm, htS⟩ := goodAnnulusCover_dyadic μ' hpoly'
    (fun n => measurableSet_coverEvent_of_measurable hμ' ρ c₀ C _)
  refine ⟨tStar, htm, ?_⟩
  filter_upwards [htS, hae] with ω hω hωe
  refine ⟨hω.1, fun n hn z hz hzl => ?_⟩
  obtain ⟨r, h1, h2, h3, h4⟩ := hω.2 n hn z hz hzl
  exact ⟨r, h1, h2, h3, by rw [hωe] at h4; exact h4⟩

end GoodAnnulusMeas

end MatedCRT
