/-!
# Strong Markov property at a stopping time for the simple random walk (task fp-S6r-S5-one-test, blocker (c))

Let `P^a = srwLaw m a` be the law of the simple random walk on path space `ℕ → ℤ` (`x 0 = a`), `coordFiltration`
its coordinate filtration, and `T` a stopping time of `coordFiltration` with values in `ℕ∞`. For a nonnegative
measurable path functional `G` whose composition with the shift at `T` is integrable on `{T < ∞}`, the functional
`StrongMarkovAt` (PRO step 14) holds: `E[G ∘ θ_T | 𝓕_T] = E_{X_T}[G]` on `{T < ∞}`.

Route:
1. the set form of the fixed-time Markov property, `srwLaw_markov_state`, is lifted to the functional form by
   identifying two measures on path space: `Measure.map` of the shift and `Measure.bind` of the walk kernel;
2. the decomposition over the values `{T = k}` transports it to `𝓕_T`-measurable sets (`lintegral_postTime`);
3. the conditional expectation is identified by `ae_eq_condExp_of_forall_setIntegral_eq`.

Named hypotheses: integrability of `G ∘ θ_T` on `{T < ∞}` (`hint`), measurability of the test time for the occupation
count (`hσ`). Terminology: strong Markov property at a stopping time (Duplantier-Sheffield; Berestycki-Powell).
-/

open MeasureTheory Set Filter Function
open scoped ENNReal

namespace MatedCRT
namespace Lemma68Window

open Lemma68WalkBridge

/-- `{T < ∞}` is the increasing union of the sets `{T ≤ k}`, `k ∈ ℕ`. -/
theorem setOf_lt_top_eq_iUnion (T : (ℕ → ℤ) → ℕ∞) :
    {w | T w < ⊤} = ⋃ k : ℕ, {w | T w ≤ (k : ℕ∞)} := by
  ext w
  simp only [mem_ofPred_eq, mem_iUnion]
  constructor
  · intro h
    obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.1 h.ne
    exact ⟨k, hk.symm.le⟩
  · rintro ⟨k, hk⟩
    exact lt_of_le_of_lt hk (ENat.natCast_lt_top k)

/-- The coordinate filtration at time `k` lies in the σ-algebra generated by the history `(x₀, …, x_k)`. -/
theorem coordFiltration_le_comap_pathHist (k : ℕ) :
    coordFiltration k ≤ MeasurableSpace.comap (MatedCRT.pathHist k) MeasurableSpace.pi := by
  show (⨆ j, ⨆ (_ : j ≤ k), MeasurableSpace.comap (fun x : ℕ → ℤ => x j) inferInstance) ≤ _
  refine iSup_le fun j => iSup_le fun hj => ?_
  have hjk : j < k + 1 := Nat.lt_succ_of_le hj
  have hph : Measurable[MeasurableSpace.comap (MatedCRT.pathHist k) MeasurableSpace.pi]
      (MatedCRT.pathHist k) := fun s hs => MeasurableSpace.measurableSet_comap.2 ⟨s, hs, rfl⟩
  have hcoord : Measurable[MeasurableSpace.comap (MatedCRT.pathHist k) MeasurableSpace.pi]
      (fun x : ℕ → ℤ => x j) :=
    (measurable_pi_apply (⟨j, hjk⟩ : Fin (k + 1))).comp hph
  exact measurable_iff_comap_le.1 hcoord

/-- A set in `coordFiltration k` is the preimage of a measurable set of histories `(x₀, …, x_k)`. -/
theorem exists_preimage_pathHist {k : ℕ} {S : Set (ℕ → ℤ)} (hS : MeasurableSet[coordFiltration k] S) :
    ∃ F : Set (Fin (k + 1) → ℤ), MeasurableSet F ∧ MatedCRT.pathHist k ⁻¹' F = S :=
  MeasurableSpace.measurableSet_comap.1 (coordFiltration_le_comap_pathHist k S hS)

/-- **Fixed-time Markov property, functional form.** For a `𝓕_k`-measurable `S` and a measurable nonnegative
`H` on paths, `E[H(θ_k) ; S] = E[ E_{X_k}[H] ; S]`. The measures `P^a|_S ∘ θ_k⁻¹` and `(P^a|_S).bind (x ↦ P^{x_k})`
agree on measurable sets by the set form `srwLaw_markov_state`. -/
theorem lintegral_shift_fixed (m : ℤ → ℤ → ℕ) (a : ℤ) {k : ℕ} {S : Set (ℕ → ℤ)}
    (hS : MeasurableSet[coordFiltration k] S) {H : (ℕ → ℤ) → ℝ≥0∞} (hH : Measurable H) :
    ∫⁻ w in S, H (WalkPotential.pathShift k w) ∂srwLaw m a
      = ∫⁻ w in S, (∫⁻ x, H x ∂srwLaw m (w k)) ∂srwLaw m a := by
  obtain ⟨F, hF, rfl⟩ := exists_preimage_pathHist hS
  have hθ : Measurable (WalkPotential.pathShift k) := MatedCRT.walk_measurable_pathShift k
  have hker : Measurable (fun w : ℕ → ℤ => srwLaw m (w k)) := by
    refine Measure.measurable_of_measurable_coe _ fun C _ => ?_
    exact (Measurable.of_discrete (f := fun b : ℤ => srwLaw m b C)).comp (measurable_pi_apply k)
  have hmap : ((srwLaw m a).restrict (MatedCRT.pathHist k ⁻¹' F)).map (WalkPotential.pathShift k)
      = Measure.bind ((srwLaw m a).restrict (MatedCRT.pathHist k ⁻¹' F))
          (fun w => srwLaw m (w k)) := by
    refine Measure.ext fun C hC => ?_
    rw [Measure.map_apply hθ hC, Measure.bind_apply hC hker.aemeasurable,
      Measure.restrict_apply (hθ hC)]
    have hM := srwLaw_markov_state m a k (fun _ => C) (fun _ => hC) hF
    rw [Set.inter_comm]
    exact hM
  calc ∫⁻ w in MatedCRT.pathHist k ⁻¹' F, H (WalkPotential.pathShift k w) ∂srwLaw m a
      = ∫⁻ w, H w ∂(((srwLaw m a).restrict (MatedCRT.pathHist k ⁻¹' F)).map
          (WalkPotential.pathShift k)) := (lintegral_map hH hθ).symm
    _ = ∫⁻ w, H w ∂(Measure.bind ((srwLaw m a).restrict (MatedCRT.pathHist k ⁻¹' F))
          (fun w => srwLaw m (w k))) := by rw [hmap]
    _ = ∫⁻ w, (∫⁻ x, H x ∂srwLaw m (w k)) ∂((srwLaw m a).restrict (MatedCRT.pathHist k ⁻¹' F)) :=
          Measure.lintegral_bind hker.aemeasurable hH.aemeasurable

/-- **Decomposition over the value of `T`.** For `B ∈ 𝓕_T` and a measurable nonnegative `H`, the lower integral of
`H(θ_T)` on `B ∩ {T < ∞}` equals the lower integral of `E_{X_T}[H]` on the same set. -/
theorem lintegral_postTime (m : ℤ → ℤ → ℕ) (a : ℤ) {T : (ℕ → ℤ) → ℕ∞}
    (hT : IsStoppingTime coordFiltration T) {H : (ℕ → ℤ) → ℝ≥0∞} (hH : Measurable H)
    {B : Set (ℕ → ℤ)} (hB : MeasurableSet[hT.measurableSpace] B) :
    ∫⁻ w in B, {w | T w < ⊤}.indicator (fun w => H (postTimePath (fun n w => w n) T w)) w ∂srwLaw m a
      = ∫⁻ w in B, {w | T w < ⊤}.indicator
          (fun w => ∫⁻ x, H x ∂srwLaw m (w (T w).toNat)) w ∂srwLaw m a := by
  have hBlt : MeasurableSet {w | T w < ⊤} := by
    rw [setOf_lt_top_eq_iUnion T]
    exact MeasurableSet.iUnion fun k => coordFiltration.le k _ (hT.measurableSet_le k)
  have hBk : ∀ k : ℕ, MeasurableSet[coordFiltration k] (B ∩ {w | T w = (k : ℕ∞)}) := by
    intro k
    have h1 : MeasurableSet[coordFiltration k] (B ∩ {w | T w ≤ (k : ℕ∞)}) := hB.2 k
    have h2 : MeasurableSet[coordFiltration k] {w | T w = (k : ℕ∞)} :=
      hT.measurableSet_eq_of_countable k
    have heq : B ∩ {w | T w = (k : ℕ∞)} = (B ∩ {w | T w ≤ (k : ℕ∞)}) ∩ {w | T w = (k : ℕ∞)} := by
      ext w
      simp only [mem_inter_iff, mem_ofPred_eq]
      constructor
      · rintro ⟨hw, he⟩
        exact ⟨⟨hw, he.le⟩, he⟩
      · rintro ⟨⟨hw, _⟩, he⟩
        exact ⟨hw, he⟩
    rw [heq]
    exact h1.inter h2
  have hBk_m : ∀ k : ℕ, MeasurableSet (B ∩ {w | T w = (k : ℕ∞)}) :=
    fun k => coordFiltration.le k _ (hBk k)
  have hsplit : ∀ g : (ℕ → ℤ) → ℝ≥0∞, ∫⁻ w in B, {w | T w < ⊤}.indicator g w ∂srwLaw m a
      = ∑' k : ℕ, ∫⁻ w in B ∩ {w | T w = (k : ℕ∞)}, g w ∂srwLaw m a := by
    intro g
    have hset : {w | T w < ⊤} ∩ B = ⋃ k : ℕ, B ∩ {w | T w = (k : ℕ∞)} := by
      ext w
      simp only [mem_inter_iff, mem_ofPred_eq, mem_iUnion]
      constructor
      · rintro ⟨hlt, hw⟩
        obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.1 hlt.ne
        exact ⟨k, hw, hk.symm⟩
      · rintro ⟨k, hw, hk⟩
        exact ⟨by rw [hk]; exact ENat.natCast_lt_top k, hw⟩
    have hdisj : Pairwise (Disjoint on fun k : ℕ => B ∩ {w | T w = (k : ℕ∞)}) := by
      intro k k' hkk'
      refine Set.disjoint_left.2 fun w hw hw' => hkk' ?_
      have h1 : T w = (k : ℕ∞) := hw.2
      have h2 : T w = (k' : ℕ∞) := hw'.2
      exact_mod_cast h1.symm.trans h2
    rw [lintegral_indicator hBlt, Measure.restrict_restrict hBlt, hset,
      lintegral_iUnion hBk_m hdisj]
  rw [hsplit, hsplit]
  refine tsum_congr fun k => ?_
  have hk : ∀ w, T w = (k : ℕ∞) → (T w).toNat = k := fun w h => by rw [h]; simp
  have hpost : ∀ w, T w = (k : ℕ∞) →
      postTimePath (fun n w => w n) T w = WalkPotential.pathShift k w := fun w h => by
    funext n
    simp only [postTimePath, WalkPotential.pathShift, hk w h]
  calc ∫⁻ w in B ∩ {w | T w = (k : ℕ∞)}, H (postTimePath (fun n w => w n) T w) ∂srwLaw m a
      = ∫⁻ w in B ∩ {w | T w = (k : ℕ∞)}, H (WalkPotential.pathShift k w) ∂srwLaw m a :=
        setLIntegral_congr_fun (hBk_m k) fun w hw => by rw [hpost w hw.2]
    _ = ∫⁻ w in B ∩ {w | T w = (k : ℕ∞)}, (∫⁻ x, H x ∂srwLaw m (w k)) ∂srwLaw m a :=
        lintegral_shift_fixed m a (hBk k) hH
    _ = ∫⁻ w in B ∩ {w | T w = (k : ℕ∞)}, ∫⁻ x, H x ∂srwLaw m (w (T w).toNat) ∂srwLaw m a :=
        setLIntegral_congr_fun (hBk_m k) fun w hw => by rw [hk w hw.2]

/-- The candidate `w ↦ 1_{T<∞} g(X_T)` is `𝓕_T`-measurable (`X_T` is the stopped value of the coordinate process). -/
theorem measurable_stopped_indicator {T : (ℕ → ℤ) → ℕ∞} (hT : IsStoppingTime coordFiltration T)
    {β : Type*} [MeasurableSpace β] [Zero β] (g : ℤ → β) :
    Measurable[hT.measurableSpace]
      (fun w => {w | T w < ⊤}.indicator (fun w => g (w (T w).toNat)) w) := by
  have hprog : IsStronglyProgressive coordFiltration (fun (n : ℕ) (w : ℕ → ℤ) => w n) :=
    StronglyAdapted.isStronglyProgressive_of_discrete fun n => (coord_measurable n).stronglyMeasurable
  have hst : Measurable[hT.measurableSpace]
      (stoppedValue (fun (n : ℕ) (w : ℕ → ℤ) => w n) T) :=
    measurable_stoppedValue hprog hT
  have hlt : MeasurableSet[hT.measurableSpace] {w | T w < ⊤} := by
    rw [setOf_lt_top_eq_iUnion T]
    exact MeasurableSet.iUnion fun k => hT.measurableSet_le' k
  have hfun : (fun w => {w | T w < ⊤}.indicator (fun w => g (w (T w).toNat)) w)
      = {w | T w < ⊤}.indicator
          (fun w => g (stoppedValue (fun (n : ℕ) (w : ℕ → ℤ) => w n) T w)) := by
    funext w
    by_cases h : T w < ⊤
    · obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.1 h.ne
      simp [Set.indicator, stoppedValue, ← hk]
    · simp [Set.indicator, h]
  rw [hfun]
  exact ((Measurable.of_discrete (f := g)).comp hst).indicator hlt

/-- **Strong Markov property at `T`, simple random walk, nonnegative functionals** (PRO step 14).
The integrability `hint` of `G ∘ θ_T` on `{T < ∞}` is a named hypothesis. -/
theorem strongMarkovAt_srwLaw (m : ℤ → ℤ → ℕ) (a : ℤ) {T : (ℕ → ℤ) → ℕ∞}
    (hT : IsStoppingTime coordFiltration T) {G : (ℕ → ℤ) → ℝ} (hG : Measurable G) (hG0 : ∀ w, 0 ≤ G w)
    (hint : Integrable
      ({w | T w < ⊤}.indicator (fun w => G (postTimePath (fun n w => w n) T w))) (srwLaw m a)) :
    StrongMarkovAt (srwLaw m a) hT (fun (n : ℕ) (w : ℕ → ℤ) => w n) (fun _ b => srwLaw m b) G := by
  unfold StrongMarkovAt
  let gE : ℤ → ℝ≥0∞ := fun b => ∫⁻ x, ENNReal.ofReal (G x) ∂srwLaw m b
  let φ : (ℕ → ℤ) → ℝ≥0∞ := fun w => {w | T w < ⊤}.indicator (fun w => gE (w (T w).toNat)) w
  have hH : Measurable (fun x => ENNReal.ofReal (G x)) := ENNReal.measurable_ofReal.comp hG
  have hφm : Measurable[hT.measurableSpace] φ := measurable_stopped_indicator hT gE
  have hφm' : Measurable φ := hφm.mono hT.measurableSpace_le le_rfl
  -- the identity of lower integrals on every `𝓕_T`-measurable set
  have hkey : ∀ B, MeasurableSet[hT.measurableSpace] B →
      ∫⁻ w in B, ENNReal.ofReal
          ({w | T w < ⊤}.indicator (fun w => G (postTimePath (fun n w => w n) T w)) w) ∂srwLaw m a
        = ∫⁻ w in B, φ w ∂srwLaw m a := by
    intro B hB
    have h1 := lintegral_postTime m a hT hH hB
    have hind : ∀ w, ENNReal.ofReal
        ({w | T w < ⊤}.indicator (fun w => G (postTimePath (fun n w => w n) T w)) w)
        = {w | T w < ⊤}.indicator (fun w => ENNReal.ofReal (G (postTimePath (fun n w => w n) T w))) w := by
      intro w
      by_cases h : w ∈ {w | T w < ⊤} <;> simp [h]
    simp only [hind]
    exact h1
  have hgR : ∀ b, ∫ x, G x ∂srwLaw m b = (gE b).toReal := fun b =>
    integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall hG0) hG.aestronglyMeasurable
  have hnn : ∀ w, 0 ≤ {w | T w < ⊤}.indicator (fun w => G (postTimePath (fun n w => w n) T w)) w :=
    fun w => Set.indicator_nonneg (fun w _ => hG0 _) w
  -- finiteness of the total lower integral
  have hfinint : ∫⁻ w, φ w ∂srwLaw m a ≠ ⊤ := by
    have h := hkey Set.univ (@MeasurableSet.univ _ hT.measurableSpace)
    rw [Measure.restrict_univ] at h
    rw [← h]
    refine ne_top_of_lt (lt_of_eq_of_lt (lintegral_congr fun w => ?_) hint.2)
    exact (Real.enorm_eq_ofReal (hnn w)).symm
  have hφae : ∀ᵐ w ∂srwLaw m a, φ w < ⊤ := ae_lt_top' hφm'.aemeasurable hfinint
  have hcR : (fun w => (φ w).toReal) = fun w =>
      {w | T w < ⊤}.indicator (fun ω' => ∫ x, G x ∂srwLaw m (ω' (T ω').toNat)) w := by
    funext w
    by_cases h : T w < ⊤
    · simp [Set.indicator, h, φ, hgR]
    · simp [Set.indicator, h, φ]
  have hg_int : ∀ s, MeasurableSet[hT.measurableSpace] s → srwLaw m a s < ⊤ →
      IntegrableOn (fun w => (φ w).toReal) s (srwLaw m a) := by
    intro s _ _
    exact integrable_toReal_of_lintegral_ne_top hφm'.aemeasurable
      (ne_top_of_le_ne_top hfinint (setLIntegral_le_lintegral s φ))
  have hg_eq : ∀ s, MeasurableSet[hT.measurableSpace] s → srwLaw m a s < ⊤ →
      ∫ w in s, (φ w).toReal ∂srwLaw m a
        = ∫ w in s, {w | T w < ⊤}.indicator (fun w => G (postTimePath (fun n w => w n) T w)) w
            ∂srwLaw m a := by
    intro s hs _
    rw [integral_toReal hφm'.aemeasurable (ae_restrict_of_ae hφae),
      integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall hnn) hint.aestronglyMeasurable.restrict,
      hkey s hs]
  have hgm : AEStronglyMeasurable[hT.measurableSpace] (fun w => (φ w).toReal) (srwLaw m a) :=
    ((ENNReal.measurable_toReal.comp hφm).stronglyMeasurable).aestronglyMeasurable
  have hae := ae_eq_condExp_of_forall_setIntegral_eq hT.measurableSpace_le hint hg_int hg_eq hgm
  filter_upwards [hae] with w hw
  exact hw.symm.trans (congrFun hcR w)

/-- The occupation count `V = ∑_{n < σ} 1{x_n ∉ A}` is nonnegative. -/
theorem occCount_nonneg (A : Set ℤ) (σ : (ℕ → ℤ) → ℕ) (w : ℕ → ℤ) : 0 ≤ occCount A σ w :=
  Finset.sum_nonneg fun _ _ => Set.indicator_nonneg (fun _ _ => zero_le_one) _

/-- The occupation count is measurable when the test time `σ` is measurable (named hypothesis `hσ`). -/
theorem measurable_occCount (A : Set ℤ) {σ : (ℕ → ℤ) → ℕ} (hσ : Measurable σ) :
    Measurable (occCount A σ) := by
  have hF : Measurable (fun p : ℕ × (ℕ → ℤ) =>
      ∑ n ∈ Finset.range p.1, Aᶜ.indicator (fun _ => (1 : ℝ)) (p.2 n)) := by
    refine measurable_from_prod_countable_right fun k => ?_
    exact Finset.measurable_sum (Finset.range k) fun n _ =>
      (Measurable.of_discrete (f := Aᶜ.indicator (fun _ : ℤ => (1 : ℝ)))).comp (measurable_pi_apply n)
  exact hF.comp (hσ.prodMk measurable_id)

/-- **Strong Markov property at `T` for the occupation count** (`V_occ` of PRO step 8, started at `T`). -/
theorem strongMarkovAt_occCount (m : ℤ → ℤ → ℕ) (a : ℤ) (A : Set ℤ) {σ : (ℕ → ℤ) → ℕ}
    (hσ : Measurable σ) {T : (ℕ → ℤ) → ℕ∞} (hT : IsStoppingTime coordFiltration T)
    (hint : Integrable
      ({w | T w < ⊤}.indicator (fun w => occCount A σ (postTimePath (fun n w => w n) T w)))
      (srwLaw m a)) :
    StrongMarkovAt (srwLaw m a) hT (fun (n : ℕ) (w : ℕ → ℤ) => w n) (fun _ b => srwLaw m b)
      (occCount A σ) :=
  strongMarkovAt_srwLaw m a hT (measurable_occCount A hσ) (occCount_nonneg A σ) hint

/-- **Strong Markov property at `T` for the square of the occupation count** (the second moment of PRO step 8). -/
theorem strongMarkovAt_occCount_sq (m : ℤ → ℤ → ℕ) (a : ℤ) (A : Set ℤ) {σ : (ℕ → ℤ) → ℕ}
    (hσ : Measurable σ) {T : (ℕ → ℤ) → ℕ∞} (hT : IsStoppingTime coordFiltration T)
    (hint : Integrable
      ({w | T w < ⊤}.indicator (fun w => occCount A σ (postTimePath (fun n w => w n) T w) ^ 2))
      (srwLaw m a)) :
    StrongMarkovAt (srwLaw m a) hT (fun (n : ℕ) (w : ℕ → ℤ) => w n) (fun _ b => srwLaw m b)
      (fun w => occCount A σ w ^ 2) :=
  strongMarkovAt_srwLaw m a hT ((measurable_occCount A hσ).pow_const 2) (fun _ => sq_nonneg _) hint

