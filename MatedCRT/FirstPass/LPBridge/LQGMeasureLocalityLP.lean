import LatticeProb.LQG.LQGMeasureLocality2
import MatedCRT.FirstPass.Frozen.S4S5b

/-!
# Locality of the γ-LQG measure: the Harmonic-Balls input to `FPLQGMeasureLocality`

Task `p2-lp-lqg-measure-locality-bridge` (worker q4).

Target: `MatedCRT.FPLQGMeasureLocality` (`MatedCRT/FirstPass/Frozen/S4S5b.lean:38`), which is
`LQGMeasureLocalityFunctionalStep` (`MatedCRT/Proofs/Sec4/Prop42Closure/LQGMeasureFunctional.lean:46`). That Prop asks
for ONE measurable `Λ` on the restricted field `(TestB1 → ℝ) × (CircleB1 → ℝ)` such that `μ(U) = Λ(h|_{B₁})` a.s. for
the cone field and, with the same `Λ`, for the whole-plane field.

What Harmonic Balls proves: `LatticeProb.LQG.lqgLocality_of_gff` (`LatticeProb/LQG/LQGMeasureLocality2.lean:171`,
unconditional). For each whole-plane model separately, `μ(U)` equals a.s. a `fieldSigmaAlgebra α₀ hC U`-measurable
random variable `Y` whose choice depends on the model. This is the existence form of locality. It does not give the
common `Λ` of `FPLQGMeasureLocality`, and it says nothing about the cone field (`IsConeField`).

This file contains: (i) a proved inclusion of `σ(h|_U)` in the σ-algebra of the restricted whole-plane field; (ii) the
Harmonic-Balls wrapper for the whole-plane side, modulo one named copy bridge `hCopy`; (iii) the cone-side gap as a named
Prop. The common-`Λ` step is `FPLQGMeasureLocality` itself; no bridge reduces it to the Harmonic-Balls theorem.
-/

namespace MatedCRT

open MeasureTheory Set Metric ProbabilityTheory
open scoped ENNReal
open _root_.HarmonicBalls

/-- **Restricted coordinates generate `σ(h|_U)`** (proved). For `U ⊆ B₁`, the σ-algebra `fieldSigmaAlgebra γ hC U` of the
whole-plane field is contained in the σ-algebra generated by the restriction `wholePlaneFieldOnB1 γ hC hcirc` to `B₁`:
a pairing with a test function `φ` supported in `U` is the coordinate at `⟨φ, _⟩ : TestB1`. -/
theorem fieldSigmaAlgebra_le_comap_wholePlaneFieldOnB1 {Ω : Type} (γ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (U : Set ℂ) (hU : U ⊆ ball (0 : ℂ) 1) :
    fieldSigmaAlgebra γ hC U ≤ MeasurableSpace.comap (wholePlaneFieldOnB1 γ hC hcirc) inferInstance := by
  unfold fieldSigmaAlgebra
  refine iSup₂_le fun φ hφ => ?_
  have hφB : IsTestFunction (ball (0 : ℂ) 1) φ := by
    unfold IsTestFunction at hφ ⊢
    exact ⟨hφ.1, hφ.2.1, hφ.2.2.trans hU⟩
  have hcoord : Measurable (fun x : (TestB1 → ℝ) × (CircleB1 → ℝ) => x.1 ⟨φ, hφB⟩) :=
    (measurable_pi_apply _).comp measurable_fst
  have hm : Measurable[MeasurableSpace.comap (wholePlaneFieldOnB1 γ hC hcirc) inferInstance]
      (fun ω => fieldPairing γ (hC ω) φ) :=
    hcoord.comp (Measurable.of_comap_le le_rfl)
  exact hm.comap_le

/-- **Whole-plane side, per model** (Harmonic-Balls input). For a whole-plane GFF with its `γ`-LQG measure and an open
`U`, `μ(U)` is a.s. equal to a `fieldSigmaAlgebra γ hC U`-measurable random variable. The Harmonic-Balls theorem
`LatticeProb.LQG.lqgLocality_of_gff` is stated for the LP copies of `IsWholePlaneGFF`, `IsLQGMeasureOfField`, `lqgQ` and
`fieldSigmaAlgebra`; the last three agree with the HB copies by unfolding. The GFF structures do not: `hCopy` is the
identification of the HB copy with the LP copy (distinct structures over distinct `GFFObservable` types; not proved
here). The conclusion is per model: it does NOT yield the common functional `Λ` of `FPLQGMeasureLocality`. -/
theorem lqgMeasure_sigmaLocality_wp_of_harmonicBalls
    (hCopy : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      HarmonicBalls.IsWholePlaneGFF P hC hcirc → LatticeProb.Gauss.IsWholePlaneGFF P hC hcirc)
    (hLQGCopy : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (γ α₀ : ℝ) (hcirc : Ω → ℝ → ℂ → ℝ)
      (μ : Ω → Measure ℂ),
      HarmonicBalls.IsLQGMeasureOfField P γ α₀ hcirc μ → LatticeProb.LQG.IsLQGMeasureOfField P γ α₀ hcirc μ)
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (hGFF : HarmonicBalls.IsWholePlaneGFF P hC hcirc) (hγ0 : 0 < γ) (hγ2 : γ < 2)
    (μ : Ω → Measure ℂ) (hμ : HarmonicBalls.IsLQGMeasureOfField P γ γ hcirc μ) (U : Set ℂ) (hU : IsOpen U) :
    ∃ Y : Ω → ℝ≥0∞, Measurable[fieldSigmaAlgebra γ hC U] Y ∧ ∀ᵐ ω ∂P, μ ω U = Y ω := by
  have hlt : γ < LatticeProb.LQG.lqgQ γ := by
    have hγne : γ ≠ 0 := ne_of_gt hγ0
    have hg : γ * (2 / γ) = 2 := by field_simp
    unfold LatticeProb.LQG.lqgQ
    nlinarith [mul_pos hγ0 hγ0, hγ2, hγ0, hg]
  exact LatticeProb.LQG.lqgLocality_of_gff P γ γ hC hcirc (hCopy Ω P hC hcirc hGFF) hγ0 hγ2 hlt μ
    (hLQGCopy Ω P γ γ hcirc μ hμ) U hU

/-- **Cone side: named gap, no proof here.** For the quantum cone field (`IsConeField`), the γ-LQG mass of an open
`U ⊆ B₁` is a.s. equal to a `fieldSigmaAlgebra 0 hC U`-measurable random variable. Harmonic Balls proves locality only for
whole-plane GFFs (`LQGLocality` takes `IsWholePlaneGFF`), so this is not an instance of the Harmonic-Balls theorem. The paper
asserts locality as Fact (LQG measure) II, lines 478-480, with no argument (`paper/idla_mated_crt-corrected.tex`). -/
def FPConeLQGMeasureSigmaLocality : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ U : Set ℂ, IsOpen U → U ⊆ ball (0 : ℂ) 1 →
    ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ)
      (μ : Ω → Measure ℂ),
      IsConeField γ P hC hcirc μ →
        ∃ Y : Ω → ℝ≥0∞, Measurable[fieldSigmaAlgebra 0 hC U] Y ∧ ∀ᵐ ω ∂P, μ ω U = Y ω

end MatedCRT
