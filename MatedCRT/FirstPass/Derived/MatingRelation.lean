import MatedCRT.Defs.Setting

/-!
# The mating relation of a boundary-length pair

For a pair of paths `b = (L, R)`, the *mating relation* `matingRel b` is the equivalence relation on times generated
by the direct `L`- and `R`-identifications `DirectRel` (`s < t`, `X_s = X_t` and `X_s < X_u` for `u ∈ (s, t)`), as in
Duplantier-Miller-Sheffield (2014), Section 8.1. Under a mating-of-trees coupling, the facts (P1) and (P2) of
DMS14 Lemmas 8.8 and 8.14 (the fields `merge` and `onlyMerge` of `IsMatingOfTreesCoupling`) say that it is almost
surely the fibre relation `η(s) = η(t)` of the space-filling SLE curve. The mated-CRT edge count of Definition 1.1 is
symmetric under the swap `L ↔ R`, so it depends on the boundary-length pair only up to that swap.

* `matingRel_eq_fibre_of_merge`: the deterministic identification from (P1) and (P2).
* `ae_matingRel_eq_fibre_of_coupling`, `MatedCRTEnv.IsValid.ae_matingRel_eq_fibre`: the almost sure forms.
* `bmEdgeCount_swap`, `bmEdgeCount_eq_of_eq_or_swap`, `MatedCRTEnv.mult_eq_of_eq_or_swap`: swap invariance of the
  edge count.
-/

namespace MatedCRT

open MeasureTheory
open scoped NNReal

/-- The mating relation of a boundary-length pair `b = (L, R)`: the equivalence relation on times generated by the
direct `L`- and `R`-identifications (`DirectRel`). -/
def matingRel (b : MatedCRTHarmonic.MatedCRT.Path2) : ℝ → ℝ → Prop :=
  Relation.EqvGen (fun a c => MatedCRTHarmonic.MatedCRT.DirectRel
      (fun u => MatedCRTHarmonic.MatedCRT.lrCoord 0 u b) a c ∨
    MatedCRTHarmonic.MatedCRT.DirectRel (fun u => MatedCRTHarmonic.MatedCRT.lrCoord 1 u b) a c)

/-- If every direct identification of `b` merges the curve `η` (P1), and `η` merges only times in the same class
(P2), then the mating relation of `b` is the fibre relation of `η`. -/
theorem matingRel_eq_fibre_of_merge {α : Type*} {b : MatedCRTHarmonic.MatedCRT.Path2} {η : ℝ → α}
    (hmerge : ∀ s t : ℝ, (MatedCRTHarmonic.MatedCRT.DirectRel
        (fun u => MatedCRTHarmonic.MatedCRT.lrCoord 0 u b) s t ∨
      MatedCRTHarmonic.MatedCRT.DirectRel (fun u => MatedCRTHarmonic.MatedCRT.lrCoord 1 u b) s t) → η s = η t)
    (honly : ∀ s t : ℝ, η s = η t → matingRel b s t) :
    matingRel b = fun s t => η s = η t := by
  funext s t
  refine propext ⟨fun h => ?_, honly s t⟩
  induction h with
  | rel a c hac => exact hmerge a c hac
  | refl a => rfl
  | symm a c _ ih => exact ih.symm
  | trans a c d _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Under a mating-of-trees coupling, almost surely the mating relation of the boundary-length pair is the fibre
relation of the area-parametrized space-filling curve (DMS14 Lemmas 8.8 and 8.14). -/
theorem ae_matingRel_eq_fibre_of_coupling {γ : ℝ} {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {X X₀ hIG₀ : Ω → MatedCRTHarmonic.MatedCRT.Field} {B B' B₀ B₀' : ℝ≥0 → Ω → ℝ} {U : Ω → ℝ}
    {ηL η η₀ : Ω → C(ℝ, ℂ)} {bm : Ω → MatedCRTHarmonic.MatedCRT.Path2}
    (hC : MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling γ P X X₀ hIG₀ B B' B₀ B₀' U ηL η η₀ bm) :
    ∀ᵐ ω ∂P, matingRel (bm ω) = fun s t => η ω s = η ω t := by
  filter_upwards [hC.merge, hC.onlyMerge] with ω h₁ h₂
  exact matingRel_eq_fibre_of_merge (η := ⇑(η ω)) h₁ h₂

/-- For a valid environment, almost surely the mating relation of the boundary-length pair `bm` is the fibre
relation of the space-filling curve `η`. -/
theorem MatedCRTEnv.IsValid.ae_matingRel_eq_fibre {Ω : Type} [MeasurableSpace Ω] {S : MatedCRTEnv Ω}
    {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) :
    ∀ᵐ ω ∂S.P, matingRel (S.bm ω) = fun s t => S.η ω s = S.η ω t := by
  obtain ⟨X, X₀, hIG₀, B, B', B₀, B₀', U, ηL, η', η₀, hC, hae⟩ := hS.matingOfTrees
  filter_upwards [ae_matingRel_eq_fibre_of_coupling hC, hae] with ω h₁ h₂
  rw [h₁, h₂.1]

/-- The mated-CRT edge count (Definition 1.1) is symmetric under the swap `L ↔ R` of the boundary-length pair. -/
theorem bmEdgeCount_swap (ε : ℝ) (L R : ℝ → ℝ) (j k : ℤ) :
    bmEdgeCount ε L R j k = bmEdgeCount ε R L j k := by
  unfold bmEdgeCount
  dsimp only
  split_ifs <;> first | rfl | (exfalso; tauto)

/-- Two boundary-length pairs that agree, or agree after the swap `L ↔ R`, have the same mated-CRT edge count. -/
theorem bmEdgeCount_eq_of_eq_or_swap {b b' : MatedCRTHarmonic.MatedCRT.Path2}
    (h : (∀ u, MatedCRTHarmonic.MatedCRT.lrCoord 0 u b' = MatedCRTHarmonic.MatedCRT.lrCoord 0 u b ∧
          MatedCRTHarmonic.MatedCRT.lrCoord 1 u b' = MatedCRTHarmonic.MatedCRT.lrCoord 1 u b) ∨
      (∀ u, MatedCRTHarmonic.MatedCRT.lrCoord 0 u b' = MatedCRTHarmonic.MatedCRT.lrCoord 1 u b ∧
          MatedCRTHarmonic.MatedCRT.lrCoord 1 u b' = MatedCRTHarmonic.MatedCRT.lrCoord 0 u b))
    (ε : ℝ) :
    bmEdgeCount ε (fun t => (b' t).1) (fun t => (b' t).2) =
      bmEdgeCount ε (fun t => (b t).1) (fun t => (b t).2) := by
  rcases h with h | h
  · have hL : (fun t => (b' t).1) = fun t => (b t).1 := funext fun t => (h t).1
    have hR : (fun t => (b' t).2) = fun t => (b t).2 := funext fun t => (h t).2
    rw [hL, hR]
  · have hL : (fun t => (b' t).1) = fun t => (b t).2 := funext fun t => (h t).1
    have hR : (fun t => (b' t).2) = fun t => (b t).1 := funext fun t => (h t).2
    rw [hL, hR]
    funext j k
    exact bmEdgeCount_swap ε _ _ j k

/-- The edge multiplicity of an environment at `ω` is the edge count of any pair that agrees with `bm ω`, or agrees
with it after the swap `L ↔ R`. -/
theorem MatedCRTEnv.mult_eq_of_eq_or_swap {Ω : Type} [MeasurableSpace Ω] (S : MatedCRTEnv Ω) (ε : ℝ) (ω : Ω)
    {b : MatedCRTHarmonic.MatedCRT.Path2}
    (h : (∀ u, MatedCRTHarmonic.MatedCRT.lrCoord 0 u (S.bm ω) = MatedCRTHarmonic.MatedCRT.lrCoord 0 u b ∧
          MatedCRTHarmonic.MatedCRT.lrCoord 1 u (S.bm ω) = MatedCRTHarmonic.MatedCRT.lrCoord 1 u b) ∨
      (∀ u, MatedCRTHarmonic.MatedCRT.lrCoord 0 u (S.bm ω) = MatedCRTHarmonic.MatedCRT.lrCoord 1 u b ∧
          MatedCRTHarmonic.MatedCRT.lrCoord 1 u (S.bm ω) = MatedCRTHarmonic.MatedCRT.lrCoord 0 u b)) :
    S.mult ε ω = bmEdgeCount ε (fun t => (b t).1) (fun t => (b t).2) :=
  bmEdgeCount_eq_of_eq_or_swap h ε

end MatedCRT
