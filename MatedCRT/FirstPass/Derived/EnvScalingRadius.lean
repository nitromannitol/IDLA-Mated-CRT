import MatedCRT.FirstPass.Derived.ConeScaleRadiusMeasurable
import MatedCRT.Proofs.Measurability.FieldCircle

/-!
# A `σ(h)`-measurable version of the cone scale radius

For a valid environment `S`, the cone scale radius `R_b = sup {r > 0 : h_r(0) + Q log r = γ⁻¹ log b}`
(eq:cone-scale-radius) is a function of the field: it agrees almost surely with a positive random
variable which is measurable for the σ-algebra `σ(h)` generated by the pairings of the field
(`MatedCRTEnv.fieldSigma`). This is the form in which the scaling `η ↦ R_b⁻¹ η(b ·)` of the
space-filling SLE is applied (line 3289, `R_b` a function of `h`, independent of `η`).

The proof reads `R_b` off its strict superlevel sets: off a null set, `x < R_b` iff a countable
event in the circle averages `h_q(0)`, `q ∈ ℚ` (`lt_scaleRadius_iff`), and the circle average `h_q(0)`
agrees almost surely with the `σ(h)`-measurable limit `FieldCircle.circleField` of pairings with
bump functions (`FieldCircle.ae_circleField_eq`). The version is the countable supremum of the
rationals below `R_b` (`exists_measurable_of_lt_iff`, deterministic).
-/

namespace MatedCRT.FirstPass.Derived

open MeasureTheory Filter Topology Set HarmonicBalls

/-- **A measurable version from the strict superlevel sets** (deterministic): if on a set `G` the
function `R` is positive and its strict superlevel sets `{x < R}`, `x ≥ 0`, agree with measurable
sets `E x`, then some measurable, everywhere positive `R'` agrees with `R` on `G`. -/
lemma exists_measurable_of_lt_iff {Ω : Type*} [MeasurableSpace Ω] {R : Ω → ℝ} {G : Set Ω}
    (E : ℝ → Set Ω) (hE : ∀ x, 0 ≤ x → MeasurableSet (E x)) (hpos : ∀ ω ∈ G, 0 < R ω)
    (hRE : ∀ x, 0 ≤ x → ∀ ω ∈ G, (x < R ω ↔ ω ∈ E x)) :
    ∃ R' : Ω → ℝ, Measurable R' ∧ (∀ ω, 0 < R' ω) ∧ ∀ ω ∈ G, R' ω = R ω := by
  classical
  set F : ℚ → Set Ω := fun q => {ω | 0 ≤ (q : ℝ) ∧ ω ∈ E q} with hF
  have hFm : ∀ q, MeasurableSet (F q) := by
    intro q
    by_cases hq : 0 ≤ (q : ℝ)
    · have : F q = E q := by ext ω; exact ⟨fun h => h.2, fun h => ⟨hq, h⟩⟩
      rw [this]; exact hE q hq
    · have : F q = ∅ := by ext ω; exact ⟨fun h => absurd h.1 hq, fun h => h.elim⟩
      rw [this]; exact MeasurableSet.empty
  set R₁ : Ω → ℝ := fun ω => ⨆ q : ℚ, (F q).indicator (fun _ => (q : ℝ)) ω with hR₁
  have hR₁m : Measurable R₁ :=
    Measurable.iSup fun q => measurable_const.indicator (hFm q)
  have hR₁G : ∀ ω ∈ G, R₁ ω = R ω := by
    intro ω hω
    have hle : ∀ q : ℚ, (F q).indicator (fun _ => (q : ℝ)) ω ≤ R ω := by
      intro q
      by_cases hq : ω ∈ F q
      · rw [indicator_of_mem hq]
        exact (hRE q hq.1 ω hω).2 hq.2 |>.le
      · rw [indicator_of_notMem hq]
        exact (hpos ω hω).le
    have hbdd : BddAbove (range fun q : ℚ => (F q).indicator (fun _ => (q : ℝ)) ω) :=
      ⟨R ω, by rintro _ ⟨q, rfl⟩; exact hle q⟩
    refine le_antisymm (ciSup_le hle) (le_of_forall_lt fun c hc => ?_)
    obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (max_lt hc (hpos ω hω))
    have hq0 : 0 ≤ (q : ℝ) := ((le_max_right c 0).trans_lt hq1).le
    have hqF : ω ∈ F q := ⟨hq0, (hRE q hq0 ω hω).1 hq2⟩
    calc c < q := (le_max_left c 0).trans_lt hq1
      _ = (F q).indicator (fun _ => (q : ℝ)) ω := (indicator_of_mem hqF (fun _ => (q : ℝ))).symm
      _ ≤ R₁ ω := le_ciSup hbdd q
  refine ⟨fun ω => if 0 < R₁ ω then R₁ ω else 1,
    Measurable.ite (measurableSet_lt measurable_const hR₁m) hR₁m measurable_const, ?_, ?_⟩
  · intro ω
    dsimp only
    split_ifs with h
    · exact h
    · exact one_pos
  · intro ω hω
    have h := hR₁G ω hω
    have hp : 0 < R₁ ω := h ▸ hpos ω hω
    show (if 0 < R₁ ω then R₁ ω else 1) = R ω
    simp only [hp, ↓reduceIte]
    exact h

/-- **The cone scale radius is a function of the field**: for a valid environment `S` and every `b`,
there is a `σ(h)`-measurable, everywhere positive random variable which is almost surely equal to the cone
scale radius `R_b = sup {r > 0 : h_r(0) + Q log r = γ⁻¹ log b}` (eq:cone-scale-radius). -/
theorem exists_fieldSigma_measurable_coneScaleRadius {𝒮 : SpaceFillingSLEModel} {γ : ℝ}
    (hγ0 : 0 < γ) (hγ2 : γ < 2) {Ω : Type} [MeasurableSpace Ω] (S : MatedCRTEnv Ω)
    (hS : S.IsValid 𝒮 γ) (b : ℝ) :
    ∃ R : Ω → ℝ, Measurable[S.fieldSigma] R ∧ (∀ ω, 0 < R ω) ∧
      ∀ᵐ ω ∂S.P, R ω = coneScaleRadius γ (S.hcirc ω) b := by
  have := hS.isProbabilityMeasure
  have h := hS.isQuantumCone
  have hcf : ∀ᵐ ω ∂S.P, ∀ q : ℚ, 0 < (q : ℝ) →
      FieldCircle.circleField S q 0 ω = S.hcirc ω q 0 := by
    rw [ae_all_iff]
    intro q
    by_cases hq : 0 < (q : ℝ)
    · filter_upwards [FieldCircle.ae_circleField_eq hS hq (z := 0) (by rw [norm_zero]; exact hq.ne)]
        with ω hω _
      exact hω
    · exact ae_of_all _ fun ω h' => absurd h' hq
  set G : Set Ω := {ω | ContinuousOn (fun p : ℝ × ℂ => S.hcirc ω p.1 p.2) (Ioi 0 ×ˢ univ) ∧
      (0 < coneScaleRadius γ (S.hcirc ω) b ∧
      S.hcirc ω (coneScaleRadius γ (S.hcirc ω) b) 0 +
          lqgQ γ * Real.log (coneScaleRadius γ (S.hcirc ω) b) = γ⁻¹ * Real.log b ∧
      ∀ r : ℝ, coneScaleRadius γ (S.hcirc ω) b < r →
        γ⁻¹ * Real.log b < S.hcirc ω r 0 + lqgQ γ * Real.log r) ∧
      ∀ q : ℚ, 0 < (q : ℝ) → FieldCircle.circleField S q 0 ω = S.hcirc ω q 0} with hG
  have hgood : ∀ᵐ ω ∂S.P, ω ∈ G := by
    filter_upwards [h.ae_continuousOn_circle, ae_coneScaleRadius_spec hγ0 hγ2 h b, hcf]
      with ω h1 h2 h3
    exact ⟨h1, h2, h3⟩
  set E : ℝ → Set Ω := fun x => {ω | ∃ n m : ℕ, ∀ k : ℕ, ∃ q : ℚ,
      (q : ℝ) ∈ Ioo (x + 1 / ((n : ℝ) + 1)) (x + m + 2) ∧
        FieldCircle.circleField S q 0 ω + lqgQ γ * Real.log q - γ⁻¹ * Real.log b <
          1 / ((k : ℝ) + 1)} with hE
  have hEm : ∀ x, 0 ≤ x → MeasurableSet[S.fieldSigma] (E x) := fun x hx =>
    @measurableSet_scaleRadius_witness Ω S.fieldSigma (fun ω r z => FieldCircle.circleField S r z ω)
      γ b (fun r z _ => FieldCircle.measurable_circleField S r z) x hx
  have hRE : ∀ x, 0 ≤ x → ∀ ω ∈ G, (x < coneScaleRadius γ (S.hcirc ω) b ↔ ω ∈ E x) := by
    intro x hx ω hω
    rw [lt_scaleRadius_iff hω.1 hω.2.1.2.1 hω.2.1.2.2 hx]
    show _ ↔ ∃ n m : ℕ, ∀ k : ℕ, ∃ q : ℚ, (q : ℝ) ∈ Ioo (x + 1 / ((n : ℝ) + 1)) (x + m + 2) ∧
      FieldCircle.circleField S q 0 ω + lqgQ γ * Real.log q - γ⁻¹ * Real.log b < 1 / ((k : ℝ) + 1)
    refine exists_congr fun n => exists_congr fun m => forall_congr' fun k =>
      exists_congr fun q => and_congr_right fun hq => ?_
    have hq0 : 0 < (q : ℝ) := by
      have : 0 < 1 / ((n : ℝ) + 1) := by positivity
      linarith [hq.1]
    rw [hω.2.2 q hq0]
  obtain ⟨R, hRm, hRpos, hRG⟩ := @exists_measurable_of_lt_iff Ω S.fieldSigma
    (fun ω => coneScaleRadius γ (S.hcirc ω) b) G E hEm (fun ω hω => hω.2.1.1) hRE
  exact ⟨R, hRm, hRpos, hgood.mono fun ω hω => hRG ω hω⟩

end MatedCRT.FirstPass.Derived
