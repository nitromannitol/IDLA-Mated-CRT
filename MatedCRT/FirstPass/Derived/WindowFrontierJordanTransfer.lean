import MatedCRT.FirstPass.Derived.WindowFrontierJordanGenuineCurve
import MatedCRT.FirstPass.Derived.WindowInverseChartJointLimit
import MatedCRT.FirstPass.Derived.ValidPeanosphere
import LatticeProb.LQG.PeanosphereContourFibers

/-!
# The Jordan frontier of the windows of a valid environment

Berestycki–Gwynne (2020), arXiv:2003.10320, proof of Lemma 7.21, use that for fixed times `a < u < b` the window
domain `U`, the connected component containing `η(u)` of the interior of `η([a, b])`, has a Jordan frontier. This
file proves the statement `WindowFrontierJordanInput 𝒮` of `WindowInverseChartJointLimit.lean`, for every valid
environment of every model, from the same fact for one curve per correlated Brownian pair.

* `WindowFrontierJordanGenuineCurve` (`WindowFrontierJordanGenuineCurve.lean`): named hypothesis. For almost every
  correlated Brownian pair `z` there is a continuous proper surjection `g : ℝ → ℂ` whose fibres are the classes of
  the equivalence relation generated by the direct identifications of `z`, with `g(u)` in the interior of `g([a, b])`
  and a Jordan frontier for the component of that interior containing `g(u)`.
* `isJordanCurve_image_homeomorph`, `image_frontier_windowComponent`: a homeomorphism of the plane carries Jordan
  curves to Jordan curves, and the frontier of the window component of `g` to that of `e ∘ g`.
* `windowFrontierJordanInput_of_genuineCurve`: `WindowFrontierJordanInput 𝒮` from
  `WindowFrontierJordanGenuineCurve`. In a valid environment the curve is almost surely a Peanosphere curve of its
  boundary-length pair, whose law is the correlated Brownian law (`MatedCRTEnv.IsValid.exists_curve_peanosphere`);
  the curve `g` of the hypothesis for that pair, with the conditions on the pair alone, is another Peanosphere curve
  of the same pair, and the two differ by a homeomorphism of the plane (`LatticeProb.Peanosphere.exists_homeomorph`),
  which carries the window component of `g` and its frontier onto those of the curve of the environment.
-/

set_option autoImplicit false

open MeasureTheory Set Filter Topology
open MatedCRTHarmonic.MatedCRT (Path2 IsCorrelatedBM2)
open MatedCRTHarmonic.RouteM (Peanosphere directRel)

namespace MatedCRT

/-- A homeomorphism of the plane carries a Jordan curve onto a Jordan curve. -/
theorem isJordanCurve_image_homeomorph (e : ℂ ≃ₜ ℂ) {Γ : Set ℂ}
    (h : LQGMetric.JordanMap.IsJordanCurve Γ) : LQGMetric.JordanMap.IsJordanCurve (e '' Γ) := by
  obtain ⟨c, hc, hi, rfl⟩ := h
  exact ⟨e ∘ c, e.continuous.comp_continuousOn hc, e.injective.comp_injOn hi, Set.image_comp _ _ _⟩

/-- A homeomorphism `e` of the plane with `e ∘ g = f` carries the frontier of the window component of `g`, the
connected component containing `g(u)` of the interior of `g([a, b])`, onto the frontier of the window component of
`f`, provided `g(u)` lies in that interior. -/
theorem image_frontier_windowComponent (e : ℂ ≃ₜ ℂ) {f g : ℝ → ℂ} (h : ∀ t, e (g t) = f t)
    {a u b : ℝ} (hu : g u ∈ interior (g '' Icc a b)) :
    e '' frontier (connectedComponentIn (interior (g '' Icc a b)) (g u)) =
      frontier (connectedComponentIn (interior (f '' Icc a b)) (f u)) := by
  have hf : f = e ∘ g := funext fun t => (h t).symm
  subst hf
  rw [e.image_frontier, e.image_connectedComponentIn hu, e.image_interior, Set.image_comp]
  rfl

/-- **The windows of a valid environment have Jordan frontiers** (`WindowFrontierJordanInput 𝒮`, for every model
`𝒮`), from `WindowFrontierJordanGenuineCurve` (written answer MQ-idla-jordan, part B1). In a valid environment the
curve is almost surely a Peanosphere curve `ξ` of the boundary-length pair `S.bm ω`, whose law is the correlated
Brownian law (coupling field `boundaryLawBM`). For almost every pair the curve `g` of the hypothesis, together with
the conditions on the pair alone carried by `ξ`, is a Peanosphere curve of the same pair; a homeomorphism `e` of the
plane with `e ∘ g = ξ` (`LatticeProb.Peanosphere.exists_homeomorph`) carries the frontier of the window component of
`g` onto that of `ξ`, and the Jordan parametrization along with it. -/
theorem windowFrontierJordanInput_of_genuineCurve (hJ : WindowFrontierJordanGenuineCurve)
    (𝒮 : SpaceFillingSLEModel) : WindowFrontierJordanInput 𝒮 := by
  intro γ hγ0 hγ2 Ω _ S hS a u b hau hub
  obtain ⟨ηc, hηc, hP, -⟩ := MatedCRTEnv.IsValid.exists_curve_peanosphere S hS
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, hC, -⟩ := hS.matingOfTrees
  have hbm : AEMeasurable S.bm S.P := hC.measurable_curves.2.2.2.aemeasurable
  have hT := ae_of_ae_map hbm (hJ γ hγ0 hγ2 _ hC.boundaryLawBM a u b hau hub)
  filter_upwards [hηc, hP, hT] with ω hηω hPω hTω
  obtain ⟨g, hc, hs, ht, hm, ho, hu, hJω⟩ := hTω
  have hg : Peanosphere (S.bm ω) g :=
    ⟨hc, hs, ht, hm, ho, hPω.liminf_L, hPω.liminf_R, hPω.locMinDistinct⟩
  obtain ⟨e, he⟩ := LatticeProb.Peanosphere.exists_homeomorph hg hPω
  rw [← hηω, ← image_frontier_windowComponent e he hu]
  exact isJordanCurve_image_homeomorph e hJω

end MatedCRT
