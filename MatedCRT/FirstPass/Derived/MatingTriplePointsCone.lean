import MatedCRT.FirstPass.Derived.MatingTriplePoints
import MatedCRT.FirstPass.Derived.MatingRelBorel

/-!
# Triple points of the mating relation off the cone times

Deterministic reduction for the triple points of the mating relation `matingRel b` of a boundary-length pair
`b = (L, R)` (Duplantier-Miller-Sheffield (2014), Section 8.1). The mating relation is the equivalence relation
generated by the direct `L`- and `R`-identifications `DirectRel`, i.e. the connected components of the graph on `ℝ`
whose edges are the direct identifications. Each time has at most four neighbours in this graph: its forward and
backward direct `L`-partners and its forward and backward direct `R`-partners, each unique when it exists.

* A triple point `s` has two distinct direct partners, or one of its direct partners has two distinct direct partners:
  otherwise `{s}` together with its direct partners is a set of at most two times closed under direct steps, which
  contains the class of `s`.
* A time with two distinct direct partners is a strict local minimum of `L` or of `R` with direct partners on both
  sides, a time of mixed type (a forward partner for one coordinate and a backward partner for the other), or a
  forward or backward cone time (forward, resp. backward, partners for both coordinates, at different times).
* Strict local minima of any function are countable.

Main statements.

* `coneTriplePoints b`: the cone times of `b` together with their partners.
* `mixTimes X Y`, `forwardConeTimes b`, `backwardConeTimes b`.
* `countable_matingTriplePoints_diff_coneTriplePoints`: the triple points off the cone triple points form a countable
  set when both sets of mixed-type times are countable.
* `countable_coneTriplePoints`: the cone triple points form a countable set when the forward and backward cone times
  do (uniqueness of the forward and backward direct partners).
-/

set_option autoImplicit false

open Set
open MatedCRTHarmonic.MatedCRT (DirectRel lrCoord Path2)

namespace MatedCRT

/-! ### Direct partners -/

/-- The **direct partners** of a time `s` for the pair `(X, Y)`: the times `c` such that `s` and `c` are joined by a
direct `X`- or `Y`-identification, in either order. -/
def directPartners (X Y : ℝ → ℝ) (s : ℝ) : Set ℝ :=
  {c | (DirectRel X s c ∨ DirectRel Y s c) ∨ (DirectRel X c s ∨ DirectRel Y c s)}

/-- Being direct partners is a symmetric relation. -/
theorem mem_directPartners_comm {X Y : ℝ → ℝ} {s c : ℝ} :
    c ∈ directPartners X Y s ↔ s ∈ directPartners X Y c := by
  exact ⟨fun h => Or.symm h, fun h => Or.symm h⟩

/-- A time has countably many (in fact at most four) direct partners. -/
theorem countable_directPartners (X Y : ℝ → ℝ) (s : ℝ) : (directPartners X Y s).Countable := by
  have hR : ∀ Z : ℝ → ℝ, {c | DirectRel Z s c}.Countable := by
    intro Z
    have h : {c | DirectRel Z s c}.Subsingleton := by
      intro c hc c' hc'
      exact directRel_right_unique hc hc'
    exact h.finite.countable
  have hL : ∀ Z : ℝ → ℝ, {c | DirectRel Z c s}.Countable := by
    intro Z
    have h : {c | DirectRel Z c s}.Subsingleton := by
      intro c hc c' hc'
      exact directRel_left_unique hc hc'
    exact h.finite.countable
  refine (((hR X).union (hR Y)).union ((hL X).union (hL Y))).mono ?_
  intro c hc
  exact hc

/-- **A chain stays in a step-closed set.** If membership in `S` is invariant along every `r`-step, it is invariant
along every chain of the generated equivalence relation `Relation.EqvGen r`. -/
theorem mem_iff_mem_of_eqvGen {α : Type*} {r : α → α → Prop} {S : Set α}
    (hS : ∀ a c, r a c → (a ∈ S ↔ c ∈ S)) {a c : α} (h : Relation.EqvGen r a c) : a ∈ S ↔ c ∈ S := by
  induction h with
  | rel x y hxy => exact hS x y hxy
  | refl x => exact Iff.rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **Triple points have a branching time nearby.** If `s` is related to two distinct times `u, v ≠ s` by the
equivalence relation generated by the direct `X`- and `Y`-identifications, then `s` or one of its direct partners has
two distinct direct partners. -/
theorem nontrivial_directPartners_of_eqvGen {X Y : ℝ → ℝ} {s u v : ℝ} (hus : u ≠ s) (hvs : v ≠ s)
    (huv : u ≠ v) (hu : Relation.EqvGen (fun a c => DirectRel X a c ∨ DirectRel Y a c) s u)
    (hv : Relation.EqvGen (fun a c => DirectRel X a c ∨ DirectRel Y a c) s v) :
    (directPartners X Y s).Nontrivial ∨ ∃ m ∈ directPartners X Y s, (directPartners X Y m).Nontrivial := by
  by_cases h1 : (directPartners X Y s).Nontrivial
  · exact Or.inl h1
  by_cases h2 : ∃ m ∈ directPartners X Y s, (directPartners X Y m).Nontrivial
  · exact Or.inr h2
  exfalso
  have hcl : ∀ x y, y ∈ directPartners X Y x → x ∈ insert s (directPartners X Y s) →
      y ∈ insert s (directPartners X Y s) := by
    intro x y hy hx
    rcases Set.mem_insert_iff.1 hx with rfl | hx
    · exact Set.mem_insert_of_mem _ hy
    · have hys : y = s := by
        by_contra hys
        exact h2 ⟨x, hx, y, hy, s, mem_directPartners_comm.1 hx, hys⟩
      rw [hys]
      exact Set.mem_insert _ _
  have hS : ∀ a c, (DirectRel X a c ∨ DirectRel Y a c) →
      (a ∈ insert s (directPartners X Y s) ↔ c ∈ insert s (directPartners X Y s)) :=
    fun a c hac => ⟨hcl a c (Or.inl hac), hcl c a (Or.inr hac)⟩
  have hu' := (mem_iff_mem_of_eqvGen hS hu).1 (Set.mem_insert _ _)
  have hv' := (mem_iff_mem_of_eqvGen hS hv).1 (Set.mem_insert _ _)
  exact h1 ⟨u, (Set.mem_insert_iff.1 hu').resolve_left hus, v,
    (Set.mem_insert_iff.1 hv').resolve_left hvs, huv⟩

/-! ### Times with two distinct direct partners -/

/-- The times with a backward and a forward direct `X`-partner. Each is a strict local minimum of `X`. -/
def twoSidedDirectRelTimes (X : ℝ → ℝ) : Set ℝ :=
  {s | ∃ a t, DirectRel X a s ∧ DirectRel X s t}

/-- The **mixed-type times** of `(X, Y)`: times with a forward direct `X`-partner and a backward direct
`Y`-partner. -/
def mixTimes (X Y : ℝ → ℝ) : Set ℝ :=
  {s | ∃ a t, DirectRel X s t ∧ DirectRel Y a s}

/-- On an open interval, at most one point is a strict minimiser of `X` over the interval. -/
private theorem subsingleton_setOf_strictMin_Ioo (X : ℝ → ℝ) (p q : ℝ) :
    {s : ℝ | s ∈ Ioo p q ∧ ∀ u ∈ Ioo p q, u ≠ s → X s < X u}.Subsingleton := by
  intro s hs s' hs'
  by_contra hne
  exact lt_asymm (hs.2 s' hs'.1 (Ne.symm hne)) (hs'.2 s hs.1 hne)

/-- **Strict local minima are countable.** The times with a backward and a forward direct `X`-partner form a
countable set: each is the strict minimiser of `X` on an open interval with rational endpoints. -/
theorem countable_twoSidedDirectRelTimes (X : ℝ → ℝ) : (twoSidedDirectRelTimes X).Countable := by
  refine (Set.countable_iUnion fun q : ℚ × ℚ =>
    (subsingleton_setOf_strictMin_Ioo X (q.1 : ℝ) (q.2 : ℝ)).finite.countable).mono ?_
  rintro s ⟨a, t, has, hst⟩
  obtain ⟨q₁, hq₁a, hq₁s⟩ := exists_rat_btwn has.1
  obtain ⟨q₂, hq₂s, hq₂t⟩ := exists_rat_btwn hst.1
  refine Set.mem_iUnion.2 ⟨(q₁, q₂), ⟨hq₁s, hq₂s⟩, fun u hu hus => ?_⟩
  rcases hus.lt_or_gt with h | h
  · rw [← has.2.1]
    exact has.2.2 u ⟨hq₁a.trans hu.1, h⟩
  · exact hst.2.2 u ⟨h, hu.2.trans hq₂t⟩

/-- **Times with two distinct direct partners.** A time with two distinct direct partners is a strict local minimum
of `X` or of `Y` with direct partners on both sides, a mixed-type time, or a forward or backward cone time. -/
theorem mem_cases_of_two_directPartners {X Y : ℝ → ℝ} {s u v : ℝ} (hu : u ∈ directPartners X Y s)
    (hv : v ∈ directPartners X Y s) (huv : u ≠ v) :
    s ∈ twoSidedDirectRelTimes X ∨ s ∈ twoSidedDirectRelTimes Y ∨ s ∈ mixTimes X Y ∨ s ∈ mixTimes Y X ∨
      (∃ t₁ t₂, t₁ ≠ t₂ ∧ DirectRel X s t₁ ∧ DirectRel Y s t₂) ∨
      ∃ t₁ t₂, t₁ ≠ t₂ ∧ DirectRel X t₁ s ∧ DirectRel Y t₂ s := by
  rcases hu with (h | h) | (h | h) <;> rcases hv with (h' | h') | (h' | h') <;>
    first
    | exact absurd (directRel_right_unique h h') huv
    | exact absurd (directRel_left_unique h h') huv
    | exact Or.inl ⟨_, _, h', h⟩
    | exact Or.inl ⟨_, _, h, h'⟩
    | exact Or.inr (Or.inl ⟨_, _, h', h⟩)
    | exact Or.inr (Or.inl ⟨_, _, h, h'⟩)
    | exact Or.inr (Or.inr (Or.inl ⟨_, _, h, h'⟩))
    | exact Or.inr (Or.inr (Or.inl ⟨_, _, h', h⟩))
    | exact Or.inr (Or.inr (Or.inr (Or.inl ⟨_, _, h, h'⟩)))
    | exact Or.inr (Or.inr (Or.inr (Or.inl ⟨_, _, h', h⟩)))
    | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨_, _, huv, h, h'⟩))))
    | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨_, _, huv.symm, h', h⟩))))
    | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨_, _, huv, h, h'⟩))))
    | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨_, _, huv.symm, h', h⟩))))

/-- **Triple points off a cone-closed set.** Let `C` contain every forward or backward cone time of `(X, Y)` together
with its two partners. If `s ∉ C` is related to two distinct times `u, v ≠ s` by the equivalence relation generated
by the direct `X`- and `Y`-identifications, then `s` is a strict local minimum with direct partners on both sides or
a mixed-type time, or a direct partner of such a time. -/
theorem mem_union_biUnion_directPartners_of_eqvGen {X Y : ℝ → ℝ} {C : Set ℝ}
    (hC : ∀ s t₁ t₂, t₁ ≠ t₂ →
      ((DirectRel X s t₁ ∧ DirectRel Y s t₂) ∨ (DirectRel X t₁ s ∧ DirectRel Y t₂ s)) →
        s ∈ C ∧ t₁ ∈ C ∧ t₂ ∈ C)
    {s u v : ℝ} (hus : u ≠ s) (hvs : v ≠ s) (huv : u ≠ v)
    (hu : Relation.EqvGen (fun a c => DirectRel X a c ∨ DirectRel Y a c) s u)
    (hv : Relation.EqvGen (fun a c => DirectRel X a c ∨ DirectRel Y a c) s v) (hsC : s ∉ C) :
    s ∈ (twoSidedDirectRelTimes X ∪ twoSidedDirectRelTimes Y ∪ mixTimes X Y ∪ mixTimes Y X) ∪
      ⋃ m ∈ twoSidedDirectRelTimes X ∪ twoSidedDirectRelTimes Y ∪ mixTimes X Y ∪ mixTimes Y X,
        directPartners X Y m := by
  rcases nontrivial_directPartners_of_eqvGen hus hvs huv hu hv with
    ⟨u', hu', v', hv', huv'⟩ | ⟨m, hm, u', hu', v', hv', huv'⟩
  · refine Set.mem_union_left _ ?_
    rcases mem_cases_of_two_directPartners hu' hv' huv' with
      h | h | h | h | ⟨t₁, t₂, hne, h1, h2⟩ | ⟨t₁, t₂, hne, h1, h2⟩
    · exact Or.inl (Or.inl (Or.inl h))
    · exact Or.inl (Or.inl (Or.inr h))
    · exact Or.inl (Or.inr h)
    · exact Or.inr h
    · exact absurd (hC s t₁ t₂ hne (Or.inl ⟨h1, h2⟩)).1 hsC
    · exact absurd (hC s t₁ t₂ hne (Or.inr ⟨h1, h2⟩)).1 hsC
  · refine Set.mem_union_right _ ?_
    have hsm : s ∈ directPartners X Y m := mem_directPartners_comm.1 hm
    rcases mem_cases_of_two_directPartners hu' hv' huv' with
      h | h | h | h | ⟨t₁, t₂, hne, h1, h2⟩ | ⟨t₁, t₂, hne, h1, h2⟩
    · exact Set.mem_biUnion (Or.inl (Or.inl (Or.inl h))) hsm
    · exact Set.mem_biUnion (Or.inl (Or.inl (Or.inr h))) hsm
    · exact Set.mem_biUnion (Or.inl (Or.inr h)) hsm
    · exact Set.mem_biUnion (Or.inr h) hsm
    · rcases hsm with (hs | hs) | (hs | hs)
      · obtain rfl := directRel_right_unique hs h1
        exact absurd (hC m _ t₂ hne (Or.inl ⟨h1, h2⟩)).2.1 hsC
      · obtain rfl := directRel_right_unique hs h2
        exact absurd (hC m t₁ _ hne (Or.inl ⟨h1, h2⟩)).2.2 hsC
      · exact Set.mem_biUnion (Or.inr ⟨s, t₂, h2, hs⟩) (Or.inr (Or.inl hs))
      · exact Set.mem_biUnion (Or.inl (Or.inr ⟨s, t₁, h1, hs⟩)) (Or.inr (Or.inr hs))
    · rcases hsm with (hs | hs) | (hs | hs)
      · exact Set.mem_biUnion (Or.inl (Or.inr ⟨t₂, s, hs, h2⟩)) (Or.inl (Or.inl hs))
      · exact Set.mem_biUnion (Or.inr ⟨t₁, s, hs, h1⟩) (Or.inl (Or.inr hs))
      · obtain rfl := directRel_left_unique hs h1
        exact absurd (hC m _ t₂ hne (Or.inr ⟨h1, h2⟩)).2.1 hsC
      · obtain rfl := directRel_left_unique hs h2
        exact absurd (hC m t₁ _ hne (Or.inr ⟨h1, h2⟩)).2.2 hsC

/-! ### Cone times and cone triple points of a boundary-length pair -/

/-- The **cone triple points** of `b = (L, R)`: the forward and backward cone times `s` of `b` (direct partners
`t₁ ≠ t₂` for `L` and for `R`, both forward or both backward), together with these partners. -/
def coneTriplePoints (b : Path2) : Set ℝ :=
  {x | ∃ s t₁ t₂, t₁ ≠ t₂ ∧
    ((DirectRel (fun u => lrCoord 0 u b) s t₁ ∧ DirectRel (fun u => lrCoord 1 u b) s t₂) ∨
     (DirectRel (fun u => lrCoord 0 u b) t₁ s ∧ DirectRel (fun u => lrCoord 1 u b) t₂ s)) ∧
    (x = s ∨ x = t₁ ∨ x = t₂)}

/-- The **forward cone times** of `b = (L, R)`: times with a forward direct `L`-partner and a forward direct
`R`-partner, at different times (forward strict `π/2`-cone times of the correlated Brownian motion). -/
def forwardConeTimes (b : Path2) : Set ℝ :=
  {s | ∃ t₁ t₂, t₁ ≠ t₂ ∧ DirectRel (fun u => lrCoord 0 u b) s t₁ ∧ DirectRel (fun u => lrCoord 1 u b) s t₂}

/-- The **backward cone times** of `b = (L, R)`: times with a backward direct `L`-partner and a backward direct
`R`-partner, at different times. -/
def backwardConeTimes (b : Path2) : Set ℝ :=
  {s | ∃ t₁ t₂, t₁ ≠ t₂ ∧ DirectRel (fun u => lrCoord 0 u b) t₁ s ∧ DirectRel (fun u => lrCoord 1 u b) t₂ s}

/-- **Triple points off the cone triple points.** If the mixed-type times of `b = (L, R)` (forward `L`- and backward
`R`-partner, and forward `R`- and backward `L`-partner) form countable sets, then the triple points of the mating
relation of `b` that are not cone triple points form a countable set. -/
theorem countable_matingTriplePoints_diff_coneTriplePoints (b : Path2)
    (hLR : (mixTimes (fun u => lrCoord 0 u b) (fun u => lrCoord 1 u b)).Countable)
    (hRL : (mixTimes (fun u => lrCoord 1 u b) (fun u => lrCoord 0 u b)).Countable) :
    (matingTriplePoints b \ coneTriplePoints b).Countable := by
  have hK : (twoSidedDirectRelTimes (fun u => lrCoord 0 u b) ∪ twoSidedDirectRelTimes (fun u => lrCoord 1 u b) ∪
      mixTimes (fun u => lrCoord 0 u b) (fun u => lrCoord 1 u b) ∪
      mixTimes (fun u => lrCoord 1 u b) (fun u => lrCoord 0 u b)).Countable :=
    (((countable_twoSidedDirectRelTimes _).union (countable_twoSidedDirectRelTimes _)).union hLR).union hRL
  refine (hK.union (hK.biUnion fun m _ =>
    countable_directPartners (fun u => lrCoord 0 u b) (fun u => lrCoord 1 u b) m)).mono ?_
  rintro s ⟨⟨u, v, hus, hvs, huv, hu, hv⟩, hsC⟩
  exact mem_union_biUnion_directPartners_of_eqvGen (X := fun u => lrCoord 0 u b)
    (Y := fun u => lrCoord 1 u b) (C := coneTriplePoints b)
    (fun s' t₁ t₂ hne h => ⟨⟨s', t₁, t₂, hne, h, Or.inl rfl⟩, ⟨s', t₁, t₂, hne, h, Or.inr (Or.inl rfl)⟩,
      ⟨s', t₁, t₂, hne, h, Or.inr (Or.inr rfl)⟩⟩) hus hvs huv hu hv hsC

/-- **Cone triple points.** If the forward and the backward cone times of `b` form countable sets, so do the cone
triple points: each cone time has at most one forward and one backward direct partner for each coordinate. -/
theorem countable_coneTriplePoints (b : Path2) (hF : (forwardConeTimes b).Countable)
    (hB : (backwardConeTimes b).Countable) : (coneTriplePoints b).Countable := by
  refine ((hF.union hB).biUnion fun s _ =>
    (countable_directPartners (fun u => lrCoord 0 u b) (fun u => lrCoord 1 u b) s).insert s).mono ?_
  rintro x ⟨s, t₁, t₂, hne, h, hx⟩
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · refine Set.mem_biUnion (show s ∈ forwardConeTimes b ∪ backwardConeTimes b from
      Or.inl ⟨t₁, t₂, hne, h1, h2⟩) ?_
    rcases hx with rfl | rfl | rfl
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ (Or.inl (Or.inl h1))
    · exact Set.mem_insert_of_mem _ (Or.inl (Or.inr h2))
  · refine Set.mem_biUnion (show s ∈ forwardConeTimes b ∪ backwardConeTimes b from
      Or.inr ⟨t₁, t₂, hne, h1, h2⟩) ?_
    rcases hx with rfl | rfl | rfl
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ (Or.inr (Or.inl h1))
    · exact Set.mem_insert_of_mem _ (Or.inr (Or.inr h2))

end MatedCRT
