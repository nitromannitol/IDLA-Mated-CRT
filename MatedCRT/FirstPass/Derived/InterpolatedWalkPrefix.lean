import MatedCRT.FirstPass.Derived.InterpolatedLawWiring
import MatedCRT.FirstPass.Derived.InterpolatedWalkShift
import LatticeProb.Prob.StoppedPathCoupling

/-!
# The interpolated embedded walk stopped at a step time depends on a finite prefix of the walk

For a labelling `v : ℤ → ℂ`, a speed `m > 0` and a walk `x : ℕ → ℤ`, the interpolated embedded walk
`interpPathCM v hm x` stopped at the step time `k / m` (`LatticeProb.stopPath`) only involves the
vertices `x 0, …, x k`: for a time `u ≤ k / m` the interpolation uses `x ⌊m u⌋` and `x (⌊m u⌋ + 1)`, and
the second one carries the weight `m u - ⌊m u⌋`, which vanishes when `⌊m u⌋ = k`.  Hence, on the annealed
space `Ω × (ℕ → ℤ)`, the stopped path is measurable for the `σ`-algebra generated by the environment and
the first `k + 1` steps of the walk.  This is the measurability hypothesis `hYG` of the Markov step of
`LatticeProb.ae_markovAt_of_markov_step_pathShift` (BG20 Lemma 7.4).

* `MatedCRT.linInterp_congr_of_le`: two sequences that agree up to `k` have the same interpolation on `[0, k]`.
* `MatedCRT.stopPath_interpPathCM_congr`: walks that agree up to `k` have the same stopped interpolated path.
* `MatedCRT.extendPrefix`: the walk obtained from a prefix `(x 0, …, x k)` by repeating the last vertex.
* `MatedCRT.measurable_stopPath_interpPathCM_prefix`: the stopped path is measurable for the `σ`-algebra
  generated by `(ω, x) ↦ (ω, (x 0, …, x k))`.
-/

open MeasureTheory MarkovProcess LatticeProb
open scoped NNReal

namespace MatedCRT

/-- Two sequences that agree up to `k` have the same linear interpolation at every time `s ∈ [0, k]`
(at `s = k` the weight of the term `a (k + 1)` is `0`). -/
theorem linInterp_congr_of_le (a b : ℕ → ℂ) (k : ℕ) (h : ∀ j ≤ k, a j = b j) {s : ℝ} (hs0 : 0 ≤ s)
    (hs : s ≤ k) : linInterp a s = linInterp b s := by
  have hfl : ⌊s⌋₊ ≤ k := Nat.floor_le_of_le hs
  unfold linInterp
  rw [h _ hfl]
  by_cases h1 : ⌊s⌋₊ + 1 ≤ k
  · rw [h _ h1]
  · have hk : ⌊s⌋₊ = k := le_antisymm hfl (by omega)
    have h0 : s - (⌊s⌋₊ : ℝ) = 0 := by
      have := Nat.floor_le hs0
      rw [hk] at this ⊢
      linarith
    simp [h0]

/-- Walks that agree up to step `k` have the same interpolated embedded walk stopped at the step time
`k / m`. -/
theorem stopPath_interpPathCM_congr (v : ℤ → ℂ) {m : ℝ} (hm : 0 < m) (k : ℕ) {x x' : ℕ → ℤ}
    (h : ∀ j ≤ k, x j = x' j) :
    stopPath (interpPathCM v hm.le x) ((k / m : ℝ).toNNReal) =
      stopPath (interpPathCM v hm.le x') ((k / m : ℝ).toNNReal) := by
  ext t
  have hk : 0 ≤ (k : ℝ) / m := div_nonneg (Nat.cast_nonneg k) hm.le
  simp only [stopPath_apply, interpPathCM_apply, interpPathFn]
  refine linInterp_congr_of_le _ _ k (fun j hj => by simp [h j hj])
    (mul_nonneg hm.le (NNReal.coe_nonneg _)) ?_
  have h1 : ((min t ((k / m : ℝ).toNNReal) : ℝ≥0) : ℝ) ≤ (k : ℝ) / m :=
    calc ((min t ((k / m : ℝ).toNNReal) : ℝ≥0) : ℝ)
        ≤ (((k / m : ℝ).toNNReal : ℝ≥0) : ℝ) := NNReal.coe_le_coe.2 (min_le_right _ _)
      _ = (k : ℝ) / m := Real.coe_toNNReal _ hk
  calc m * ((min t ((k / m : ℝ).toNNReal) : ℝ≥0) : ℝ) ≤ m * ((k : ℝ) / m) :=
        mul_le_mul_of_nonneg_left h1 hm.le
    _ = k := by field_simp

/-- The walk obtained from the prefix `(x 0, …, x k)` by repeating the last vertex: `j ↦ y (min j k)`. -/
def extendPrefix (k : ℕ) (y : Finset.Iic k → ℤ) : ℕ → ℤ :=
  fun j => y ⟨min j k, Finset.mem_Iic.2 (min_le_right _ _)⟩

theorem measurable_extendPrefix (k : ℕ) : Measurable (extendPrefix k) :=
  measurable_pi_iff.2 fun _ => measurable_pi_apply _

theorem extendPrefix_frestrictLe_apply_of_le (k : ℕ) (x : ℕ → ℤ) {j : ℕ} (hj : j ≤ k) :
    extendPrefix k (Preorder.frestrictLe k x) j = x j := by
  simp [extendPrefix, hj]

/-- The stopped interpolated embedded walk, as a function of the environment and the walk, is
measurable for the `σ`-algebra generated by the environment and the first `k + 1` steps of the
walk. -/
theorem measurable_stopPath_interpPathCM_prefix {Ω : Type*} [MeasurableSpace Ω] {v : Ω → ℤ → ℂ}
    (hv : Measurable v) {m : ℝ} (hm : 0 < m) (k : ℕ) :
    Measurable[MeasurableSpace.comap
        (fun p : Ω × (ℕ → ℤ) => (p.1, Preorder.frestrictLe k p.2)) inferInstance]
      (fun p : Ω × (ℕ → ℤ) =>
        stopPath (interpPathCM (v p.1) hm.le p.2) ((k / m : ℝ).toNNReal)) := by
  have hF : Measurable fun p : Ω × (ℕ → ℤ) =>
      stopPath (interpPathCM (v p.1) hm.le p.2) ((k / m : ℝ).toNNReal) := by
    have h3 : Measurable fun p : Ω × (ℕ → ℤ) => interpPathCM (v p.1) hm.le p.2 :=
      (measurable_interpPathCM_uncurry hm.le).comp ((hv.comp measurable_fst).prodMk measurable_snd)
    refine ContinuousMap.measurable_iff_eval.2 fun t => ?_
    exact (ContinuousPath.continuous_eval (min t ((k / m : ℝ).toNNReal))).measurable.comp h3
  have hh : Measurable fun q : Ω × (Finset.Iic k → ℤ) =>
      stopPath (interpPathCM (v q.1) hm.le (extendPrefix k q.2)) ((k / m : ℝ).toNNReal) :=
    hF.comp (measurable_fst.prodMk ((measurable_extendPrefix k).comp measurable_snd))
  have h4 := hh.comp (comap_measurable
    (fun p : Ω × (ℕ → ℤ) => (p.1, Preorder.frestrictLe k p.2)))
  convert h4 using 1
  funext p
  exact stopPath_interpPathCM_congr (v p.1) hm k
    (fun j hj => (extendPrefix_frestrictLe_apply_of_le k p.2 hj).symm)

end MatedCRT
