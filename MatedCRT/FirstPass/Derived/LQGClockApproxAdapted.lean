import MatedCRT.FirstPass.Derived.LQGClockApproxMeasurable
import MarkovProcess.Path.Stopping

/-!
# Adaptedness of the approximating LQG clocks to the canonical path filtration

For a field with circle averages `hε` and a scale `ε`, the approximating LQG clock (Berestycki 2015, Section 2, p. 6;
`HarmonicBalls.lqgClockApprox`)
`A_ε(b, t) = ∫_0^t ε^{γ²/2} e^{γ h_ε(b_s)} ds`
only reads the path `b` on `[0, t]`, so it is unchanged when `b` is stopped at time `t`. Stopping at a deterministic
time `t` is measurable from the canonical filtration at time `t` to the Borel σ-algebra of `ContinuousPath ℂ`, since
that Borel σ-algebra is generated by the coordinates (Mathlib `ContinuousMap.measurable_iff_eval`) and the coordinate
of the stopped path at time `s` is the coordinate of `b` at time `min s t ≤ t`. Hence `b ↦ A_ε(b, t)` is measurable for
the canonical filtration at time `t` as soon as `z ↦ h_ε(z)` is measurable.

## Main statements

* `measurable_stoppedPath_canonicalFiltration`: stopping at time `T` is `𝓕_T`-measurable.
* `lqgClockApprox_stoppedPath`: the clock at time `t` of the path stopped at `t` is the clock of the path.
* `measurable_lqgClockApprox_canonicalFiltration`: `b ↦ A_ε(b, t)` is `𝓕_t`-measurable.
-/

open MeasureTheory Set HarmonicBalls MarkovProcess
open scoped NNReal

namespace MatedCRT.LQGClockApproxAdapted

/-- **Stopping at a deterministic time is adapted.** The path stopped at time `T` is measurable from the canonical
filtration at time `T` to the Borel σ-algebra of `ContinuousPath α`, for a second-countable metrizable state space:
the Borel σ-algebra of `C(ℝ≥0, α)` is generated by the coordinates, and the coordinate at time `s` of the stopped
path is the coordinate of the path at time `min s T ≤ T`. -/
theorem measurable_stoppedPath_canonicalFiltration {α : Type*} [TopologicalSpace α]
    [TopologicalSpace.PseudoMetrizableSpace α] [SecondCountableTopology α] [MeasurableSpace α] [BorelSpace α]
    (T : ℝ≥0) :
    Measurable[ContinuousPath.canonicalFiltration (alpha := α) T]
      (ContinuousPath.stoppedPath (alpha := α) T) := by
  let _ : MeasurableSpace (ContinuousPath α) := ContinuousPath.canonicalFiltration (alpha := α) T
  refine ContinuousMap.measurable_iff_eval.2 fun s => ?_
  have hmono : ContinuousPath.canonicalFiltration (alpha := α) (min s T) ≤
      ContinuousPath.canonicalFiltration (alpha := α) T :=
    (ContinuousPath.canonicalFiltration (alpha := α)).mono (min_le_right s T)
  exact (ContinuousPath.measurable_coordinateProcess_canonicalFiltration (alpha := α) (min s T)).mono hmono le_rfl

/-- The approximating LQG clock at time `t` only reads the path on `[0, t]`: it is unchanged when the path is stopped
at time `t`. -/
theorem lqgClockApprox_stoppedPath (γ : ℝ) (hε : ℝ → ℂ → ℝ) (ε : ℝ) (b : ContinuousPath ℂ) (t : ℝ≥0) :
    lqgClockApprox γ hε ε (ContinuousPath.stoppedPath t b) t = lqgClockApprox γ hε ε b t := by
  unfold lqgClockApprox
  refine intervalIntegral.integral_congr fun s hs => ?_
  have hs' : s ≤ (t : ℝ) := by
    rcases Set.mem_uIcc.1 hs with h | h
    · exact h.2
    · exact h.2.trans t.2
  have hst : s.toNNReal ≤ t := Real.toNNReal_le_iff_le_coe.2 hs'
  simp only [ContinuousPath.stoppedPath_apply_of_le t b s.toNNReal hst]

/-- **Adaptedness of the approximating LQG clock.** If `z ↦ h_ε(z)` is measurable, then for every time `t` the
approximating LQG clock `b ↦ ∫_0^t ε^{γ²/2} e^{γ h_ε(b_s)} ds` is measurable for the canonical filtration at time
`t`. -/
theorem measurable_lqgClockApprox_canonicalFiltration (γ : ℝ) {hε : ℝ → ℂ → ℝ} {ε : ℝ}
    (hmeas : Measurable (hε ε)) (t : ℝ≥0) :
    Measurable[ContinuousPath.canonicalFiltration (alpha := ℂ) t]
      fun b : ContinuousPath ℂ => lqgClockApprox γ hε ε b t := by
  have hborel : Measurable fun b : ContinuousPath ℂ => lqgClockApprox γ hε ε b t :=
    (LQGClockApproxMeasurable.measurable_lqgClockApprox_field_path_time_of_scale (X := Unit)
      (c := fun _ => hε) γ (hmeas.comp measurable_snd)).comp
      (measurable_const.prodMk (measurable_id.prodMk measurable_const) :
        Measurable fun b : ContinuousPath ℂ => ((() : Unit), b, t))
  have heq : (fun b : ContinuousPath ℂ => lqgClockApprox γ hε ε b t) =
      (fun b : ContinuousPath ℂ => lqgClockApprox γ hε ε b t) ∘ ContinuousPath.stoppedPath t := by
    funext b
    exact (lqgClockApprox_stoppedPath γ hε ε b t).symm
  rw [heq]
  exact hborel.comp (measurable_stoppedPath_canonicalFiltration t)

end MatedCRT.LQGClockApproxAdapted
