import LatticeProb.Bonanno.ReflectedGMS.GeomTop.GMSTopology

/-!
# The pseudometric `d^CC` on the space of cell configurations and measurable limits

Gwynne–Miller–Sheffield (arXiv:1807.07515), Definition 1.15 and (1.15): the topology of the space
of cell configurations is the one generated by the open balls of
`d^CC(H,H') = ∫₀^∞ e^{-r} ∧ inf_{f_r} {sup_z |z - f_r(z)| + max |c(H₁,H₂) - c'(f_r H₁, f_r H₂)|} dr`.

On `GMSSpace` this is a finite pseudometric: it is symmetric (an admissible homeomorphism of the
pair `(H,H')` inverts to one of `(H',H)` with the same displacement and the same conductance
errors), bounded by `1`, and satisfies the triangle inequality (every configuration has finitely
many cells meeting each ball).  Consequently the balls form a neighbourhood basis, and a pointwise
`d^CC`-limit of measurable maps into `GMSSpace` is measurable, for the Borel `σ`-algebra of the
topology generated by the balls.

Main declarations:

* `MatedCRT.ZeroConePolygonal.finite_restrict_ball`: finitely many cells meet each ball.
* `MatedCRT.ZeroConePolygonal.dCC_symm`: symmetry of `d^CC` on arbitrary cell configurations.
* `MatedCRT.ZeroConePolygonal.dCC_le_one`, `MatedCRT.ZeroConePolygonal.dCC_triangle`.
* `MatedCRT.ZeroConePolygonal.isOpen_iff_forall_dCC`: the balls form a basis of the topology.
* `MatedCRT.ZeroConePolygonal.mem_closure_iff_iInf_dCC_eq_zero`: closure by `d^CC`-distance.
* `MatedCRT.ZeroConePolygonal.measurable_of_tendsto_dCC`: pointwise `d^CC`-limits of measurable
  maps are measurable.
* `MatedCRT.ZeroConePolygonal.measurable_of_countable_range`: a map with countable range and
  measurable fibres is measurable.
-/

set_option autoImplicit false

open MeasureTheory Set Filter Topology Metric
open scoped ENNReal NNReal

namespace MatedCRT.ZeroConePolygonal

open ReflectedGMS ReflectedGMS.GMS

/-! ### Finite restrictions -/

/-- A GMS configuration has only finitely many cells meeting each ball about the origin. -/
theorem finite_restrict_ball (H : GMSSpace) (r : ℝ) :
    (H.1.restrict (Metric.ball (0 : Plane) r)).Finite :=
  ReflectedGMS.GeomTop.GMSTopology.finite_restrict_ball H.2 r

/-! ### Symmetry -/

/-- Inverting an admissible homeomorphism of `(H,H')` gives an admissible one of `(H',H)`. -/
theorem admissibleAt_symm {H H' : CellConfig} {r : ℝ} {f : Plane ≃ₜ Plane}
    (h : CellConfig.AdmissibleAt H H' r f) : CellConfig.AdmissibleAt H' H r f.symm := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨h2, fun K hK => ?_, h4, fun K hK K' hK' hadj => ?_⟩
  · simpa only [Homeomorph.symm_symm] using h1 K hK
  · simpa only [Homeomorph.symm_symm] using h3 K hK K' hK' hadj

/-- The distortion of an admissible homeomorphism is at most that of its inverse for the swapped
pair: the displacement is reindexed by `w = f z`, and the conductance errors by the cell bijection
induced by `f`. -/
theorem distortion_le_distortion_symm {H H' : CellConfig} {r : ℝ} {f : Plane ≃ₜ Plane}
    (h : CellConfig.AdmissibleAt H H' r f) :
    CellConfig.distortion H H' r f ≤ CellConfig.distortion H' H r f.symm := by
  unfold CellConfig.distortion
  refine add_le_add (iSup_le fun z => ?_) ?_
  · refine le_iSup_of_le (f z) ?_
    simp [edist_comm]
  · refine iSup₂_le fun K hK => iSup₂_le fun K' hK' => iSup_le fun hadj => ?_
    refine le_iSup₂_of_le (CellConfig.mapCell f K) (h.1 K hK)
      (le_iSup₂_of_le (CellConfig.mapCell f K') (h.1 K' hK')
        (le_iSup_of_le (h.2.2.1 K hK K' hK' hadj) ?_))
    rw [CellConfig.mapCell_symm_mapCell, CellConfig.mapCell_symm_mapCell, abs_sub_comm]

theorem dCCIntegrand_symm_le (H H' : CellConfig) (r : ℝ) :
    ReflectedGMS.GeomTop.GMSTopology.dCCIntegrand H' H r ≤
      ReflectedGMS.GeomTop.GMSTopology.dCCIntegrand H H' r := by
  unfold ReflectedGMS.GeomTop.GMSTopology.dCCIntegrand
  refine min_le_min le_rfl (le_iInf₂ fun f hf => ?_)
  refine (iInf₂_le f.symm (admissibleAt_symm hf)).trans ?_
  simpa only [Homeomorph.symm_symm] using distortion_le_distortion_symm (admissibleAt_symm hf)

/-- **Symmetry of GMS's metric** `d^CC`, for arbitrary cell configurations. -/
theorem dCC_symm (H H' : CellConfig) : CellConfig.dCC H H' = CellConfig.dCC H' H := by
  rw [ReflectedGMS.GeomTop.GMSTopology.dCC_eq, ReflectedGMS.GeomTop.GMSTopology.dCC_eq]
  exact lintegral_congr fun r =>
    le_antisymm (dCCIntegrand_symm_le H' H r) (dCCIntegrand_symm_le H H' r)

/-! ### Boundedness and the triangle inequality -/

/-- `d^CC ≤ 1`. -/
theorem dCC_le_one (H H' : CellConfig) : CellConfig.dCC H H' ≤ 1 := by
  calc CellConfig.dCC H H' ≤ ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal (Real.exp (-r)) :=
        lintegral_mono fun r => min_le_left _ _
    _ = 1 := by
        rw [ReflectedGMS.GeomTop.GMSTopology.lintegral_exp_neg_Ioi]
        simp

theorem dCC_ne_top (H H' : CellConfig) : CellConfig.dCC H H' ≠ ∞ :=
  ne_top_of_le_ne_top ENNReal.one_ne_top (dCC_le_one H H')

/-- **The triangle inequality for `d^CC`** on the space of cell configurations. -/
theorem dCC_triangle (H₁ H₂ H₃ : GMSSpace) :
    CellConfig.dCC H₁.1 H₃.1 ≤ CellConfig.dCC H₁.1 H₂.1 + CellConfig.dCC H₂.1 H₃.1 :=
  ReflectedGMS.GeomTop.GMSTopology.dCC_triangle (finite_restrict_ball H₁) (finite_restrict_ball H₂)
    H₃.1

/-! ### The balls form a basis -/

/-- A set of configurations is open iff it contains a `d^CC`-ball about each of its points. -/
theorem isOpen_iff_forall_dCC {S : Set GMSSpace} :
    IsOpen S ↔ ∀ H ∈ S, ∃ ε : ℝ≥0∞, 0 < ε ∧ ∀ H' : GMSSpace, CellConfig.dCC H.1 H'.1 < ε →
      H' ∈ S := by
  refine ⟨fun hS => ?_, isOpen_of_forall_dCC⟩
  have key : ∀ S : Set GMSSpace, TopologicalSpace.GenerateOpen
      {S | ∃ (H : GMSSpace) (ε : ℝ≥0∞), 0 < ε ∧ S = {H' | CellConfig.dCC H.1 H'.1 < ε}} S →
      ∀ H ∈ S, ∃ ε : ℝ≥0∞, 0 < ε ∧ ∀ H' : GMSSpace, CellConfig.dCC H.1 H'.1 < ε → H' ∈ S := by
    intro S hS'
    induction hS' with
    | basic S hS =>
      obtain ⟨H₀, ε₀, hε₀, rfl⟩ := hS
      intro H hH
      have hH' : CellConfig.dCC H₀.1 H.1 < ε₀ := hH
      refine ⟨ε₀ - CellConfig.dCC H₀.1 H.1, tsub_pos_of_lt hH', fun H' hH'' => ?_⟩
      show CellConfig.dCC H₀.1 H'.1 < ε₀
      calc CellConfig.dCC H₀.1 H'.1 ≤ CellConfig.dCC H₀.1 H.1 + CellConfig.dCC H.1 H'.1 :=
            dCC_triangle H₀ H H'
        _ < CellConfig.dCC H₀.1 H.1 + (ε₀ - CellConfig.dCC H₀.1 H.1) :=
            ENNReal.add_lt_add_left (dCC_ne_top _ _) hH''
        _ = ε₀ := add_tsub_cancel_of_le hH'.le
    | univ => exact fun H _ => ⟨1, one_pos, fun _ _ => mem_univ _⟩
    | inter S T _ _ ihS ihT =>
      rintro H ⟨hHS, hHT⟩
      obtain ⟨ε, hε, hεS⟩ := ihS H hHS
      obtain ⟨δ, hδ, hδT⟩ := ihT H hHT
      exact ⟨min ε δ, lt_min hε hδ, fun H' h =>
        ⟨hεS H' (lt_of_lt_of_le h (min_le_left _ _)),
          hδT H' (lt_of_lt_of_le h (min_le_right _ _))⟩⟩
    | sUnion F _ ih =>
      rintro H ⟨T, hT, hHT⟩
      obtain ⟨ε, hε, hεT⟩ := ih T hT H hHT
      exact ⟨ε, hε, fun H' h => ⟨T, hT, hεT H' h⟩⟩
  exact key S hS

/-- Every `d^CC`-ball is open. -/
theorem isOpen_ball_dCC (H : GMSSpace) (ε : ℝ≥0∞) :
    IsOpen {H' : GMSSpace | CellConfig.dCC H.1 H'.1 < ε} := by
  refine isOpen_iff_forall_dCC.2 fun H₁ hH₁ => ?_
  have hH' : CellConfig.dCC H.1 H₁.1 < ε := hH₁
  refine ⟨ε - CellConfig.dCC H.1 H₁.1, tsub_pos_of_lt hH', fun H' hH'' => ?_⟩
  show CellConfig.dCC H.1 H'.1 < ε
  calc CellConfig.dCC H.1 H'.1 ≤ CellConfig.dCC H.1 H₁.1 + CellConfig.dCC H₁.1 H'.1 :=
        dCC_triangle H H₁ H'
    _ < CellConfig.dCC H.1 H₁.1 + (ε - CellConfig.dCC H.1 H₁.1) :=
        ENNReal.add_lt_add_left (dCC_ne_top _ _) hH''
    _ = ε := add_tsub_cancel_of_le hH'.le

/-- A configuration lies in the closure of `F` iff `F` has members arbitrarily `d^CC`-close to it. -/
theorem mem_closure_iff_dCC {F : Set GMSSpace} {H : GMSSpace} :
    H ∈ closure F ↔ ∀ ε : ℝ≥0∞, 0 < ε → ∃ H' ∈ F, CellConfig.dCC H.1 H'.1 < ε := by
  rw [_root_.mem_closure_iff]
  refine ⟨fun h ε hε => ?_, fun h U hU hHU => ?_⟩
  · obtain ⟨H', hH', hF⟩ := h _ (isOpen_ball_dCC H ε)
      (show CellConfig.dCC H.1 H.1 < ε by rw [CellConfig.dCC_self]; exact hε)
    exact ⟨H', hF, hH'⟩
  · obtain ⟨ε, hε, hεU⟩ := isOpen_iff_forall_dCC.1 hU H hHU
    obtain ⟨H', hH', hlt⟩ := h ε hε
    exact ⟨H', hεU H' hlt, hH'⟩

/-- A configuration lies in the closure of `F` iff its `d^CC`-distance to `F` is zero. -/
theorem mem_closure_iff_iInf_dCC_eq_zero {F : Set GMSSpace} {H : GMSSpace} :
    H ∈ closure F ↔ ⨅ H' ∈ F, CellConfig.dCC H.1 H'.1 = 0 := by
  rw [mem_closure_iff_dCC]
  refine ⟨fun h => ?_, fun h ε hε => ?_⟩
  · by_contra hne
    obtain ⟨H', hH', hlt⟩ := h _ (pos_iff_ne_zero.2 hne)
    exact absurd (iInf₂_le H' hH') (not_le.2 hlt)
  · have : ⨅ H' ∈ F, CellConfig.dCC H.1 H'.1 < ε := h ▸ hε
    obtain ⟨H', hH'⟩ := iInf_lt_iff.1 this
    obtain ⟨hF, hlt⟩ := iInf_lt_iff.1 hH'
    exact ⟨H', hF, hlt⟩

/-! ### Measurable limits -/

/-- `d^CC` as a pseudometric on `GMSSpace`, compatible with the given topology. -/
@[instance_reducible]
noncomputable def dCCPseudoMetricSpace : PseudoMetricSpace GMSSpace :=
  PseudoMetricSpace.ofDistTopology (fun H H' => (CellConfig.dCC H.1 H'.1).toReal)
    (fun H => by simp [CellConfig.dCC_self])
    (fun H H' => by rw [dCC_symm])
    (fun H₁ H₂ H₃ => by
      rw [← ENNReal.toReal_add (dCC_ne_top _ _) (dCC_ne_top _ _)]
      exact ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨dCC_ne_top _ _, dCC_ne_top _ _⟩)
        (dCC_triangle H₁ H₂ H₃))
    (fun S => by
      rw [isOpen_iff_forall_dCC]
      refine forall₂_congr fun H _ => ⟨fun ⟨ε, hε, h⟩ => ?_, fun ⟨ε, hε, h⟩ => ?_⟩
      · refine ⟨(min ε 1).toReal, ENNReal.toReal_pos (lt_min hε one_pos).ne'
          (ne_top_of_le_ne_top ENNReal.one_ne_top (min_le_right _ _)), fun H' hH' => h H' ?_⟩
        exact lt_of_lt_of_le ((ENNReal.toReal_lt_toReal (dCC_ne_top _ _)
          (ne_top_of_le_ne_top ENNReal.one_ne_top (min_le_right _ _))).1 hH') (min_le_left _ _)
      · refine ⟨ENNReal.ofReal ε, ENNReal.ofReal_pos.2 hε, fun H' hH' => h H' ?_⟩
        exact ENNReal.toReal_lt_of_lt_ofReal hH')

/-- **Pointwise `d^CC`-limits of measurable maps are measurable.**  If `Φ n x → Ψ x` in `d^CC` for
every `x`, and every `Φ n` is measurable into `GMSSpace` (with its Borel `σ`-algebra for the
topology generated by the `d^CC`-balls), then `Ψ` is measurable. -/
theorem measurable_of_tendsto_dCC {X : Type*} [MeasurableSpace X] {Φ : ℕ → X → GMSSpace}
    {Ψ : X → GMSSpace} (hΦ : ∀ n, Measurable (Φ n))
    (hlim : ∀ x, Tendsto (fun n => CellConfig.dCC (Φ n x).1 (Ψ x).1) atTop (𝓝 0)) :
    Measurable Ψ := by
  have : TopologicalSpace.PseudoMetrizableSpace GMSSpace := by
    let _ : PseudoMetricSpace GMSSpace := dCCPseudoMetricSpace
    exact ⟨⟨inferInstance, rfl, inferInstance⟩⟩
  refine measurable_of_tendsto_metrizable hΦ (tendsto_pi_nhds.2 fun x => ?_)
  refine tendsto_nhds.2 fun U hU hxU => ?_
  obtain ⟨ε, hε, hεU⟩ := isOpen_iff_forall_dCC.1 hU (Ψ x) hxU
  filter_upwards [(hlim x).eventually (gt_mem_nhds hε)] with n hn
  exact hεU _ (by rwa [dCC_symm])

/-- A map with countable range and measurable fibres is measurable. -/
theorem measurable_of_countable_range {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {f : X → Y} (hc : (range f).Countable) (hf : ∀ y, MeasurableSet (f ⁻¹' {y})) :
    Measurable f := by
  intro S _
  have : f ⁻¹' S = ⋃ y ∈ range f ∩ S, f ⁻¹' {y} := by
    ext x
    simp only [mem_preimage, mem_iUnion, mem_inter_iff, mem_range, mem_singleton_iff,
      exists_prop]
    exact ⟨fun h => ⟨f x, ⟨⟨x, rfl⟩, h⟩, rfl⟩, fun ⟨y, ⟨_, hy⟩, hx⟩ => hx ▸ hy⟩
  rw [this]
  exact MeasurableSet.biUnion (hc.mono inter_subset_left) fun y _ => hf y

end MatedCRT.ZeroConePolygonal
