import MatedCRT.FirstPass.Derived.MatingRelation
import LatticeProb.LQG.MatingOfTreesCouplingMerge
import LatticeProb.Topology.PolishContinuousMap
import Mathlib.MeasureTheory.Constructions.Polish.Basic

/-!
# The mating relation is a Borel subset of `Path2 × ℝ × ℝ`

For a pair of paths `b = (L, R)`, the mating relation `matingRel b` is the equivalence relation on times generated by
the direct `L`- and `R`-identifications `DirectRel` (Duplantier-Miller-Sheffield (2014), Section 8.1). A generated
equivalence relation is in general only a projection over chains of arbitrary length. Here every time has at most one
direct partner of each of the four types (`L` forward or backward, `R` forward or backward), so a chain is determined
by its starting time and its word of types, and the chain existentials are images of Borel sets under injective
continuous maps. By the Lusin-Souslin theorem these images are Borel.

* `directRel_right_unique`, `directRel_left_unique`: a time has at most one forward and one backward direct partner.
* `stepT`, `flipT`: the four typed direct steps and the reversal of a type; `stepT_unique`, `stepT_flip`.
* `chainW`: chains of typed steps along a word in `Fin 4`; `chainW_append`, `chainW_reverse`, `chainW_unique`.
* `matingRel_iff_chainW`: two times are mated iff some word connects them.
* `measurableSet_stepT`: each typed step is Borel (from `MatedCRTHarmonic.MatedCRT.measurableSet_directRel`).
* `measurableSet_chainW`: each word gives a Borel set (Lusin-Souslin, `MeasurableSet.image_of_measurable_injOn`).
* `measurableSet_matingRel`: `{(b, s, t) | matingRel b s t}` is a Borel subset of `Path2 × ℝ × ℝ`.
-/

open MeasureTheory Set
open MatedCRTHarmonic.MatedCRT (DirectRel lrCoord Path2)

namespace MatedCRT

/-- A time has at most one forward direct partner: if `DirectRel X a c` and `DirectRel X a c'`, then `c = c'`. -/
theorem directRel_right_unique {X : ℝ → ℝ} {a c c' : ℝ} (h : DirectRel X a c)
    (h' : DirectRel X a c') : c = c' := by
  rcases lt_trichotomy c c' with hlt | heq | hgt
  · have := h'.2.2 c ⟨h.1, hlt⟩
    rw [h.2.1] at this
    exact absurd this (lt_irrefl _)
  · exact heq
  · have := h.2.2 c' ⟨h'.1, hgt⟩
    rw [h'.2.1] at this
    exact absurd this (lt_irrefl _)

/-- A time has at most one backward direct partner: if `DirectRel X a c` and `DirectRel X a' c`, then `a = a'`. -/
theorem directRel_left_unique {X : ℝ → ℝ} {a a' c : ℝ} (h : DirectRel X a c)
    (h' : DirectRel X a' c) : a = a' := by
  rcases lt_trichotomy a a' with hlt | heq | hgt
  · have := h.2.2 a' ⟨hlt, h'.1⟩
    rw [h.2.1, ← h'.2.1] at this
    exact absurd this (lt_irrefl _)
  · exact heq
  · have := h'.2.2 a ⟨hgt, h.1⟩
    rw [h'.2.1, ← h.2.1] at this
    exact absurd this (lt_irrefl _)

/-- The typed direct steps from `x` to `y` for the pair `b = (L, R)`: type `0` is a forward `L`-identification,
`1` a backward `L`-identification, `2` a forward `R`-identification and `3` a backward `R`-identification. -/
def stepT (k : Fin 4) (b : Path2) (x y : ℝ) : Prop :=
  if k = 0 then DirectRel (fun u => lrCoord 0 u b) x y
  else if k = 1 then DirectRel (fun u => lrCoord 0 u b) y x
  else if k = 2 then DirectRel (fun u => lrCoord 1 u b) x y
  else DirectRel (fun u => lrCoord 1 u b) y x

/-- The reversal of a step type: forward and backward are exchanged. -/
def flipT : Fin 4 → Fin 4 := ![1, 0, 3, 2]

/-- A step of type `0` is a forward `L`-identification. -/
theorem stepT_zero_iff {b : Path2} {x y : ℝ} :
    stepT 0 b x y ↔ DirectRel (fun u => lrCoord 0 u b) x y :=
  Iff.rfl

/-- A step of type `2` is a forward `R`-identification. -/
theorem stepT_two_iff {b : Path2} {x y : ℝ} :
    stepT 2 b x y ↔ DirectRel (fun u => lrCoord 1 u b) x y :=
  Iff.rfl

/-- A typed step has at most one endpoint from a given start. -/
theorem stepT_unique {k : Fin 4} {b : Path2} {x y y' : ℝ} (h : stepT k b x y) (h' : stepT k b x y') :
    y = y' := by
  unfold stepT at h h'
  split_ifs at h h'
  · exact directRel_right_unique h h'
  · exact directRel_left_unique h h'
  · exact directRel_right_unique h h'
  · exact directRel_left_unique h h'

/-- Reversing a typed step reverses its type. -/
theorem stepT_flip {k : Fin 4} {b : Path2} {x y : ℝ} : stepT (flipT k) b y x ↔ stepT k b x y := by
  fin_cases k <;> exact Iff.rfl

/-- Every typed step joins two mated times. -/
theorem matingRel_of_stepT {k : Fin 4} {b : Path2} {x y : ℝ} (h : stepT k b x y) : matingRel b x y := by
  unfold stepT at h
  unfold matingRel
  split_ifs at h
  · exact Relation.EqvGen.rel _ _ (Or.inl h)
  · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ (Or.inl h))
  · exact Relation.EqvGen.rel _ _ (Or.inr h)
  · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ (Or.inr h))

/-- Chains of typed steps along a word: `chainW w b s t` says that the steps of types `w` lead from `s` to `t`. -/
def chainW : List (Fin 4) → Path2 → ℝ → ℝ → Prop
  | [], _, s, t => s = t
  | k :: w, b, s, t => ∃ y, stepT k b s y ∧ chainW w b y t

/-- The empty word connects a time only to itself. -/
@[simp] theorem chainW_nil {b : Path2} {s t : ℝ} : chainW [] b s t ↔ s = t :=
  Iff.rfl

/-- A chain along `k :: w` is a step of type `k` followed by a chain along `w`. -/
@[simp] theorem chainW_cons {k : Fin 4} {w : List (Fin 4)} {b : Path2} {s t : ℝ} :
    chainW (k :: w) b s t ↔ ∃ y, stepT k b s y ∧ chainW w b y t :=
  Iff.rfl

/-- A chain along a concatenated word is a chain along the first word followed by one along the second. -/
theorem chainW_append {w₁ w₂ : List (Fin 4)} {b : Path2} {s t : ℝ} :
    chainW (w₁ ++ w₂) b s t ↔ ∃ y, chainW w₁ b s y ∧ chainW w₂ b y t := by
  induction w₁ generalizing s with
  | nil => simp
  | cons k w₁ ih =>
    simp only [List.cons_append, chainW_cons, ih]
    constructor
    · rintro ⟨y, hy, z, hz, hzt⟩
      exact ⟨z, ⟨y, hy, hz⟩, hzt⟩
    · rintro ⟨z, ⟨y, hy, hz⟩, hzt⟩
      exact ⟨y, hy, z, hz, hzt⟩

/-- A chain read backwards is a chain along the reversed word of reversed types. -/
theorem chainW_reverse {w : List (Fin 4)} {b : Path2} {s t : ℝ} (h : chainW w b s t) :
    chainW (w.reverse.map flipT) b t s := by
  induction w generalizing s with
  | nil =>
    simp only [List.reverse_nil, List.map_nil, chainW_nil] at h ⊢
    exact h.symm
  | cons k w ih =>
    obtain ⟨y, hy, hw⟩ := chainW_cons.mp h
    rw [List.reverse_cons, List.map_append, chainW_append]
    refine ⟨y, ih hw, ?_⟩
    simp only [List.map_cons, List.map_nil, chainW_cons, chainW_nil, exists_eq_right]
    exact stepT_flip.mpr hy

/-- A chain is determined by its word and its starting time. -/
theorem chainW_unique {w : List (Fin 4)} {b : Path2} {s t t' : ℝ} (h : chainW w b s t)
    (h' : chainW w b s t') : t = t' := by
  induction w generalizing s with
  | nil => exact (chainW_nil.mp h).symm.trans (chainW_nil.mp h')
  | cons k w ih =>
    obtain ⟨y, hy, hw⟩ := chainW_cons.mp h
    obtain ⟨y', hy', hw'⟩ := chainW_cons.mp h'
    have hyy : y = y' := stepT_unique hy hy'
    subst hyy
    exact ih hw hw'

/-- Two times are mated iff some word of typed steps leads from one to the other. -/
theorem matingRel_iff_chainW {b : Path2} {s t : ℝ} :
    matingRel b s t ↔ ∃ w : List (Fin 4), chainW w b s t := by
  constructor
  · intro h
    induction h with
    | rel _ c hac =>
      rcases hac with hac | hac
      · exact ⟨[0], chainW_cons.mpr ⟨c, stepT_zero_iff.mpr hac, chainW_nil.mpr rfl⟩⟩
      · exact ⟨[2], chainW_cons.mpr ⟨c, stepT_two_iff.mpr hac, chainW_nil.mpr rfl⟩⟩
    | refl _ => exact ⟨[], chainW_nil.mpr rfl⟩
    | symm _ _ _ ih =>
      obtain ⟨w, hw⟩ := ih
      exact ⟨_, chainW_reverse hw⟩
    | trans _ c _ _ _ ih₁ ih₂ =>
      obtain ⟨w₁, hw₁⟩ := ih₁
      obtain ⟨w₂, hw₂⟩ := ih₂
      exact ⟨w₁ ++ w₂, chainW_append.mpr ⟨c, hw₁, hw₂⟩⟩
  · rintro ⟨w, hw⟩
    induction w generalizing s with
    | nil =>
      rw [chainW_nil] at hw
      subst hw
      exact Relation.EqvGen.refl _
    | cons k w ih =>
      obtain ⟨y, hy, hw⟩ := chainW_cons.mp hw
      exact Relation.EqvGen.trans _ _ _ (matingRel_of_stepT hy) (ih hw)

/-- Each typed step is a Borel subset of `Path2 × ℝ × ℝ` (the direct identifications are Borel:
`MatedCRTHarmonic.MatedCRT.measurableSet_directRel`; the backward types are preimages under the swap of times). -/
theorem measurableSet_stepT (k : Fin 4) :
    MeasurableSet {p : Path2 × ℝ × ℝ | stepT k p.1 p.2.1 p.2.2} := by
  have hswap : Measurable (fun p : Path2 × ℝ × ℝ => (p.1, p.2.2, p.2.1)) := by fun_prop
  unfold stepT
  split_ifs
  · exact MatedCRTHarmonic.MatedCRT.measurableSet_directRel 0
  · exact (MatedCRTHarmonic.MatedCRT.measurableSet_directRel 0).preimage hswap
  · exact MatedCRTHarmonic.MatedCRT.measurableSet_directRel 1
  · exact (MatedCRTHarmonic.MatedCRT.measurableSet_directRel 1).preimage hswap

/-- Each word of typed steps gives a Borel subset of `Path2 × ℝ × ℝ`. The set of a word `k :: w` is the image of the
Borel set `{(b, s, y, t) | stepT k b s y ∧ chainW w b y t}` under `(b, s, y, t) ↦ (b, s, t)`, which is injective on it
because a step has at most one endpoint; injective measurable images of Borel sets of a standard Borel space are Borel
(Lusin-Souslin). -/
theorem measurableSet_chainW (w : List (Fin 4)) :
    MeasurableSet {p : Path2 × ℝ × ℝ | chainW w p.1 p.2.1 p.2.2} := by
  have : PolishSpace Path2 := LatticeProb.polishSpace_continuousMap ℝ (ℝ × ℝ)
  induction w with
  | nil => exact measurableSet_eq_fun measurable_snd.fst measurable_snd.snd
  | cons k w ih =>
    have h₁ : MeasurableSet {q : Path2 × ℝ × ℝ × ℝ | stepT k q.1 q.2.1 q.2.2.1} :=
      (measurableSet_stepT k).preimage
        (show Measurable (fun q : Path2 × ℝ × ℝ × ℝ => (q.1, q.2.1, q.2.2.1)) by fun_prop)
    have h₂ : MeasurableSet {q : Path2 × ℝ × ℝ × ℝ | chainW w q.1 q.2.2.1 q.2.2.2} :=
      ih.preimage (show Measurable (fun q : Path2 × ℝ × ℝ × ℝ => (q.1, q.2.2.1, q.2.2.2)) by fun_prop)
    have hT : MeasurableSet
        {q : Path2 × ℝ × ℝ × ℝ | stepT k q.1 q.2.1 q.2.2.1 ∧ chainW w q.1 q.2.2.1 q.2.2.2} :=
      h₁.inter h₂
    have hinj : InjOn (fun q : Path2 × ℝ × ℝ × ℝ => (q.1, q.2.1, q.2.2.2))
        {q : Path2 × ℝ × ℝ × ℝ | stepT k q.1 q.2.1 q.2.2.1 ∧ chainW w q.1 q.2.2.1 q.2.2.2} := by
      rintro ⟨b, s, y, t⟩ ⟨hy, -⟩ ⟨b', s', y', t'⟩ ⟨hy', -⟩ he
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl, rfl, rfl⟩ := he
      have hyy : y = y' := stepT_unique hy hy'
      subst hyy
      rfl
    have himg : {p : Path2 × ℝ × ℝ | chainW (k :: w) p.1 p.2.1 p.2.2} =
        (fun q : Path2 × ℝ × ℝ × ℝ => (q.1, q.2.1, q.2.2.2)) ''
          {q : Path2 × ℝ × ℝ × ℝ | stepT k q.1 q.2.1 q.2.2.1 ∧ chainW w q.1 q.2.2.1 q.2.2.2} := by
      ext p
      constructor
      · rintro ⟨y, hy, hw⟩
        exact ⟨(p.1, p.2.1, y, p.2.2), ⟨hy, hw⟩, rfl⟩
      · rintro ⟨q, ⟨hy, hw⟩, rfl⟩
        exact ⟨q.2.2.1, hy, hw⟩
    rw [himg]
    exact hT.image_of_measurable_injOn (by fun_prop) hinj

/-- **The mating relation is Borel**: `{(b, s, t) | matingRel b s t}` is a measurable subset of `Path2 × ℝ × ℝ`.
It is the countable union over words `w : List (Fin 4)` of the Borel sets `measurableSet_chainW w`. -/
theorem measurableSet_matingRel : MeasurableSet {p : Path2 × ℝ × ℝ | matingRel p.1 p.2.1 p.2.2} := by
  have h : {p : Path2 × ℝ × ℝ | matingRel p.1 p.2.1 p.2.2} =
      ⋃ w : List (Fin 4), {p : Path2 × ℝ × ℝ | chainW w p.1 p.2.1 p.2.2} := by
    ext p
    rw [Set.mem_iUnion]
    exact matingRel_iff_chainW (b := p.1) (s := p.2.1) (t := p.2.2)
  rw [h]
  exact MeasurableSet.iUnion fun w => measurableSet_chainW w

end MatedCRT
