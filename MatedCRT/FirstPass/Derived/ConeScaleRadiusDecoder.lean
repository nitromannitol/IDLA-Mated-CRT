import MatedCRT.FirstPass.Derived.ConeScaleRadiusMeasurable

/-!
# The cone scale radius is a measurable function of the circle average process

For a `γ`-quantum cone the cone scale radius `R_b = sup {r > 0 : h_r(0) + Q log r = γ⁻¹ log b}` is read off the
rational times of the circle average process `circleProcess (hcirc ω)`: there is a function
`radiusDecoder γ b` on `(0, ∞) × ℂ → ℝ`, measurable for the product σ-algebra, such that almost surely
`radiusDecoder γ b (circleProcess (hcirc ω)) = coneScaleRadius γ (hcirc ω) b`.  Hence `R_b` is almost surely
equal to a measurable function of the circle average process, in particular it is measurable with respect to the
σ-algebra generated by the circle average process (and not only with respect to the ambient σ-algebra).
-/

open MeasureTheory Filter Topology Set HarmonicBalls
open scoped NNReal ENNReal

namespace MatedCRT.FirstPass.Derived

/-- A circle average process on `(0, ∞) × ℂ`, extended by `0` to a family indexed by all radii. -/
noncomputable def extendCircle (x : Ioi (0 : ℝ) × ℂ → ℝ) : ℝ → ℂ → ℝ :=
  fun r z => if h : 0 < r then x (⟨r, h⟩, z) else 0

theorem extendCircle_circleProcess (hc : ℝ → ℂ → ℝ) {r : ℝ} (hr : 0 < r) (z : ℂ) :
    extendCircle (circleProcess hc) r z = hc r z := by
  simp [extendCircle, circleProcess, hr]

/-- The countable witness event for `t < R_b`, read off the rational times of the circle average process. -/
def radiusWitness (γ b : ℝ) (x : Ioi (0 : ℝ) × ℂ → ℝ) (t : ℝ) : Prop :=
  ∃ n m : ℕ, ∀ k : ℕ, ∃ q : ℚ, (q : ℝ) ∈ Ioo (t + 1 / ((n : ℝ) + 1)) (t + m + 2) ∧
    extendCircle x q 0 + lqgQ γ * Real.log q - γ⁻¹ * Real.log b < 1 / ((k : ℝ) + 1)

theorem measurableSet_radiusWitness (γ b : ℝ) {t : ℝ} (ht : 0 ≤ t) :
    MeasurableSet {x : Ioi (0 : ℝ) × ℂ → ℝ | radiusWitness γ b x t} := by
  have hmeas : ∀ (r : ℝ) (z : ℂ), 0 < r → Measurable fun x : Ioi (0 : ℝ) × ℂ → ℝ => extendCircle x r z := by
    intro r z hr
    simp only [extendCircle, hr, dite_true]
    exact measurable_pi_apply _
  exact measurableSet_scaleRadius_witness (hcirc := fun x => extendCircle x) γ b hmeas ht

/-- The measurable decoder of the cone scale radius: the supremum of the nonnegative rationals `q` with
`radiusWitness`. -/
noncomputable def radiusDecoder (γ b : ℝ) (x : Ioi (0 : ℝ) × ℂ → ℝ) : ℝ := by
  classical
  exact ⨆ q : {q : ℚ // 0 ≤ q}, if radiusWitness γ b x (q.1 : ℝ) then (q.1 : ℝ) else 0

theorem measurable_radiusDecoder (γ b : ℝ) : Measurable (radiusDecoder γ b) := by
  classical
  have h : radiusDecoder γ b = fun x => ⨆ q : {q : ℚ // 0 ≤ q},
      if radiusWitness γ b x (q.1 : ℝ) then (q.1 : ℝ) else 0 := by
    funext x
    simp only [radiusDecoder]
  rw [h]
  refine Measurable.iSup fun q => ?_
  exact Measurable.ite (measurableSet_radiusWitness γ b (by exact_mod_cast q.2))
    measurable_const measurable_const

/-- **The cone scale radius is almost surely a measurable function of the circle average process.** -/
theorem ae_radiusDecoder_eq {Ω : Type*} [MeasurableSpace Ω] {γ : ℝ} {P : Measure Ω}
    [IsProbabilityMeasure P] {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (hγ0 : 0 < γ) (hγ2 : γ < 2) (h : IsQuantumCone γ P hC hcirc) (b : ℝ) :
    ∀ᵐ ω ∂P, radiusDecoder γ b (circleProcess (hcirc ω)) = coneScaleRadius γ (hcirc ω) b := by
  classical
  filter_upwards [h.ae_continuousOn_circle, ae_coneScaleRadius_spec hγ0 hγ2 h b] with ω h1 h2
  obtain ⟨hpos, h3, h4⟩ := h2
  have key : ∀ q : ℚ, 0 ≤ q →
      (radiusWitness γ b (circleProcess (hcirc ω)) (q : ℝ) ↔ (q : ℝ) < coneScaleRadius γ (hcirc ω) b) := by
    intro q hq
    rw [lt_scaleRadius_iff h1 h3 h4 (x := (q : ℝ)) (by exact_mod_cast hq)]
    unfold radiusWitness
    refine exists_congr fun n => exists_congr fun m => forall_congr' fun k => exists_congr fun q' => ?_
    refine and_congr_right fun hmem => ?_
    have hq0 : (0 : ℝ) ≤ q := by exact_mod_cast hq
    have hpos' : (0 : ℝ) < q' := by
      have := hmem.1
      have h1n : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
      linarith
    rw [extendCircle_circleProcess _ hpos']
  have hbdd : BddAbove (Set.range fun q : {q : ℚ // 0 ≤ q} =>
      if radiusWitness γ b (circleProcess (hcirc ω)) (q.1 : ℝ) then (q.1 : ℝ) else 0) := by
    refine ⟨coneScaleRadius γ (hcirc ω) b, ?_⟩
    rintro _ ⟨q, rfl⟩
    by_cases hw : radiusWitness γ b (circleProcess (hcirc ω)) (q.1 : ℝ)
    · simpa [hw] using ((key q.1 q.2).1 hw).le
    · simpa [hw] using hpos.le
  have hunfold : radiusDecoder γ b (circleProcess (hcirc ω)) = ⨆ q : {q : ℚ // 0 ≤ q},
      if radiusWitness γ b (circleProcess (hcirc ω)) (q.1 : ℝ) then (q.1 : ℝ) else 0 := by
    simp only [radiusDecoder]
  rw [hunfold]
  apply le_antisymm
  · refine ciSup_le fun q => ?_
    by_cases hw : radiusWitness γ b (circleProcess (hcirc ω)) (q.1 : ℝ)
    · simpa [hw] using ((key q.1 q.2).1 hw).le
    · simpa [hw] using hpos.le
  · refine le_of_forall_lt fun c hc => ?_
    by_cases hc0 : c < 0
    · have h0 := le_ciSup hbdd (⟨0, le_refl _⟩ : {q : ℚ // 0 ≤ q})
      have : (if radiusWitness γ b (circleProcess (hcirc ω)) (((⟨0, le_refl _⟩ : {q : ℚ // 0 ≤ q}).1 : ℚ) : ℝ)
          then ((((⟨0, le_refl _⟩ : {q : ℚ // 0 ≤ q}).1 : ℚ)) : ℝ) else 0) = 0 := by
        split_ifs <;> simp
      linarith
    · push Not at hc0
      obtain ⟨q, hcq, hqR⟩ := exists_rat_btwn hc
      have hq0 : 0 ≤ q := by exact_mod_cast hc0.trans hcq.le
      have hw : radiusWitness γ b (circleProcess (hcirc ω)) (q : ℝ) := (key q hq0).2 hqR
      have h0 := le_ciSup hbdd (⟨q, hq0⟩ : {q : ℚ // 0 ≤ q})
      simp only [hw, ↓reduceIte] at h0
      exact lt_of_lt_of_le hcq h0

end MatedCRT.FirstPass.Derived
