import Mathlib.Probability.Independence.Basic

/-!
# Independence transfers through a measurable code that is faithful on an almost sure set

If `Z` takes values almost surely in a set `L` on which the σ-algebra of the target is generated by a
code `e` (every measurable set of the target agrees, inside `L`, with a preimage under `e` of a
measurable set), then independence of `e ∘ Z` and `ξ` gives independence of `Z` and `ξ`.
No measurability of `Z`, `ξ` or `e` is needed: independence of functions is a statement about the
σ-algebras they generate.
-/

namespace MatedCRT.FirstPass.Derived

open MeasureTheory ProbabilityTheory Set

/-- Independence transfers from `e ∘ Z` to `Z` when the σ-algebra of the target is generated by `e` on an
almost sure set `L`. -/
theorem indepFun_of_embedding_ae {Ω Y V C : Type*} [MeasurableSpace Ω] [MeasurableSpace Y]
    [MeasurableSpace V] [MeasurableSpace C] {P : Measure Ω} {Z : Ω → Y} {ξ : Ω → C} (e : Y → V)
    (L : Set Y) (hL : ∀ᵐ ω ∂P, Z ω ∈ L)
    (hcomap : ∀ S : Set Y, MeasurableSet S →
      ∃ T : Set V, MeasurableSet T ∧ S ∩ L = e ⁻¹' T ∩ L)
    (hind : IndepFun (e ∘ Z) ξ P) : IndepFun Z ξ P := by
  rw [indepFun_iff_measure_inter_preimage_eq_mul]
  intro S S' hS hS'
  obtain ⟨T, hT, hST⟩ := hcomap S hS
  have hae : Z ⁻¹' S =ᵐ[P] (e ∘ Z) ⁻¹' T := by
    filter_upwards [hL] with ω hω
    have h := congrArg (fun A : Set Y => Z ω ∈ A) hST
    simp only [eq_iff_iff, mem_inter_iff, mem_preimage, hω, and_true] at h
    exact propext (by simpa [Function.comp] using h)
  have h1 : P (Z ⁻¹' S ∩ ξ ⁻¹' S') = P ((e ∘ Z) ⁻¹' T ∩ ξ ⁻¹' S') :=
    measure_congr (hae.inter (Filter.EventuallyEq.refl _ _))
  have h2 : P (Z ⁻¹' S) = P ((e ∘ Z) ⁻¹' T) := measure_congr hae
  rw [h1, h2]
  exact (indepFun_iff_measure_inter_preimage_eq_mul.1 hind) T S' hT hS'

end MatedCRT.FirstPass.Derived
