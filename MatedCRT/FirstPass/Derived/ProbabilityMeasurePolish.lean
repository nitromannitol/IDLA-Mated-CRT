import MatedCRT.FirstPass.Derived.PolishGdeltaEmbedding
import MatedCRT.FirstPass.Derived.ProbabilityMeasureEmbeddingHomeomorph
import MatedCRT.FirstPass.Derived.ProbabilityMeasureConcentrationGdelta
import LatticeProb.Topology.PolishContinuousMap
import MarkovProcess.Path.Basic

/-!
# Probability measures on a Polish space form a Polish space

For a Polish space `X` with its Borel `σ`-algebra, the space `ProbabilityMeasure X` of Borel
probability measures with the topology of convergence in distribution is Polish, and its
evaluation `σ`-algebra (generated by `μ ↦ μ A`) is its Borel `σ`-algebra.

Proof. Embed `X` topologically into a compact metric space `H` (the Hilbert cube). The range of
the embedding `i` is a `G_δ` set, so the probability measures on `H` concentrated on it form a
`G_δ` subset of the Polish space `ProbabilityMeasure H`, hence a Polish space. The push-forward
`μ ↦ i_* μ` is a homeomorphism of `ProbabilityMeasure X` onto it, measurable for the evaluation
`σ`-algebras; the Borel `σ`-algebra of `ProbabilityMeasure X` is therefore the pull-back of the
Borel (= evaluation) `σ`-algebra of `ProbabilityMeasure H`, which is contained in the evaluation
`σ`-algebra.

* `MatedCRT.polishSpace_probabilityMeasure_of_polish`,
  `MatedCRT.borelSpace_probabilityMeasure_of_polish`: the general statements.
* Instances for the space `ProbabilityMeasure (ContinuousPath ℂ)` of laws of continuous planar
  paths and for the space `C(ℂ, ProbabilityMeasure (ContinuousPath ℂ))` of continuous fields of
  path laws (compact-open topology, Borel `σ`-algebra `ContinuousMap.measurableSpace`).
-/

open MeasureTheory Topology
open MarkovProcess (ContinuousPath)

namespace MatedCRT

/-- If a Polish space `X` embeds topologically into a compact metric space `H`, then
`ProbabilityMeasure X` is Polish: it is homeomorphic to the `G_δ` set of probability measures on
`H` concentrated on the range of the embedding. -/
theorem polishSpace_probabilityMeasure_of_isEmbedding {X H : Type*} [TopologicalSpace X]
    [PolishSpace X] [MeasurableSpace X] [BorelSpace X] [hHm : MetricSpace H]
    [hHc : CompactSpace H] [MeasurableSpace H] [hHb : BorelSpace H] {i : X → H}
    (hi : IsEmbedding i) : PolishSpace (ProbabilityMeasure X) := by
  have hS : IsGδ {ν : ProbabilityMeasure H | (ν : Measure H) (Set.range i) = 1} :=
    isGδ_setOf_measure_eq_one (isGδ_range_of_isEmbedding hi)
  have : PolishSpace {ν : ProbabilityMeasure H // (ν : Measure H) (Set.range i) = 1} :=
    polishSpace_subtype_of_isGδ hS
  exact (probabilityMeasureRangeHomeomorph hi).isClosedEmbedding.polishSpace

/-- If a Polish space `X` embeds topologically into a compact metric space `H`, then the
evaluation `σ`-algebra of `ProbabilityMeasure X` is its Borel `σ`-algebra. -/
theorem borelSpace_probabilityMeasure_of_isEmbedding_compactSpace {X H : Type*}
    [TopologicalSpace X] [PolishSpace X] [MeasurableSpace X] [BorelSpace X] [hHm : MetricSpace H]
    [hHc : CompactSpace H] [MeasurableSpace H] [hHb : BorelSpace H] {i : X → H}
    (hi : IsEmbedding i) : BorelSpace (ProbabilityMeasure X) :=
  borelSpace_probabilityMeasure_of_isEmbedding
    (IsEmbedding.subtypeVal.comp (probabilityMeasureRangeHomeomorph hi).isEmbedding)
    (measurable_probabilityMeasureRangeHomeomorph hi)

/-- **The space of Borel probability measures on a Polish space is Polish** (topology of
convergence in distribution). -/
theorem polishSpace_probabilityMeasure_of_polish (X : Type*) [TopologicalSpace X] [PolishSpace X]
    [MeasurableSpace X] [BorelSpace X] : PolishSpace (ProbabilityMeasure X) := by
  obtain ⟨i, hi, -⟩ := exists_isEmbedding_hilbertCube_isGδ X
  exact polishSpace_probabilityMeasure_of_isEmbedding (H := ℕ → unitInterval)
    (hHm := TopologicalSpace.metrizableSpaceMetric _)
    (hHc := (inferInstance : CompactSpace (ℕ → unitInterval)))
    (hHb := (inferInstance : BorelSpace (ℕ → unitInterval))) hi

/-- **On a Polish space, the evaluation `σ`-algebra of the space of Borel probability measures is
its Borel `σ`-algebra** for the topology of convergence in distribution. -/
theorem borelSpace_probabilityMeasure_of_polish (X : Type*) [TopologicalSpace X] [PolishSpace X]
    [MeasurableSpace X] [BorelSpace X] : BorelSpace (ProbabilityMeasure X) := by
  obtain ⟨i, hi, -⟩ := exists_isEmbedding_hilbertCube_isGδ X
  exact borelSpace_probabilityMeasure_of_isEmbedding_compactSpace (H := ℕ → unitInterval)
    (hHm := TopologicalSpace.metrizableSpaceMetric _)
    (hHc := (inferInstance : CompactSpace (ℕ → unitInterval)))
    (hHb := (inferInstance : BorelSpace (ℕ → unitInterval))) hi

/-- The laws of continuous planar paths form a Polish space. -/
instance polishSpace_probabilityMeasure_continuousPath :
    PolishSpace (ProbabilityMeasure (ContinuousPath ℂ)) :=
  have : PolishSpace (ContinuousPath ℂ) := LatticeProb.polishSpace_continuousMap NNReal ℂ
  polishSpace_probabilityMeasure_of_polish (ContinuousPath ℂ)

/-- The evaluation `σ`-algebra on the laws of continuous planar paths is the Borel `σ`-algebra. -/
instance borelSpace_probabilityMeasure_continuousPath :
    BorelSpace (ProbabilityMeasure (ContinuousPath ℂ)) :=
  have : PolishSpace (ContinuousPath ℂ) := LatticeProb.polishSpace_continuousMap NNReal ℂ
  borelSpace_probabilityMeasure_of_polish (ContinuousPath ℂ)

/-- The continuous fields `ℂ → ProbabilityMeasure (ContinuousPath ℂ)` of path laws form a Polish
space (compact-open topology). -/
instance polishSpace_continuousMap_probabilityMeasure_continuousPath :
    PolishSpace C(ℂ, ProbabilityMeasure (ContinuousPath ℂ)) :=
  LatticeProb.polishSpace_continuousMap ℂ (ProbabilityMeasure (ContinuousPath ℂ))

/-- The `σ`-algebra `ContinuousMap.measurableSpace` on the continuous fields of path laws is the
Borel `σ`-algebra of the compact-open topology. -/
instance borelSpace_continuousMap_probabilityMeasure_continuousPath :
    @BorelSpace C(ℂ, ProbabilityMeasure (ContinuousPath ℂ)) _ ContinuousMap.measurableSpace :=
  inferInstance

end MatedCRT
