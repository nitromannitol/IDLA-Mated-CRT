import MatedCRT.FirstPass.Derived.ConeAnnulusAreaLawEquivalenceOuterStop
import LatticeProb.Prob.CameronMartinEquivalence
import LatticeProb.Prob.CauchyPointPolar

/-!
# Cameron–Martin on a bounded time interval

For a Brownian motion `b` with continuous paths and a time `N`, the laws on `C(ℝ≥0, ℝ)` of the paths
`t ↦ b_{min(t,N)} + v₁ min(t,N)` and `t ↦ b_{min(t,N)} + v₂ min(t,N)` (the stopped paths with drifts
`v₁` and `v₂` up to time `N`) are equivalent (`map_driftStop_absolutelyContinuous`).

Proof. The stopped process `X_t = b_{min(t,N)}` is a centred Gaussian process with
`cov[X_j, X_N] = min(j, N)`, so the Cameron–Martin shift of the direction `(v₁ - v₂) δ_N` is
`j ↦ (v₁ - v₂) min(j, N)` (`LatticeProb.gaussian_map_shift_absolutelyContinuous`); adding the
deterministic drift `v₂ min(t, N)` is a measurable map. Laws on `C(ℝ≥0, ℝ)` are compared through the
coordinate map to `ℝ≥0 → ℝ`, since the Borel σ-algebra of `C(ℝ≥0, ℝ)` is generated by it.

Source: Cameron–Martin (Bogachev, *Gaussian Measures*, AMS 1998, Chapter 2).
-/

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal NNReal

namespace MatedCRT

open LatticeProb

/-- Absolute continuity of two laws on `C(ℝ≥0, ℝ)` follows from that of their images under the
coordinate map. -/
theorem absolutelyContinuous_of_map_coe {μ ν : Measure C(ℝ≥0, ℝ)}
    (h : μ.map (fun (w : C(ℝ≥0, ℝ)) (t : ℝ≥0) => w t) ≪
      ν.map (fun (w : C(ℝ≥0, ℝ)) (t : ℝ≥0) => w t)) : μ ≪ ν := by
  refine Measure.AbsolutelyContinuous.mk fun s hs hνs => ?_
  obtain ⟨Γ, hΓ, rfl⟩ := exists_measurableSet_coe_preimage hs
  rw [← Measure.map_apply measurable_coeFn_continuousMap hΓ] at hνs ⊢
  exact h hνs

/-- **Cameron–Martin on `[0, N]`.** The laws of the Brownian path stopped at `N` with the drifts
`v₁` and `v₂` up to `N` are absolutely continuous. -/
theorem map_driftStop_absolutelyContinuous {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] {b : ℝ≥0 → Ω → ℝ} (hb : IsBrownianReal b P)
    (hm : ∀ t, Measurable (b t)) (hc : ∀ ω, Continuous fun t => b t ω) (v₁ v₂ : ℝ) (N : ℝ≥0) :
    P.map (fun ω => driftStop v₁ N (stopAt (N : ℝ≥0∞) (pathMap b hc ω))) ≪
      P.map (fun ω => driftStop v₂ N (stopAt (N : ℝ≥0∞) (pathMap b hc ω))) := by
  apply absolutelyContinuous_of_map_coe
  set X : ℝ≥0 → Ω → ℝ := fun t ω => b (min t N) ω with hXdef
  have hX : IsGaussianProcess X P :=
    hb.toIsPreBrownianReal.isGaussianProcess.comp_right (fun t => min t N)
  have hXm : ∀ t, Measurable (X t) := fun t => hm _
  have hXc : ∀ t, P[X t] = 0 := fun t => hb.toIsPreBrownianReal.integral_eval _
  set σ : ℝ≥0 →₀ ℝ := Finsupp.single N (v₁ - v₂) with hσ
  have hshift : ∀ j : ℝ≥0,
      QuantumZipper.CameronMartin.covShift X P σ j = (v₁ - v₂) * min (j : ℝ) N := by
    intro j
    by_cases ha : v₁ - v₂ = 0
    · simp [hσ, ha, QuantumZipper.CameronMartin.covShift]
    · rw [QuantumZipper.CameronMartin.covShift, hσ, Finsupp.support_single N ha,
        Finset.sum_singleton, Finsupp.single_eq_same]
      congr 1
      have h := hb.toIsPreBrownianReal.covariance_eval (min j N) (min N N)
      have e : min (min j N) (min N N) = min j N := by
        rw [min_self]
        exact min_eq_left (min_le_right j N)
      rw [e] at h
      unfold QuantumZipper.CameronMartin.covK
      rw [show X j = b (min j N) from rfl, show X N = b (min N N) by simp [hXdef], h]
      simp [NNReal.coe_min]
  have hCM := (gaussian_map_shift_absolutelyContinuous hX hXm hXc σ).1
  have hT : Measurable fun (y : ℝ≥0 → ℝ) (j : ℝ≥0) => y j + v₂ * min (j : ℝ) N :=
    measurable_pi_iff.2 fun j => (measurable_pi_apply j).add_const _
  have hf1 : Measurable fun (ω : Ω) (j : ℝ≥0) =>
      X j ω + QuantumZipper.CameronMartin.covShift X P σ j :=
    measurable_pi_iff.2 fun j => (hXm j).add_const _
  have hf2 : Measurable fun (ω : Ω) (j : ℝ≥0) => X j ω :=
    measurable_pi_iff.2 fun j => hXm j
  have hAC := map_absolutelyContinuous_of_absolutelyContinuous hCM hT
  rw [Measure.map_map hT hf1, Measure.map_map hT hf2] at hAC
  have hZm : ∀ v : ℝ, Measurable fun ω => driftStop v N (stopAt (N : ℝ≥0∞) (pathMap b hc ω)) :=
    fun v => (measurable_driftStop v N).comp (measurable_stopAt_pathMap_const hm hc N)
  rw [Measure.map_map measurable_coeFn_continuousMap (hZm v₁),
    Measure.map_map measurable_coeFn_continuousMap (hZm v₂)]
  have e1 : ((fun (w : C(ℝ≥0, ℝ)) (t : ℝ≥0) => w t) ∘
      fun ω => driftStop v₁ N (stopAt (N : ℝ≥0∞) (pathMap b hc ω))) =
      (fun (y : ℝ≥0 → ℝ) (j : ℝ≥0) => y j + v₂ * min (j : ℝ) N) ∘
        fun (ω : Ω) (j : ℝ≥0) => X j ω + QuantumZipper.CameronMartin.covShift X P σ j := by
    funext ω t
    simp only [Function.comp_apply, driftStop, stopAt_coe, hshift]
    simp only [ContinuousMap.coe_mk, pathMap_apply, hXdef]
    ring
  have e2 : ((fun (w : C(ℝ≥0, ℝ)) (t : ℝ≥0) => w t) ∘
      fun ω => driftStop v₂ N (stopAt (N : ℝ≥0∞) (pathMap b hc ω))) =
      (fun (y : ℝ≥0 → ℝ) (j : ℝ≥0) => y j + v₂ * min (j : ℝ) N) ∘
        fun (ω : Ω) (j : ℝ≥0) => X j ω := by
    funext ω t
    simp only [Function.comp_apply, driftStop, stopAt_coe, ContinuousMap.coe_mk, pathMap_apply,
      hXdef]
  rw [e1, e2]
  exact hAC

end MatedCRT
