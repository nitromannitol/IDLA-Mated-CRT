import MatedCRT.FirstPass.Derived.ConeAreaCurveCode
import MatedCRT.FirstPass.Derived.ConeBoundaryLengthScale
import MatedCRT.Proofs.Field.WholePlaneExistence
import LatticeProb.LQG.RadialUniform
import LatticeProb.LQG.MatingOfTreesCouplingBoundaryLength

/-!
# The radial uniform variable of the mating-of-trees coupling of the environment

Let `V` be the data of a mating-of-trees coupling tied to a valid environment `S`: the whole-plane
GFF `X`, the radial Brownian motions `B, B'` of the `γ`-quantum cone `h = coneField X (coneRadial γ γ B B')`,
the imaginary-geometry field `h^IG + U`, the curve `η` (parametrized by `μ_h`-area) and the
boundary-length pair `β`, with `η` the curve of `S` and `h` the field of `S`.

The cone field uses only the lateral part of `X`: its radial part is replaced by the process built
from `B, B'` (Duplantier-Miller-Sheffield, Definition 4.10). The pairing of `X` with a radial test
function therefore gives a uniform variable `Z = radialUniform X` (the normal distribution function
applied to the pairing, `LatticeProb.LQG.radialUniform`) which is independent of the lateral part of
`X` and of everything independent of `X` (DMS Lemma 4.9: radial-lateral orthogonality).

Main result (`MatedCRTEnv.IsValid.indepFun_radialUniform_coneData`): `Z` is independent of the
quadruple `(lateral part of X, (B, B'), η, β)`. The curve is a Borel function of the cone field and
of the imaginary-geometry field (`coneCurveCode` and the `igMap` clause), and `β` is a Borel function
of the cone field and the curve (the boundary-length functional); the cone field in turn is a Borel
function of the lateral part of `X` and `(B, B')` on the full-measure set `radGood`. Continuous-path
valued coordinates are handled through `ContinuousMap.measurable_iff_eval`: the σ-algebra of a random
continuous path is the one generated by its evaluations.

`Z` is the extra uniform randomness of the same-space lift (`ProbabilityTheory.exists_map_eq_and_ae_comp_eq`)
that realizes the coupling data of the rescaled environment on the sample space of the environment.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace MatedCRT

section Comap

variable {Ω β γ γ' : Type*} [MeasurableSpace Ω] [MeasurableSpace β] [mγ : MeasurableSpace γ]
  [MeasurableSpace γ'] {μ : Measure Ω}

/-- Independence passes to a random element which is measurable with respect to the σ-algebra
generated by the other one. -/
theorem indepFun_of_measurable_comap {f : Ω → β} {g : Ω → γ} {g' : Ω → γ'} (h : IndepFun f g μ)
    (hg' : Measurable[MeasurableSpace.comap g mγ] g') : IndepFun f g' μ := by
  rw [IndepFun_iff_Indep] at h ⊢
  exact indep_of_indep_of_le_right h (measurable_iff_comap_le.1 hg')

end Comap

/-- A map into `C(ℝ≥0, ℝ)` is measurable, for any σ-algebra on the source, when all its
evaluations are. -/
theorem measurable_continuousMap_nnreal_of_eval {Z : Type*} {m : MeasurableSpace Z}
    {g : Z → C(ℝ≥0, ℝ)} (h : ∀ x, Measurable[m] fun a => g a x) : Measurable[m] g :=
  ContinuousMap.measurable_iff_eval.2 h

/-- A map into `C(ℝ, ℂ)` is measurable, for any σ-algebra on the source, when all its evaluations
are. -/
theorem measurable_continuousMap_real_of_eval {Z : Type*} {m : MeasurableSpace Z}
    {g : Z → C(ℝ, ℂ)} (h : ∀ x, Measurable[m] fun a => g a x) : Measurable[m] g :=
  ContinuousMap.measurable_iff_eval.2 h

/-- The cone field read off the lateral part and the pair of radial Brownian paths
(`ConeScaling.fieldOf` of the lateral part and of `ConeScaling.radMap`). -/
noncomputable def coneFieldOfLateral (γ : ℝ) (p : LQGMetric.DistC × (C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ))) :
    LQGMetric.DistC :=
  MatedCRTHarmonic.ConeScaling.fieldOf p.1 (MatedCRTHarmonic.ConeScaling.radMap γ γ p.2)

theorem measurable_coneFieldOfLateral (γ : ℝ) : Measurable (coneFieldOfLateral γ) :=
  MatedCRTHarmonic.ConeScaling.measurable_fieldOf.comp
    (measurable_fst.prodMk ((MatedCRTHarmonic.ConeScaling.measurable_radMap γ γ).comp measurable_snd))

/-- The pairings of a field with the test functions on `ℂ`, as an element of the code space. -/
noncomputable def pairingCodeOf (F : LQGMetric.DistC) : FieldPairingCode := fun φ => F (MatedCRT.Field.toTestC φ.2)

theorem measurable_pairingCodeOf : Measurable pairingCodeOf :=
  measurable_pi_iff.mpr fun φ => LQGMetric.measurable_evalDist (MatedCRT.Field.toTestC φ.2)

/-- The circle-average process `(ρ, w) ↦ h^IG_ρ(w) + U` of the imaginary-geometry field. -/
noncomputable def igCircleAvgOf (p : LQGMetric.DistC × ℝ) : ℝ → ℂ → ℝ :=
  fun ρ w => LQGMetric.circleAvg p.1 ρ w + p.2

theorem measurable_igCircleAvgOf : Measurable igCircleAvgOf :=
  measurable_pi_iff.mpr fun ρ => measurable_pi_iff.mpr fun w =>
    ((LQGMetric.measurable_circleAvg_left ρ w).comp measurable_fst).add measurable_snd

/-- The area-parametrized curve decoded from the lateral part of the GFF, the radial Brownian paths
and the imaginary-geometry field, for the imaginary-geometry map `Φ`. -/
noncomputable def coneCurveDecoder (γ : ℝ) (Φ : (ℝ → ℂ → ℝ) → C(ℝ, ℂ))
    (t : LQGMetric.DistC × (C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ)) × (LQGMetric.DistC × ℝ)) : ℝ → ℂ :=
  coneCurveCode γ (pairingCodeOf (coneFieldOfLateral γ (t.1, t.2.1)), Φ (igCircleAvgOf t.2.2))

theorem measurable_coneCurveDecoder (γ : ℝ) {Φ : (ℝ → ℂ → ℝ) → C(ℝ, ℂ)} (hΦ : Measurable Φ) :
    Measurable (coneCurveDecoder γ Φ) :=
  measurable_pi_iff.mpr fun s => (measurable_coneCurveCode γ s).comp
    ((measurable_pairingCodeOf.comp ((measurable_coneFieldOfLateral γ).comp
      (measurable_fst.prodMk (measurable_fst.comp measurable_snd)))).prodMk
      (hΦ.comp (measurable_igCircleAvgOf.comp (measurable_snd.comp measurable_snd))))

/-- **The radial uniform variable is independent of the cone data.** For the data `V` of a
mating-of-trees coupling tied to a valid environment (the curve of `V` is the curve of `S` and the
pairings of the cone field of `V` are those of the field of `S`), the uniform variable
`radialUniform X` of the whole-plane GFF `X` is independent of the lateral part of `X`, the radial
Brownian paths `(B, B')`, the curve `η` and the boundary-length pair `β`. -/
theorem MatedCRTEnv.IsValid.indepFun_radialUniform_coneData {Ω : Type} [MeasurableSpace Ω]
    {S : MatedCRTEnv Ω} {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) (hγ : 0 < γ)
    (hγ2 : γ < 2) {V : Ω → MatedCRTHarmonic.MatedCRT.CouplingData} (hV : Measurable V)
    (hC : MatedCRTHarmonic.MatedCRT.IsCouplingData γ S.P V)
    (htie : ∀ᵐ ω ∂S.P, ⇑(V ω).η = S.η ω ∧ ∀ φ : LQGMetric.TestC,
      S.hC ω ⇑φ = MatedCRTHarmonic.MatedCRT.coneField (V ω).X
        (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (V ω).B (V ω).B') φ) :
    IndepFun (fun ω => LatticeProb.LQG.radialUniform (V ω).X)
      (fun ω => (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'), (V ω).η,
        (V ω).bm)) S.P := by
  have hCP := (show MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling _ _ _ _ _ _ _ _ _ _ _ _ _ _
    from hC)
  have := hCP.isProbabilityMeasure
  have hXm : Measurable fun ω => (V ω).X :=
    MatedCRTHarmonic.MatedCRT.CouplingData.measurable_X.comp hV
  have hBm : Measurable fun ω => ((V ω).B, (V ω).B') :=
    (MatedCRTHarmonic.MatedCRT.CouplingData.measurable_B.comp hV).prodMk
      (MatedCRTHarmonic.MatedCRT.CouplingData.measurable_B'.comp hV)
  have hIGm : Measurable fun ω => ((V ω).hIG, (V ω).U) :=
    (MatedCRTHarmonic.MatedCRT.CouplingData.measurable_hIG.comp hV).prodMk
      (MatedCRTHarmonic.MatedCRT.CouplingData.measurable_U.comp hV)
  -- `X ⊥ (B, B')` with continuous-path valued Brownian motions
  have h1 : IndepFun (fun ω => (V ω).X) (fun ω => ((V ω).B, (V ω).B')) S.P := by
    refine indepFun_of_measurable_comap hCP.indep_cone.1 ?_
    have hc := comap_measurable (m := (inferInstance : MeasurableSpace ((ℝ≥0 → ℝ) × (ℝ≥0 → ℝ))))
      (fun ω => ((fun t => (V ω).B t), (fun t => (V ω).B' t)))
    exact (measurable_continuousMap_nnreal_of_eval fun t =>
        (measurable_pi_apply t).comp (measurable_fst.comp hc)).prodMk
      (measurable_continuousMap_nnreal_of_eval fun t =>
        (measurable_pi_apply t).comp (measurable_snd.comp hc))
  -- `(X, (B, B')) ⊥ (h^IG, U)`
  have h2 : IndepFun (fun ω => ((V ω).X, ((V ω).B, (V ω).B'))) (fun ω => ((V ω).hIG, (V ω).U))
      S.P := by
    refine (indepFun_of_measurable_comap hCP.indep_curve ?_).symm
    have hc := comap_measurable (m := (inferInstance : MeasurableSpace (LQGMetric.DistC ×
        (ℝ≥0 → ℝ) × (ℝ≥0 → ℝ) × LQGMetric.DistC × (ℝ≥0 → ℝ) × (ℝ≥0 → ℝ))))
      (fun ω => ((V ω).X, (fun t => (V ω).B t), (fun t => (V ω).B' t), (V ω).X₀,
        (fun t => (V ω).B₀ t), (fun t => (V ω).B₀' t)))
    exact (measurable_fst.comp hc).prodMk
      ((measurable_continuousMap_nnreal_of_eval fun t =>
        (measurable_pi_apply t).comp (measurable_fst.comp (measurable_snd.comp hc))).prodMk
      (measurable_continuousMap_nnreal_of_eval fun t =>
        (measurable_pi_apply t).comp
          (measurable_fst.comp (measurable_snd.comp (measurable_snd.comp hc)))))
  have hXW : IndepFun (fun ω => (V ω).X) (fun ω => (((V ω).B, (V ω).B'), ((V ω).hIG, (V ω).U)))
      S.P := LatticeProb.LQG.indepFun_prodMk_right_of_indepFun_prodMk hXm hBm hIGm h1 h2
  -- `Z ⊥ T`, `T = (lateral part, (B, B'), (h^IG, U))`
  have hZT := LatticeProb.LQG.IsWholePlaneGFF.indepFun_radialUniform_lateralPart_prodMk hCP.gff
    (hBm.prodMk hIGm) hXW
  -- the curve is decoded from `T`
  obtain ⟨Φ, hΦ, -, hΦae, -⟩ := hCP.igMap
  have hΦae' : ∀ᵐ ω ∂S.P, (V ω).ηL = Φ (igCircleAvgOf ((V ω).hIG, (V ω).U)) := hΦae
  have hcode : ∀ᵐ ω ∂S.P, ∀ t, coneCurveCode γ (fieldPairingCode S ω, (V ω).ηL) t = S.η ω t := by
    refine hS.ae_coneCurveCode_eq (fun ω => (V ω).ηL) ?_
    filter_upwards [hCP.areaParam, htie] with ω hap hω
    obtain ⟨⟨φ, hφ0, hφ⟩, -⟩ := hap
    exact ⟨φ, hφ0, fun t => by rw [← hω.1]; exact hφ t⟩
  have hrad := MatedCRTHarmonic.MatedCRT.IsCouplingData.ae_radGood hC hγ hγ2
  have hdec : ∀ᵐ ω ∂S.P, ⇑(V ω).η = coneCurveDecoder γ Φ
      (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'), ((V ω).hIG, (V ω).U)) := by
    filter_upwards [hcode, hrad, htie, hΦae'] with ω hc hr ht hΦω
    funext s
    have hpc : fieldPairingCode S ω = pairingCodeOf (coneFieldOfLateral γ
        (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'))) :=
      funext fun φ => (ht.2 (MatedCRT.Field.toTestC φ.2)).trans
        (congrArg (fun F : LQGMetric.DistC => F (MatedCRT.Field.toTestC φ.2))
          (MatedCRTHarmonic.MatedCRT.CouplingData.coneTriple_fst_of_mem hr).symm)
    rw [ht.1, ← hc s, hpc, hΦω]
    rfl
  -- `Z ⊥ (lateral part, (B, B'), ⇑η)`
  have hG₀ : Measurable fun t : LQGMetric.DistC × (C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ)) × (LQGMetric.DistC × ℝ) =>
      (t.1, t.2.1, coneCurveDecoder γ Φ t) :=
    measurable_fst.prodMk ((measurable_fst.comp measurable_snd).prodMk
      (measurable_coneCurveDecoder γ hΦ))
  have hZY₀ : IndepFun (fun ω => LatticeProb.LQG.radialUniform (V ω).X)
      (fun ω => (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'),
        (⇑(V ω).η : ℝ → ℂ))) S.P :=
    (hZT.comp measurable_id hG₀).congr (Filter.Eventually.of_forall fun _ => rfl)
      (hdec.mono fun ω h => by
        show (_, _, _) = (_, _, ⇑(V ω).η)
        rw [h])
  -- `Z ⊥ (lateral part, (B, B'), η)` with the continuous curve
  have hZY₁ : IndepFun (fun ω => LatticeProb.LQG.radialUniform (V ω).X)
      (fun ω => (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'), (V ω).η))
      S.P := by
    refine indepFun_of_measurable_comap hZY₀ ?_
    have hc := comap_measurable (m := (inferInstance : MeasurableSpace (LQGMetric.DistC ×
        (C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ)) × (ℝ → ℂ))))
      (fun ω => (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'),
        (⇑(V ω).η : ℝ → ℂ)))
    exact (measurable_fst.comp hc).prodMk ((measurable_fst.comp (measurable_snd.comp hc)).prodMk
      (measurable_continuousMap_real_of_eval fun s =>
        (measurable_pi_apply s).comp (measurable_snd.comp (measurable_snd.comp hc))))
  -- the boundary-length pair is a Borel function of the cone field and the curve
  obtain ⟨BL, hBL, hbm, -⟩ := MatedCRT.Sec1.exists_boundaryLength_rescaledPair hCP
  have hbm' : ∀ᵐ ω ∂S.P, (V ω).bm = BL (MatedCRTHarmonic.MatedCRT.coneField (V ω).X
      (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (V ω).B (V ω).B'), (V ω).η) := hbm
  have hH : Measurable fun y : LQGMetric.DistC × (C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ)) × C(ℝ, ℂ) =>
      (y.1, y.2.1, y.2.2, BL (coneFieldOfLateral γ (y.1, y.2.1), y.2.2)) :=
    measurable_fst.prodMk ((measurable_fst.comp measurable_snd).prodMk
      ((measurable_snd.comp measurable_snd).prodMk (hBL.comp
        (((measurable_coneFieldOfLateral γ).comp (measurable_fst.prodMk
          (measurable_fst.comp measurable_snd))).prodMk (measurable_snd.comp measurable_snd)))))
  refine (hZY₁.comp measurable_id hH).congr (Filter.Eventually.of_forall fun _ => rfl) ?_
  filter_upwards [hbm', hrad] with ω h hr
  show (_, _, _, _) = (_, _, _, (V ω).bm)
  rw [h, ← MatedCRTHarmonic.MatedCRT.CouplingData.coneTriple_fst_of_mem hr]
  rfl

/-- **The radial uniform variable of the environment's coupling.** `radialUniform X` is a measurable
uniform variable on `[0, 1]`, independent of the lateral part of `X`, the radial Brownian paths, the
curve and the boundary-length pair. -/
theorem MatedCRTEnv.IsValid.radialUniform_coneData {Ω : Type} [MeasurableSpace Ω]
    {S : MatedCRTEnv Ω} {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) (hγ : 0 < γ)
    (hγ2 : γ < 2) {V : Ω → MatedCRTHarmonic.MatedCRT.CouplingData} (hV : Measurable V)
    (hC : MatedCRTHarmonic.MatedCRT.IsCouplingData γ S.P V)
    (htie : ∀ᵐ ω ∂S.P, ⇑(V ω).η = S.η ω ∧ ∀ φ : LQGMetric.TestC,
      S.hC ω ⇑φ = MatedCRTHarmonic.MatedCRT.coneField (V ω).X
        (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (V ω).B (V ω).B') φ) :
    Measurable (fun ω => LatticeProb.LQG.radialUniform (V ω).X) ∧
      S.P.map (fun ω => LatticeProb.LQG.radialUniform (V ω).X) = volume ∧
      IndepFun (fun ω => LatticeProb.LQG.radialUniform (V ω).X)
        (fun ω => (MatedCRTHarmonic.CellScaling.lateralPart (V ω).X, ((V ω).B, (V ω).B'), (V ω).η,
          (V ω).bm)) S.P := by
  have hCP := (show MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling _ _ _ _ _ _ _ _ _ _ _ _ _ _
    from hC)
  exact ⟨LatticeProb.LQG.measurable_radialUniform.comp
      (MatedCRTHarmonic.MatedCRT.CouplingData.measurable_X.comp hV),
    LatticeProb.LQG.IsWholePlaneGFF.map_radialUniform hCP.gff,
    hS.indepFun_radialUniform_coneData hγ hγ2 hV hC htie⟩

end MatedCRT
