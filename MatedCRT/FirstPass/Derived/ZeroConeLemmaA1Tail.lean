import MatedCRT.FirstPass.Derived.ZeroConeTailOfLemmaA1
import LatticeProb.Prob.TrivialSigma
import LatticeProb.Prob.CellConfigDiamSqDegreeSum
import LatticeProb.Bonanno.LQGMetric.Blueprint.M2Defs
import LatticeProb.Bonanno.LQGMetric.Papers.GM.S2.SpatialIndepCirc

/-!
# The exterior tail of the circle-average zero cone

For the proof of Lemma A.1 of Gwynne–Miller–Sheffield (arXiv:1705.11161, Appendix A; written answer 58, section 1:
the instance of their Lemma A.3 used there), this file sets up the exterior σ-algebras `extSigma k` of a field (the
σ-algebra of its restriction to `{|w| > k}`) and the named statement `WholePlaneGFFExteriorTailTrivial` (the tail at
infinity of the whole-plane GFF modulo additive constants is trivial: Miller–Sheffield, Imaginary geometry IV,
arXiv:1302.4738, §2.2.1, (2.7)), and proves:

* `exists_const_of_forall_extVersion`: if the exterior tail is trivial for a law `μ` and a function `F` has, for every
  `k`, a version measurable with respect to `extSigma (k + 1)`, then `F` is `μ`-almost surely constant.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set Metric
open scoped ENNReal NNReal

namespace MatedCRT

open MatedCRTHarmonic MatedCRTHarmonic.MatedCRT

/-- The open exterior `{w : |w| > k}` of the closed disc of radius `k`. -/
def extOpen (k : ℝ) : TopologicalSpace.Opens ℂ :=
  ⟨{w : ℂ | k < ‖w‖}, isOpen_lt continuous_const continuous_norm⟩

/-- The exterior σ-algebra on fields: the σ-algebra generated by the restriction to `{|w| > k}`. -/
abbrev extSigma (k : ℝ) : MeasurableSpace Field :=
  LQGMetric.Blueprint.fieldSigma (fun h : Field => h) (extOpen k)

theorem extOpen_anti {k k' : ℝ} (hkk' : k ≤ k') : extOpen k' ≤ extOpen k := fun _ hw =>
  lt_of_le_of_lt hkk' hw

theorem extSigma_anti {k k' : ℝ} (hkk' : k ≤ k') : extSigma k' ≤ extSigma k :=
  LQGMetric.GM.fieldSigma_mono _ (extOpen_anti hkk')

theorem extSigma_le (k : ℝ) : extSigma k ≤ (inferInstance : MeasurableSpace Field) :=
  (LQGMetric.measurable_restrictTo (extOpen k)).comap_le

theorem antitone_extSigma_succ : Antitone fun k : ℕ => extSigma ((k : ℝ) + 1) := fun _ _ hkk' =>
  extSigma_anti (by exact_mod_cast Nat.add_le_add_right hkk' 1)

/-- **Tail triviality at infinity of the whole-plane GFF modulo constants** (Miller–Sheffield, Imaginary geometry IV,
arXiv:1302.4738, §2.2.1, (2.7)): for a whole-plane GFF `X`, the σ-algebra generated by the pairings of `X` with the
mean-zero test functions supported in `{|w| > k}`, intersected over `k`, is trivial. -/
def WholePlaneGFFExteriorTailTrivial : Prop :=
  ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) (X : Ω → LQGMetric.DistC),
    IsProbabilityMeasure P → LQGMetric.IsWholePlaneGFF X P →
      LatticeProb.IsTrivialSigma (⨅ k : ℕ, LQGMetric.Blueprint.fieldSigma0On X {w : ℂ | (k : ℝ) < ‖w‖}) P

/-- **Tail triviality along almost-everywhere inclusions**: if every set of `𝒞 k` is almost everywhere equal to a set
of `𝒟 k`, the `𝒟 k` decrease and their intersection is trivial, then the intersection of the `𝒞 k` is trivial. -/
theorem isTrivialSigma_iInf_of_ae_le {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {𝒞 𝒟 : ℕ → MeasurableSpace Ω} (hanti : Antitone 𝒟)
    (hle : ∀ k s, MeasurableSet[𝒞 k] s → ∃ t, MeasurableSet[𝒟 k] t ∧ s =ᵐ[P] t)
    (htriv : LatticeProb.IsTrivialSigma (⨅ k, 𝒟 k) P) : LatticeProb.IsTrivialSigma (⨅ k, 𝒞 k) P := by
  intro s hs
  have hver : ∀ k, ∃ g : Ω → ℝ, StronglyMeasurable[𝒟 k] g ∧ s.indicator (fun _ => (1 : ℝ)) =ᵐ[P] g := by
    intro k
    obtain ⟨t, ht, hst⟩ := hle k s (iInf_le 𝒞 k s hs)
    refine ⟨t.indicator fun _ => (1 : ℝ), stronglyMeasurable_const.indicator ht, ?_⟩
    filter_upwards [hst] with ω hω
    have hiff : ω ∈ s ↔ ω ∈ t := Iff.of_eq hω
    by_cases hωt : ω ∈ t
    · rw [Set.indicator_of_mem hωt, Set.indicator_of_mem (hiff.2 hωt)]
    · rw [Set.indicator_of_notMem hωt, Set.indicator_of_notMem (fun h => hωt (hiff.1 h))]
  obtain ⟨g, hgm, hg⟩ := LatticeProb.exists_iInf_version (P := P) hanti hver
  have hT : MeasurableSet[⨅ k, 𝒟 k] {ω | (1 / 2 : ℝ) < g ω} := hgm measurableSet_Ioi
  have hseq : s =ᵐ[P] {ω | (1 / 2 : ℝ) < g ω} := by
    filter_upwards [hg] with ω hω
    show (ω ∈ s) = ((1 / 2 : ℝ) < g ω)
    by_cases hωs : ω ∈ s
    · rw [Set.indicator_of_mem hωs] at hω
      rw [← hω]
      exact propext ⟨fun _ => by norm_num, fun _ => hωs⟩
    · rw [Set.indicator_of_notMem hωs] at hω
      rw [← hω]
      exact propext ⟨fun h => absurd h hωs, fun h => by norm_num at h⟩
  rw [measure_congr hseq]
  exact htriv _ hT

/-- **Triviality transfers to the image law**: if the pullback of a sub-σ-algebra `m` along an almost everywhere
measurable map `Z` is trivial for `P`, then `m` is trivial for the image law `P.map Z`. -/
theorem isTrivialSigma_map_of_comap {Ω β : Type*} [MeasurableSpace Ω] {m : MeasurableSpace β}
    [mβ : MeasurableSpace β] {P : Measure Ω} {Z : Ω → β} (hZ : AEMeasurable Z P) (hm : m ≤ mβ)
    (h : LatticeProb.IsTrivialSigma (m.comap Z) P) : LatticeProb.IsTrivialSigma m (P.map Z) := by
  intro s hs
  rw [Measure.map_apply_of_aemeasurable hZ (hm s hs)]
  exact h _ ⟨s, hs, rfl⟩

/-- **Functions with exterior versions are constant under a trivial exterior tail.** -/
theorem exists_const_of_forall_extVersion {μ : Measure Field} [IsProbabilityMeasure μ]
    (htail : LatticeProb.IsTrivialSigma (⨅ k : ℕ, extSigma ((k : ℝ) + 1)) μ) {F : Field → ℝ}
    (hF : ∀ k : ℕ, ∃ g : Field → ℝ, StronglyMeasurable[extSigma ((k : ℝ) + 1)] g ∧ F =ᵐ[μ] g) :
    ∃ c : ℝ, F =ᵐ[μ] fun _ => c := by
  obtain ⟨g, hgm, hFg⟩ := LatticeProb.exists_iInf_version (P := μ) antitone_extSigma_succ hF
  have hle : (⨅ k : ℕ, extSigma ((k : ℝ) + 1)) ≤ (inferInstance : MeasurableSpace Field) :=
    (iInf_le _ 0).trans (extSigma_le _)
  obtain ⟨c, hc⟩ := LatticeProb.CellConfigCappedSquare.exists_ae_eq_const_of_measure_le_zero_or_one
    (hgm.mono hle le_rfl) fun r => htail _ (hgm measurableSet_Iic)
  exact ⟨c, hFg.trans hc⟩

end MatedCRT
