import Mathlib

/-!
# Normalization by the diameter on `[0, 1]`, and approximation by functions of a curve window

Two measure-theoretic facts about the space `C(ℝ, ℂ)` of continuous curves with its Borel σ-algebra of the
compact-open topology, which is generated by the evaluations `x ↦ x t`
(`ContinuousMap.borel_eq_iSup_comap_eval`).

* `curveScale x` is the largest distance between two points of `x([0, 1])`, and `curveNormalize x = (curveScale x)⁻¹ • x`
  is the curve divided by it (the zero curve when `curveScale x = 0`). Both are Borel measurable
  (`measurable_curveScale`, `measurable_curveNormalize`), `curveScale (c • x) = c * curveScale x` for `c ≥ 0`, and
  `curveNormalize (c • x) = curveNormalize x` for `c > 0` (`curveNormalize_smul`).
* `curveWindow L x` is the restriction of `x` to `[-L, L]`, a point of the product space `Icc (-L) L → ℂ`
  (`measurable_curveWindow`). For a finite measure `ν` on `C(ℝ, ℂ) × ℝ` and a bounded measurable `W`, the function `W`
  is approximated in `L¹(ν)` by bounded measurable functions of `(curveWindow L x.1, x.2)`
  (`exists_window_approx`). The proof applies the `L¹` martingale convergence theorem
  (`MeasureTheory.Integrable.tendsto_eLpNorm_condExp`) to the increasing σ-algebras generated by the windows
  `(curveWindow n x.1, x.2)`, whose supremum is the product σ-algebra, and then the Doob–Dynkin factorization
  (`MeasureTheory.StronglyMeasurable.exists_eq_measurable_comp`) of each conditional expectation.
-/

set_option autoImplicit false

open MeasureTheory MeasurableSpace Set Filter Topology TopologicalSpace
open scoped ENNReal NNReal

namespace MatedCRT.ZeroConePolygonal

/-- The pairs of parameters in `[0, 1]`. -/
abbrev UnitSquarePair : Type := Icc (0 : ℝ) 1 × Icc (0 : ℝ) 1

/-- The scale of a curve: the largest distance `⨆ ‖x s - x t‖` between two points of `x([0, 1])`. -/
noncomputable def curveScale (x : C(ℝ, ℂ)) : ℝ :=
  ⨆ p : UnitSquarePair, ‖x p.1 - x p.2‖

/-- The curve divided by its scale `curveScale x`; it is the zero curve when `curveScale x = 0`. -/
noncomputable def curveNormalize (x : C(ℝ, ℂ)) : C(ℝ, ℂ) :=
  (curveScale x)⁻¹ • x

/-- The distances `‖x s - x t‖`, `s, t ∈ [0, 1]`, are bounded. -/
lemma bddAbove_norm_sub_unit (x : C(ℝ, ℂ)) :
    BddAbove (range fun p : UnitSquarePair => ‖x p.1 - x p.2‖) := by
  have hc : Continuous fun p : UnitSquarePair => ‖x p.1 - x p.2‖ := by fun_prop
  exact (isCompact_range hc).bddAbove

/-- The scale of a curve is nonnegative. -/
lemma curveScale_nonneg (x : C(ℝ, ℂ)) : 0 ≤ curveScale x :=
  Real.iSup_nonneg fun _ => norm_nonneg _

/-- The scale is positively homogeneous: `curveScale (c • x) = c * curveScale x` for `c ≥ 0`. -/
lemma curveScale_smul {c : ℝ} (hc : 0 ≤ c) (x : C(ℝ, ℂ)) :
    curveScale (c • x) = c * curveScale x := by
  unfold curveScale
  rw [Real.mul_iSup_of_nonneg hc]
  refine iSup_congr fun p => ?_
  rw [ContinuousMap.smul_apply, ContinuousMap.smul_apply, ← smul_sub, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg hc]

/-- The scale of the normalization of a curve of nonzero scale is `1`. -/
lemma curveScale_curveNormalize {x : C(ℝ, ℂ)} (hx : curveScale x ≠ 0) :
    curveScale (curveNormalize x) = 1 := by
  unfold curveNormalize
  rw [curveScale_smul (inv_nonneg.2 (curveScale_nonneg x))]
  exact inv_mul_cancel₀ hx

/-- The normalization of a curve is unchanged by multiplying the curve by a positive constant. -/
theorem curveNormalize_smul {c : ℝ} (hc : 0 < c) (x : C(ℝ, ℂ)) :
    curveNormalize (c • x) = curveNormalize x := by
  unfold curveNormalize
  rw [curveScale_smul hc.le, smul_smul, mul_inv_rev, inv_mul_cancel_right₀ hc.ne']

/-- The scale of a curve is a Borel measurable function of the curve: by continuity, the supremum may be taken over a
countable dense set of pairs of parameters. -/
theorem measurable_curveScale : Measurable curveScale := by
  haveI : Nonempty UnitSquarePair := ⟨(⟨0, by norm_num⟩, ⟨0, by norm_num⟩)⟩
  have key : ∀ x : C(ℝ, ℂ), curveScale x =
      ⨆ n : ℕ, ‖x (denseSeq UnitSquarePair n).1 - x (denseSeq UnitSquarePair n).2‖ := by
    intro x
    unfold curveScale
    have hb := bddAbove_norm_sub_unit x
    have hc : Continuous fun p : UnitSquarePair => ‖x p.1 - x p.2‖ := by fun_prop
    have hbN : BddAbove (range fun n : ℕ =>
        ‖x (denseSeq UnitSquarePair n).1 - x (denseSeq UnitSquarePair n).2‖) :=
      hb.mono (by rintro _ ⟨n, rfl⟩; exact ⟨_, rfl⟩)
    refine le_antisymm (ciSup_le fun p => ?_) (ciSup_le fun n => le_ciSup hb _)
    exact (denseRange_denseSeq UnitSquarePair).induction_on
      (p := fun q : UnitSquarePair => ‖x q.1 - x q.2‖ ≤
        ⨆ n : ℕ, ‖x (denseSeq UnitSquarePair n).1 - x (denseSeq UnitSquarePair n).2‖) p
      (isClosed_le hc continuous_const) (fun n => le_ciSup hbN n)
  have : curveScale = fun x : C(ℝ, ℂ) =>
      ⨆ n : ℕ, ‖x (denseSeq UnitSquarePair n).1 - x (denseSeq UnitSquarePair n).2‖ := funext key
  rw [this]
  exact Measurable.iSup fun n =>
    ((ContinuousMap.measurable_eval _).sub (ContinuousMap.measurable_eval _)).norm

/-- The normalization of a curve by its scale is a Borel measurable function of the curve. -/
theorem measurable_curveNormalize : Measurable curveNormalize := by
  refine ContinuousMap.measurable_iff_eval.2 fun t => ?_
  simp only [curveNormalize, ContinuousMap.smul_apply]
  exact measurable_curveScale.inv.smul (ContinuousMap.measurable_eval t)

/-- The restriction of a curve to the interval `[-L, L]`, as a point of the product space `Icc (-L) L → ℂ`. -/
def curveWindow (L : ℝ) (x : C(ℝ, ℂ)) : Icc (-L) L → ℂ := fun t => x t

/-- The window of a curve is measurable for the product σ-algebra on the window space. -/
theorem measurable_curveWindow (L : ℝ) : Measurable (curveWindow L) :=
  measurable_pi_lambda _ fun _ => ContinuousMap.measurable_eval _

/-- The window together with the second coordinate of a pair `(curve, phase)`. -/
def windowPhase (L : ℝ) (x : C(ℝ, ℂ) × ℝ) : (Icc (-L) L → ℂ) × ℝ :=
  (curveWindow L x.1, x.2)

/-- The map `windowPhase L` is measurable. -/
lemma measurable_windowPhase (L : ℝ) : Measurable (windowPhase L) :=
  ((measurable_curveWindow L).comp measurable_fst).prodMk measurable_snd

/-- Restriction from the window `[-M, M]` to the smaller window `[-L, L]`. -/
def windowRestrict {L M : ℝ} (h : L ≤ M) (y : (Icc (-M) M → ℂ) × ℝ) : (Icc (-L) L → ℂ) × ℝ :=
  (fun t => y.1 ⟨t.1, (neg_le_neg h).trans t.2.1, t.2.2.trans h⟩, y.2)

/-- Restriction of windows is measurable. -/
lemma measurable_windowRestrict {L M : ℝ} (h : L ≤ M) : Measurable (windowRestrict h) :=
  (measurable_pi_lambda _ fun _ => (measurable_pi_apply _).comp measurable_fst).prodMk measurable_snd

/-- The increasing σ-algebras on `C(ℝ, ℂ) × ℝ` generated by the windows `(curveWindow n x.1, x.2)`. -/
noncomputable def windowFiltration : Filtration ℕ (inferInstance : MeasurableSpace (C(ℝ, ℂ) × ℝ)) where
  seq n := MeasurableSpace.comap (windowPhase (n : ℝ)) inferInstance
  mono' := by
    intro n m h
    have hnm : (n : ℝ) ≤ m := Nat.cast_le.2 h
    have e : windowPhase (n : ℝ) = windowRestrict hnm ∘ windowPhase (m : ℝ) := rfl
    show MeasurableSpace.comap (windowPhase (n : ℝ)) _ ≤ MeasurableSpace.comap (windowPhase (m : ℝ)) _
    rw [e, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_windowRestrict hnm).comap_le
  le' n := (measurable_windowPhase (n : ℝ)).comap_le

/-- The windows generate the product σ-algebra: the supremum of `windowFiltration n` is the whole σ-algebra of
`C(ℝ, ℂ) × ℝ`, since the Borel σ-algebra of `C(ℝ, ℂ)` is generated by the evaluations. -/
lemma iSup_windowFiltration :
    ⨆ n, windowFiltration n = (inferInstance : MeasurableSpace (C(ℝ, ℂ) × ℝ)) := by
  refine le_antisymm (iSup_le fun n => windowFiltration.le n) ?_
  have hC : (inferInstance : MeasurableSpace C(ℝ, ℂ)) =
      ⨆ t : ℝ, (inferInstance : MeasurableSpace ℂ).comap (fun f : C(ℝ, ℂ) => f t) :=
    ContinuousMap.measurableSpace_eq_iSup_comap_eval
  refine sup_le ?_ ?_
  · refine (congrArg (MeasurableSpace.comap (Prod.fst : C(ℝ, ℂ) × ℝ → C(ℝ, ℂ))) hC).le.trans ?_
    rw [MeasurableSpace.comap_iSup]
    refine iSup_le fun t => ?_
    obtain ⟨n, hn⟩ := exists_nat_ge |t|
    refine le_trans ?_ (le_iSup _ n)
    have ht : t ∈ Icc (-(n : ℝ)) n := ⟨(abs_le.1 hn).1, (abs_le.1 hn).2⟩
    have e : ((fun f : C(ℝ, ℂ) => f t) ∘ Prod.fst : C(ℝ, ℂ) × ℝ → ℂ) =
        (fun y : (Icc (-(n : ℝ)) n → ℂ) × ℝ => y.1 ⟨t, ht⟩) ∘ windowPhase (n : ℝ) := rfl
    rw [MeasurableSpace.comap_comp, e, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono ((measurable_pi_apply _).comp measurable_fst).comap_le
  · show MeasurableSpace.comap Prod.snd (inferInstance : MeasurableSpace ℝ) ≤ _
    refine le_trans ?_ (le_iSup _ 0)
    have e : (Prod.snd : C(ℝ, ℂ) × ℝ → ℝ) =
        (Prod.snd : (Icc (-((0 : ℕ) : ℝ)) ((0 : ℕ) : ℝ) → ℂ) × ℝ → ℝ) ∘ windowPhase ((0 : ℕ) : ℝ) := rfl
    rw [e, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono measurable_snd.comap_le

/-- A bounded measurable function `W` of a curve and a phase is approximated in `L¹(ν)`, for a finite measure `ν`, by
bounded measurable functions of the pair (window of the curve on `[-L, L]`, phase). -/
theorem exists_window_approx (ν : Measure (C(ℝ, ℂ) × ℝ)) [IsFiniteMeasure ν]
    (W : C(ℝ, ℂ) × ℝ → ℝ) (hW : Measurable W) (B : ℝ) (hB : ∀ x, |W x| ≤ B)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ L : ℕ, ∃ F : (Icc (-(L : ℝ)) L → ℂ) × ℝ → ℝ, Measurable F ∧ (∀ y, |F y| ≤ B) ∧
      ∫ x, |F (curveWindow L x.1, x.2) - W x| ∂ν < ε := by
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB (0, 0))
  have hint : Integrable W ν :=
    Integrable.of_bound hW.aestronglyMeasurable B
      (Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hB x)
  have hmeas : StronglyMeasurable[⨆ n, windowFiltration n] W := by
    rw [iSup_windowFiltration]
    exact hW.stronglyMeasurable
  have hlim := hint.tendsto_eLpNorm_condExp (ℱ := windowFiltration) hmeas
  obtain ⟨n, hn⟩ := (hlim.eventually (gt_mem_nhds (ENNReal.ofReal_pos.2 hε))).exists
  have hsm : StronglyMeasurable[MeasurableSpace.comap (windowPhase (n : ℝ)) inferInstance]
      (ν[W | windowFiltration n]) := stronglyMeasurable_condExp
  obtain ⟨h, hh, hfac⟩ := StronglyMeasurable.exists_eq_measurable_comp
    (f := windowPhase (n : ℝ)) (Z := ℝ) hsm
  refine ⟨n, fun y => max (-B) (min B (h y)), ?_, ?_, ?_⟩
  · exact measurable_const.max (measurable_const.min hh.measurable)
  · intro y
    exact abs_le.2 ⟨le_max_left _ _, max_le (neg_le_self hB0) (min_le_left _ _)⟩
  · have hbd : ∀ᵐ x ∂ν, |W x| ≤ ((B.toNNReal : ℝ≥0) : ℝ) :=
      Eventually.of_forall fun x => by rw [Real.coe_toNNReal _ hB0]; exact hB x
    have hbc := ae_bdd_condExp_of_ae_bdd (m := windowFiltration n) hbd
    have hae : ∀ᵐ x ∂ν, max (-B) (min B (h (windowPhase (n : ℝ) x))) = ν[W | windowFiltration n] x := by
      filter_upwards [hbc] with x hx
      have e : h (windowPhase (n : ℝ) x) = ν[W | windowFiltration n] x := (congrFun hfac x).symm
      rw [e]
      rw [Real.coe_toNNReal _ hB0] at hx
      have h1 := abs_le.1 hx
      rw [min_eq_right h1.2, max_eq_right h1.1]
    have hint2 : Integrable (fun x => ν[W | windowFiltration n] x - W x) ν :=
      integrable_condExp.sub hint
    have h1 : ∫ x, |max (-B) (min B (h (windowPhase (n : ℝ) x))) - W x| ∂ν =
        ∫ x, ‖ν[W | windowFiltration n] x - W x‖ ∂ν := by
      refine integral_congr_ae ?_
      filter_upwards [hae] with x hx
      rw [hx, Real.norm_eq_abs]
    have h2 : ENNReal.ofReal (∫ x, ‖ν[W | windowFiltration n] x - W x‖ ∂ν) =
        eLpNorm (ν[W | windowFiltration n] - W) 1 ν := by
      exact (ofReal_integral_norm_eq_lintegral_enorm hint2).trans
        (eLpNorm_one_eq_lintegral_enorm hint2.aestronglyMeasurable).symm
    change ∫ x, |max (-B) (min B (h (windowPhase (n : ℝ) x))) - W x| ∂ν < ε
    rw [h1]
    refine (ENNReal.ofReal_lt_ofReal_iff hε).1 ?_
    rw [h2]
    exact hn

end MatedCRT.ZeroConePolygonal
