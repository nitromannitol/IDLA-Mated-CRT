import MatedCRT.FirstPass.Derived.ZeroConeLemmaA1Tail
import MatedCRT.FirstPass.Derived.ZeroConeLemmaA1Radial
import LatticeProb.Bonanno.MatedCRTHarmonic.GMS4O.Prop48OPhaseCone
import LatticeProb.Bonanno.LQGMetric.Papers.CONF.S3D114S4

/-!
# The exterior tail of the circle-average zero cone is trivial

For the proof of Lemma A.1 of Gwynne–Miller–Sheffield (arXiv:1705.11161, Appendix A; written answer 58, section 1,
last paragraph), this file proves `isTrivialSigma_zeroCone_extTail`: the tail at infinity of the circle-average
embedding `h = zeroConeFieldOf γ X₀ b b'` of the `0`-quantum cone is trivial, given the tail triviality of the
whole-plane GFF (`WholePlaneGFFExteriorTailTrivial`).

Write `h = lateral(X₀) + W(-log |·|)` with `W` the continuous radial path of the cone. The pairing of `h` with a test
function `ψ` supported in `{|w| > k + 1}` is almost surely the sum of

* `⟨X₀, ψ - ψ̄⟩`, where `ψ̄` is the rotation average of `ψ` (the lateral pairing, `ae_lateralPart_apply`); this is
  measurable for the σ-algebra `𝒜 k` of the mean-zero pairings of `X₀` supported in `{|w| > k + 1}`;
* `∫ ψ(z) W(-log |z|) dz`, which is a function of the process `u ↦ W(-u) + Q u`, `u ≥ log (k + 1)`, because
  the circle at radius `|z|` is reached by `log |z|`: the integral is the limit of integrals of the process
  evaluated at dyadic-type grid times above `log |z|` (`measurable_integral_radial`); this is measurable for the
  σ-algebra `ℬ k` of that process.

The σ-algebras `𝒜 k` and `ℬ k` decrease, are independent at `k = 0` (the cone path `W` is independent of `X₀`), and
have trivial intersections (`WholePlaneGFFExteriorTailTrivial` for `𝒜`; for `ℬ`, the process is almost surely
`s ↦ coneOuterProc Q b' s`, whose tail is trivial by `isTrivialSigma_tailFar_coneOuterProc`). Hence
`⨅ₖ 𝒜 k ⊔ ℬ k` is trivial, and every set of the pullback of the exterior σ-algebras is almost surely equal to a set
of `𝒜 k ⊔ ℬ k` (`isTrivialSigma_iInf_of_ae_le`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal NNReal

namespace MatedCRT

open MatedCRTHarmonic MatedCRTHarmonic.MatedCRT

/-! ### Sets almost everywhere equal to sets of a σ-algebra -/

/-- The σ-algebra of the sets which are `P`-almost everywhere equal to a set of `m`. -/
abbrev aeSigma {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (m : MeasurableSpace Ω) :
    MeasurableSpace Ω where
  MeasurableSet' s := ∃ t, MeasurableSet[m] t ∧ s =ᵐ[P] t
  measurableSet_empty := ⟨∅, @MeasurableSet.empty _ m, Filter.EventuallyEq.refl _ _⟩
  measurableSet_compl := fun _ ⟨t, ht, hst⟩ => ⟨tᶜ, @MeasurableSet.compl _ _ m ht, hst.compl⟩
  measurableSet_iUnion := fun f hf => by
    choose t ht hft using hf
    exact ⟨⋃ i, t i, @MeasurableSet.iUnion _ _ m _ _ ht, Filter.EventuallyEqSet.countable_iUnion hft⟩

/-- **A set measurable for the σ-algebra generated by a family of functions, each almost surely equal to an
`m`-measurable function, is almost surely equal to an `m`-measurable set.** -/
theorem exists_ae_eq_of_measurableSet_comap_pi {Ω ι : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {m : MeasurableSpace Ω} {F : Ω → ι → ℝ}
    (hF : ∀ i, ∃ g : Ω → ℝ, Measurable[m] g ∧ (fun ω => F ω i) =ᵐ[P] g) {s : Set Ω}
    (hs : MeasurableSet[MeasurableSpace.comap F MeasurableSpace.pi] s) :
    ∃ t, MeasurableSet[m] t ∧ s =ᵐ[P] t := by
  have hmeas : Measurable[@aeSigma Ω mΩ P m] F := by
    refine (@measurable_pi_iff Ω ι (fun _ => ℝ) (@aeSigma Ω mΩ P m) _ F).2 fun i => ?_
    obtain ⟨g, hg, hgi⟩ := hF i
    intro S hS
    refine ⟨g ⁻¹' S, hg hS, ?_⟩
    filter_upwards [hgi] with ω h
    simp only [Set.mem_preimage, h]
  exact hmeas.comap_le s hs

/-! ### Pairings with radial functions and with the lateral part -/

/-- The pairing of `ofFunC f` with a test function, for a locally integrable `f`. -/
theorem ofFunC_apply_of_locallyIntegrable {f : ℂ → ℝ} (hf : LocallyIntegrable f volume)
    (ψ : LQGMetric.TestC) : CellScaling.ofFunC f ψ = ∫ z, ψ z * f z := by
  rw [CellScaling.ofFunC, Distribution.ofFun_apply (hf.locallyIntegrableOn _)]
  rfl

/-- The rotation average of a test function supported in `{|w| > c}` is supported in `{|w| > c}`, hence so is
`ψ - ψ̄`. -/
theorem tsupport_sub_symmTest_subset {c : ℝ} {ψ : LQGMetric.TestC}
    (hψ : tsupport (ψ : ℂ → ℝ) ⊆ {w : ℂ | c < ‖w‖}) :
    tsupport ((ψ - GMCFacts.symmTest ψ : LQGMetric.TestC) : ℂ → ℝ) ⊆ {w : ℂ | c < ‖w‖} := by
  obtain ⟨c', hc', hK⟩ : ∃ c' : ℝ, c < c' ∧ tsupport (ψ : ℂ → ℝ) ⊆ {w : ℂ | c' ≤ ‖w‖} := by
    rcases (tsupport (ψ : ℂ → ℝ)).eq_empty_or_nonempty with h | h
    · exact ⟨c + 1, by linarith, by rw [h]; exact empty_subset _⟩
    · obtain ⟨w₀, hw₀, hmin⟩ :=
        ψ.hasCompactSupport.isCompact.exists_isMinOn h continuous_norm.continuousOn
      exact ⟨‖w₀‖, hψ hw₀, fun w hw => hmin hw⟩
  have hclosed : IsClosed {w : ℂ | c' ≤ ‖w‖} := isClosed_le continuous_const continuous_norm
  have hsymm : tsupport (GMCFacts.symmTest ψ : ℂ → ℝ) ⊆ {w : ℂ | c' ≤ ‖w‖} := by
    refine closure_minimal (fun w hw => ?_) hclosed
    by_contra hlt
    have hlt' : ‖w‖ < c' := not_le.1 hlt
    refine hw ?_
    show GMCFacts.rotSymm ψ w = 0
    unfold GMCFacts.rotSymm
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) (fun θ _ => ?_)]
    · simp
    · refine image_eq_zero_of_notMem_tsupport fun h => ?_
      have := hK h
      simp only [Set.mem_ofPred_eq, norm_mul, GMCFacts.norm_exp_ofReal_mul_I', one_mul] at this
      linarith
  have hsub : tsupport ((ψ - GMCFacts.symmTest ψ : LQGMetric.TestC) : ℂ → ℝ) ⊆
      tsupport (ψ : ℂ → ℝ) ∪ tsupport (GMCFacts.symmTest ψ : ℂ → ℝ) :=
    tsupport_sub _ _
  intro w hw
  rcases hsub hw with h | h
  · exact lt_of_lt_of_le hc' (hK h)
  · exact lt_of_lt_of_le hc' (hsymm h)

/-! ### The radial process and its σ-algebras -/

/-- The radial process `u ↦ W(-u) + Q u` of a path `W`. -/
def radialProc {Ω : Type*} (W : Ω → C(ℝ, ℝ)) (Q : ℝ) : ℝ≥0 → Ω → ℝ :=
  fun u ω => W ω (-(u : ℝ)) + Q * (u : ℝ)

/-- The σ-algebra generated by the values at times `u ≥ T` of a process. -/
abbrev procTail {Ω : Type*} (Y : ℝ≥0 → Ω → ℝ) (T : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (u : Set.Ici T) => Y u ω) MeasurableSpace.pi

theorem procTail_anti {Ω : Type*} (Y : ℝ≥0 → Ω → ℝ) {T T' : ℝ≥0} (h : T ≤ T') :
    procTail Y T' ≤ procTail Y T := by
  let _ : MeasurableSpace Ω := procTail Y T
  refine Measurable.comap_le ?_
  refine (measurable_pi_iff (X := fun _ : Set.Ici T' => ℝ)).2 fun u => ?_
  exact (measurable_pi_iff.1 (comap_measurable (fun ω (u : Set.Ici T) => Y u ω)))
    ⟨u.1, h.trans u.2⟩

theorem procTail_le {Ω : Type*} [mΩ : MeasurableSpace Ω] {Y : ℝ≥0 → Ω → ℝ}
    (hY : ∀ u, Measurable (Y u)) (T : ℝ≥0) : procTail Y T ≤ mΩ := by
  refine Measurable.comap_le ?_
  exact (measurable_pi_iff (X := fun _ : Set.Ici T => ℝ)).2 fun u => hY u

theorem measurable_radialProc {Ω : Type*} [MeasurableSpace Ω] {W : Ω → C(ℝ, ℝ)} (hW : Measurable W)
    (Q : ℝ) (u : ℝ≥0) : Measurable (radialProc W Q u) :=
  ((continuous_eval_const (-(u : ℝ))).measurable.comp hW).add_const _

/-- **The pairing of the radial function `W(-log |·|)` with a test function supported in `{log |z| ≥ T}`
is measurable for the σ-algebra of the process `u ↦ W(-u) + Q u`, `u ≥ T`.** The integral is the limit of the
integrals of the process read at the grid times `⌈d log |z|⌉ / d` above `log |z|`, which are finite combinations of
values of the process. -/
theorem measurable_integral_radial {Ω : Type*} (W : Ω → C(ℝ, ℝ)) (Q : ℝ) (T : ℝ≥0) {ψ : ℂ → ℝ}
    (hψc : Continuous ψ) (hψs : HasCompactSupport ψ)
    (hψT : ∀ z, ψ z ≠ 0 → (T : ℝ) ≤ Real.log ‖z‖) :
    Measurable[procTail (radialProc W Q) T] (fun ω => ∫ z, ψ z * W ω (-Real.log ‖z‖)) := by
  classical
  let _ : MeasurableSpace Ω := procTail (radialProc W Q) T
  let j : ℕ → ℂ → ℕ := fun d z => ⌈(d : ℝ) * Real.log ‖z‖⌉₊
  let ev : ℕ → ℕ → (Set.Ici T → ℝ) → ℝ := fun d m y =>
    if h : T ≤ (m : ℝ≥0) / (d : ℝ≥0) then y ⟨(m : ℝ≥0) / (d : ℝ≥0), h⟩ else 0
  let Φ : ℕ → (Set.Ici T → ℝ) → ℝ := fun d y =>
    ∫ z, ψ z * (ev d (j d z) y - Q * ((j d z : ℝ) / d))
  let Yp : Ω → (Set.Ici T → ℝ) := fun ω u => radialProc W Q u ω
  have hYp : Measurable Yp := comap_measurable _
  have hjm : ∀ d, Measurable (j d) := fun d =>
    Nat.measurable_ceil.comp (measurable_const.mul (Real.measurable_log.comp measurable_norm))
  have hΦ : ∀ d, Measurable (Φ d) := by
    intro d
    have hE : Measurable fun p : (Set.Ici T → ℝ) × ℕ => ev d p.2 p.1 := by
      refine measurable_from_prod_countable_left fun m => ?_
      by_cases h : T ≤ (m : ℝ≥0) / (d : ℝ≥0)
      · simp only [ev, h, dite_true]
        exact measurable_pi_apply _
      · simp only [ev, h, dite_false]
        exact measurable_const
    have hf : Measurable fun p : (Set.Ici T → ℝ) × ℂ =>
        ψ p.2 * (ev d (j d p.2) p.1 - Q * ((j d p.2 : ℝ) / d)) := by
      refine (hψc.measurable.comp measurable_snd).mul ?_
      refine (hE.comp (measurable_fst.prodMk ((hjm d).comp measurable_snd))).sub ?_
      exact (measurable_const.mul
        ((measurable_from_nat.comp ((hjm d).comp measurable_snd)).div_const _))
    exact (hf.stronglyMeasurable.integral_prod_right').measurable
  have hlim : ∀ ω, Tendsto (fun n : ℕ => Φ (n + 1) (Yp ω)) atTop
      (𝓝 (∫ z, ψ z * W ω (-Real.log ‖z‖))) := by
    intro ω
    have hge : ∀ d : ℕ, 0 < d → ∀ z, 0 ≤ Real.log ‖z‖ →
        Real.log ‖z‖ ≤ (j d z : ℝ) / d ∧ (j d z : ℝ) / d < Real.log ‖z‖ + 1 / d := by
      intro d hd z hz
      have hd' : (0 : ℝ) < d := by exact_mod_cast hd
      have h0 : 0 ≤ (d : ℝ) * Real.log ‖z‖ := mul_nonneg hd'.le hz
      refine ⟨(le_div_iff₀ hd').2 ?_, ?_⟩
      · rw [mul_comm]; exact Nat.le_ceil _
      · rw [div_lt_iff₀ hd']
        have e : (Real.log ‖z‖ + 1 / d) * d = d * Real.log ‖z‖ + 1 := by field_simp
        rw [e]
        exact Nat.ceil_lt_add_one h0
    have hid : ∀ d : ℕ, 0 < d → ∀ z, ψ z * (ev d (j d z) (Yp ω) - Q * ((j d z : ℝ) / d)) =
        ψ z * W ω (-((j d z : ℝ) / d)) := by
      intro d hd z
      by_cases hz : ψ z = 0
      · simp [hz]
      · have hT := hψT z hz
        have hs0 : 0 ≤ Real.log ‖z‖ := (NNReal.coe_nonneg T).trans hT
        have hmem : T ≤ (j d z : ℝ≥0) / (d : ℝ≥0) := by
          rw [← NNReal.coe_le_coe]
          push_cast
          exact hT.trans (hge d hd z hs0).1
        have hc : (((j d z : ℝ≥0) / (d : ℝ≥0) : ℝ≥0) : ℝ) = (j d z : ℝ) / d := by
          push_cast; ring
        have e : ev d (j d z) (Yp ω) = W ω (-((j d z : ℝ) / d)) + Q * ((j d z : ℝ) / d) := by
          simp only [ev, hmem, dite_true, Yp, radialProc]
          rw [hc]
        rw [e]
        ring
    obtain ⟨R₀, hR₀⟩ := hψs.isCompact.isBounded.subset_closedBall (0 : ℂ)
    obtain ⟨Mψ, hMψ⟩ := hψc.bounded_above_of_compact_support hψs
    set R : ℝ := max R₀ 0 with hRdef
    have hR : tsupport ψ ⊆ Metric.closedBall (0 : ℂ) R :=
      hR₀.trans (Metric.closedBall_subset_closedBall (le_max_left _ _))
    have hR0 : 0 ≤ R := le_max_right _ _
    obtain ⟨MW, hMW⟩ := (isCompact_Icc (a := -(R + 1)) (b := 0)).exists_bound_of_continuousOn
      (W ω).continuous.continuousOn
    have hMψ0 : 0 ≤ Mψ := (norm_nonneg _).trans (hMψ 0)
    have hMW0 : 0 ≤ MW :=
      (norm_nonneg _).trans (hMW 0 ⟨by linarith, le_rfl⟩)
    have hq : ∀ z, ψ z ≠ 0 → Tendsto (fun n : ℕ => (j (n + 1) z : ℝ) / ((n + 1 : ℕ) : ℝ)) atTop
        (𝓝 (Real.log ‖z‖)) := by
      intro z hz
      have hs0 : 0 ≤ Real.log ‖z‖ := (NNReal.coe_nonneg T).trans (hψT z hz)
      have h1 : Tendsto (fun n : ℕ => Real.log ‖z‖ + 1 / ((n + 1 : ℕ) : ℝ)) atTop
          (𝓝 (Real.log ‖z‖)) := by
        have := (tendsto_const_nhds (x := Real.log ‖z‖)).add
          (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
        simpa [Nat.cast_add, Nat.cast_one] using this
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h1
        (fun n => (hge (n + 1) n.succ_pos z hs0).1) (fun n => (hge (n + 1) n.succ_pos z hs0).2.le)
    have hint : ∀ n : ℕ, Φ (n + 1) (Yp ω) =
        ∫ z, ψ z * W ω (-((j (n + 1) z : ℝ) / ((n + 1 : ℕ) : ℝ))) := fun n =>
      integral_congr_ae (Eventually.of_forall fun z => hid (n + 1) n.succ_pos z)
    refine Tendsto.congr (fun n => (hint n).symm) ?_
    refine tendsto_integral_of_dominated_convergence
      ((tsupport ψ).indicator fun _ => Mψ * MW) (fun n => ?_) ?_ (fun n => ?_) ?_
    · exact (hψc.measurable.mul ((W ω).continuous.measurable.comp
        ((measurable_from_nat.comp (hjm _)).div_const _).neg)).aestronglyMeasurable
    · exact (integrable_indicator_iff (isClosed_tsupport ψ).measurableSet).2
        (integrableOn_const hψs.isCompact.measure_lt_top.ne)
    · refine Eventually.of_forall fun z => ?_
      by_cases hz : ψ z = 0
      · rw [hz, zero_mul, norm_zero]
        exact Set.indicator_nonneg (fun _ _ => mul_nonneg hMψ0 hMW0) z
      · have hzK : z ∈ tsupport ψ := subset_tsupport _ hz
        rw [Set.indicator_of_mem hzK, norm_mul]
        have hs0 : 0 ≤ Real.log ‖z‖ := (NNReal.coe_nonneg T).trans (hψT z hz)
        have hb := hge (n + 1) n.succ_pos z hs0
        have hzR : ‖z‖ ≤ R := by simpa using hR hzK
        have hlogR : Real.log ‖z‖ ≤ R := (Real.log_le_self (norm_nonneg z)).trans hzR
        have h1 : 1 / ((n + 1 : ℕ) : ℝ) ≤ 1 := by
          rw [div_le_one (by positivity)]
          exact_mod_cast Nat.succ_pos n
        refine mul_le_mul (hMψ z) (hMW _ ⟨?_, ?_⟩) (norm_nonneg _) hMψ0
        · linarith [hb.2]
        · linarith [hb.1]
    · refine Eventually.of_forall fun z => ?_
      by_cases hz : ψ z = 0
      · simp [hz]
      · exact (((W ω).continuous.tendsto _).comp (hq z hz).neg).const_mul (ψ z)
  exact measurable_of_tendsto_metrizable (fun n => (hΦ (n + 1)).comp hYp) (tendsto_pi_nhds.2 hlim)

/-! ### The grid times and the data of the cone -/

/-- The time `log (k + 1)` as a nonnegative real. -/
def logGrid (k : ℕ) : ℝ≥0 := (Real.log ((k : ℝ) + 1)).toNNReal

theorem coe_logGrid (k : ℕ) : (logGrid k : ℝ) = Real.log ((k : ℝ) + 1) :=
  Real.coe_toNNReal _ (Real.log_nonneg (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]))

theorem logGrid_mono : Monotone logGrid := fun a b hab =>
  Real.toNNReal_le_toNNReal (Real.log_le_log (by positivity) (by
    have : (a : ℝ) ≤ b := by exact_mod_cast hab
    linarith))

theorem exists_logGrid_ge (t : ℝ≥0) : ∃ k : ℕ, t ≤ logGrid (k + 1) := by
  refine ⟨⌈Real.exp t⌉₊, ?_⟩
  rw [← NNReal.coe_le_coe, coe_logGrid, Real.le_log_iff_exp_le (by positivity)]
  push_cast
  linarith [Nat.le_ceil (Real.exp t)]

/-- A set of the tail σ-algebra of a process is almost everywhere equal to a set of the tail σ-algebra of an
almost surely equal process. -/
theorem exists_mem_procTail_ae_eq {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {Y Y' : ℝ≥0 → Ω → ℝ}
    {T : ℝ≥0} (h : ∀ᵐ ω ∂P, ∀ u : ℝ≥0, T ≤ u → Y u ω = Y' u ω) {s : Set Ω}
    (hs : MeasurableSet[procTail Y T] s) :
    ∃ t, MeasurableSet[procTail Y' T] t ∧ s =ᵐ[P] t := by
  obtain ⟨B, hB, rfl⟩ := hs
  refine ⟨(fun ω (u : Set.Ici T) => Y' u ω) ⁻¹' B, ⟨B, hB, rfl⟩, ?_⟩
  filter_upwards [h] with ω hω
  have : (fun u : Set.Ici T => Y u ω) = fun u : Set.Ici T => Y' u ω :=
    funext fun u => hω u u.2
  simp only [Set.mem_preimage, this]

/-- The σ-algebra of the whole-plane field outside the disc of radius `k + 1`, modulo constants. -/
abbrev outerSigma {Ω : Type} (X : Ω → LQGMetric.DistC) (k : ℕ) : MeasurableSpace Ω :=
  LQGMetric.Blueprint.fieldSigma0On X {w : ℂ | (k : ℝ) + 1 < ‖w‖}

theorem outerSigma_anti {Ω : Type} (X : Ω → LQGMetric.DistC) : Antitone (outerSigma X) :=
  fun a b hab => LQGMetric.CONF.conf36_fieldSigma0On_mono X fun w hw => by
    have hab' : (a : ℝ) ≤ b := by exact_mod_cast hab
    have hw' : (b : ℝ) + 1 < ‖w‖ := hw
    show (a : ℝ) + 1 < ‖w‖
    linarith

theorem outerSigma_le_comap {Ω : Type} (X : Ω → LQGMetric.DistC) (k : ℕ) :
    outerSigma X k ≤ MeasurableSpace.comap X inferInstance := by
  let _ : MeasurableSpace Ω := MeasurableSpace.comap X inferInstance
  refine Measurable.comap_le ?_
  refine (measurable_pi_iff (X := fun _ => ℝ)).2 fun ψ => ?_
  exact (LQGMetric.GFFInv.measurable_pair ψ.1.1).comp (comap_measurable X)

theorem outerSigma_le {Ω : Type} [MeasurableSpace Ω] {X : Ω → LQGMetric.DistC} (hX : Measurable X)
    (k : ℕ) : outerSigma X k ≤ (inferInstance : MeasurableSpace Ω) :=
  (outerSigma_le_comap X k).trans hX.comap_le

/-! ### The pairings of the cone field with test functions in the exterior -/

section Pairing

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}

/-- **The pairing of the cone field with a test function supported in `{|w| > k + 1}` has a version measurable
for `𝒜 k ⊔ ℬ k`.** Almost surely the pairing is `⟨X, ψ - ψ̄⟩ + ∫ ψ(z) W(-log |z|) dz`: the first term is a
pairing of `X` with a mean-zero test function supported in `{|w| > k + 1}`, the second a function of the process
`u ↦ W(-u) + Q u`, `u ≥ log (k + 1)`. -/
theorem exists_version_pairing_cone {X Z : Ω → LQGMetric.DistC} {W : Ω → C(ℝ, ℝ)} (Q : ℝ)
    (hX : LQGMetric.IsWholePlaneGFF X P)
    (hZ : ∀ᵐ ω ∂P, Z ω = ConeScaling.fieldOf (CellScaling.lateralPart (X ω)) (W ω))
    (hli : ∀ᵐ ω ∂P, LocallyIntegrable (ConeScaling.radialOf (W ω)) volume) (k : ℕ)
    (φ : LQGMetric.TestOn (extOpen ((k : ℝ) + 1))) :
    ∃ g : Ω → ℝ, Measurable[outerSigma X k ⊔ procTail (radialProc W Q) (logGrid k)] g ∧
      (fun ω => LQGMetric.restrictTo (extOpen ((k : ℝ) + 1)) (Z ω) φ) =ᵐ[P] g := by
  let ψ : LQGMetric.TestC := TestFunction.monoCLM ℝ (n₁ := ⊤) (n₂ := ⊤)
    (Ω₁ := extOpen ((k : ℝ) + 1)) (Ω₂ := ⊤) φ
  have hψφ : (ψ : ℂ → ℝ) = φ := by
    rw [TestFunction.monoCLM_apply]
    simp
  have hψs : tsupport (ψ : ℂ → ℝ) ⊆ {w : ℂ | (k : ℝ) + 1 < ‖w‖} := by
    rw [hψφ]
    exact φ.tsupport_subset
  have hlat : tsupport ((ConeScaling.latTest ψ).1 : ℂ → ℝ) ⊆ {w : ℂ | (k : ℝ) + 1 < ‖w‖} :=
    tsupport_sub_symmTest_subset hψs
  have hg₁ : Measurable[outerSigma X k] fun ω => X ω (ψ - GMCFacts.symmTest ψ) := by
    let f : Ω → ({ψ' : LQGMetric.TestC0 // tsupport (ψ'.1 : ℂ → ℝ) ⊆
        {w : ℂ | (k : ℝ) + 1 < ‖w‖}} → ℝ) := fun ω ψ' => X ω ψ'.1.1
    exact (measurable_pi_apply (⟨ConeScaling.latTest ψ, hlat⟩ : _)).comp (comap_measurable f)
  have hg₂ : Measurable[procTail (radialProc W Q) (logGrid k)]
      fun ω => ∫ z, ψ z * W ω (-Real.log ‖z‖) := by
    refine measurable_integral_radial W Q (logGrid k) ψ.continuous ψ.hasCompactSupport fun z hz => ?_
    have hzK : (k : ℝ) + 1 < ‖z‖ := hψs (subset_tsupport _ hz)
    rw [coe_logGrid]
    exact Real.log_le_log (by positivity) hzK.le
  refine ⟨fun ω => X ω (ψ - GMCFacts.symmTest ψ) + ∫ z, ψ z * W ω (-Real.log ‖z‖),
    (hg₁.mono le_sup_left le_rfl).add (hg₂.mono le_sup_right le_rfl), ?_⟩
  filter_upwards [hZ, hli, GMCFacts.ae_lateralPart_apply hX ψ] with ω hZω hl hlatω
  show Z ω ψ = _
  rw [hZω]
  show CellScaling.lateralPart (X ω) ψ + CellScaling.ofFunC (ConeScaling.radialOf (W ω)) ψ = _
  rw [hlatω, ofFunC_apply_of_locallyIntegrable hl]
  rfl

/-- **Every set of the pullback of the exterior σ-algebra `extSigma (k + 1)` along the cone field is almost
everywhere equal to a set of `𝒜 k ⊔ ℬ k`.** -/
theorem exists_ae_eq_of_measurableSet_comap_cone {X Z : Ω → LQGMetric.DistC} {W : Ω → C(ℝ, ℝ)} (Q : ℝ)
    (hX : LQGMetric.IsWholePlaneGFF X P)
    (hZ : ∀ᵐ ω ∂P, Z ω = ConeScaling.fieldOf (CellScaling.lateralPart (X ω)) (W ω))
    (hli : ∀ᵐ ω ∂P, LocallyIntegrable (ConeScaling.radialOf (W ω)) volume) (k : ℕ) {s : Set Ω}
    (hs : MeasurableSet[MeasurableSpace.comap Z (extSigma ((k : ℝ) + 1))] s) :
    ∃ t, MeasurableSet[outerSigma X k ⊔ procTail (radialProc W Q) (logGrid k)] t ∧ s =ᵐ[P] t := by
  have hc : MeasurableSpace.comap Z (extSigma ((k : ℝ) + 1)) =
      MeasurableSpace.comap (fun ω (φ : LQGMetric.TestOn (extOpen ((k : ℝ) + 1))) =>
        LQGMetric.restrictTo (extOpen ((k : ℝ) + 1)) (Z ω) φ) MeasurableSpace.pi := by
    show MeasurableSpace.comap Z (MeasurableSpace.comap (fun h : LQGMetric.DistC =>
      LQGMetric.restrictTo (extOpen ((k : ℝ) + 1)) h) (MeasurableSpace.comap
      (fun (h : LQGMetric.DistOn (extOpen ((k : ℝ) + 1))) (φ : LQGMetric.TestOn (extOpen ((k : ℝ) + 1))) =>
        h φ) MeasurableSpace.pi)) = _
    rw [MeasurableSpace.comap_comp, MeasurableSpace.comap_comp]
    rfl
  rw [hc] at hs
  exact exists_ae_eq_of_measurableSet_comap_pi (exists_version_pairing_cone Q hX hZ hli k) hs

end Pairing

/-! ### The radial path of the zero cone -/

/-- The radial path of the `0`-quantum cone as a measurable continuous path `W`, independent of `X₀`, with almost
surely locally integrable radial profile. -/
theorem exists_radialPath_zeroCone {γ : ℝ} {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] {X₀ : Ω → Field} {b b' : ℝ≥0 → Ω → ℝ} (hγ : 0 < γ)
    (hb : IsBrownianReal b P) (hb' : IsBrownianReal b' P)
    (hXB : IndepFun X₀ (fun ω => ((fun t => b t ω), (fun t => b' t ω))) P)
    (hbb : IndepFun (fun ω t => b t ω) (fun ω t => b' t ω) P) :
    ∃ W : Ω → C(ℝ, ℝ), Measurable W ∧ IndepFun X₀ W P ∧
      (∀ᵐ ω ∂P, ∀ t, W ω t = CellScaling.coneRadial γ 0 (fun s => b s ω) (fun s => b' s ω) t) ∧
      (∀ᵐ ω ∂P, LocallyIntegrable (ConeScaling.radialOf (W ω)) volume) := by
  have hQ0 : (0 : ℝ) < CellScaling.lqgQ γ := GMS4O.p48o_lqgQ_pos hγ
  have hQ0' : 0 < CellScaling.lqgQ γ - 0 := by rw [sub_zero]; exact hQ0
  obtain ⟨W, hWm, hXW, -, hW⟩ := IGLaw.exists_radialPath_alpha (γ := γ) (α := 0) hQ0' hb hb' hXB
    (indepFun_const_left (μ := P) (c := ()) _)
  have hQ : CellScaling.lqgQ γ = QuantumZipper.Qc γ := by dsimp [CellScaling.lqgQ, QuantumZipper.Qc]
  have hA : MoTPort.IsConeProcess 0 (QuantumZipper.Qc γ)
      (fun t ω => LQGCone.motConeRadial γ 0 (fun s => b s ω) (fun s => b' s ω) t) P :=
    LQGCone.isConeProcess_motConeRadial hb hb' hbb
  have hli : ∀ᵐ ω ∂P, LocallyIntegrable (ConeScaling.radialOf (W ω)) volume := by
    filter_upwards [hW, MoTPort.ConeArea4.ae_locallyIntegrable_coneProfile hA] with ω hω hl
    refine hl.congr (Eventually.of_forall fun z => ?_)
    simp only [ConeScaling.radialOf, hω, LQGCone.coneRadial_eq_Q_add_motConeRadial, hQ]
  exact ⟨W, hWm, hXW, hW, hli⟩

/-- For `u > 0`, the radial path of the zero cone at `-u` is the outer process after the last zero, minus `Q u`. -/
theorem coneRadial_neg_add_eq_coneOuterProc {γ : ℝ} {b b' : ℝ≥0 → ℝ} {u : ℝ≥0} (hu : 0 < u) :
    CellScaling.coneRadial γ 0 b b' (-(u : ℝ)) + CellScaling.lqgQ γ * (u : ℝ) =
      coneOuterProc (lqgQ γ) b' u := by
  have hneg : ¬ (0 : ℝ) ≤ -(u : ℝ) := by
    have : (0 : ℝ) < u := hu
    linarith
  simp only [CellScaling.coneRadial, hneg, ↓reduceIte]
  show (fun c : ℝ → ℝ => c (lastZeroR c - -(u : ℝ)) + lqgQ γ * -(u : ℝ))
      (fun v => b' v.toNNReal + (lqgQ γ - 0) * v) + lqgQ γ * (u : ℝ) =
    (fun c : ℝ → ℝ => c (lastZeroR c + (u : ℝ))) (fun v => b' v.toNNReal + lqgQ γ * v)
  simp only [sub_neg_eq_add, sub_zero]
  ring

theorem logGrid_succ_pos (k : ℕ) : 0 < logGrid (k + 1) := by
  rw [← NNReal.coe_pos, coe_logGrid]
  exact Real.log_pos (by push_cast; linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)])

theorem procTail_radialProc_le_comap {Ω : Type*} (W : Ω → C(ℝ, ℝ)) (Q : ℝ) (T : ℝ≥0) :
    procTail (radialProc W Q) T ≤ MeasurableSpace.comap W inferInstance := by
  let _ : MeasurableSpace Ω := MeasurableSpace.comap W inferInstance
  refine Measurable.comap_le ?_
  refine (measurable_pi_iff (X := fun _ : Set.Ici T => ℝ)).2 fun u => ?_
  exact ((continuous_eval_const (-(u : ℝ≥0) : ℝ)).measurable.comp (comap_measurable W)).add_const _

/-- **The exterior tail of the circle-average zero cone is trivial** (answer 58, section 1, last paragraph:
subtract `Q s` and add the lateral field). For the circle-average embedding `h = zeroConeFieldOf γ X₀' b b'` of
the `0`-quantum cone, the intersection over `k` of the pullbacks of the exterior σ-algebras of the fields is
trivial, given the tail triviality of the whole-plane GFF. -/
theorem isTrivialSigma_zeroCone_extTail (hT1a : WholePlaneGFFExteriorTailTrivial) {γ : ℝ}
    (hγ : γ ∈ Ioo (0 : ℝ) 2) {Ω' : Type} [MeasurableSpace Ω'] (P' : Measure Ω') (X₀' : Ω' → Field)
    (b b' : ℝ≥0 → Ω' → ℝ) (hP : IsProbabilityMeasure P') (hX : LQGMetric.IsWholePlaneGFF X₀' P')
    (hb : IsBrownianReal b P') (hb' : IsBrownianReal b' P')
    (hi1 : IndepFun X₀' (fun ω => ((fun t => b t ω), (fun t => b' t ω))) P')
    (hi2 : IndepFun (fun ω t => b t ω) (fun ω t => b' t ω) P') :
    LatticeProb.IsTrivialSigma (⨅ k : ℕ, extSigma ((k : ℝ) + 1))
      (P'.map (zeroConeFieldOf γ X₀' b b')) := by
  obtain ⟨W, hWm, hXW, hW, hli⟩ := exists_radialPath_zeroCone hγ.1 hb hb' hi1 hi2
  have hQ0 : (0 : ℝ) < lqgQ γ := GMS4O.p48o_lqgQ_pos hγ.1
  set Q : ℝ := lqgQ γ
  have hZ : ∀ᵐ ω ∂P', zeroConeFieldOf γ X₀' b b' ω =
      ConeScaling.fieldOf (CellScaling.lateralPart (X₀' ω)) (W ω) := by
    filter_upwards [hW] with ω hω
    exact IGLaw.coneField_eq_fieldOf_alpha γ 0 (X₀' ω) (b := fun s => b s ω)
      (b' := fun s => b' s ω) hω
  have hmeasZ : AEMeasurable (zeroConeFieldOf γ X₀' b b') P' :=
    ((ConeScaling.measurable_fieldOf.comp
      ((ConeScaling.measurable_lateralPart.comp hX.measurable).prodMk hWm)).aemeasurable).congr
      (Filter.EventuallyEq.symm hZ)
  let 𝒜 : ℕ → MeasurableSpace Ω' := outerSigma X₀'
  let ℬ : ℕ → MeasurableSpace Ω' := fun k => procTail (radialProc W Q) (logGrid k)
  have h𝒜 : ∀ k, 𝒜 k ≤ (inferInstance : MeasurableSpace Ω') := fun k => outerSigma_le hX.measurable k
  have hℬ : ∀ k, ℬ k ≤ (inferInstance : MeasurableSpace Ω') := fun k =>
    procTail_le (measurable_radialProc hWm Q) _
  have hanti𝒜 : Antitone 𝒜 := outerSigma_anti X₀'
  have hantiℬ : Antitone ℬ := fun a b hab => procTail_anti _ (logGrid_mono hab)
  have hind : Indep (𝒜 0) (ℬ 0) P' :=
    indep_of_indep_of_le_right (indep_of_indep_of_le_left
      ((IndepFun_iff_Indep _ _ _).1 hXW) (outerSigma_le_comap X₀' 0))
      (procTail_radialProc_le_comap W Q _)
  have hta : LatticeProb.IsTrivialSigma (⨅ n, 𝒜 n) P' :=
    (hT1a P' X₀' hP hX).mono (le_iInf fun j => (iInf_le 𝒜 j).trans
      (LQGMetric.CONF.conf36_fieldSigma0On_mono X₀' fun w hw => by
        have : (j : ℝ) < (j : ℝ) + 1 := lt_add_one _
        exact lt_trans this hw))
  have htb : LatticeProb.IsTrivialSigma (⨅ n, ℬ n) P' := by
    let Y : ℝ≥0 → Ω' → ℝ := fun s ω => coneOuterProc Q (fun t => b' t ω) s
    have hY : LatticeProb.IsTrivialSigma (LatticeProb.tailFar Y) P' :=
      isTrivialSigma_tailFar_coneOuterProc hQ0 P' b' hb'
    have h1 : LatticeProb.IsTrivialSigma (⨅ k : ℕ, ℬ (k + 1)) P' := by
      refine isTrivialSigma_iInf_of_ae_le (𝒟 := fun k => procTail Y (logGrid (k + 1)))
        (fun a b hab => procTail_anti Y (logGrid_mono (Nat.succ_le_succ hab))) ?_ ?_
      · intro k s hs
        refine exists_mem_procTail_ae_eq ?_ hs
        filter_upwards [hW] with ω hω u hu
        have hu0 : 0 < u := lt_of_lt_of_le (logGrid_succ_pos k) hu
        show W ω (-(u : ℝ)) + Q * (u : ℝ) = _
        rw [hω]
        exact coneRadial_neg_add_eq_coneOuterProc hu0
      · refine hY.mono (le_iInf fun t => ?_)
        obtain ⟨k, hk⟩ := exists_logGrid_ge t
        exact (iInf_le _ k).trans (procTail_anti Y hk)
    exact h1.mono (le_iInf fun k => iInf_le ℬ (k + 1))
  have hsup : LatticeProb.IsTrivialSigma (⨅ n, 𝒜 n ⊔ ℬ n) P' := by
    have := hP
    exact LatticeProb.isTrivialSigma_iInf_sup h𝒜 hℬ hanti𝒜 hantiℬ hind hta htb
  have hC : LatticeProb.IsTrivialSigma (⨅ k : ℕ, MeasurableSpace.comap
      (zeroConeFieldOf γ X₀' b b') (extSigma ((k : ℝ) + 1))) P' := by
    have := hP
    exact isTrivialSigma_iInf_of_ae_le (𝒟 := fun k => 𝒜 k ⊔ ℬ k)
      (fun a b hab => sup_le_sup (hanti𝒜 hab) (hantiℬ hab))
      (fun k s hs => exists_ae_eq_of_measurableSet_comap_cone Q hX hZ hli k hs) hsup
  have := hP
  exact isTrivialSigma_map_of_comap hmeasZ ((iInf_le _ 0).trans (extSigma_le _))
    (hC.mono (le_iInf fun k => MeasurableSpace.comap_mono (iInf_le _ k)))

end MatedCRT
