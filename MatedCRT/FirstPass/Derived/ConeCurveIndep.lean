/-!
# The space-filling curve is independent of the cone field

In the mating-of-trees coupling, the curve `ηL` is almost surely a measurable function of the imaginary-geometry
field and the uniform angle, which are independent of the whole-plane GFF `X` and the two Brownian motions `B, B'`
of the γ-quantum cone (`MatedCRT.Sec1.indepFun_igCurve_cone`). The cone field
`h = coneField X (coneRadial γ γ B B')` is, however, a measurable function of `X` and of *continuous versions* of
`B, B'` only (the radial path involves the last zero of a drifted Brownian motion). This file transfers the
independence to those versions and obtains a measurable version of the cone field that is independent of `ηL`;
then the circle-average process of a valid environment is independent of `ηL`.

## Main results

* `indepFun_triple_continuousMap_of_coe`: independence from `(g, U, V)` with `U, V` continuous paths is
  independence from `(g, ⇑U, ⇑V)`.
* `exists_coneField_version_indepFun_igCurve`: a measurable version of the cone field independent of `ηL`.
* `indepFun_circleProcess_igCurve_of_valid`: for a valid environment and its mating-of-trees curve `ηL`, the
  circle-average process `(r, z) ↦ h_r(z)` is independent of `ηL`.
* `indepFun_circleProcess_lqgMeasure_igCurve_of_coupling`: the pair (circle-average process, LQG measure) is
  independent of `ηL` (the measure is a.s. a measurable function of the circle averages through its masses of
  countably many open sets).
-/

open HarmonicBalls

namespace MatedCRT.FirstPass.Derived

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

/-- Independence from a variable and a pair of continuous paths is independence from the variable and the
underlying functions of the paths (the Borel σ-algebra of `C(ℝ≥0, ℝ)` is generated by the evaluations). -/
theorem indepFun_triple_continuousMap_of_coe {Ω α β : Type*} [MeasurableSpace Ω] [MeasurableSpace α]
    [MeasurableSpace β] {P : Measure Ω} {f : Ω → β} {g : Ω → α} {U V : Ω → C(ℝ≥0, ℝ)}
    (h : IndepFun f (fun ω => (g ω, (⇑(U ω) : ℝ≥0 → ℝ), (⇑(V ω) : ℝ≥0 → ℝ))) P) :
    IndepFun f (fun ω => (g ω, U ω, V ω)) P := by
  have hc : Measurable fun f : C(ℝ≥0, ℝ) => (⇑f : ℝ≥0 → ℝ) :=
    measurable_pi_iff.2 fun t => ContinuousMap.measurable_eval t
  have hσ : MeasurableSpace.comap (fun ω => (g ω, U ω, V ω))
        (inferInstance : MeasurableSpace (α × C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ))) =
      MeasurableSpace.comap (fun ω => (g ω, (⇑(U ω) : ℝ≥0 → ℝ), (⇑(V ω) : ℝ≥0 → ℝ)))
        (inferInstance : MeasurableSpace (α × (ℝ≥0 → ℝ) × (ℝ≥0 → ℝ))) := by
    apply le_antisymm
    · rw [← measurable_iff_comap_le]
      let _ : MeasurableSpace Ω := MeasurableSpace.comap
        (fun ω => (g ω, (⇑(U ω) : ℝ≥0 → ℝ), (⇑(V ω) : ℝ≥0 → ℝ))) inferInstance
      have hm : Measurable fun ω => (g ω, (⇑(U ω) : ℝ≥0 → ℝ), (⇑(V ω) : ℝ≥0 → ℝ)) :=
        comap_measurable _
      exact (measurable_fst.comp hm).prodMk
        ((ContinuousMap.measurable_iff_eval.2 fun t =>
          (measurable_pi_apply t).comp (measurable_fst.comp (measurable_snd.comp hm))).prodMk
        (ContinuousMap.measurable_iff_eval.2 fun t =>
          (measurable_pi_apply t).comp (measurable_snd.comp (measurable_snd.comp hm))))
    · rw [← measurable_iff_comap_le]
      let _ : MeasurableSpace Ω := MeasurableSpace.comap (fun ω => (g ω, U ω, V ω)) inferInstance
      have hm : Measurable fun ω => (g ω, U ω, V ω) := comap_measurable _
      exact (measurable_fst.comp hm).prodMk
        ((hc.comp (measurable_fst.comp (measurable_snd.comp hm))).prodMk
          (hc.comp (measurable_snd.comp (measurable_snd.comp hm))))
  unfold IndepFun Kernel.IndepFun at h ⊢
  rw [hσ]
  exact h

/-- The cone field of the mating-of-trees coupling is the cone field of the cell model (the two copies of the
definitions have the same bodies). -/
theorem matedCRT_coneField_coneRadial_eq (γ : ℝ) (X : LQGMetric.DistC) (b b' : ℝ≥0 → ℝ) :
    MatedCRTHarmonic.MatedCRT.coneField X (MatedCRTHarmonic.MatedCRT.coneRadial γ γ b b') =
      MatedCRTHarmonic.CellScaling.coneFieldOf γ X b b' := by
  unfold MatedCRTHarmonic.MatedCRT.coneField MatedCRTHarmonic.MatedCRT.coneRadial
    MatedCRTHarmonic.CellScaling.coneFieldOf MatedCRTHarmonic.CellScaling.coneField
    MatedCRTHarmonic.CellScaling.coneRadial MatedCRTHarmonic.MatedCRT.lateralPart
    MatedCRTHarmonic.CellScaling.lateralPart MatedCRTHarmonic.MatedCRT.lastZeroR
    MatedCRTHarmonic.CellScaling.lastZeroR MatedCRTHarmonic.MatedCRT.lqgQ MatedCRTHarmonic.CellScaling.lqgQ
    MatedCRTHarmonic.MatedCRT.radialAvg MatedCRTHarmonic.CellScaling.radialAvg
  rfl

/-- **A version of the cone field independent of the curve.** Under the mating-of-trees coupling
(`0 < γ < 2`) there is a measurable `H` with `H = coneField X (coneRadial γ γ B B')` almost surely and `H`
independent of the space-filling curve `ηL`. -/
theorem exists_coneField_version_indepFun_igCurve {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} {γ : ℝ}
    {X X₀ hIG₀ : Ω → MatedCRTHarmonic.MatedCRT.Field}
    {B B' B₀ B₀' : ℝ≥0 → Ω → ℝ} {U : Ω → ℝ} {ηL η η₀ : Ω → C(ℝ, ℂ)}
    {bm : Ω → MatedCRTHarmonic.MatedCRT.Path2}
    (h : MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling γ P X X₀ hIG₀ B B' B₀ B₀' U ηL η η₀ bm)
    (hγ : 0 < γ) (hγ2 : γ < 2) :
    ∃ H : Ω → LQGMetric.DistC, Measurable H ∧ IndepFun H ηL P ∧
      ∀ᵐ ω ∂P, MatedCRTHarmonic.MatedCRT.coneField (X ω)
        (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (fun u => B u ω) (fun u => B' u ω)) = H ω := by
  obtain ⟨Bc, hBcm, hBc⟩ := MatedCRTHarmonic.ConeScaling.exists_continuousMap_version h.bm_B
  obtain ⟨Bc', hBc'm, hBc'⟩ := MatedCRTHarmonic.ConeScaling.exists_continuousMap_version h.bm_B'
  have hproj : Measurable fun p : MatedCRTHarmonic.MatedCRT.Field × (ℝ≥0 → ℝ) × (ℝ≥0 → ℝ) ×
      MatedCRTHarmonic.MatedCRT.Field × (ℝ≥0 → ℝ) × (ℝ≥0 → ℝ) => (p.1, p.2.1, p.2.2.1) := by
    fun_prop
  have h0 : IndepFun ηL (fun ω => (X ω, (fun t => B t ω), (fun t => B' t ω))) P :=
    (MatedCRT.Sec1.indepFun_igCurve_cone h).comp measurable_id hproj
  have h1 : IndepFun ηL (fun ω => (X ω, (⇑(Bc ω) : ℝ≥0 → ℝ), (⇑(Bc' ω) : ℝ≥0 → ℝ))) P := by
    refine h0.congr (ae_eq_refl _) ?_
    filter_upwards [hBc, hBc'] with ω e1 e2
    exact Prod.ext rfl (Prod.ext (funext fun t => (e1 t).symm) (funext fun t => (e2 t).symm))
  have h2 : IndepFun ηL (fun ω => (X ω, Bc ω, Bc' ω)) P := indepFun_triple_continuousMap_of_coe h1
  have hF : Measurable fun p : MatedCRTHarmonic.MatedCRT.Field × C(ℝ≥0, ℝ) × C(ℝ≥0, ℝ) =>
      MatedCRTHarmonic.ConeScaling.fieldOf (MatedCRTHarmonic.CellScaling.lateralPart p.1)
        (MatedCRTHarmonic.ConeScaling.radMap γ γ p.2) :=
    MatedCRTHarmonic.ConeScaling.measurable_fieldOf.comp
      ((MatedCRTHarmonic.ConeScaling.measurable_lateralPart.comp measurable_fst).prodMk
        ((MatedCRTHarmonic.ConeScaling.measurable_radMap γ γ).comp measurable_snd))
  refine ⟨fun ω => MatedCRTHarmonic.ConeScaling.fieldOf
      (MatedCRTHarmonic.CellScaling.lateralPart (X ω))
      (MatedCRTHarmonic.ConeScaling.radMap γ γ (Bc ω, Bc' ω)),
    hF.comp (h.gff.measurable.prodMk (hBcm.prodMk hBc'm)), (h2.comp measurable_id hF).symm, ?_⟩
  filter_upwards [hBc, hBc', h.bm_B.eval_zero_ae_eq_zero, h.bm_B'.eval_zero_ae_eq_zero,
    MatedCRTHarmonic.CellScaling.ae_goodDrift h.bm_B'
      (MatedCRTHarmonic.CellScaling.lqgQ_sub_pos hγ hγ2)] with ω e1 e2 e3 e4 hdrift
  have f1 : (⇑(Bc ω) : ℝ≥0 → ℝ) = fun s => B s ω := funext e1
  have f2 : (⇑(Bc' ω) : ℝ≥0 → ℝ) = fun s => B' s ω := funext e2
  have hmem : (Bc ω, Bc' ω) ∈ MatedCRTHarmonic.ConeScaling.radGood γ γ := by
    refine ⟨?_, ?_, ?_⟩
    · rw [e1]; exact e3
    · rw [e2]; exact e4
    · show BddAbove {s : ℝ | 0 ≤ s ∧ MatedCRTHarmonic.CellScaling.coneDrift γ γ (⇑(Bc' ω)) s = 0}
      rw [f2]; exact hdrift.bddAbove_zeroSet
  have hw : ∀ t, MatedCRTHarmonic.ConeScaling.radMap γ γ (Bc ω, Bc' ω) t =
      MatedCRTHarmonic.CellScaling.coneRadial γ γ (fun s => B s ω) (fun s => B' s ω) t := by
    intro t
    rw [MatedCRTHarmonic.ConeScaling.radMap_apply, ite_eq_left hmem]
    simp only [f1, f2]
  rw [matedCRT_coneField_coneRadial_eq]
  exact MatedCRTHarmonic.ConeScaling.coneFieldOf_eq_fieldOf γ (X ω) hw

/-- **The circle-average process is independent of the curve.** For a valid environment `S` (`0 < γ < 2`) and a
mating-of-trees coupling on its carrier whose cone field represents the pairings of `S`, the circle-average process
`(r, z) ↦ h_r(z)`, `r > 0`, is independent of the space-filling curve `ηL`. -/
theorem indepFun_circleProcess_igCurve_of_coupling {Ω : Type} [MeasurableSpace Ω] {S : MatedCRTEnv Ω}
    {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) (hγ : 0 < γ) (hγ2 : γ < 2)
    {X X₀ hIG₀ : Ω → MatedCRTHarmonic.MatedCRT.Field}
    {B B' B₀ B₀' : ℝ≥0 → Ω → ℝ} {U : Ω → ℝ} {ηL η η₀ : Ω → C(ℝ, ℂ)}
    {bm : Ω → MatedCRTHarmonic.MatedCRT.Path2}
    (h : MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling γ S.P X X₀ hIG₀ B B' B₀ B₀' U ηL η η₀ bm)
    (hrep : ∀ᵐ ω ∂S.P, ∀ φ : LQGMetric.TestC, S.hC ω ⇑φ = MatedCRTHarmonic.MatedCRT.coneField (X ω)
      (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (fun u => B u ω) (fun u => B' u ω)) φ) :
    IndepFun (fun ω => circleProcess (S.hcirc ω)) ηL S.P := by
  obtain ⟨H, hHm, hind, hH⟩ := exists_coneField_version_indepFun_igCurve h hγ hγ2
  have hpair : ∀ᵐ ω ∂S.P, ∀ φ : LQGMetric.TestC, S.hC ω φ = H ω φ := by
    filter_upwards [hrep, hH] with ω h1 h2 φ
    rw [h1 φ, h2]
  have hcirc := MatedCRT.Sec1.ae_distributionCircleVersion_eq hS hpair
  refine (hind.comp MatedCRT.Sec1.measurable_distributionCircleCode measurable_id).congr ?_
    (ae_eq_refl _)
  filter_upwards [hcirc] with ω hω
  funext p
  exact hω p.1 p.1.2 p.2

/-- **The circle averages and the LQG measure are independent of the curve.** Under the hypotheses of
`indepFun_circleProcess_igCurve_of_coupling`, the pair `((r, z) ↦ h_r(z), μ_h)` is independent of `ηL`. -/
theorem indepFun_circleProcess_lqgMeasure_igCurve_of_coupling {Ω : Type} [MeasurableSpace Ω]
    {S : MatedCRTEnv Ω} {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) (hγ : 0 < γ) (hγ2 : γ < 2)
    {X X₀ hIG₀ : Ω → MatedCRTHarmonic.MatedCRT.Field}
    {B B' B₀ B₀' : ℝ≥0 → Ω → ℝ} {U : Ω → ℝ} {ηL η η₀ : Ω → C(ℝ, ℂ)}
    {bm : Ω → MatedCRTHarmonic.MatedCRT.Path2}
    (h : MatedCRTHarmonic.MatedCRT.IsMatingOfTreesCoupling γ S.P X X₀ hIG₀ B B' B₀ B₀' U ηL η η₀ bm)
    (hrep : ∀ᵐ ω ∂S.P, ∀ φ : LQGMetric.TestC, S.hC ω ⇑φ = MatedCRTHarmonic.MatedCRT.coneField (X ω)
      (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (fun u => B u ω) (fun u => B' u ω)) φ) :
    IndepFun (fun ω => (circleProcess (S.hcirc ω), S.μ ω)) ηL S.P := by
  have hcone := hS.isConeField
  have hc0 := indepFun_circleProcess_igCurve_of_coupling hS hγ hγ2 h hrep
  obtain ⟨V, hV, hgen⟩ := exists_countable_openMass_generation
  obtain ⟨F, hFm, hF⟩ := exists_measurable_openMass_decoder γ V hV
  have hlim : ∀ᵐ ω ∂S.P, IsLQGLimit γ (S.hcirc ω) (S.μ ω) := hcone.2.2
  have hcont := hcone.2.1.ae_continuousOn_circle
  let e : (Set.Ioi (0 : ℝ) × ℂ → ℝ) × Measure ℂ × Unit →
      (Set.Ioi (0 : ℝ) × ℂ → ℝ) × (ℕ → ℝ≥0∞) × Unit := fun q => (q.1, fun n => q.2.1 (V n), q.2.2)
  let Z : Ω → (Set.Ioi (0 : ℝ) × ℂ → ℝ) × Measure ℂ × Unit := fun ω =>
    (circleProcess (S.hcirc ω), S.μ ω, ())
  let g : (Set.Ioi (0 : ℝ) × ℂ → ℝ) → (Set.Ioi (0 : ℝ) × ℂ → ℝ) × (ℕ → ℝ≥0∞) × Unit := fun y =>
    (y, F y, ())
  have hgm : Measurable g := measurable_id.prodMk (hFm.prodMk measurable_const)
  have hae : (e ∘ Z) =ᵐ[S.P] g ∘ (fun ω => circleProcess (S.hcirc ω)) := by
    filter_upwards [hlim, hcont] with ω hl hc
    simp only [Function.comp_apply, e, Z, g]
    rw [hF _ _ hc hl]
  have hind' : IndepFun (e ∘ Z) ηL S.P :=
    (hc0.comp hgm measurable_id).congr hae.symm (ae_eq_refl _)
  have hL : ∀ᵐ ω ∂S.P, Z ω ∈ {q : (Set.Ioi (0 : ℝ) × ℂ → ℝ) × Measure ℂ × Unit |
      IsLocallyFiniteMeasure q.2.1} := by
    filter_upwards [hlim] with ω hl
    exact hl.isLocallyFiniteMeasure
  have hZ : IndepFun Z ηL S.P := indepFun_of_embedding_ae e _ hL (hcomap_prod_openMass V hgen) hind'
  exact hZ.comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd)) measurable_id

end MatedCRT.FirstPass.Derived
