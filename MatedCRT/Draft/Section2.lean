/-- **Fact 2.2** (fact:lqg-measure, line 474). The LQG area measure `μ_h` of the quantum cone satisfies:
* I. (Radon measure) a.s. `μ_h` is a non-atomic Radon (locally finite Borel) measure;
* II. (Locality) for every deterministic open `U`, `μ_h(U)` is a.s. equal to a `σ(h|_U)`-measurable random variable
  (`σ(h|_U)` = `HarmonicBalls.fieldSigmaAlgebra 0 hC U`, generated by the pairings with test functions supported in
  `U`);
* III. (Weyl scaling) a.s., for every continuous `f : ℂ → ℝ`, `e^{γ f} · μ_h = μ_{h + f}`: the measure `e^{γ f} dμ_h` is
  the LQG measure (vague limit of the circle average approximations) of `h + f`;
* IV. (Conformal covariance) a.s., for every complex affine map `φ(z) = a z + w` (`a ≠ 0`), the measure
  `A ↦ μ_h(φ(A))` is the LQG measure of `h ∘ φ + Q log |φ'|`, whose circle averages are
  `(r, z) ↦ h_{|a| r}(a z + w) + Q log |a|`. The printed statement is for all conformal maps between open sets; only
  affine maps are used (lines 578, 2367), and general ones are not expressible with circle averages (ESCALATIONS
  E-A6). -/
def LQGMeasurePropertiesStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  (∀ᵐ ω ∂P, IsLocallyFiniteMeasure (μ ω) ∧ NullSingletonClass (μ ω)) ∧
  (∀ U : Set ℂ, IsOpen U → ∃ X : Ω → ℝ≥0∞, Measurable[fieldSigmaAlgebra 0 hC U] X ∧
    (fun ω => μ ω U) =ᵐ[P] X) ∧
  (∀ᵐ ω ∂P, ∀ f : ℂ → ℝ, Continuous f →
    IsLQGLimit γ (addCircleAverage (hcirc ω) f)
      ((μ ω).withDensity fun x => ENNReal.ofReal (Real.exp (γ * f x)))) ∧
  (∀ᵐ ω ∂P, ∀ a w : ℂ, a ≠ 0 →
    IsLQGLimit γ (fun r z => hcirc ω (‖a‖ * r) (a * z + w) + lqgQ γ * Real.log ‖a‖)
      ((μ ω).map fun x => a⁻¹ * (x - w)))

/-- **Theorem 2.3** (theorem:harmonic-balls, line 509; combination of HB22 Theorems 1.1, 5.5 and Lemma 3.2 for the
quantum cone). On an event of probability one there is a unique family of harmonic balls `{Λ_t}_{t > 0}` for `μ_h`
centred at `0` satisfying (a), (b), (c) (`IsConeHarmonicBallFamily`). Uniqueness: any two such families agree at every
`t > 0`. -/
def ConeHarmonicBallsStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  ∀ᵐ ω ∂P, ∃ Λ : ℝ → Set ℂ, IsConeHarmonicBallFamily (μ ω) Λ ∧
    ∀ Λ' : ℝ → Set ℂ, IsConeHarmonicBallFamily (μ ω) Λ' → EqOn Λ' Λ (Ioi 0)

/-- **Lemma 2.4** (lemma:existence-up-to-fixed-time, line 533). On an event of probability one there is a unique family
of harmonic balls `{Λ_t}_{0 < t < T}` satisfying the properties of Theorem 2.3 with `t ∈ (0, T)`, where
`T = sup {t > 0 : Λ_t ⊆ B_{1/2}}`. The defining property of `T` is `IsStoppedAtHalfBall Λ T` (all `Λ_t ⊆ B_{1/2}` for
`t < T`, and the family is not stopped before reaching `∂B_{1/2}`); uniqueness is uniqueness of the pair `(T, Λ)`. -/
def ConeHarmonicBallsUpToFixedTimeStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  ∀ᵐ ω ∂P, ∃ T : ℝ, 0 < T ∧ ∃ Λ : ℝ → Set ℂ,
    IsConeHarmonicBallFamilyOn (μ ω) Λ T ∧ IsStoppedAtHalfBall Λ T ∧
    ∀ (T' : ℝ) (Λ' : ℝ → Set ℂ), 0 < T' → IsConeHarmonicBallFamilyOn (μ ω) Λ' T' → IsStoppedAtHalfBall Λ' T' →
      T' = T ∧ EqOn Λ' Λ (Ioo 0 T)

/-- **Lemma 2.5** (lemma:scale-invariance-up-to-fixed-time, line 548). Let `{Λ_t}_{0 < t < T}` be the family of
Lemma 2.4 (any random family which a.s. has its properties). For `b > 0` let `R_b` be the cone scale radius
(eq:cone-scale-radius). A.s. there is a unique family of harmonic balls `{Λ^b_t}_{0 < t < b T^b}` for `μ_h`
satisfying the properties of Theorem 2.3 on `(0, b T^b)`, where `T^b = sup {t > 0 : R_b⁻¹ Λ^b_{bt} ⊆ B_{1/2}}`
(`IsStoppedAtHalfBall` for the rescaled family), and the joint laws agree:
`(h, {Λ_t}_{0<t<T}) =d (h(R_b ·) + Q log R_b - γ⁻¹ log b, {R_b⁻¹ Λ^b_{bt}}_{0<t<T^b})`
(the field through all its admissible observables, the family through its indicator process `familyProcess`). The
first assertion of the lemma (equality in law of the families) is the second marginal of the joint law. -/
def ConeScaleInvarianceUpToFixedTimeStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  ∀ (T : Ω → ℝ) (Λ : Ω → ℝ → Set ℂ),
    (∀ᵐ ω ∂P, 0 < T ω ∧ IsConeHarmonicBallFamilyOn (μ ω) (Λ ω) (T ω) ∧ IsStoppedAtHalfBall (Λ ω) (T ω)) →
  ∀ b : ℝ, 0 < b →
    ∃ (Tb : Ω → ℝ) (Λb : Ω → ℝ → Set ℂ),
      (∀ᵐ ω ∂P, 0 < Tb ω ∧ IsConeHarmonicBallFamilyOn (μ ω) (Λb ω) (b * Tb ω) ∧
        IsStoppedAtHalfBall (rescaledFamily (Λb ω) (coneScaleRadius γ (hcirc ω) b) b) (Tb ω) ∧
        ∀ (T' : ℝ) (Λ' : ℝ → Set ℂ), 0 < T' → IsConeHarmonicBallFamilyOn (μ ω) Λ' (b * T') →
          IsStoppedAtHalfBall (rescaledFamily Λ' (coneScaleRadius γ (hcirc ω) b) b) T' →
          T' = Tb ω ∧ EqOn Λ' (Λb ω) (Ioo 0 (b * Tb ω))) ∧
      P.map (fun ω => (fieldProcess (hC ω) (hcirc ω), familyProcess (Λ ω) (T ω))) =
        P.map (fun ω =>
          (fieldProcess (rescaledPairing γ (hC ω) (coneScaleRadius γ (hcirc ω) b) b)
              (rescaledCircle γ (hcirc ω) (coneScaleRadius γ (hcirc ω) b) b),
            familyProcess (rescaledFamily (Λb ω) (coneScaleRadius γ (hcirc ω) b) b) (Tb ω)))

/-- **Lemma 2.6** (lemma:scale-invariance, line 597). For the family `{Λ_t}_{t > 0}` of Theorem 2.3 and each `b > 0`,
`(h, {Λ_t}_{t > 0}) =d (h(R_b ·) + Q log R_b - γ⁻¹ log b, {R_b⁻¹ Λ_{bt}}_{t > 0})`. -/
def ConeScaleInvarianceStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  ∀ Λ : Ω → ℝ → Set ℂ, (∀ᵐ ω ∂P, IsConeHarmonicBallFamily (μ ω) (Λ ω)) →
  ∀ b : ℝ, 0 < b →
    P.map (fun ω => (fieldProcess (hC ω) (hcirc ω), globalFamilyProcess (Λ ω))) =
      P.map (fun ω =>
        (fieldProcess (rescaledPairing γ (hC ω) (coneScaleRadius γ (hcirc ω) b) b)
            (rescaledCircle γ (hcirc ω) (coneScaleRadius γ (hcirc ω) b) b),
          globalFamilyProcess (rescaledFamily (Λ ω) (coneScaleRadius γ (hcirc ω) b) b)))

/-- **Lemma 2.7** (lemma:volume-growth, line 658; BG20 Lemma A.1). For each `β⁺ ∈ (0, (2-γ)²/2)` and
`β⁻ > (2+γ)²/2`, with polynomially high probability as `δ → 0`,
`δ^{β⁻} ≤ μ_h(B_δ(z)) ≤ δ^{β⁺}` for all `z ∈ B_{1-δ}`. -/
def VolumeGrowthStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ βp βm : ℝ, 0 < βp → βp < (2 - γ) ^ 2 / 2 → (2 + γ) ^ 2 / 2 < βm →
  ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  PolyHighProb P fun δ => {ω | ∀ z ∈ ball (0 : ℂ) (1 - δ),
    ENNReal.ofReal (δ ^ βm) ≤ μ ω (ball z δ) ∧ μ ω (ball z δ) ≤ ENNReal.ofReal (δ ^ βp)}

/-- **Lemma 2.8** (lemma:cell-size-estimate, line 669; BG20 Lemma 2.4). Fix `ζ ∈ (0, 1)` and `ρ ∈ (0, 1)`. With
polynomially high probability as `ε → 0`, every cell `H^ε_a` which meets `B_ρ` has
`ε^{2/(2-γ)² + ζ} ≤ diam(H^ε_a) ≤ ε^{2/(2+γ)² - ζ}`. -/
def CellSizeEstimateStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ ζ ρ : ℝ, 0 < ζ → ζ < 1 → 0 < ρ → ρ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω | ∀ k : ℤ, (cell ε (S.η ω) k ∩ ball 0 ρ).Nonempty →
    ε ^ (2 / (2 - γ) ^ 2 + ζ) ≤ diam (cell ε (S.η ω) k) ∧ diam (cell ε (S.η ω) k) ≤ ε ^ (2 / (2 + γ) ^ 2 - ζ)}

/-- **Lemma 2.9** (lemma:mu_h-convergence, line 680; BG20 Lemma A.4). Fix `ρ ∈ (0, 1)`. There are `α = α(γ) > 0` and
`β = β(γ) > 0` such that with polynomially high probability as `ε → 0`: for every `D ⊆ B_ρ`, every nonnegative
`f : B_{ε^α}(D) → [0, ∞)` which is `ε^{-β}`-Lipschitz with `‖f‖_∞ ≤ ε^{-β}`, and every choice of points
`w_a ∈ H^ε_a ∩ cl(D)` (`a ∈ V^ε(D)`),
`ε⁻¹ ∫_D f dμ_h - ε^{-1+α} ≤ ∑_{a ∈ V^ε(D)} f(w_a) ≤ ε⁻¹ ∫_{B_{ε^α}(D)} f dμ_h + ε^{-1+α}`.
(`B_{ε^α}(D)` is `Metric.thickening`; `f` is a function on `ℂ` whose values off `B_{ε^α}(D)` are irrelevant.) -/
def CountingMeasureConvergenceStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ α β : ℝ, 0 < α ∧ 0 < β ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω | ∀ (D : Set ℂ) (f : ℂ → ℝ) (w : ℤ → ℂ), D ⊆ ball 0 ρ →
    (∀ x ∈ thickening (ε ^ α) D, 0 ≤ f x ∧ |f x| ≤ ε ^ (-β)) →
    (∀ x ∈ thickening (ε ^ α) D, ∀ y ∈ thickening (ε ^ α) D, |f x - f y| ≤ ε ^ (-β) * ‖x - y‖) →
    (∀ k ∈ cellVertices ε (S.η ω) D, w k ∈ cell ε (S.η ω) k ∩ closure D) →
    ε⁻¹ * ∫ x in D, f x ∂S.μ ω - ε ^ (-1 + α) ≤ ∑' k : cellVertices ε (S.η ω) D, f (w k) ∧
    ∑' k : cellVertices ε (S.η ω) D, f (w k) ≤ ε⁻¹ * ∫ x in thickening (ε ^ α) D, f x ∂S.μ ω + ε ^ (-1 + α)}

/-- **Lemma 2.10** (lemma:mu_h_degree-convergence, line 698; BG20 Corollary A.6). Let `μ^ε_h` be the measure whose
restriction to each cell `H^ε_a` is `deg^ε(a) μ_h|_{H^ε_a}` (`degreeWeightedMeasure`). Then `μ^ε_h → 6 μ_h` in
probability for the vague topology: for every continuous compactly supported `f`, `∫ f dμ^ε_h → 6 ∫ f dμ_h` in
probability. -/
def DegreeMeasureConvergenceStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  ∀ f : ℂ → ℝ, Continuous f → HasCompactSupport f →
    TendstoInProbability S.P (fun ε ω => ∫ x, f x ∂degreeWeightedMeasure ε (S.η ω) (S.μ ω))
      (fun ω => 6 * ∫ x, f x ∂S.μ ω)

/-- **Theorem 2.11** (theorem:rw-to-lbm, line 735; BG20 Theorem 1.2). For each compact `K ⊆ ℂ` and `z ∈ K`, the
conditional law given `(h, η)` of the embedded linearly interpolated walk `(η(X^{z,ε}_{m_ε t}))_{t ≥ 0}` (started from
`a^ε_z`) converges in probability to the law of the rescaled LBM `X^z` (eq:rescaled-lbm) for the Prokhorov topology of
the local uniform metric on paths. Convergence in probability of the conditional laws is stated through bounded
Lipschitz functionals of paths `F` (for the local uniform distance), which determine the Prokhorov topology: for each
such `F`, `E[F(walk) | h, η] → E[F(X^z) | h]` in probability. -/
def RandomWalkToLBMStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  ∀ K : Set ℂ, IsCompact K → ∀ z ∈ K, ∀ F : (ℝ≥0 → ℂ) → ℝ, IsBoundedLipschitzPathFunctional F →
    TendstoInProbability S.P
      (fun ε ω => ∫ x, F (interpolatedWalk ε (S.η ω) (S.mε ε) x) ∂srwLaw (S.mult ε ω) (vertexOf ε (S.η ω) z))
      (fun ω => ∫ b, F (rescaledLBMPath (S.clock ω) S.m₀ b) ∂planarBrownianMotion z)

/-- **Lemma 2.13** (lemma:maximum-principle, line 824). For every connected `A ⊆ V^ε`, if `u : cl(A) → ℝ` is
subharmonic on `A` then `max_A u ≤ max_{∂A} u`; stated as: every value `u(a)`, `a ∈ A`, is at most some boundary value.
As printed this is FALSE for infinite `A` (e.g. `A = V^ε`, `∂A = ∅`); see ESCALATIONS E-A4 (correction: `A` finite).
Stated a.s., for every `ε > 0`. -/
def MaximumPrincipleStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  ∀ᵐ ω ∂S.P, ∀ ε : ℝ, 0 < ε → ∀ A : Set ℤ, IsVConnected (S.mult ε ω) A → ∀ u : ℤ → ℝ,
    IsSubharmonicOn (S.mult ε ω) u A → ∀ a ∈ A, ∃ b ∈ vBoundary (S.mult ε ω) A, u a ≤ u b

/-- **Lemma 2.14** (lemma:bounded-greens-function, line 843; BG20 Lemma 5.4). There are `β = β(γ) > 0` and
`C = C(ρ, γ) > 0` such that with polynomially high probability as `ε → 0`,
`g^ε_{B_ρ}(a, b) ≤ C log (1/|η(a) - η(b)|) + C` for all `a, b ∈ V^ε(B_ρ)` with `|η(a) - η(b)| ≥ ε^β`. -/
def GreenKernelUpperBoundStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ β : ℝ, 0 < β ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 → ∃ C : ℝ, 0 < C ∧
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω | ∀ a ∈ cellVertices ε (S.η ω) (ball 0 ρ), ∀ b ∈ cellVertices ε (S.η ω) (ball 0 ρ),
    ε ^ β ≤ ‖vertexPoint ε (S.η ω) a - vertexPoint ε (S.η ω) b‖ →
    greenKernel (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball 0 ρ)) a b ≤
      C * Real.log (1 / ‖vertexPoint ε (S.η ω) a - vertexPoint ε (S.η ω) b‖) + C}

/-- **Lemma 2.15** (lemma:greens-function-log-bound, line 857; BG20 Lemma 5.6). For each `ζ ∈ (0, 1)`, with
polynomially high probability as `ε → 0`, `sup_{a, b ∈ V^ε(B_ρ)} G^ε_{B_ρ}(a, b) ≤ ε^{-ζ}`. -/
def GreenFunctionCrudeBoundStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ ρ ζ : ℝ, 0 < ρ → ρ < 1 → 0 < ζ → ζ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω | ∀ a ∈ cellVertices ε (S.η ω) (ball 0 ρ), ∀ b ∈ cellVertices ε (S.η ω) (ball 0 ρ),
    greenFn (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball 0 ρ)) a b ≤ ε ^ (-ζ)}

/-- **Lemma 2.16** (lemma:greens-kernel-lower-bound, line 867; BG20 Lemma 4.4). There are `ω₀ = ω(γ) > 0` and
`C = C(ρ, γ) > 0` such that with polynomially high probability as `ε → 0`: for each `a ∈ V^ε(B_{ρ - ε^{ω₀}})`, each
`r ∈ [ε^{ω₀}, dist(η(a), ∂B_ρ)]` and each `b ∈ V^ε(B_{r/3}(η(a)))`,
`G^ε_{B_r(η(a))}(a, b) ≥ g^ε_{B_r(η(a))}(a, b) ≥ C⁻¹ log ((r/|η(a) - η(b)|) ∧ ε⁻¹) - 1`
(with `r/0 = ∞`, so the minimum is `ε⁻¹` when `η(a) = η(b)`). -/
def GreenKernelLowerBoundStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ ω₀ : ℝ, 0 < ω₀ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 → ∃ C : ℝ, 0 < C ∧
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω | ∀ a ∈ cellVertices ε (S.η ω) (ball 0 (ρ - ε ^ ω₀)), ∀ r : ℝ,
    ε ^ ω₀ ≤ r → r ≤ infDist (vertexPoint ε (S.η ω) a) (sphere 0 ρ) →
    ∀ b ∈ cellVertices ε (S.η ω) (ball (vertexPoint ε (S.η ω) a) (r / 3)),
      greenKernel (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball (vertexPoint ε (S.η ω) a) r)) a b ≤
        greenFn (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball (vertexPoint ε (S.η ω) a) r)) a b ∧
      C⁻¹ * Real.log (if vertexPoint ε (S.η ω) a = vertexPoint ε (S.η ω) b then ε⁻¹
          else min (r / ‖vertexPoint ε (S.η ω) a - vertexPoint ε (S.η ω) b‖) ε⁻¹) - 1 ≤
        greenKernel (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball (vertexPoint ε (S.η ω) a) r)) a b}

/-- **Lemma 2.17** (lemma:bounded-exit-time, line 888). Almost surely `sup_{D ⊆ B_ρ} 𝓜(D) < ∞`, and, for some
deterministic `q = q(γ) > 0`, with polynomially high probability as `δ → 0`, `sup_{y ∈ B_ρ} 𝓜(B_δ(y)) ≤ δ^q`, where
`𝓜(D) = sup_{z ∈ D} ∫_D (log (1/|z - w|) + 1) dμ_h(w)` (`largestExitTimeRV`). -/
def BoundedExitTimeRVStmt : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ q : ℝ, 0 < q ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ), IsConeField γ P hC hcirc μ →
  (∀ᵐ ω ∂P, (⨆ (D : Set ℂ) (_ : D ⊆ ball 0 ρ), largestExitTimeRV (μ ω) D) < ⊤) ∧
  PolyHighProb P fun δ => {ω | ∀ y ∈ ball (0 : ℂ) ρ, largestExitTimeRV (μ ω) (ball y δ) ≤ ENNReal.ofReal (δ ^ q)}

/-- **Lemma 2.18** (lemma:exit-time-upper-bound, line 916; BG20 Proposition 5.1). There are `α = α(γ) > 0` and
`C = C(ρ, γ) > 0` such that with polynomially high probability as `ε → 0`: for every Borel `D ⊆ B_ρ` with
`μ_h(D) ≥ ε^α`, every `a ∈ V^ε(D)` and every `N ∈ ℕ`,
`E[(τ^ε_D(a))^N | h, η] ≤ N! C^N ε^{-N} (sup_{z ∈ D} ∫_{B_{ε^α}(D)} (log (1/|z - w|) + 1) dμ_h(w))^N`;
and, for all `D ⊆ B_ρ` and `a ∈ V^ε(D)`, `q^ε_D(a) ≤ Q^ε_D(a) ≤ C ε⁻¹ 𝓜(B_{ε^α}(D))`. -/
def ExitTimeUpperBoundStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ α : ℝ, 0 < α ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 → ∃ C : ℝ, 0 < C ∧
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P fun ε => {ω |
    (∀ D : Set ℂ, MeasurableSet D → D ⊆ ball 0 ρ → ENNReal.ofReal (ε ^ α) ≤ S.μ ω D →
      ∀ a ∈ cellVertices ε (S.η ω) D, ∀ N : ℕ,
        exitTimeMoment (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a N ≤
          ENNReal.ofReal (N.factorial * C ^ N * ε ^ (-(N : ℝ))) *
            (⨆ z ∈ D, ∫⁻ w in thickening (ε ^ α) D,
              ENNReal.ofReal (Real.log (1 / ‖z - w‖) + 1) ∂S.μ ω) ^ N) ∧
    (∀ D : Set ℂ, D ⊆ ball 0 ρ → ∀ a ∈ cellVertices ε (S.η ω) D,
      ENNReal.ofReal (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a) ≤
        expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a ∧
      expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a ≤
        ENNReal.ofReal (C * ε⁻¹) * largestExitTimeRV (S.μ ω) (thickening (ε ^ α) D))}

/-- **Lemma 2.19** (lemma:expected-exit-time-explicit-bound, line 933). There is `α = α(γ) > 0` such that with
polynomially high probability as `ε → 0`, `q^ε_D ≤ Q^ε_D < ∞` for every Borel `D ⊆ B_ρ` with `μ_h(D) ≥ ε^α`. Moreover,
for some deterministic `q = q(γ) > 0`, with probability tending to `1` as `ε → 0` and then `δ → 0`,
`q^ε_{B_δ(y)} ≤ Q^ε_{B_δ(y)} ≤ ε⁻¹ δ^q` for every `y` with `B_δ(y) ⊆ B_ρ`
("as `ε → 0` and then `δ → 0`": `lim_{δ → 0} limsup_{ε → 0} P[failure] = 0`). -/
def ExpectedExitTimeExplicitBoundStmt (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∃ α q : ℝ, 0 < α ∧ 0 < q ∧ ∀ ρ : ℝ, 0 < ρ → ρ < 1 →
  ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  PolyHighProb S.P (fun ε => {ω | ∀ D : Set ℂ, MeasurableSet D → D ⊆ ball 0 ρ →
    ENNReal.ofReal (ε ^ α) ≤ S.μ ω D → ∀ a : ℤ,
      ENNReal.ofReal (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a) ≤
        expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a ∧
      expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) D) a < ⊤}) ∧
  Tendsto (fun δ => limsup (fun ε => S.P {ω | ¬ ∀ y : ℂ, ball y δ ⊆ ball 0 ρ → ∀ a : ℤ,
      ENNReal.ofReal (normExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball y δ)) a) ≤
        expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball y δ)) a ∧
      expectedExitTime (S.mult ε ω) (interiorCellVertices ε (S.η ω) (ball y δ)) a ≤
        ENNReal.ofReal (ε⁻¹ * δ ^ q)}) (𝓝[>] 0)) (𝓝[>] 0) (𝓝 0)

end MatedCRT
