import MatedCRT.Proofs.Sec3.ConvergenceHarmonicFunctions.CellCover
import MatedCRT.Proofs.Sec3.ConvergenceHarmonicFunctions.DirectIdentification

/-! # Safe cell chains on connected sets -/

namespace MatedCRT

open Set Filter Topology

/-- If equal curve values are generated by boundary-length identifications,
the cells meeting a compact connected set are joined by a walk through any
vertex set containing all cells meeting that set. -/
theorem IsPreconnected.reachable_in_safe_cell_cover
    {ε : ℝ} {η : ℝ → ℂ} {L R : ℝ → ℝ}
    (hε : 0 < ε) (hη : Continuous η)
    (hp : Tendsto η (cocompact ℝ) (cocompact ℂ))
    (hsurj : Function.Surjective η) (hL : Continuous L) (hR : Continuous R)
    (hmerge : ∀ s t, (MatedCRTHarmonic.MatedCRT.DirectRel L s t ∨
      MatedCRTHarmonic.MatedCRT.DirectRel R s t) → η s = η t)
    (hidentify : ∀ s t, η s = η t → Relation.EqvGen (fun a b =>
      MatedCRTHarmonic.MatedCRT.DirectRel L a b ∨
      MatedCRTHarmonic.MatedCRT.DirectRel R a b) s t)
    {K : Set ℂ} (hK : IsPreconnected K) (hcompact : IsCompact K)
    (U : Set ℤ) (hsafe : ∀ j, (K ∩ cell ε η j).Nonempty → j ∈ U)
    {j k : ℤ} (hj : (K ∩ cell ε η j).Nonempty)
    (hk : (K ∩ cell ε η k).Nonempty) :
    ((adjGraph (bmEdgeCount ε L R)).induce U).Reachable
      ⟨j, hsafe j hj⟩ ⟨k, hsafe k hk⟩ := by
  let I : Set ℤ := {i | (K ∩ cell ε η i).Nonempty}
  have hfinite : I.Finite := by
    have h := (locallyFinite_cells_of_proper hη hp hε).finite_nonempty_inter_compact hcompact
    convert h using 1
    ext i
    change (K ∩ cell ε η i).Nonempty ↔ (cell ε η i ∩ K).Nonempty
    exact ⟨fun ⟨x, hx, hy⟩ => ⟨x, hy, hx⟩, fun ⟨x, hx, hy⟩ => ⟨x, hy, hx⟩⟩
  let : Finite I := hfinite.to_subtype
  have hcover : K ⊆ ⋃ i : I, cell ε η i := by
    intro q hq
    obtain ⟨t, rfl⟩ := hsurj q
    have ht : η t ∈ cell ε η ⌈t / ε⌉ := Tightness.mem_cell_ceil hε t
    exact mem_iUnion.mpr ⟨⟨⌈t / ε⌉, ⟨η t, hq, ht⟩⟩, ht⟩
  apply IsPreconnected.reachable_of_finite_closed_face_cover hK
    (fun i : I => cell ε η i) (fun i => (isCompact_Icc.image hη).isClosed)
    hcover ((adjGraph (bmEdgeCount ε L R)).induce U)
    (fun i => ⟨i, hsafe i i.property⟩) ?_ (first := ⟨j, hj⟩)
      (last := ⟨k, hk⟩) hj hk
  intro a b hab
  obtain ⟨q, ⟨hq, hqa⟩, hqb⟩ := hab
  obtain ⟨s, hs, hsq⟩ := hqa
  obtain ⟨t, ht, htq⟩ := hqb
  have hs' : s ∈ Icc (ε * (a : ℤ) - ε) (ε * (a : ℤ)) := by
    simpa only [cell, mul_sub, mul_one] using hs
  have ht' : t ∈ Icc (ε * (b : ℤ) - ε) (ε * (b : ℤ)) := by
    simpa only [cell, mul_sub, mul_one] using ht
  have hqsafe : ∀ v, η v = q → (⌈v / ε⌉ : ℤ) ∈ U := by
    intro v hv
    apply hsafe
    exact ⟨q, hq, hv ▸ Tightness.mem_cell_ceil hε v⟩
  exact reachable_cells_of_directRel_eqvGen hε hL hR hmerge q U hqsafe
    (hsafe a a.property) (hsafe b b.property) hs' ht'
    (hidentify s t (hsq.trans htq.symm)) hsq htq

/-- A clear radial segment joins its endpoint cells by a walk avoiding a disk,
when each cell meeting the segment has diameter at most the clearance. -/
theorem radial_segment_reachable_via_identifications
    {ε : ℝ} {η : ℝ → ℂ} {L R : ℝ → ℝ} {z x e : ℂ}
    {radius inner outer margin diameter : ℝ}
    (hε : 0 < ε) (hη : Continuous η)
    (hp : Tendsto η (cocompact ℝ) (cocompact ℂ))
    (hsurj : Function.Surjective η) (hL : Continuous L) (hR : Continuous R)
    (hmerge : ∀ s t, (MatedCRTHarmonic.MatedCRT.DirectRel L s t ∨
      MatedCRTHarmonic.MatedCRT.DirectRel R s t) → η s = η t)
    (hidentify : ∀ s t, η s = η t → Relation.EqvGen (fun a b =>
      MatedCRTHarmonic.MatedCRT.DirectRel L a b ∨
      MatedCRTHarmonic.MatedCRT.DirectRel R a b) s t)
    (hclear : ∀ t ∈ Icc inner outer, ∀ y ∈ Metric.ball z radius,
      margin < dist (x + t • e) y)
    (hdiam : ∀ i, (((fun t : ℝ => x + t • e) '' Icc inner outer) ∩
      cell ε η i).Nonempty → ∀ u ∈ cell ε η i, ∀ v ∈ cell ε η i,
      dist u v ≤ diameter)
    (hmargin : diameter ≤ margin) {j k : ℤ}
    (hj : (((fun t : ℝ => x + t • e) '' Icc inner outer) ∩ cell ε η j).Nonempty)
    (hk : (((fun t : ℝ => x + t • e) '' Icc inner outer) ∩ cell ε η k).Nonempty) :
    ∃ hjSafe : j ∉ cellVertices ε η (Metric.ball z radius),
    ∃ hkSafe : k ∉ cellVertices ε η (Metric.ball z radius),
      ((adjGraph (bmEdgeCount ε L R)).induce (cellVertices ε η (Metric.ball z radius))ᶜ).Reachable
        ⟨j, hjSafe⟩ ⟨k, hkSafe⟩ := by
  let K := (fun t : ℝ => x + t • e) '' Icc inner outer
  have hsafe : ∀ i, (K ∩ cell ε η i).Nonempty →
      i ∈ (cellVertices ε η (Metric.ball z radius))ᶜ := by
    intro i hi
    obtain ⟨q, ⟨t, ht, rfl⟩, hq⟩ := hi
    apply cell_not_mem_cellVertices_ball_of_near_clear_segment hclear
      (buffer := 0) (diameter := diameter)
      ⟨t, ht, x + t • e, hq, by simp⟩ (hdiam i ⟨x + t • e, ⟨t, ht, rfl⟩, hq⟩)
    simpa using hmargin
  refine ⟨hsafe j hj, hsafe k hk, ?_⟩
  exact IsPreconnected.reachable_in_safe_cell_cover hε hη hp hsurj hL hR hmerge
    hidentify (outward_radial_segment_compact_preconnected x e inner outer).2
    (outward_radial_segment_compact_preconnected x e inner outer).1 _ hsafe hj hk

end MatedCRT
