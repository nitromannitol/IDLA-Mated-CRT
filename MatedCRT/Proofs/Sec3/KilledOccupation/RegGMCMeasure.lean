import MatedCRT.Proofs.Sec3.KilledOccupation.RegClockFun

/-!
# Regularized Gaussian multiplicative chaos measure, measurable in the circle-average family

Step B3 of MQ-li-8 (b) (transfer of thm:occ-main): the regularized Gaussian multiplicative chaos measure
`ε^{γ²/2} e^{γ h_ε(x)} dx` on the ball `B_ρ`, where `h_ε` is the circle-average representative
`circleAverageRep` of step B1 (`RegClockFun.lean`). It is the B1 construction with the clock integrand
`ε^{γ²/2} exp(γ ψ̃(ε, b_u))` replaced by Lebesgue measure on the ball.

The file proves only the definition and the joint measurability: `(ψ, x) ↦ regGMCDensity γ ε ψ x` is measurable,
and `ψ ↦ regGMCMeasure γ ε ρ ψ` is measurable for the σ-algebra of the Borel-measure valued maps (evaluations on
measurable sets). The limit of these measures as `ε → 0` (the Gaussian multiplicative chaos limit Γ of B3) is not
stated here.

The density is a nonnegative measurable function, and the measure is `withDensity` of the restriction of Lebesgue
measure to the ball, in the sense of Duplantier-Sheffield (Gaussian free field and Liouville quantum gravity) and
Berestycki-Powell (Gaussian multiplicative chaos). The measurability uses Tonelli's theorem for the product of the
parameter space and `ℂ` (`Measurable.lintegral_prod_right'`).
-/

open MeasureTheory Set Filter Topology Metric MarkovProcess HarmonicBalls
open scoped ENNReal NNReal

namespace MatedCRT.KilledOccupation

/-- B3 of MQ-li-8 (b): the regularized GMC density `x ↦ ε^{γ²/2} e^{γ h_ε(x)}` for the circle-average family `ψ`,
with `h_ε(x) = circleAverageRep ψ ε x` the circle-average representative of step B1. -/
noncomputable def regGMCDensity (γ ε : ℝ) (ψ : UnitDiskCircleIndex → ℝ) (x : ℂ) : ℝ≥0∞ :=
  ENNReal.ofReal (ε ^ (γ ^ 2 / 2) * Real.exp (γ * circleAverageRep ψ ε x))

/-- B3 of MQ-li-8 (b): the regularized Gaussian multiplicative chaos measure `ε^{γ²/2} e^{γ h_ε(x)} dx` on the ball
`B_ρ(0)`, for the circle-average family `ψ` (Duplantier-Sheffield; Berestycki-Powell), given by `withDensity` of
Lebesgue measure restricted to the ball. -/
noncomputable def regGMCMeasure (γ ε ρ : ℝ) (ψ : UnitDiskCircleIndex → ℝ) : Measure ℂ :=
  (volume.restrict (Metric.ball (0 : ℂ) ρ)).withDensity (regGMCDensity γ ε ψ)

/-- The regularized GMC density is jointly measurable in the circle-average family and the point `x`. -/
theorem measurable_regGMCDensity (γ ε : ℝ) :
    Measurable fun q : (UnitDiskCircleIndex → ℝ) × ℂ => regGMCDensity γ ε q.1 q.2 :=
  measurable_ofReal_exp_mul (ε ^ (γ ^ 2 / 2)) γ (measurable_circleAverageRep ε)

/-- The regularized GMC measure `regGMCMeasure γ ε ρ ψ` is a measurable function of the circle-average family `ψ`,
for the σ-algebra of Borel-measure valued maps generated by the evaluations on measurable sets. -/
theorem measurable_regGMCMeasure (γ ε ρ : ℝ) :
    Measurable fun ψ : UnitDiskCircleIndex → ℝ => regGMCMeasure γ ε ρ ψ := by
  refine Measure.measurable_of_measurable_coe _ fun s hs => ?_
  have hEq : (fun ψ : UnitDiskCircleIndex → ℝ => regGMCMeasure γ ε ρ ψ s) =
      fun ψ => ∫⁻ x, regGMCDensity γ ε ψ x ∂((volume.restrict (Metric.ball (0 : ℂ) ρ)).restrict s) := by
    funext ψ
    rw [regGMCMeasure, withDensity_apply _ hs]
  rw [hEq]
  exact (measurable_regGMCDensity γ ε).lintegral_prod_right'

end MatedCRT.KilledOccupation
