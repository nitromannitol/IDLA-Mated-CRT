import Mathlib

/-!
# Agreement event for two occupation measures on a generating π-system

Step B4 of the MQ-li-8 (b) argument (transfer of the occupation measure identity of thm:occ-main to the cone;
notes/fp-gaps/MATH-ANSWERS.md). For measurable families `m₁ m₂ : α → Measure ℂ` (for instance the killed occupation
measures of two environments, indexed by the environment `a`), the set of parameters on which `m₁ a` is finite on `D`
and agrees with `m₂ a` on a countable family `C` is measurable (`measurableSet_occupationAgreementEvent`). On this
event the two measures agree on every measurable subset of `D`, provided `D ∈ C`, the members of `C` are measurable
subsets of `D`, `C` is a π-system and the σ-algebra generated by `C` contains the measurable subsets of `D`
(`eq_of_mem_occupationAgreementEvent`). The proof is Dynkin's π-λ theorem in the form
`MeasurableSpace.induction_on_inter` (Billingsley, Probability and Measure).

Terminology: occupation measure and killed occupation measure as in Armstrong-Kuusi-Mourrat; the density
`withDensity` and the Gaussian multiplicative chaos measure as in Duplantier-Sheffield and Berestycki-Powell.
-/

open MeasureTheory Set Filter Function
open scoped ENNReal

namespace MatedCRT.KilledOccupation

/-- The family `a ↦ (Γ a).withDensity g` is measurable when `Γ` is measurable and `g` is a measurable density.
For a measurable set `S`, `(Γ a).withDensity g S = ∫⁻ x, S.indicator g x ∂(Γ a)`, which is measurable in `a` by the
measurability of `μ ↦ ∫⁻ f dμ` (Giry monad, `Measure.measurable_lintegral`). -/
theorem measurable_withDensity_of_measurable {α : Type*} [MeasurableSpace α] {Γ : α → Measure ℂ}
    (hΓ : Measurable Γ) {g : ℂ → ℝ≥0∞} (hg : Measurable g) :
    Measurable fun a => (Γ a).withDensity g := by
  refine Measure.measurable_of_measurable_coe _ fun S hS => ?_
  have h : (fun a => (Γ a).withDensity g S) = fun a => ∫⁻ x, S.indicator g x ∂(Γ a) := by
    funext a
    rw [withDensity_apply _ hS, lintegral_indicator hS]
  rw [h]
  exact (Measure.measurable_lintegral (hg.indicator hS)).comp hΓ

/-- The occupation-agreement event `{a | m₁ a D < ∞ and m₁ a S = m₂ a S for all S ∈ C}`. -/
def occupationAgreementEvent {α : Type*} (m₁ m₂ : α → Measure ℂ) (D : Set ℂ) (C : Set (Set ℂ)) : Set α :=
  {a | m₁ a D < ∞ ∧ ∀ S ∈ C, m₁ a S = m₂ a S}

/-- The occupation-agreement event is measurable, for measurable families `m₁ m₂`, a countable family `C` of
measurable sets and a measurable set `D`. -/
theorem measurableSet_occupationAgreementEvent {α : Type*} [MeasurableSpace α] {m₁ m₂ : α → Measure ℂ}
    {D : Set ℂ} {C : Set (Set ℂ)} (hm₁ : Measurable m₁) (hm₂ : Measurable m₂)
    (hC : C.Countable) (hCm : ∀ S ∈ C, MeasurableSet S) (hD : MeasurableSet D) :
    MeasurableSet (occupationAgreementEvent m₁ m₂ D C) := by
  have hfin : MeasurableSet {a | m₁ a D < ∞} :=
    measurableSet_lt ((Measure.measurable_coe hD).comp hm₁) measurable_const
  have heq : ∀ S ∈ C, MeasurableSet {a | m₁ a S = m₂ a S} := fun S hS =>
    measurableSet_eq_fun ((Measure.measurable_coe (hCm S hS)).comp hm₁)
      ((Measure.measurable_coe (hCm S hS)).comp hm₂)
  have hset : occupationAgreementEvent m₁ m₂ D C =
      {a | m₁ a D < ∞} ∩ ⋂ S ∈ C, {a | m₁ a S = m₂ a S} := by
    ext a
    simp [occupationAgreementEvent]
  rw [hset]
  exact hfin.inter (MeasurableSet.biInter hC heq)

/-- Uniqueness on the agreement event (Dynkin's π-λ theorem). If `m₁ a D < ∞`, `D ∈ C`, the members of the π-system
`C` are measurable subsets of `D`, and `m₁ a`, `m₂ a` agree on `C`, then they agree on every measurable subset of
`D`, provided the σ-algebra generated by `C` contains the measurable subsets of `D`. -/
theorem eq_of_mem_occupationAgreementEvent {α : Type*} [MeasurableSpace α] {m₁ m₂ : α → Measure ℂ}
    {D : Set ℂ} {C : Set (Set ℂ)} (hDC : D ∈ C) (hCD : ∀ S ∈ C, S ⊆ D) (hCm : ∀ S ∈ C, MeasurableSet S)
    (hpi : IsPiSystem C)
    (hgen : ∀ S, MeasurableSet S → S ⊆ D → MeasurableSet[MeasurableSpace.generateFrom C] S)
    {a : α} (ha : a ∈ occupationAgreementEvent m₁ m₂ D C) :
    ∀ S, MeasurableSet S → S ⊆ D → m₁ a S = m₂ a S := by
  obtain ⟨hfin, hagree⟩ := ha
  have hD : MeasurableSet D := hCm D hDC
  have hle : MeasurableSpace.generateFrom C ≤ (inferInstance : MeasurableSpace ℂ) :=
    MeasurableSpace.generateFrom_le hCm
  have hDeq : m₁ a D = m₂ a D := hagree D hDC
  -- Dynkin's theorem for the traces on `D` of the sets in `σ(C)`.
  have key : ∀ T (hT : MeasurableSet[MeasurableSpace.generateFrom C] T),
      m₁ a (T ∩ D) = m₂ a (T ∩ D) := by
    intro T hT
    refine MeasurableSpace.induction_on_inter (C := fun T _ => m₁ a (T ∩ D) = m₂ a (T ∩ D))
      rfl hpi ?_ ?_ ?_ ?_ T hT
    · show m₁ a (∅ ∩ D) = m₂ a (∅ ∩ D)
      simp
    · intro t ht
      show m₁ a (t ∩ D) = m₂ a (t ∩ D)
      rw [inter_eq_left.2 (hCD t ht)]
      exact hagree t ht
    · intro t htm hteq
      have hteq' : m₁ a (t ∩ D) = m₂ a (t ∩ D) := hteq
      have hcompl : tᶜ ∩ D = D \ (t ∩ D) := by
        ext x
        simp only [mem_inter_iff, mem_compl_iff, Set.mem_sdiff]
        tauto
      have htD : MeasurableSet (t ∩ D) := (hle t htm).inter hD
      have h1fin : m₁ a (t ∩ D) ≠ ∞ := ((measure_mono inter_subset_right).trans_lt hfin).ne
      have h2fin : m₂ a (t ∩ D) ≠ ∞ := by rw [← hteq']; exact h1fin
      show m₁ a (tᶜ ∩ D) = m₂ a (tᶜ ∩ D)
      rw [hcompl, measure_sdiff inter_subset_right htD.nullMeasurableSet h1fin,
        measure_sdiff inter_subset_right htD.nullMeasurableSet h2fin, hDeq, hteq']
    · intro f hdisj hfm hf
      show m₁ a ((⋃ i, f i) ∩ D) = m₂ a ((⋃ i, f i) ∩ D)
      have hdisj' : Pairwise (Disjoint on fun i => f i ∩ D) := fun i j hij =>
        Disjoint.mono inter_subset_left inter_subset_left (hdisj hij)
      have hm' : ∀ i, MeasurableSet (f i ∩ D) := fun i => (hle _ (hfm i)).inter hD
      rw [Set.iUnion_inter, measure_iUnion hdisj' hm', measure_iUnion hdisj' hm']
      exact tsum_congr hf
  intro S hS hSD
  have hSg := hgen S hS hSD
  have hkey := key S hSg
  rwa [inter_eq_left.2 hSD] at hkey

end MatedCRT.KilledOccupation
