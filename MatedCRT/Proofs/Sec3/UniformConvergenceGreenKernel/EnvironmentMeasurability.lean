import MatedCRT.Proofs.Sec3.DiscretePotentialTightness.SelectionStep
import Mathlib.MeasureTheory.Function.FactorsThrough
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap

/-! # Boundary lengths as a measurable function of the field and curve -/

namespace MatedCRT

open MeasureTheory Filter Topology Set HarmonicBalls

/-- The space-filling curve has a continuous version measurable with respect
to the sigma-algebra it generates. -/
theorem MatedCRTEnv.IsValid.exists_envSigma_measurable_curve
    {Ω : Type} [MeasurableSpace Ω] {S : MatedCRTEnv Ω}
    {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) :
    ∃ η : Ω → C(ℝ, ℂ), Measurable[S.envSigma] η ∧
      ∀ᵐ ω ∂S.P, ⇑(η ω) = S.η ω := by
  let coeCurve : C(ℝ, ℂ) → (ℝ → ℂ) := fun f => f
  have hsigma : (inferInstance : MeasurableSpace C(ℝ, ℂ)) =
      MeasurableSpace.comap coeCurve inferInstance := by
    rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
    simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup,
      MeasurableSpace.comap_comp, Function.comp_def, coeCurve]
  have hid : Measurable[MeasurableSpace.comap coeCurve inferInstance]
      (id : C(ℝ, ℂ) → C(ℝ, ℂ)) := by
    rw [← hsigma]
    exact measurable_id
  obtain ⟨G, hG, hGid⟩ := hid.exists_eq_measurable_comp
  have hηm := Tightness.measurable_eta_of_envSigma S
  have hη : Measurable[S.envSigma] S.η := by
    let : MeasurableSpace Ω := S.envSigma
    apply measurable_pi_iff.mpr
    exact hηm
  refine ⟨G ∘ S.η, hG.comp hη, ?_⟩
  obtain ⟨X, X₀, hIG₀, B, B', B₀, B₀', U, ηL, η', η₀, hc, htie⟩ := hS.matingOfTrees
  filter_upwards [htie] with ω hω
  have h' : G (S.η ω) = η' ω := by
    rw [← hω.1]
    exact (congrFun hGid (η' ω)).symm
  exact (congrArg (fun f : C(ℝ, ℂ) => (f : ℝ → ℂ)) h').trans hω.1

/-- The boundary-length Brownian path has a version measurable with respect to
 the sigma-algebra generated by the field and the space-filling curve. -/
theorem MatedCRTEnv.IsValid.exists_envSigma_measurable_bm
    {Ω : Type} [MeasurableSpace Ω] {S : MatedCRTEnv Ω}
    {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) :
    ∃ B : Ω → C(ℝ, ℝ × ℝ), Measurable[S.envSigma] B ∧
      ∀ᵐ ω ∂S.P, B ω = S.bm ω := by
  obtain ⟨X, X₀, hIG₀, B, B', B₀, B₀', U, ηL, η', η₀, hc, htie⟩ := hS.matingOfTrees
  obtain ⟨BL, hBL, hBLae, -⟩ := hc.boundaryLength
  let F : MatedCRTHarmonic.MatedCRT.Field × C(ℝ, ℂ) →
      (LQGMetric.TestC → ℝ) × (ℝ → ℂ) :=
    fun p => (fun φ => p.1 φ, p.2)
  have hsigma : (inferInstance : MeasurableSpace
      (MatedCRTHarmonic.MatedCRT.Field × C(ℝ, ℂ))) =
      MeasurableSpace.comap F inferInstance := by
    change ((inferInstance : MeasurableSpace MatedCRTHarmonic.MatedCRT.Field).prod
        (inferInstance : MeasurableSpace C(ℝ, ℂ))) = _
    change _ = (MeasurableSpace.prod (inferInstance : MeasurableSpace (LQGMetric.TestC → ℝ))
      (inferInstance : MeasurableSpace (ℝ → ℂ))).comap (Prod.map
      (fun f : MatedCRTHarmonic.MatedCRT.Field => fun φ : LQGMetric.TestC => f φ)
      (fun f : C(ℝ, ℂ) => (f : ℝ → ℂ)))
    rw [MeasurableSpace.comap_prodMap]
    congr 1
    change _ = MeasurableSpace.comap (fun f : C(ℝ, ℂ) => (f : ℝ → ℂ)) inferInstance
    rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
    simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,
      Function.comp_def]
  have hBL' : Measurable[MeasurableSpace.comap F inferInstance] BL := by
    rw [← hsigma]
    exact hBL
  obtain ⟨G, hG, hGeq⟩ := hBL'.exists_eq_measurable_comp
  let data : Ω → (LQGMetric.TestC → ℝ) × (ℝ → ℂ) :=
    fun ω => (fun φ => S.hC ω φ, S.η ω)
  have hηm := Tightness.measurable_eta_of_envSigma S
  have hdata : Measurable[S.envSigma] data := by
    let : MeasurableSpace Ω := S.envSigma
    apply Measurable.prodMk
    · apply measurable_pi_iff.mpr
      intro φ
      apply measurable_iff_comap_le.mpr
      apply le_sup_of_le_left
      apply le_iSup_of_le (φ : ℂ → ℝ)
      apply le_iSup_of_le ⟨φ.contDiff, φ.hasCompactSupport, subset_univ _⟩
      simp [fieldPairing]
    · apply measurable_pi_iff.mpr
      intro t
      exact hηm t
  refine ⟨G ∘ data, hG.comp hdata, ?_⟩
  filter_upwards [hBLae, htie] with ω hω hη
  have heq : data ω = F (MatedCRTHarmonic.MatedCRT.coneField (X ω)
      (MatedCRTHarmonic.MatedCRT.coneRadial γ γ (fun u => B u ω) (fun u => B' u ω)), η' ω) := by
    apply Prod.ext
    · funext φ
      exact hη.2 φ
    · exact hη.1.symm
  rw [hω, hGeq]
  exact congrArg G heq

end MatedCRT
