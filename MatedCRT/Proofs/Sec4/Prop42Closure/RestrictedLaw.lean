import Mathlib.MeasureTheory.Constructions.Cylinders
import Mathlib.MeasureTheory.Measure.GiryMonad
import Mathlib.MeasureTheory.Measure.Typeclasses.Finite
import Mathlib.MeasureTheory.Constructions.Polish.Basic
import Mathlib.MeasureTheory.PiSystem
import Mathlib.Probability.IdentDistrib

/-!
# From open-set masses to the law of a restricted random measure (item (ii) of the restricted LQG law, z5)

Operator ruling (task `z5-prop42-restricted-lqg-law`, item (ii)): passing from the masses of a random measure on a
family of sets to the law of the measure restricted to `S = B_1` is pure measure theory.

A family `𝒬` is an admissible *trace π-system* for `S` when it is a π-system of measurable subsets of `S`, contains `S`,
and its traces generate the measurable subsets of `S` (hypothesis `hgen`). For example, the finite intersections of a
countable base of the topology, intersected with `S`, form such a family.

Main results:
* `exists_measurable_mass_eq`: on `{ν S < ∞}`, the mass of `A ∩ S` is a measurable function of the masses of the members
  of `𝒬` (Dynkin's π-λ argument).
* `identDistrib_restrict_of_finiteDim`: two random measures on `E`, concentrated on `S` with finite mass on `S`, have the
  same law (`IdentDistrib`) as soon as the joint laws of their masses on finitely many members of `𝒬` agree.
  No countability is needed: the product σ-algebra on `𝒬 → ℝ≥0∞` is generated by finite-dimensional cylinders.
-/

open MeasureTheory Set Filter Function ProbabilityTheory
open scoped ENNReal

namespace MatedCRT.RestrictedLaw

variable {E : Type*} [MeasurableSpace E]

/-- The masses of the members of a family `𝒬` of sets, as a point of the product `𝒬 → ℝ≥0∞`. -/
def massFamily (𝒬 : Set (Set E)) (ν : Measure E) : 𝒬 → ℝ≥0∞ := fun Q => ν (Q : Set E)

theorem measurable_massFamily {𝒬 : Set (Set E)} (h𝒬 : ∀ Q ∈ 𝒬, MeasurableSet Q) :
    Measurable (massFamily 𝒬) :=
  Measurable.of_eval fun Q : 𝒬 => Measure.measurable_coe (h𝒬 Q.1 Q.2)

/-- A measure with no mass outside `S` gives the same mass to `A` and to `A ∩ S`. -/
theorem measure_inter_eq_of_compl_null {ν : Measure E} {S : Set E} (hS : MeasurableSet S) (hν : ν Sᶜ = 0)
    (A : Set E) : ν (A ∩ S) = ν A := by
  have h0 : ν (A \ S) = 0 := measure_mono_null (fun _ hx => hx.2) hν
  have h := measure_inter_add_sdiff A hS (μ := ν)
  rw [h0, add_zero] at h
  exact h

/-- **Dynkin step.** Let `𝒬` be a π-system of measurable subsets of `S` containing `S`, whose traces on `S` generate
the measurable subsets of `S`. On `{ν S < ∞}`, the mass of `A ∩ S` is a measurable function of the masses of `𝒬`. -/
theorem exists_measurable_mass_eq {S : Set E} {𝒬 : Set (Set E)} (hpi : IsPiSystem 𝒬)
    (hQ : ∀ Q ∈ 𝒬, MeasurableSet Q ∧ Q ⊆ S) (hSQ : S ∈ 𝒬)
    (hgen : ∀ A : Set E, MeasurableSet A → MeasurableSet[MeasurableSpace.generateFrom 𝒬] (A ∩ S))
    (A : Set E) (hA : MeasurableSet A) :
    ∃ g : (𝒬 → ℝ≥0∞) → ℝ≥0∞, Measurable g ∧
      ∀ ν : Measure E, ν S ≠ ∞ → g (massFamily 𝒬 ν) = ν (A ∩ S) := by
  have hSm : MeasurableSet S := (hQ S hSQ).1
  have hmle : MeasurableSpace.generateFrom 𝒬 ≤ (inferInstance : MeasurableSpace E) :=
    MeasurableSpace.generateFrom_le fun Q hQ' => (hQ Q hQ').1
  have key : ∀ B : Set E, MeasurableSet[MeasurableSpace.generateFrom 𝒬] B →
      ∃ g : (𝒬 → ℝ≥0∞) → ℝ≥0∞, Measurable g ∧
        ∀ ν : Measure E, ν S ≠ ∞ → g (massFamily 𝒬 ν) = ν (B ∩ S) := by
    intro B hB
    refine MeasurableSpace.induction_on_inter (m := MeasurableSpace.generateFrom 𝒬) (s := 𝒬)
      (C := fun B _ => ∃ g : (𝒬 → ℝ≥0∞) → ℝ≥0∞, Measurable g ∧
        ∀ ν : Measure E, ν S ≠ ∞ → g (massFamily 𝒬 ν) = ν (B ∩ S))
      rfl hpi ?_ ?_ ?_ ?_ B hB
    · exact ⟨fun _ => 0, measurable_const, fun ν _ => by simp⟩
    · intro t ht
      refine ⟨fun y => y ⟨t, ht⟩, measurable_pi_apply _, fun ν _ => ?_⟩
      show ν t = ν (t ∩ S)
      rw [inter_eq_left.mpr (hQ t ht).2]
    · intro B' hB' hgB
      obtain ⟨g, hgm, hgv⟩ := hgB
      refine ⟨fun y => y ⟨S, hSQ⟩ - g y, (measurable_pi_apply _).sub hgm, fun ν hν => ?_⟩
      have hB'm : MeasurableSet B' := hmle _ hB'
      have hset : B'ᶜ ∩ S = S \ (B' ∩ S) := by
        ext x
        simp only [mem_inter_iff, mem_compl_iff, Set.mem_sdiff]
        tauto
      have hfin : ν (B' ∩ S) ≠ ∞ := ne_top_of_le_ne_top hν (measure_mono inter_subset_right)
      show ν S - g (massFamily 𝒬 ν) = ν (B'ᶜ ∩ S)
      rw [hgv ν hν, hset, measure_sdiff inter_subset_right (hB'm.inter hSm).nullMeasurableSet hfin]
    · intro f hdisj hfm hf
      choose g hgm hgv using hf
      refine ⟨fun y => ∑' n, g n y, Measurable.tsum hgm, fun ν hν => ?_⟩
      have hm : ∀ n, MeasurableSet (f n ∩ S) := fun n => (hmle _ (hfm n)).inter hSm
      have hd : Pairwise (Disjoint on fun n => f n ∩ S) := fun i j hij =>
        (hdisj hij).mono inter_subset_left inter_subset_left
      show ∑' n, g n (massFamily 𝒬 ν) = ν ((⋃ n, f n) ∩ S)
      rw [Set.iUnion_inter, measure_iUnion (μ := ν) hd fun n => hm n]
      exact tsum_congr fun n => hgv n ν hν
  obtain ⟨g, hg, hgv⟩ := key (A ∩ S) (hgen A hA)
  refine ⟨g, hg, fun ν hν => ?_⟩
  rw [hgv ν hν, inter_assoc, inter_self]

/-- The mass-event transfer: for `A ∈ t`, the mass of `A ∩ S` is `g A` of the mass vector, so on `{Y S < ∞}` the event
`{Y ∈ ⋂_{A ∈ t} {ν A ∈ B A}}` agrees with the event that the mass vector lies in `{y | ∀ A ∈ t, g A y ∈ B A}`. -/
theorem ae_mass_event_eq {Ω₀ : Type*} [MeasurableSpace Ω₀] {μ₀ : Measure Ω₀} {Y : Ω₀ → Measure E} {S : Set E}
    (hS : MeasurableSet S) {𝒬 : Set (Set E)} (t : Finset (Set E)) (B : Set E → Set ℝ≥0∞)
    (g : Set E → (𝒬 → ℝ≥0∞) → ℝ≥0∞)
    (hg : ∀ i ∈ t, ∀ ν : Measure E, ν S ≠ ∞ → g i (massFamily 𝒬 ν) = ν (i ∩ S))
    (hYS : ∀ ω, Y ω Sᶜ = 0) (hfin : ∀ᵐ ω ∂μ₀, Y ω S ≠ ∞) :
    (Y ⁻¹' {ν : Measure E | ∀ i ∈ t, ν i ∈ B i}) =ᵐ[μ₀]
      ((fun ω => massFamily 𝒬 (Y ω)) ⁻¹' {y : 𝒬 → ℝ≥0∞ | ∀ i ∈ t, g i y ∈ B i}) := by
  refine Filter.eventuallyEqSet_iff.2 ?_
  filter_upwards [hfin] with ω hω
  simp only [mem_preimage, mem_ofPred_eq]
  have hiff : ∀ i ∈ t, (Y ω i ∈ B i ↔ g i (massFamily 𝒬 (Y ω)) ∈ B i) := by
    intro i hi
    rw [hg i hi (Y ω) hω, measure_inter_eq_of_compl_null hS (hYS ω) i]
  exact ⟨fun h i hi => (hiff i hi).1 (h i hi), fun h i hi => (hiff i hi).2 (h i hi)⟩

/-- **Core of item (ii).** Let `S` be measurable and `𝒬` a trace π-system for `S` (see the module docstring).
Two random measures `X`, `X'` on `E`, each concentrated on `S` with finite mass on `S` almost surely, have the same
law as soon as the joint laws of their masses on finitely many members of `𝒬` agree. -/
theorem identDistrib_restrict_of_finiteDim {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    {P : Measure Ω} {P' : Measure Ω'} [IsProbabilityMeasure P] [IsProbabilityMeasure P']
    {S : Set E} {𝒬 : Set (Set E)} (hpi : IsPiSystem 𝒬)
    (hQ : ∀ Q ∈ 𝒬, MeasurableSet Q ∧ Q ⊆ S) (hSQ : S ∈ 𝒬)
    (hgen : ∀ A : Set E, MeasurableSet A → MeasurableSet[MeasurableSpace.generateFrom 𝒬] (A ∩ S))
    {X : Ω → Measure E} {X' : Ω' → Measure E}
    (hX : AEMeasurable X P) (hX' : AEMeasurable X' P')
    (hXS : ∀ ω, X ω Sᶜ = 0) (hX'S : ∀ ω, X' ω Sᶜ = 0)
    (hXfin : ∀ᵐ ω ∂P, X ω S ≠ ∞) (hX'fin : ∀ᵐ ω ∂P', X' ω S ≠ ∞)
    (hfd : ∀ (I : Finset 𝒬) (s : Set (I → ℝ≥0∞)), MeasurableSet s →
      P ((fun (ω : Ω) (i : I) => massFamily 𝒬 (X ω) i.1) ⁻¹' s) =
        P' ((fun (ω' : Ω') (i : I) => massFamily 𝒬 (X' ω') i.1) ⁻¹' s)) :
    IdentDistrib X X' P P' := by
  classical
  have hmeasQ : ∀ Q ∈ 𝒬, MeasurableSet Q := fun Q hQ' => (hQ Q hQ').1
  have hSm : MeasurableSet S := (hQ S hSQ).1
  have hΦ : Measurable (massFamily 𝒬 : Measure E → 𝒬 → ℝ≥0∞) := measurable_massFamily hmeasQ
  have hΦX : AEMeasurable (fun ω => massFamily 𝒬 (X ω)) P := hΦ.comp_aemeasurable hX
  have hΦX' : AEMeasurable (fun ω => massFamily 𝒬 (X' ω)) P' := hΦ.comp_aemeasurable hX'
  -- Step 1: the joint law of all the masses on `𝒬` (the product σ-algebra is generated by cylinders).
  have hprod : P.map (fun ω => massFamily 𝒬 (X ω)) = P'.map (fun ω => massFamily 𝒬 (X' ω)) := by
    refine ext_of_generate_finite (measurableCylinders fun _ : 𝒬 => ℝ≥0∞)
      generateFrom_measurableCylinders.symm isPiSystem_measurableCylinders ?_ ?_
    · intro t ht
      obtain ⟨I, s, hs, rfl⟩ := (mem_measurableCylinders _).1 ht
      rw [Measure.map_apply_of_aemeasurable hΦX (MeasurableSet.cylinder I hs),
        Measure.map_apply_of_aemeasurable hΦX' (MeasurableSet.cylinder I hs)]
      exact hfd I s hs
    · simp
  -- Step 2: the events `{ν ∈ ⋂_{A ∈ t} {ν A ∈ B A}}` for finitely many measurable `A`.
  have hK : ∀ (t : Finset (Set E)), (∀ i ∈ t, MeasurableSet i) → ∀ B : Set E → Set ℝ≥0∞,
      (∀ i ∈ t, MeasurableSet (B i)) →
      P (X ⁻¹' {ν | ∀ i ∈ t, ν i ∈ B i}) = P' (X' ⁻¹' {ν | ∀ i ∈ t, ν i ∈ B i}) := by
    intro t ht B hB
    have hg : ∀ A : Set E, ∃ g : (𝒬 → ℝ≥0∞) → ℝ≥0∞, MeasurableSet A →
        Measurable g ∧ ∀ ν : Measure E, ν S ≠ ∞ → g (massFamily 𝒬 ν) = ν (A ∩ S) := by
      intro A
      by_cases hA : MeasurableSet A
      · obtain ⟨g, hg1, hg2⟩ := exists_measurable_mass_eq hpi hQ hSQ hgen A hA
        exact ⟨g, fun _ => ⟨hg1, hg2⟩⟩
      · exact ⟨fun _ => 0, fun h => absurd h hA⟩
    choose g hg using hg
    have hgv : ∀ i ∈ t, ∀ ν : Measure E, ν S ≠ ∞ → g i (massFamily 𝒬 ν) = ν (i ∩ S) :=
      fun i hi ν hν => (hg i (ht i hi)).2 ν hν
    have hHm : MeasurableSet {y : 𝒬 → ℝ≥0∞ | ∀ i ∈ t, g i y ∈ B i} := by
      have hH : {y : 𝒬 → ℝ≥0∞ | ∀ i ∈ t, g i y ∈ B i} = ⋂ i ∈ t, (g i) ⁻¹' (B i) := by
        ext y
        simp
      rw [hH]
      exact Finset.measurableSet_biInter t fun i hi => (hg i (ht i hi)).1 (hB i hi)
    calc P (X ⁻¹' {ν | ∀ i ∈ t, ν i ∈ B i})
        = P ((fun ω => massFamily 𝒬 (X ω)) ⁻¹' {y | ∀ i ∈ t, g i y ∈ B i}) :=
          measure_congr (ae_mass_event_eq hSm t B g hgv hXS hXfin)
      _ = (P.map fun ω => massFamily 𝒬 (X ω)) {y | ∀ i ∈ t, g i y ∈ B i} :=
          (Measure.map_apply_of_aemeasurable hΦX hHm).symm
      _ = (P'.map fun ω => massFamily 𝒬 (X' ω)) {y | ∀ i ∈ t, g i y ∈ B i} := by rw [hprod]
      _ = P' ((fun ω => massFamily 𝒬 (X' ω)) ⁻¹' {y | ∀ i ∈ t, g i y ∈ B i}) :=
          Measure.map_apply_of_aemeasurable hΦX' hHm
      _ = P' (X' ⁻¹' {ν | ∀ i ∈ t, ν i ∈ B i}) :=
          (measure_congr (ae_mass_event_eq hSm t B g hgv hX'S hX'fin)).symm
  -- Step 3: the laws agree on the π-system of finite intersections of cylinder events.
  have hmain : P.map X = P'.map X' := by
    let π : Set E → Set (Set (Measure E)) := fun A =>
      {G : Set (Measure E) | MeasurableSet[MeasurableSpace.comap (fun ν : Measure E => ν A) inferInstance] G}
    have hgenerate : (inferInstance : MeasurableSpace (Measure E)) =
        MeasurableSpace.generateFrom (piiUnionInter π {A : Set E | MeasurableSet A}) := by
      have h := generateFrom_piiUnionInter_measurableSet
        (fun A : Set E => MeasurableSpace.comap (fun ν : Measure E => ν A) (inferInstance : MeasurableSpace ℝ≥0∞))
        {A : Set E | MeasurableSet A}
      rw [h]
      rfl
    refine ext_of_generate_finite _ hgenerate
      (isPiSystem_piiUnionInter π
        (fun A s hs t ht _ => @MeasurableSet.inter (Measure E)
          (MeasurableSpace.comap (fun ν : Measure E => ν A) inferInstance) s t hs ht) _) ?_ ?_
    · rintro s ⟨t, hS, f, hπ, rfl⟩
      have ht' : ∀ i ∈ t, MeasurableSet i := fun i hi => hS (Finset.mem_coe.2 hi)
      have hfB : ∀ i ∈ t, ∃ B : Set ℝ≥0∞, MeasurableSet B ∧ (fun ν : Measure E => ν i) ⁻¹' B = f i :=
        fun i hi => MeasurableSpace.measurableSet_comap.1 (hπ i hi)
      choose! B hBm hBf using hfB
      have hset : (⋂ i ∈ t, f i) = {ν : Measure E | ∀ i ∈ t, ν i ∈ B i} := by
        ext ν
        simp only [mem_iInter, mem_ofPred_eq]
        constructor
        · intro h i hi
          have h' := h i hi
          rw [← hBf i hi] at h'
          exact h'
        · intro h i hi
          rw [← hBf i hi]
          exact h i hi
      have hfm : ∀ i ∈ t, MeasurableSet (f i) := by
        intro i hi
        rw [← hBf i hi]
        exact Measure.measurable_coe (ht' i hi) (hBm i hi)
      rw [Measure.map_apply_of_aemeasurable hX (Finset.measurableSet_biInter t hfm),
        Measure.map_apply_of_aemeasurable hX' (Finset.measurableSet_biInter t hfm), hset]
      exact hK t ht' B hBm
    · rw [Measure.map_apply_of_aemeasurable hX MeasurableSet.univ,
        Measure.map_apply_of_aemeasurable hX' MeasurableSet.univ]
      simp
  exact ⟨hX, hX', hmain⟩

/-! ### A countable trace π-system for an open set

The finite intersections of the countable base of a second countable space form a countable π-system of open sets
containing `univ` and generating the Borel σ-algebra. Its traces on an open set `S` give the family `𝒬` required by
`identDistrib_restrict_of_finiteDim`. -/

/-- The finite intersections of the countable base `TopologicalSpace.countableBasis E`. -/
def basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] : Set (Set E) :=
  {s | ∃ T : Set (Set E), T.Finite ∧ T ⊆ TopologicalSpace.countableBasis E ∧ s = ⋂₀ T}

theorem inter_mem_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] {s t : Set E}
    (hs : s ∈ basisPiSystem E) (ht : t ∈ basisPiSystem E) : s ∩ t ∈ basisPiSystem E := by
  obtain ⟨T₁, hT₁, hB₁, rfl⟩ := hs
  obtain ⟨T₂, hT₂, hB₂, rfl⟩ := ht
  exact ⟨T₁ ∪ T₂, hT₁.union hT₂, Set.union_subset hB₁ hB₂, (Set.sInter_union T₁ T₂).symm⟩

theorem isPiSystem_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] :
    IsPiSystem (basisPiSystem E) :=
  fun _ hs _ ht _ => inter_mem_basisPiSystem E hs ht

theorem countable_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] :
    (basisPiSystem E).Countable := by
  refine Set.Countable.mono ?_ ((Set.countable_ofPred_finite_subset
    (TopologicalSpace.countable_countableBasis E)).image (fun T : Set (Set E) => ⋂₀ T))
  rintro s ⟨T, hT, hB, rfl⟩
  exact ⟨T, ⟨hT, hB⟩, rfl⟩

theorem univ_mem_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] :
    (Set.univ : Set E) ∈ basisPiSystem E :=
  ⟨∅, Set.finite_empty, Set.empty_subset _, Set.sInter_empty.symm⟩

theorem isOpen_of_mem_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] {s : Set E}
    (hs : s ∈ basisPiSystem E) : IsOpen s := by
  obtain ⟨T, hT, hB, rfl⟩ := hs
  exact hT.isOpen_sInter fun t ht => TopologicalSpace.isOpen_of_mem_countableBasis (hB ht)

theorem borel_le_generateFrom_basisPiSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] :
    borel E ≤ MeasurableSpace.generateFrom (basisPiSystem E) := by
  rw [(TopologicalSpace.isBasis_countableBasis E).borel_eq_generateFrom]
  refine MeasurableSpace.generateFrom_le fun t ht => MeasurableSpace.measurableSet_generateFrom ?_
  exact ⟨{t}, Set.finite_singleton t, Set.singleton_subset_iff.2 ht, (Set.sInter_singleton t).symm⟩

/-- **Trace π-system of an open set.** For an open `S ⊆ E` there is a countable π-system `𝒬` of open subsets of `S`,
containing `S`, whose traces generate the measurable subsets of `S`; this is the hypothesis family of
`identDistrib_restrict_of_finiteDim`. The members are open, which the locality input (A) requires. -/
theorem exists_traceSystem (E : Type*) [TopologicalSpace E] [SecondCountableTopology E] [MeasurableSpace E]
    [BorelSpace E] {S : Set E} (hS : IsOpen S) :
    ∃ 𝒬 : Set (Set E), 𝒬.Countable ∧ IsPiSystem 𝒬 ∧ (∀ Q ∈ 𝒬, IsOpen Q ∧ Q ⊆ S) ∧ S ∈ 𝒬 ∧
      ∀ A : Set E, MeasurableSet A → MeasurableSet[MeasurableSpace.generateFrom 𝒬] (A ∩ S) := by
  refine ⟨(fun Q => Q ∩ S) '' basisPiSystem E, (countable_basisPiSystem E).image _, ?_, ?_, ?_, ?_⟩
  · rintro _ ⟨Q₁, hQ₁, rfl⟩ _ ⟨Q₂, hQ₂, rfl⟩ _
    refine ⟨Q₁ ∩ Q₂, inter_mem_basisPiSystem E hQ₁ hQ₂, ?_⟩
    ext x
    simp only [Set.mem_inter_iff]
    tauto
  · rintro _ ⟨Q, hQ, rfl⟩
    exact ⟨(isOpen_of_mem_basisPiSystem E hQ).inter hS, Set.inter_subset_right⟩
  · exact ⟨Set.univ, univ_mem_basisPiSystem E, Set.univ_inter S⟩
  · intro A hA
    have hb : MeasurableSet[borel E] A := by
      rw [← BorelSpace.measurable_eq]
      exact hA
    have hA' : MeasurableSet[MeasurableSpace.generateFrom (basisPiSystem E)] A :=
      borel_le_generateFrom_basisPiSystem E A hb
    have hSm : MeasurableSet[MeasurableSpace.generateFrom ((fun Q => Q ∩ S) '' basisPiSystem E)] S :=
      MeasurableSpace.measurableSet_generateFrom ⟨Set.univ, univ_mem_basisPiSystem E, Set.univ_inter S⟩
    refine MeasurableSpace.induction_on_inter (m := MeasurableSpace.generateFrom (basisPiSystem E))
      (s := basisPiSystem E)
      (C := fun B _ => MeasurableSet[MeasurableSpace.generateFrom ((fun Q => Q ∩ S) '' basisPiSystem E)] (B ∩ S))
      rfl (isPiSystem_basisPiSystem E) ?_ ?_ ?_ ?_ A hA'
    · rw [Set.empty_inter]
      exact @MeasurableSet.empty E (MeasurableSpace.generateFrom ((fun Q => Q ∩ S) '' basisPiSystem E))
    · intro t ht
      exact MeasurableSpace.measurableSet_generateFrom ⟨t, ht, rfl⟩
    · intro B' _ hB'
      have hset : B'ᶜ ∩ S = S \ (B' ∩ S) := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_sdiff]
        tauto
      rw [hset]
      exact hSm.diff hB'
    · intro f _ _ hC
      rw [Set.iUnion_inter]
      exact MeasurableSet.iUnion hC

end MatedCRT.RestrictedLaw
