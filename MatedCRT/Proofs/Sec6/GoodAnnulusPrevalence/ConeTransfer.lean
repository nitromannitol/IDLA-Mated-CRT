import MatedCRT.Steps.Sec6.GoodAnnulusPrevalence
import MatedCRT.Proofs.Field.Translation

/-!
# Lemma 6.6 for the cone field on annuli centred at `z` (IR-c4-5, `AnnulusIterateConeTransferStep`)

The proof of Lemma 6.4 (line 2392) applies Lemma 6.6, which is stated for the whole-plane GFF and annuli centred at `0`,
to the cone field `h` and annuli `𝔸_{s₁ r_k, s₂ r_k}(z) ⊆ B_1`. The transfer:

* by eq:gff (`ConeMeanZeroRestrictionStep`), the mean-zero pairings of `h` supported in `B_1` have the law of those of
  `h^ℂ - γ log |·|`, i.e. of `(h^ℂ, φ) - γ ∫ φ log |·|`;
* by translation invariance of `h^ℂ` modulo additive constant (`MatedCRT.Field.IsWholePlaneGFF.map_pairing_translate`,
  proved from the covariance), they also have the law of `(h^ℂ, φ(· + z)) - γ ∫ φ log |·|`;
* an event determined by `h|_{𝔸(z)}` modulo additive constant is `{(h, φ)_{φ ∈ 𝒯(𝔸(z))} ∈ S}` up to a null set, where
  `𝒯(U)` is the set of test functions supported in `U` with mean zero (`modConstSigma_le_comap`). The event
  `{((h^ℂ, φ(· + z)) - γ ∫ φ log |·|)_{φ ∈ 𝒯(𝔸(z))} ∈ S}` is determined by `h^ℂ|_{𝔸(0)}` modulo additive constant
  (`measurable_translatedPairings`), and the joint law of the events over `k` is the same.

Lemma 6.6 for `h^ℂ` then gives the bound for the cone field with the same `p` and `C`.
-/

namespace MatedCRT

open MeasureTheory ProbabilityTheory Filter Set Metric HarmonicBalls
open scoped ENNReal

namespace ConeTransfer

/-- The test functions supported in `U` with `∫ φ = 0`: the pairings of a field with them are its observables on `U`
modulo additive constant. -/
abbrev MeanZeroTest (U : Set ℂ) : Type := {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0}

/-- The pairings `(h, φ)`, `φ ∈ 𝒯(U)`. -/
def pairings {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) : Ω → MeanZeroTest U → ℝ :=
  fun ω φ => hC ω φ.1

lemma isTestFunction_mono {U V : Set ℂ} (hUV : U ⊆ V) {φ : ℂ → ℝ} (hφ : IsTestFunction U φ) :
    IsTestFunction V φ :=
  ⟨hφ.1, hφ.2.1, hφ.2.2.trans hUV⟩

/-- `σ(h|_U` modulo additive constant`)` is generated by the process of pairings with `𝒯(U)`. -/
lemma modConstSigma_le_comap {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    modConstSigma hC U ≤ MeasurableSpace.comap (pairings hC U) MeasurableSpace.pi := by
  unfold modConstSigma
  refine iSup₂_le fun φ hφ => ?_
  have h : (fun ω => hC ω φ) = (fun f : MeanZeroTest U → ℝ => f ⟨φ, hφ⟩) ∘ pairings hC U := rfl
  rw [h, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

/-- The translated pairings `((h, φ(· + z)) - c(φ))_{φ ∈ 𝒯(U)}` are determined by `h|_{U - z}` modulo additive
constant. -/
lemma measurable_translatedPairings {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (z : ℂ)
    (c : (ℂ → ℝ) → ℝ) :
    Measurable[modConstSigma hC ((fun x => x + z) ⁻¹' U)]
      (fun ω (φ : MeanZeroTest U) => hC ω (fun x => φ.1 (x + z)) - c φ.1) := by
  let _ : MeasurableSpace Ω := modConstSigma hC ((fun x => x + z) ⁻¹' U)
  refine measurable_pi_iff.2 fun φ => Measurable.sub_const ?_ _
  have hφ : IsTestFunction ((fun x => x + z) ⁻¹' U) (fun x => φ.1 (x + z)) ∧ ∫ x, φ.1 (x + z) = 0 :=
    ⟨Field.isTestFunction_translate φ.2.1 z, (Field.integral_translate φ.1 z).trans φ.2.2⟩
  exact (comap_measurable (fun ω => hC ω fun x => φ.1 (x + z))).mono
    (le_iSup₂ (f := fun ψ (_ : IsTestFunction ((fun x => x + z) ⁻¹' U) ψ ∧ ∫ x, ψ x = 0) =>
      MeasurableSpace.comap (fun ω => hC ω ψ) inferInstance) _ hφ) le_rfl

/-- `𝔸_{a,b}(z) - z = 𝔸_{a,b}(0)`. -/
lemma annulus_translate (z : ℂ) (a b : ℝ) : (fun x => x + z) ⁻¹' annulus z a b = annulus 0 a b := by
  ext x
  simp [annulus, Metric.mem_ball, Metric.mem_closedBall, dist_eq_norm]

end ConeTransfer

open ConeTransfer in
/-- **Lemma 6.6 for the cone field on annuli centred at any `z`** (IR-c4-5), from eq:gff on mean-zero pairings
(`ConeMeanZeroRestrictionStep`) and the translation invariance of the whole-plane GFF modulo additive constant. -/
theorem annulusIterateConeTransfer (hR : ConeMeanZeroRestrictionStep) : AnnulusIterateConeTransferStep := by
  intro h66 s₁ s₂ hs₁ hs₁₂ hs₂ α hα
  obtain ⟨p, C, hp, hp1, hCpos, hiter⟩ := h66 s₁ s₂ hs₁ hs₁₂ hs₂ α hα
  refine ⟨p, C, hp, hp1, hCpos, ?_⟩
  intro γ hγ hγ2 Ω _ P hC hcirc μ hcone z r E hr hrpos hratio hsub hloc hprob K
  have hPprob : IsProbabilityMeasure P := hcone.1
  have hcq : IsQuantumCone γ P hC hcirc := hcone.2.1
  obtain ⟨Ω', mΩ', P', hC', hcirc', hP', hgff, -⟩ := hcq.lateral_law
  -- the pairings with mean-zero test functions in `B_1`, for `h` and for the translated `h^ℂ - γ log |·|`
  let c : (ℂ → ℝ) → ℝ := fun φ => γ * ∫ x, φ x * Real.log ‖x‖
  let X : Ω → MeanZeroTest (ball 0 1) → ℝ := pairings hC (ball 0 1)
  let Ψ : Ω' → MeanZeroTest (ball 0 1) → ℝ := fun ω φ => hC' ω (fun x => φ.1 (x + z)) - c φ.1
  have huniv : ∀ φ : MeanZeroTest (ball 0 1), IsTestFunction univ φ.1 :=
    fun φ => isTestFunction_mono (subset_univ _) φ.2.1
  have hunivz : ∀ φ : MeanZeroTest (ball 0 1), IsTestFunction univ fun x => φ.1 (x + z) :=
    fun φ => by simpa using Field.isTestFunction_translate (huniv φ) z
  have hXm : Measurable X := Measurable.of_eval fun φ => hcq.measurable_pairing _ (huniv φ)
  have hΨm : Measurable Ψ :=
    Measurable.of_eval fun φ => (hgff.measurable_pairing _ (hunivz φ)).sub_const _
  -- the two families have the same law
  have hlaw : P.map X = P'.map Ψ := by
    let M : (MeanZeroTest (ball 0 1) → ℝ) → (MeanZeroTest (ball 0 1) → ℝ) := fun f φ => f φ - c φ.1
    have hM : Measurable M := Measurable.of_eval fun φ => (measurable_pi_apply φ).sub_const _
    let U₁ : Ω' → MeanZeroTest (ball 0 1) → ℝ := fun ω φ => hC' ω φ.1
    let U₂ : Ω' → MeanZeroTest (ball 0 1) → ℝ := fun ω φ => hC' ω fun x => φ.1 (x + z)
    have hU₁ : Measurable U₁ := Measurable.of_eval fun φ => hgff.measurable_pairing _ (huniv φ)
    have hU₂ : Measurable U₂ := Measurable.of_eval fun φ => hgff.measurable_pairing _ (hunivz φ)
    have h1 : P.map X = P'.map (M ∘ U₁) := hR γ hγ hγ2 Ω P hC hcirc hPprob hcq Ω' P' hC' hcirc' hgff
    have h2 : P'.map U₁ = P'.map U₂ :=
      Field.IsWholePlaneGFF.map_pairing_translate hgff z (fun φ : MeanZeroTest (ball 0 1) => φ.1) huniv
        fun φ => φ.2.2
    calc P.map X = P'.map (M ∘ U₁) := h1
      _ = (P'.map U₁).map M := (Measure.map_map hM hU₁).symm
      _ = (P'.map U₂).map M := by rw [h2]
      _ = P'.map (M ∘ U₂) := Measure.map_map hM hU₂
      _ = P'.map Ψ := rfl
  -- the events as preimages under the pairing processes
  have hrep : ∀ k, ∃ S : Set (MeanZeroTest (annulus z (s₁ * r k) (s₂ * r k)) → ℝ), MeasurableSet S ∧
      E k =ᵐ[P] pairings hC (annulus z (s₁ * r k) (s₂ * r k)) ⁻¹' S := by
    intro k
    obtain ⟨E', hE'm, hEE'⟩ := hloc k
    obtain ⟨S, hSm, rfl⟩ :=
      MeasurableSpace.measurableSet_comap.1 (modConstSigma_le_comap hC _ E' hE'm)
    exact ⟨S, hSm, hEE'⟩
  choose S hSm hES using hrep
  let res : ∀ k, (MeanZeroTest (ball 0 1) → ℝ) → (MeanZeroTest (annulus z (s₁ * r k) (s₂ * r k)) → ℝ) :=
    fun k f φ => f ⟨φ.1, isTestFunction_mono (hsub k) φ.2.1, φ.2.2⟩
  have hres : ∀ k, Measurable (res k) := fun k => Measurable.of_eval fun φ => measurable_pi_apply _
  let F : ℕ → Set Ω' := fun k => (fun ω => res k (Ψ ω)) ⁻¹' S k
  have hFm : ∀ k, MeasurableSet[modConstSigma hC' (annulus 0 (s₁ * r k) (s₂ * r k))] (F k) := by
    intro k
    have h := measurable_translatedPairings hC' (annulus z (s₁ * r k) (s₂ * r k)) z c
    rw [annulus_translate] at h
    exact h (hSm k)
  have hPF : ∀ k, P (E k) = P' (F k) := by
    intro k
    rw [measure_congr (hES k)]
    calc P (pairings hC (annulus z (s₁ * r k) (s₂ * r k)) ⁻¹' S k) = P (X ⁻¹' (res k ⁻¹' S k)) := rfl
      _ = P.map X (res k ⁻¹' S k) := (Measure.map_apply hXm (hres k (hSm k))).symm
      _ = P'.map Ψ (res k ⁻¹' S k) := by rw [hlaw]
      _ = P' (Ψ ⁻¹' (res k ⁻¹' S k)) := Measure.map_apply hΨm (hres k (hSm k))
      _ = P' (F k) := rfl
  -- the event that none of `E_1, ..., E_K` occurs
  let B : Set (MeanZeroTest (ball 0 1) → ℝ) := {f | ∀ k ∈ Finset.Icc 1 K, f ∉ res k ⁻¹' S k}
  have hBm : MeasurableSet B := by
    have hB : B = ⋂ k ∈ Finset.Icc 1 K, (res k ⁻¹' S k)ᶜ := by
      ext f
      simp [B]
    rw [hB]
    exact Finset.measurableSet_biInter _ fun k _ => (hres k (hSm k)).compl
  have hall : ∀ᵐ ω ∂P, ∀ k, (ω ∈ E k ↔ ω ∈ pairings hC (annulus z (s₁ * r k) (s₂ * r k)) ⁻¹' S k) :=
    ae_all_iff.2 fun k => Filter.EventuallyEqSet.mem_iff (hES k)
  have hset : {ω | ∀ k ∈ Finset.Icc 1 K, ω ∉ E k} =ᵐ[P] X ⁻¹' B := by
    refine Filter.eventuallyEqSet_iff.2 (hall.mono fun ω hω => ?_)
    show (∀ k ∈ Finset.Icc 1 K, ω ∉ E k) ↔ ∀ k ∈ Finset.Icc 1 K, X ω ∉ res k ⁻¹' S k
    exact forall₂_congr fun k _ => not_congr (hω k)
  calc P {ω | ∀ k ∈ Finset.Icc 1 K, ω ∉ E k} = P (X ⁻¹' B) := measure_congr hset
    _ = P.map X B := (Measure.map_apply hXm hBm).symm
    _ = P'.map Ψ B := by rw [hlaw]
    _ = P' (Ψ ⁻¹' B) := Measure.map_apply hΨm hBm
    _ = P' {ω | ∀ k ∈ Finset.Icc 1 K, ω ∉ F k} := rfl
    _ ≤ ENNReal.ofReal (C * Real.exp (-α * K)) :=
      hiter Ω' P' hC' hcirc' hP' hgff r F hr hrpos hratio (fun k => ⟨F k, hFm k, Filter.EventuallyEq.rfl⟩)
        (fun k => by rw [← hPF k]; exact hprob k) K

/-- **Lemma 6.4 from Lemmas 6.5, 6.6, eq:gff and the locality step** (proof lines 2387-2400). -/
theorem goodAnnulusPrevalence_of_restriction (h66 : AnnulusIterateStmt) (h65 : AnnulusHitStmt)
    (hR : ConeMeanZeroRestrictionStep) (hL : GoodAnnulusEventLocalityStep) :
    GoodAnnulusPrevalenceStmt :=
  goodAnnulusPrevalence_of_steps h66 h65 (annulusIterateConeTransfer hR) hL

end MatedCRT
