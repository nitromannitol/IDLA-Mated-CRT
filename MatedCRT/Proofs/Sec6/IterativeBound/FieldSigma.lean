import MatedCRT.Steps.Sec6.IterativeBound

/-!
# The field is a random variable (`FieldSigmaMeasurableStep`)

`σ(h)` (`MatedCRTEnv.fieldSigma`, generated by the pairings `(h, φ)` with test functions `φ`) is contained in the
σ-algebra of `Ω`: each pairing is a random variable (`IsQuantumCone.measurable_pairing`, Definition 2.1). This is the
`σ(h)` half of `EnvSigmaMeasurableStep` (ESCALATIONS E-c2-1); the `σ(η)` half is not needed for Lemma 6.10.
-/

namespace MatedCRT

open MeasureTheory HarmonicBalls

/-- `σ(h) ≤ 𝓕` for a valid environment: the pairings of the field with test functions are random variables. -/
theorem MatedCRTEnv.fieldSigma_le {Ω : Type} [mΩ : MeasurableSpace Ω] (S : MatedCRTEnv Ω)
    {𝒮 : SpaceFillingSLEModel} {γ : ℝ} (hS : S.IsValid 𝒮 γ) : S.fieldSigma ≤ mΩ := by
  simp only [MatedCRTEnv.fieldSigma, fieldSigmaAlgebra]
  refine iSup₂_le fun φ hφ => ?_
  have hm : Measurable fun ω => fieldPairing 0 (S.hC ω) φ := by
    simpa [fieldPairing] using hS.isQuantumCone.measurable_pairing φ hφ
  exact hm.comap_le

/-- **`FieldSigmaMeasurableStep`** holds for every space-filling SLE model. -/
theorem fieldSigmaMeasurableStep (𝒮 : SpaceFillingSLEModel) : FieldSigmaMeasurableStep 𝒮 :=
  fun _ _ _ _ _ S hS => S.fieldSigma_le hS

end MatedCRT
