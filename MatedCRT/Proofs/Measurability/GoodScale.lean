import MatedCRT.Steps.Sec6.ConstantOrderLowerBoundDiv

/-!
# Measurability of the good-scale events of Lemmas 6.4 and 2.7 (`GoodScaleEventMeasurableStep`, line 2505)

**Deterministic part (proved).** The events of Lemma 6.4 (`GoodAnnulusCover`) and of Lemma 2.7 (`VolumeGrowthAt`) at a
fixed scale `δ` are measurable sets of measures (for the σ-algebra of `Measure ℂ` generated by the evaluations
`m ↦ m(B)`): `measurableSet_goodAnnulusCover`, `measurableSet_volumeGrowthAt`. They involve suprema and infima over the
points of annuli and balls, reduced to countable operations as follows.
* `m(B_s(w)) = sup {m(B_t(q)) : q ∈ D, t ∈ ℚ, |w - q| + t < s}` for a countable dense `D`
  (`measure_ball_eq_iSup_rational`), so `w ↦ m(B_s(w))` is a countable supremum of `m(B_t(q)) 1_{U_{q,t}}` with
  `U_{q,t}` open.
* For such a function and a compact `K`, `inf_K = sup_{F finite, K ⊆ ⋃_F U} min_F` by compactness
  (`iInf_mem_compact_eq_iSup_finset`); an annulus is a countable union of compact sets
  (`annulus_eq_iUnion_isCompact`). Suprema over any set are countable suprema (`iSup_mem_eq_iSup_nonempty`).
* `v ↦ ∫_A log(r / |u - v|) + 1 dm(u)` is lower semicontinuous (Fatou, `logKernel_le_liminf`), so its supremum over
  an open set is the supremum over a countable dense subset (`iSup_logPotential_eq_iSup_inter_dense`).

**Stochastic part: the step is not provable as stated.** `GoodScaleEventMeasurableStep` asks for `F ∈ σ(h)` with
`F ⊆ E` *pointwise*. In `MatedCRTEnv.IsValid` the LQG measure is tied to the field only almost surely
(`IsLQGMeasure P γ hcirc μ := ∀ᵐ ω, IsLQGLimit γ (hcirc ω) (μ ω)`, and the circle averages are tied to the pairings only
through their joint law, `IsQuantumCone.lateral_law`). Hence on the product `Ω × [0, 1]` of a valid environment with an
independent uniform variable `U`, redefining `μ := 0` on the null set `N = {U = 1/2}` keeps the environment valid,
makes `{VolumeGrowthAt μ βp βm δ} ⊆ Nᶜ`, and every `σ(h)`-measurable set containing `N` is the whole space: the only
admissible `F` is empty, while `P[VolumeGrowthAt]` is close to `1` for small `δ` (Lemma 2.7).

The proof of Lemma 6.8 (MatedCRT/Proofs/Sec6/ConstantOrderLowerBoundDiv/OfSteps.lean, lines 257-283: Borel-Cantelli
over dyadic `δ` and `probTendsToOne_of_ae`) only needs `F ⊆ E` outside a `P`-null set: this is
`GoodScaleEventMeasurableAEStep`, which follows from the deterministic part and `LQGMeasureFieldMeasurableStep` (the
LQG measure is almost surely equal to a `σ(h)`-measurable random measure) by
`goodScaleEventMeasurableAEStep_of_lqgMeasure`.
-/

open MeasureTheory ProbabilityTheory Filter Topology Set Metric HarmonicBalls
open scoped ENNReal NNReal

namespace MatedCRT

/-! ## Countable reduction of infima and suprema -/

/-- For `g = sup_i a_i 1_{U_i}` with `U_i` open and `K` compact, `inf_K g = sup_{F finite, K ⊆ ⋃_F U} min_F a`. -/
theorem iInf_mem_compact_eq_iSup_finset {X ι : Type*} [TopologicalSpace X] {U : ι → Set X}
    (hU : ∀ i, IsOpen (U i)) (a : ι → ℝ≥0∞) (g : X → ℝ≥0∞)
    (hg : ∀ x, g x = ⨆ i, ⨆ (_ : x ∈ U i), a i) {K : Set X} (hK : IsCompact K) :
    ⨅ x ∈ K, g x = ⨆ (F : Finset ι) (_ : K ⊆ ⋃ i ∈ F, U i), ⨅ i ∈ F, a i := by
  apply le_antisymm
  · refine le_of_forall_lt fun b hb => ?_
    have hcov : K ⊆ ⋃ j : {i // b < a i}, U j.1 := by
      intro x hx
      have h1 : b < g x := hb.trans_le (iInf₂_le x hx)
      rw [hg x] at h1
      obtain ⟨i, hi⟩ := lt_iSup_iff.1 h1
      obtain ⟨hxi, hbi⟩ := lt_iSup_iff.1 hi
      exact mem_iUnion.2 ⟨⟨i, hbi⟩, hxi⟩
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun j : {i // b < a i} => U j.1) (fun j => hU j.1) hcov
    have hcovF : K ⊆ ⋃ i ∈ t.map (Function.Embedding.subtype _), U i := by
      intro x hx
      obtain ⟨j, hj, hxj⟩ := mem_iUnion₂.1 (ht hx)
      exact mem_iUnion₂.2 ⟨j.1, Finset.mem_map_of_mem _ hj, hxj⟩
    refine lt_of_lt_of_le ?_ (le_iSup₂_of_le (t.map (Function.Embedding.subtype _)) hcovF le_rfl)
    rw [← Finset.inf_eq_iInf, Finset.lt_inf_iff (hb.trans_le le_top)]
    intro i hi
    obtain ⟨j, -, rfl⟩ := Finset.mem_map.1 hi
    exact j.2
  · refine iSup₂_le fun F hF => le_iInf₂ fun x hx => ?_
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 (hF hx)
    rw [hg x]
    exact (iInf₂_le i hi).trans (le_iSup₂_of_le i hxi le_rfl)

/-- For `g = sup_i a_i 1_{U_i}`, `sup_A g = sup {a_i : A ∩ U_i ≠ ∅}`. -/
theorem iSup_mem_eq_iSup_nonempty {X ι : Type*} (U : ι → Set X) (a : ι → ℝ≥0∞) (g : X → ℝ≥0∞)
    (hg : ∀ x, g x = ⨆ i, ⨆ (_ : x ∈ U i), a i) (A : Set X) :
    ⨆ x ∈ A, g x = ⨆ i, ⨆ (_ : (A ∩ U i).Nonempty), a i := by
  apply le_antisymm
  · refine iSup₂_le fun x hx => ?_
    rw [hg x]
    exact iSup₂_le fun i hxi => le_iSup₂_of_le i ⟨x, hx, hxi⟩ le_rfl
  · refine iSup₂_le fun i hi => ?_
    obtain ⟨x, hx, hxi⟩ := hi
    refine le_iSup₂_of_le x hx ?_
    rw [hg x]
    exact le_iSup₂_of_le i hxi le_rfl

/-- The mass of an open ball as a countable supremum: for a dense `D`,
`m(B_s(w)) = sup {m(B_t(q)) : q ∈ D, t ∈ ℚ, |w - q| + t < s}`. -/
theorem measure_ball_eq_iSup_rational {D : Set ℂ} (hD : Dense D) (m : Measure ℂ) (w : ℂ) (s : ℝ) :
    m (ball w s) = ⨆ i : D × ℚ, ⨆ (_ : w ∈ {x : ℂ | dist x i.1 + i.2 < s}), m (ball (i.1 : ℂ) i.2) := by
  apply le_antisymm
  · have hU : ball w s = ⋃ n : ℕ, ball w (s - 1 / ((n : ℝ) + 1)) := by
      ext x
      simp only [mem_ball, mem_iUnion]
      constructor
      · intro hx
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.2 hx)
        exact ⟨n, by linarith⟩
      · rintro ⟨n, hn⟩
        have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
        linarith
    have hmono : Monotone fun n : ℕ => ball w (s - 1 / ((n : ℝ) + 1)) := by
      intro i j hij
      apply ball_subset_ball
      have hij' : (i : ℝ) + 1 ≤ (j : ℝ) + 1 := by
        have : (i : ℝ) ≤ j := by exact_mod_cast hij
        linarith
      have := one_div_le_one_div_of_le (by positivity : (0 : ℝ) < (i : ℝ) + 1) hij'
      linarith
    rw [hU]
    refine le_of_tendsto' (tendsto_measure_iUnion_atTop hmono) fun n => ?_
    show m (ball w (s - 1 / ((n : ℝ) + 1))) ≤ _
    have hg : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨y, hyD, hy⟩ := hD.exists_dist_lt w (div_pos hg (by norm_num : (0 : ℝ) < 3))
    obtain ⟨t, ht1, ht2⟩ := exists_rat_btwn
      (by linarith : s - 1 / ((n : ℝ) + 1) + 1 / ((n : ℝ) + 1) / 3 <
        s - 1 / ((n : ℝ) + 1) + 2 * (1 / ((n : ℝ) + 1)) / 3)
    have hsub : ball w (s - 1 / ((n : ℝ) + 1)) ⊆ ball y t := ball_subset_ball' (by linarith)
    refine (measure_mono hsub).trans (le_iSup₂_of_le (⟨y, hyD⟩, t) ?_ le_rfl)
    show dist w y + (t : ℝ) < s
    linarith
  · refine iSup₂_le fun i hi => measure_mono (ball_subset_ball' ?_)
    have hi' : dist w i.1 + i.2 < s := hi
    rw [dist_comm] at hi'
    linarith

/-- `m ↦ inf_{w ∈ K} m(B_s(w))` is measurable for a compact `K`. -/
theorem measurable_iInf_measure_ball_of_isCompact {K : Set ℂ} (hK : IsCompact K) (s : ℝ) :
    Measurable fun m : Measure ℂ => ⨅ w ∈ K, m (ball w s) := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have := hDc.to_subtype
  have hrep : (fun m : Measure ℂ => ⨅ w ∈ K, m (ball w s)) = fun m =>
      ⨆ (F : Finset (D × ℚ)) (_ : K ⊆ ⋃ i ∈ F, {x : ℂ | dist x i.1 + i.2 < s}),
        ⨅ i ∈ F, m (ball (i.1 : ℂ) i.2) :=
    funext fun m => iInf_mem_compact_eq_iSup_finset (U := fun i : D × ℚ => {x : ℂ | dist x i.1 + i.2 < s})
      (fun i => isOpen_lt (by fun_prop) continuous_const) (fun i => m (ball (i.1 : ℂ) i.2))
      (fun w => m (ball w s)) (measure_ball_eq_iSup_rational hD m · s) hK
  rw [hrep]
  exact Measurable.iSup fun F => Measurable.iSup fun _ => Measurable.iInf fun i => Measurable.iInf fun _ =>
    Measure.measurable_coe measurableSet_ball

/-- `m ↦ sup_{w ∈ A} m(B_s(w))` is measurable for any `A`. -/
theorem measurable_iSup_measure_ball (A : Set ℂ) (s : ℝ) :
    Measurable fun m : Measure ℂ => ⨆ w ∈ A, m (ball w s) := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have := hDc.to_subtype
  have hrep : (fun m : Measure ℂ => ⨆ w ∈ A, m (ball w s)) = fun m =>
      ⨆ (i : D × ℚ) (_ : (A ∩ {x : ℂ | dist x i.1 + i.2 < s}).Nonempty), m (ball (i.1 : ℂ) i.2) :=
    funext fun m => iSup_mem_eq_iSup_nonempty (fun i : D × ℚ => {x : ℂ | dist x i.1 + i.2 < s})
      (fun i => m (ball (i.1 : ℂ) i.2)) (fun w => m (ball w s)) (measure_ball_eq_iSup_rational hD m · s) A
  rw [hrep]
  exact Measurable.iSup fun i => Measurable.iSup fun _ => Measure.measurable_coe measurableSet_ball

/-- An annulus is a countable union of compact annuli. -/
theorem annulus_eq_iUnion_isCompact (z : ℂ) (r₁ r₂ : ℝ) :
    annulus z r₁ r₂ = ⋃ n : ℕ, closedBall z (r₂ - 1 / ((n : ℝ) + 1)) \ ball z (r₁ + 1 / ((n : ℝ) + 1)) := by
  ext x
  simp only [annulus, Set.mem_sdiff, mem_ball, mem_closedBall, mem_iUnion, not_le, not_lt]
  constructor
  · rintro ⟨h1, h2⟩
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt (lt_min (sub_pos.2 h1) (sub_pos.2 h2))
    have hl := min_le_left (r₂ - dist x z) (dist x z - r₁)
    have hr := min_le_right (r₂ - dist x z) (dist x z - r₁)
    exact ⟨n, by linarith, by linarith⟩
  · rintro ⟨n, h1, h2⟩
    have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    exact ⟨by linarith, by linarith⟩

/-- An open ball is an annulus with a negative inner radius. -/
theorem ball_eq_annulus_neg_one (z : ℂ) (R : ℝ) : ball z R = annulus z (-1) R := by
  ext x
  simp only [annulus, Set.mem_sdiff, mem_ball, mem_closedBall, not_le]
  constructor
  · intro h
    exact ⟨h, by linarith [dist_nonneg (x := x) (y := z)]⟩
  · exact fun h => h.1

/-- `m ↦ inf_{w ∈ annulus z r₁ r₂} m(B_s(w))` is measurable. -/
theorem measurable_iInf_measure_ball_annulus (z : ℂ) (r₁ r₂ s : ℝ) :
    Measurable fun m : Measure ℂ => ⨅ w ∈ annulus z r₁ r₂, m (ball w s) := by
  simp_rw [annulus_eq_iUnion_isCompact z r₁ r₂, iInf_iUnion]
  exact Measurable.iInf fun n => measurable_iInf_measure_ball_of_isCompact
    ((isCompact_closedBall z _).diff isOpen_ball) s

/-! ## The logarithmic potential of the good-annulus event -/

/-- Lower semicontinuity of `v ↦ log(r / |u - v|) + 1` (with `r / 0 = 0`, `log 0 = 0` on the diagonal). -/
theorem logKernel_le_liminf {r : ℝ} (hr : 0 < r) (u v : ℂ) {x : ℕ → ℂ} (hx : Tendsto x atTop (𝓝 v)) :
    ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ≤
      liminf (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop := by
  by_cases huv : u = v
  · subst huv
    simp only [sub_self, norm_zero, div_zero, Real.log_zero, zero_add, ENNReal.ofReal_one]
    refine Filter.le_liminf_of_le (by isBoundedDefault) ?_
    filter_upwards [Metric.tendsto_nhds.1 hx r hr] with n hn
    rw [ENNReal.one_le_ofReal]
    have hlog : 0 ≤ Real.log (r / ‖u - x n‖) := by
      rcases eq_or_lt_of_le (norm_nonneg (u - x n)) with h0 | hpos
      · rw [← h0, div_zero, Real.log_zero]
      · apply Real.log_nonneg
        rw [le_div_iff₀ hpos, one_mul]
        rw [dist_comm, dist_eq_norm] at hn
        exact hn.le
    linarith
  · have hd : ‖u - v‖ ≠ 0 := norm_ne_zero_iff.2 (sub_ne_zero.2 huv)
    have h : Tendsto (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop
        (𝓝 (ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1))) :=
      ENNReal.tendsto_ofReal (((tendsto_const_nhds.div (tendsto_const_nhds.sub hx).norm hd).log
        (div_ne_zero hr.ne' hd)).add_const 1)
    exact h.liminf_eq.ge

/-- The logarithmic kernel is measurable in `u`. -/
theorem measurable_logKernel (r : ℝ) (v : ℂ) :
    Measurable fun u : ℂ => ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) :=
  (((measurable_const.div (measurable_id.sub_const v).norm).log).add_const 1).ennreal_ofReal

/-- The supremum over an open set `A` of the lower semicontinuous potential `v ↦ ∫_B log(r / |u - v|) + 1 dm(u)` is
its supremum over `A ∩ D`, `D` dense. -/
theorem iSup_logPotential_eq_iSup_inter_dense (m : Measure ℂ) {r : ℝ} (hr : 0 < r) {A : Set ℂ}
    (hA : IsOpen A) {D : Set ℂ} (hD : Dense D) (B : Set ℂ) :
    ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m =
      ⨆ v ∈ A ∩ D, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m := by
  apply le_antisymm
  · refine iSup₂_le fun v hv => ?_
    obtain ⟨x, hxA, hxv⟩ := mem_closure_iff_seq_limit.1 (hD.open_subset_closure_inter hA hv)
    calc ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m
        ≤ ∫⁻ u in B, liminf (fun n => ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1)) atTop ∂m :=
          lintegral_mono fun u => logKernel_le_liminf hr u v hxv
      _ ≤ liminf (fun n => ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m) atTop :=
          lintegral_liminf_le fun n => measurable_logKernel r (x n)
      _ ≤ limsup (fun n => ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m) atTop :=
          liminf_le_limsup
      _ ≤ ⨆ n, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - x n‖) + 1) ∂m := limsup_le_iSup
      _ ≤ _ := iSup_le fun n => le_iSup₂_of_le (x n) (hxA n) le_rfl
  · exact iSup₂_le fun v hv => le_iSup₂_of_le v hv.1 le_rfl

/-- `m ↦ sup_{v ∈ A} ∫_B log(r / |u - v|) + 1 dm(u)` is measurable for `A` open and `B` measurable. -/
theorem measurable_iSup_logPotential {r : ℝ} (hr : 0 < r) {A : Set ℂ} (hA : IsOpen A) {B : Set ℂ}
    (hB : MeasurableSet B) :
    Measurable fun m : Measure ℂ => ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense ℂ
  have hrep : (fun m : Measure ℂ => ⨆ v ∈ A, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m) =
      fun m => ⨆ v ∈ A ∩ D, ∫⁻ u in B, ENNReal.ofReal (Real.log (r / ‖u - v‖) + 1) ∂m :=
    funext fun m => iSup_logPotential_eq_iSup_inter_dense m hr hA hD B
  rw [hrep]
  refine Measurable.biSup _ (hDc.mono inter_subset_right) fun v _ => ?_
  simp_rw [← lintegral_indicator hB]
  exact Measure.measurable_lintegral ((measurable_logKernel r v).indicator hB)

/-! ## The events of Lemmas 6.4 and 2.7 are measurable sets of measures -/

/-- The good-annulus event `E_r(z; C)` (`IsGoodAnnulusEvent`, `r > 0`) is a measurable set of measures. -/
theorem measurableSet_isGoodAnnulusEvent (c₀ C : ℝ) {r : ℝ} (hr : 0 < r) (z : ℂ) :
    MeasurableSet {m : Measure ℂ | IsGoodAnnulusEvent m c₀ C r z} := by
  have hA : IsOpen (annulus z r (2 * r)) := isOpen_ball.sdiff isClosed_closedBall
  have hL := measurable_iSup_logPotential hr hA hA.measurableSet
  have hR := (measurable_iInf_measure_ball_annulus z r (2 * r) (c₀ * r)).const_mul (ENNReal.ofReal C)
  exact measurableSet_le hL hR

/-- The event of Lemma 6.4 at the scale `δ` is a measurable set of measures. -/
theorem measurableSet_goodAnnulusCover (ρ c₀ C δ : ℝ) :
    MeasurableSet {m : Measure ℂ | GoodAnnulusCover m ρ c₀ C δ} := by
  have h : {m : Measure ℂ | GoodAnnulusCover m ρ c₀ C δ} = {m | ∀ a b : ℤ,
      ((δ / 100 : ℝ) : ℂ) * (a + b * Complex.I) ∈
        ball (0 : ℂ) (ρ - 3 * Real.sqrt δ) \ ball 0 (10 * Real.sqrt δ) →
      ∃ k : ℕ, δ ≤ (7 : ℝ)⁻¹ ^ k ∧ (7 : ℝ)⁻¹ ^ k ≤ Real.sqrt δ ∧
        IsGoodAnnulusEvent m c₀ C ((7 : ℝ)⁻¹ ^ k) (((δ / 100 : ℝ) : ℂ) * (a + b * Complex.I))} := by
    ext m
    simp only [GoodAnnulusCover, mem_ofPred_eq]
    constructor
    · intro h a b hz
      obtain ⟨r, h1, h2, ⟨k, rfl⟩, h4⟩ := h _ hz ⟨a, b, rfl⟩
      exact ⟨k, h1, h2, h4⟩
    · rintro h z hz ⟨a, b, rfl⟩
      obtain ⟨k, h1, h2, h4⟩ := h a b hz
      exact ⟨_, h1, h2, ⟨k, rfl⟩, h4⟩
  rw [h]
  exact measurableSet_setOfPred.2 (Measurable.forall fun a => Measurable.forall fun b => measurable_const.imp
    (Measurable.exists fun k => measurable_const.and (measurable_const.and
      (measurableSet_setOfPred.1 (measurableSet_isGoodAnnulusEvent c₀ C (by positivity) _)))))

/-- The event of Lemma 2.7 at the scale `δ` is a measurable set of measures. -/
theorem measurableSet_volumeGrowthAt (βp βm δ : ℝ) :
    MeasurableSet {m : Measure ℂ | VolumeGrowthAt m βp βm δ} := by
  have h : {m : Measure ℂ | VolumeGrowthAt m βp βm δ} =
      {m | ENNReal.ofReal (δ ^ βm) ≤ ⨅ z ∈ ball (0 : ℂ) (1 - δ), m (ball z δ)} ∩
        {m | ⨆ z ∈ ball (0 : ℂ) (1 - δ), m (ball z δ) ≤ ENNReal.ofReal (δ ^ βp)} := by
    ext m
    simp only [VolumeGrowthAt, mem_inter_iff, mem_ofPred_eq, le_iInf₂_iff, iSup₂_le_iff]
    exact ⟨fun h => ⟨fun z hz => (h z hz).1, fun z hz => (h z hz).2⟩,
      fun h z hz => ⟨h.1 z hz, h.2 z hz⟩⟩
  have hinf : Measurable fun m : Measure ℂ => ⨅ z ∈ ball (0 : ℂ) (1 - δ), m (ball z δ) := by
    rw [ball_eq_annulus_neg_one (0 : ℂ) (1 - δ)]
    exact measurable_iInf_measure_ball_annulus 0 (-1) (1 - δ) δ
  rw [h]
  exact (measurableSet_le measurable_const hinf).inter
    (measurableSet_le (measurable_iSup_measure_ball _ δ) measurable_const)

/-! ## The almost-sure form of the step -/

/-- `E` contains, outside a `P`-null set, a `σ(h)`-measurable event `F` with `P[Fᶜ] ≤ P[Eᶜ]` (the probability of
`Eᶜ` is the outer measure). The almost-sure form of `IsFieldInnerMeasurable`. -/
def IsFieldInnerMeasurableAE {Ω : Type} [MeasurableSpace Ω] (S : MatedCRTEnv Ω) (E : Set Ω) : Prop :=
  ∃ F : Set Ω, MeasurableSet[S.fieldSigma] F ∧ S.P (F \ E) = 0 ∧ S.P Fᶜ ≤ S.P Eᶜ

/-- **Step (measurability of the good-scale events, line 2505), almost-sure form.** `GoodScaleEventMeasurableStep`
with `F ⊆ E` outside a `P`-null set. This is what the Borel-Cantelli step of line 2505 uses. -/
def GoodScaleEventMeasurableAEStep (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
  ∀ ρ c₀ C βp βm δ : ℝ,
    IsFieldInnerMeasurableAE S {ω | GoodAnnulusCover (S.μ ω) ρ c₀ C δ} ∧
    IsFieldInnerMeasurableAE S {ω | VolumeGrowthAt (S.μ ω) βp βm δ}

/-- **Step (the LQG measure is determined by the field, eq:measure-lim, line 470).** The LQG measure `μ_h` is almost
surely equal to a `σ(h)`-measurable random measure. (It is the almost sure vague limit of the measures
`ε^{γ²/2} e^{γ h_ε(z)} dz` along dyadic `ε`, `IsLQGMeasure`; what is missing is that the circle averages `h_ε(z)` are
almost surely equal to `σ(h)`-measurable random variables, which `IsQuantumCone` gives only through the joint law of
the pairings and circle averages.) -/
def LQGMeasureFieldMeasurableStep (𝒮 : SpaceFillingSLEModel) : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 2 → ∀ (Ω : Type) [MeasurableSpace Ω] (S : MatedCRTEnv Ω), S.IsValid 𝒮 γ →
    ∃ μ' : Ω → Measure ℂ, Measurable[S.fieldSigma] μ' ∧ ∀ᵐ ω ∂S.P, μ' ω = S.μ ω

/-- If `μ_h` is almost surely equal to a `σ(h)`-measurable random measure `μ'`, every event `{μ_h ∈ A}` with `A` a
measurable set of measures has the almost-sure inner approximation `{μ' ∈ A}`. -/
theorem MatedCRTEnv.isFieldInnerMeasurableAE_of_measurableSet {Ω : Type} [MeasurableSpace Ω]
    (S : MatedCRTEnv Ω) {μ' : Ω → Measure ℂ} (hμ' : Measurable[S.fieldSigma] μ')
    (hae : ∀ᵐ ω ∂S.P, μ' ω = S.μ ω) {A : Set (Measure ℂ)} (hA : MeasurableSet A) :
    IsFieldInnerMeasurableAE S {ω | S.μ ω ∈ A} := by
  have hN : S.P {ω | ¬ μ' ω = S.μ ω} = 0 := ae_iff.1 hae
  refine ⟨μ' ⁻¹' A, hμ' hA, measure_mono_null ?_ hN, ?_⟩
  · rintro ω ⟨h1, h2⟩ heq
    have h1' : μ' ω ∈ A := h1
    rw [heq] at h1'
    exact h2 h1'
  · calc S.P (μ' ⁻¹' A)ᶜ ≤ S.P ({ω | S.μ ω ∈ A}ᶜ ∪ {ω | ¬ μ' ω = S.μ ω}) := by
          refine measure_mono fun ω hω => ?_
          by_cases heq : μ' ω = S.μ ω
          · refine Or.inl fun h => hω ?_
            show μ' ω ∈ A
            rw [heq]
            exact h
          · exact Or.inr heq
      _ ≤ S.P {ω | S.μ ω ∈ A}ᶜ + S.P {ω | ¬ μ' ω = S.μ ω} := measure_union_le _ _
      _ = S.P {ω | S.μ ω ∈ A}ᶜ := by rw [hN, add_zero]

/-- **`GoodScaleEventMeasurableAEStep`** from `LQGMeasureFieldMeasurableStep` and the measurability of the events of
Lemmas 6.4 and 2.7 as sets of measures. -/
theorem goodScaleEventMeasurableAEStep_of_lqgMeasure (𝒮 : SpaceFillingSLEModel)
    (h : LQGMeasureFieldMeasurableStep 𝒮) : GoodScaleEventMeasurableAEStep 𝒮 := by
  intro γ hγ hγ2 Ω _ S hS ρ c₀ C βp βm δ
  obtain ⟨μ', hμ', hae⟩ := h γ hγ hγ2 Ω S hS
  exact ⟨S.isFieldInnerMeasurableAE_of_measurableSet hμ' hae (measurableSet_goodAnnulusCover ρ c₀ C δ),
    S.isFieldInnerMeasurableAE_of_measurableSet hμ' hae (measurableSet_volumeGrowthAt βp βm δ)⟩

end MatedCRT
